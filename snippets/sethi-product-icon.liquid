      <path d="M12 3 5.5 5.8v5.4c0 4.1 2.5 7.8 6.5 9.8 4-2 6.5-5.7 6.5-9.8V5.8L12 3Z"/>
      <path d="m8.8 12 2.1 2.1 4.3-4.4"/>
