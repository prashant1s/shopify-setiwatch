{%- comment -%}
  Luxury Menu Final
  Four compact desktop layouts with Dawn mobile drawer preserved.
{%- endcomment -%}


<style>
  .lmf-nav__list{gap:clamp(1.2rem,1.6vw,2.4rem)}
  .lmf-nav__link{position:relative;padding-inline:0;font-size:1.5rem;color:inherit;transition:color .2s ease}
  .lmf-nav__link:after{content:"";position:absolute;left:0;right:0;bottom:.65rem;height:1px;background:rgb(var(--color-gold));transform:scaleX(0);transform-origin:right;transition:transform .22s ease}
  .lmf-nav__link:hover,.lmf-menu[open]>summary{color:rgb(var(--color-gold-deep))}
  .lmf-nav__link:hover:after,.lmf-menu[open]>summary:after{transform:scaleX(1);transform-origin:left}
  .lmf-nav__link svg{transition:transform .28s cubic-bezier(.22,1,.36,1)}
  .lmf-menu[open]>summary svg{transform:rotate(180deg)}
  @media(prefers-reduced-motion:reduce){
    .lmf-nav__link,.lmf-nav__link:after,.lmf-nav__link svg{transition:none!important}
  }

  .lmf-menu__panel{left:0!important;right:0!important;width:100%!important;padding:0!important;border-top:1px solid rgba(var(--color-foreground),.08);border-bottom:1px solid rgba(var(--color-foreground),.08);box-shadow:0 22px 55px rgba(0,0,0,.07)}
  .lmf-menu__inner{padding-top:2.8rem!important;padding-bottom:2.4rem!important;max-width:none!important;width:100%!important}
  .lmf-kicker{margin:0 0 1.4rem;font-size:1.05rem;letter-spacing:.16em;text-transform:uppercase;font-weight:600}

  /* Editorial commerce */
  .lmf-editorial{display:grid!important;grid-template-columns:28% 38% 34%;gap:2.4rem;min-height:410px;max-height:460px;overflow:hidden}
  .lmf-editorial__collection-list{display:grid;gap:.75rem}
  .lmf-collection-row{display:grid;grid-template-columns:5rem 1fr auto;align-items:center;gap:1rem;padding:.65rem .75rem;border:1px solid rgba(var(--color-foreground),.1);border-radius:1.15rem;color:rgb(var(--color-foreground));text-decoration:none;background:rgba(var(--color-background),.85);transition:.2s ease}
  .lmf-collection-row:hover{transform:translateY(-2px);box-shadow:0 10px 24px rgba(0,0,0,.06)}
  .lmf-collection-row__media{width:5rem;height:5rem;overflow:hidden;border-radius:50%;background:rgba(var(--color-foreground),.04)}
  .lmf-collection-row__image{width:100%;height:100%;object-fit:cover}
  .lmf-collection-row__copy{display:grid;gap:.1rem}
  .lmf-collection-row__copy strong{font-size:1.4rem}
  .lmf-collection-row__copy small{font-size:1.05rem;opacity:.62}

  .lmf-price-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.1rem}
  .lmf-price-card{color:rgb(var(--color-foreground));text-decoration:none}
  .lmf-price-card__media{overflow:hidden;aspect-ratio:1.5/1;border-radius:1.25rem;background:rgba(var(--color-foreground),.035)}
  .lmf-price-card__image{width:100%;height:100%;object-fit:cover;transition:transform .55s ease}
  .lmf-price-card:hover .lmf-price-card__image{transform:scale(1.04)}
  .lmf-price-card>span{display:block;padding-top:.65rem;text-align:center;font-size:1.35rem;font-weight:500}

  .lmf-feature-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));grid-template-rows:repeat(2,minmax(0,1fr));gap:1.1rem;height:385px}
  .lmf-feature-tile{position:relative;overflow:hidden;border-radius:1.3rem;color:#fff;text-decoration:none;background:#111}
  .lmf-feature-tile--tall{grid-row:span 2}
  .lmf-feature-tile__media,.lmf-feature-tile__image{position:absolute;inset:0;width:100%;height:100%}
  .lmf-feature-tile__image{object-fit:cover;transition:transform .65s ease}
  .lmf-feature-tile:hover .lmf-feature-tile__image{transform:scale(1.045)}
  .lmf-feature-tile__overlay{position:absolute;inset:0;background:linear-gradient(180deg,transparent 32%,rgba(0,0,0,.72))}
  .lmf-feature-tile__copy{position:absolute;z-index:2;left:1.5rem;right:1.5rem;bottom:1.3rem;display:grid;gap:.25rem}
  .lmf-feature-tile__copy span{font-size:.9rem;letter-spacing:.14em;text-transform:uppercase;opacity:.82}
  .lmf-feature-tile__copy strong{font-size:1.7rem;line-height:1.1}

  /* Product + blog */
  .lmf-product-blog{display:grid!important;gap:2rem;max-height:500px;overflow:hidden}
  .lmf-product-grid{display:grid!important;grid-template-columns:repeat(5,minmax(0,1fr));gap:1.1rem}
  .lmf-product-card{color:rgb(var(--color-foreground));text-decoration:none}
  .lmf-product-card__media{aspect-ratio:1/1;overflow:hidden;border-radius:1.1rem;background:rgba(var(--color-foreground),.035)}
  .lmf-product-card__image{width:100%;height:100%;object-fit:contain;padding:.8rem}
  .lmf-product-card strong,.lmf-product-card span{display:block;margin-top:.5rem}
  .lmf-product-card strong{font-size:1.25rem}
  .lmf-product-card span{font-size:1.1rem;opacity:.72}
  .lmf-blog-grid{display:grid!important;grid-template-columns:repeat(4,minmax(0,1fr));gap:1.1rem}
  .lmf-blog-card{color:rgb(var(--color-foreground));text-decoration:none}
  .lmf-blog-card__media{aspect-ratio:1.65/1;overflow:hidden;border-radius:1.1rem;background:rgba(var(--color-foreground),.04)}
  .lmf-blog-card__image{width:100%;height:100%;object-fit:cover;transition:transform .55s ease}
  .lmf-blog-card:hover .lmf-blog-card__image{transform:scale(1.04)}
  .lmf-blog-card>span{display:block;margin-top:.65rem;font-size:1.25rem}

  /* Columns + slider */
  .lmf-columns{display:grid!important;grid-template-columns:repeat(4,minmax(0,1fr))!important;gap:2.4rem 4rem!important;padding-bottom:2.6rem!important}
  .lmf-column{min-width:0}
  .lmf-column__title{display:block!important;margin:0 0 1.15rem!important;padding:0!important;color:rgb(var(--color-foreground))!important;font-size:1.85rem!important;font-weight:600!important;text-decoration:none!important}
  .lmf-column__links{display:grid!important;gap:.65rem!important;margin:0!important;padding:0!important}
  .lmf-column__link{display:inline-flex!important;width:fit-content!important;color:rgba(var(--color-foreground),.78)!important;font-size:1.38rem!important;text-decoration:none!important;transition:.18s ease}
  .lmf-column__link:hover{transform:translateX(3px);color:rgb(var(--color-foreground))!important}
  .lmf-column__links--boxed{display:flex!important;flex-wrap:wrap!important;gap:.65rem!important}
  .lmf-column__link--boxed{padding:.72rem 1rem!important;border:1px solid rgba(var(--color-foreground),.13)!important;border-radius:999px!important;background:rgba(var(--color-background),.9)!important;box-shadow:0 5px 14px rgba(0,0,0,.035)!important;font-size:1.22rem!important;line-height:1!important}
  .lmf-column__link--boxed:hover{transform:translateY(-2px)!important;border-color:rgba(var(--color-foreground),.25)!important;box-shadow:0 9px 20px rgba(0,0,0,.06)!important}

  .lmf-discover{padding-top:1.8rem;border-top:1px solid rgba(var(--color-foreground),.1)}
  .lmf-discover__head{display:flex;justify-content:space-between;align-items:center;margin-bottom:1.4rem}
  .lmf-discover__head h3{margin:0;font-size:1.8rem;font-weight:500}
  .lmf-discover__arrows{display:flex;gap:.8rem}
  .lmf-discover__arrows button{width:5rem;height:3.8rem;border:0;border-radius:.9rem;background:#000;color:#fff;font-size:1.7rem;cursor:pointer}
  .lmf-discover__arrows button:disabled{opacity:.34}
  .lmf-discover__track{display:grid!important;grid-auto-flow:column!important;grid-auto-columns:calc((100% - 5.2rem)/5)!important;gap:1.3rem!important;overflow-x:auto!important;scroll-snap-type:x mandatory;scroll-behavior:smooth;scrollbar-width:none}
  .lmf-discover__track::-webkit-scrollbar{display:none}
  .lmf-category-card{color:rgb(var(--color-foreground));text-decoration:none;scroll-snap-align:start}
  .lmf-category-card__media{overflow:hidden;aspect-ratio:1.36/1;border-radius:1.15rem;background:rgba(var(--color-foreground),.035)}
  .lmf-category-card__image{width:100%;height:100%;object-fit:cover;transition:transform .55s ease}
  .lmf-category-card:hover .lmf-category-card__image{transform:scale(1.045)}
  .lmf-category-card>span{display:block;padding-top:.85rem;text-align:center;font-size:1.4rem}

  /* Visual tiles */
  .lmf-visual-grid{display:grid!important;grid-template-columns:repeat(4,minmax(0,1fr))!important;gap:1.2rem!important;max-height:430px;overflow:hidden}
  .lmf-visual-tile{position:relative;min-height:390px;overflow:hidden;border-radius:1.4rem;color:#fff;text-decoration:none;background:#111}
  .lmf-visual-tile__media,.lmf-visual-tile__image{position:absolute;inset:0;width:100%;height:100%}
  .lmf-visual-tile__image{object-fit:cover;transition:transform .65s ease}
  .lmf-visual-tile:hover .lmf-visual-tile__image{transform:scale(1.045)}
  .lmf-visual-tile__overlay{position:absolute;inset:0;background:linear-gradient(180deg,transparent 32%,rgba(0,0,0,.72))}
  .lmf-visual-tile__copy{position:absolute;z-index:2;left:1.7rem;right:1.7rem;bottom:1.5rem;display:grid;gap:.3rem}
  .lmf-visual-tile__copy span{font-size:.9rem;letter-spacing:.15em;text-transform:uppercase;opacity:.82}
  .lmf-visual-tile__copy strong{font-size:2rem;line-height:1.1}

  .lmf-animate{opacity:0;transform:translateY(10px)}
  .lmf-menu[open] .lmf-animate{animation:lmfFade .44s ease forwards}
  .lmf-menu--slide_right .lmf-animate{transform:translateX(16px)}
  .lmf-menu--soft_zoom .lmf-animate{transform:scale(.97)}
  @keyframes lmfFade{to{opacity:1;transform:none}}

  @media(max-width:1499px){
    .lmf-editorial{grid-template-columns:27% 39% 34%}
    .lmf-product-grid{grid-template-columns:repeat(4,minmax(0,1fr))}
    .lmf-discover__track{grid-auto-columns:calc((100% - 3.9rem)/4)!important}
  }
  @media(max-width:1199px){
    .lmf-editorial{grid-template-columns:32% 42% 26%;gap:1.7rem}
    .lmf-feature-grid{grid-template-columns:1fr;grid-template-rows:repeat(3,minmax(0,1fr))}
    .lmf-feature-tile--tall{grid-row:span 1}
    .lmf-columns{grid-template-columns:repeat(3,minmax(0,1fr))!important}
    .lmf-product-grid{grid-template-columns:repeat(3,minmax(0,1fr))}
    .lmf-blog-grid{grid-template-columns:repeat(3,minmax(0,1fr))}
    .lmf-visual-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important;max-height:none}
    .lmf-visual-tile{min-height:300px}
  }
  @media(max-width:989px){.lmf-nav{display:none!important}}
  @media(prefers-reduced-motion:reduce){
    .lmf-animate,.lmf-menu[open] .lmf-animate{opacity:1;transform:none;animation:none}
  }
</style>

<nav class="header__inline-menu lmf-nav" aria-label="Primary navigation">
  <ul class="list-menu list-menu--inline lmf-nav__list" role="list">
    {%- for link in section.settings.menu.links -%}
      {%- assign trigger = link.title | handle -%}
      {%- assign layout = 'columns_slider' -%}
      {%- assign animation = 'fade_up' -%}
      {%- assign brand_style = 'plain' -%}

      {%- for block in section.blocks -%}
        {%- if block.type == 'menu_design' -%}
          {%- assign design_trigger = block.settings.menu_trigger | handle -%}
          {%- if design_trigger == trigger -%}
            {%- assign layout = block.settings.layout -%}
            {%- assign animation = block.settings.animation -%}
            {%- assign brand_style = block.settings.brand_style -%}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}

      <li class="lmf-nav__item">
        {%- if link.links != blank -%}
          <header-menu>
            <details class="mega-menu lmf-menu lmf-menu--{{ layout }} lmf-menu--{{ animation }}">
              <summary class="header__menu-item list-menu__item link focus-inset lmf-nav__link" aria-haspopup="true">
                <span>{{ link.title | escape }}</span>
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </summary>

              <div class="mega-menu__content color-{{ section.settings.menu_color_scheme }} gradient motion-reduce global-settings-popup lmf-menu__panel" tabindex="-1">
                <div class="page-width lmf-menu__inner">

                  {%- case layout -%}

                    {%- when 'editorial_commerce' -%}
                      <div class="lmf-editorial">
                        <section class="lmf-editorial__collections">
                          <h3 class="lmf-kicker">Collection</h3>
                          <div class="lmf-editorial__collection-list">
                            {%- for block in section.blocks limit: 50 -%}
                              {%- assign block_trigger = block.settings.menu_trigger | handle -%}
                              {%- if block.type == 'editorial_item' and block_trigger == trigger -%}
                                <a href="{{ block.settings.link | default: link.url }}" class="lmf-collection-row lmf-animate" {{ block.shopify_attributes }}>
                                  <span class="lmf-collection-row__media">
                                    {%- if block.settings.image != blank -%}
                                      {{ block.settings.image | image_url: width: 180 | image_tag: loading: 'lazy', class: 'lmf-collection-row__image', alt: block.settings.title }}
                                    {%- else -%}
                                      {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg lmf-collection-row__image' }}
                                    {%- endif -%}
                                  </span>
                                  <span class="lmf-collection-row__copy">
                                    <strong>{{ block.settings.title | escape }}</strong>
                                    {%- if block.settings.subtitle != blank -%}
                                      <small>{{ block.settings.subtitle | escape }}</small>
                                    {%- endif -%}
                                  </span>
                                  <span aria-hidden="true">→</span>
                                </a>
                              {%- endif -%}
                            {%- endfor -%}
                          </div>
                        </section>

                        <section class="lmf-editorial__price">
                          <h3 class="lmf-kicker">By price</h3>
                          <div class="lmf-price-grid">
                            {%- for block in section.blocks -%}
                              {%- assign block_trigger = block.settings.menu_trigger | handle -%}
                              {%- if block.type == 'price_card' and block_trigger == trigger -%}
                                {%- assign price_url = block.settings.link -%}
                                {%- if price_url == blank -%}
                                  {%- assign price_url = routes.all_products_collection_url -%}
                                {%- endif -%}
                                {%- assign price_url = price_url | append: '?filter.v.price.gte=' | append: block.settings.min_price -%}
                                {%- if block.settings.max_price > 0 -%}
                                  {%- assign price_url = price_url | append: '&filter.v.price.lte=' | append: block.settings.max_price -%}
                                {%- endif -%}

                                <a href="{{ price_url }}" class="lmf-price-card lmf-animate" {{ block.shopify_attributes }}>
                                  <div class="lmf-price-card__media">
                                    {%- if block.settings.image != blank -%}
                                      {{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', class: 'lmf-price-card__image', alt: block.settings.title }}
                                    {%- else -%}
                                      {{ 'collection-2' | placeholder_svg_tag: 'placeholder-svg lmf-price-card__image' }}
                                    {%- endif -%}
                                  </div>
                                  <span>{{ block.settings.title | escape }}</span>
                                </a>
                              {%- endif -%}
                            {%- endfor -%}
                          </div>
                        </section>

                        <section class="lmf-editorial__features">
                          <h3 class="lmf-kicker">Trending</h3>
                          <div class="lmf-feature-grid">
                            {%- for block in section.blocks -%}
                              {%- assign block_trigger = block.settings.menu_trigger | handle -%}
                              {%- if block.type == 'feature_tile' and block_trigger == trigger -%}
                                <a href="{{ block.settings.link | default: link.url }}" class="lmf-feature-tile lmf-feature-tile--{{ block.settings.tile_size }} lmf-animate" {{ block.shopify_attributes }}>
                                  <div class="lmf-feature-tile__media">
                                    {%- if block.settings.image != blank -%}
                                      {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', class: 'lmf-feature-tile__image', alt: block.settings.title }}
                                    {%- else -%}
                                      {{ 'collection-3' | placeholder_svg_tag: 'placeholder-svg lmf-feature-tile__image' }}
                                    {%- endif -%}
                                  </div>
                                  <div class="lmf-feature-tile__overlay"></div>
                                  <div class="lmf-feature-tile__copy">
                                    <span>{{ block.settings.eyebrow | escape }}</span>
                                    <strong>{{ block.settings.title | escape }}</strong>
                                  </div>
                                </a>
                              {%- endif -%}
                            {%- endfor -%}
                          </div>
                        </section>
                      </div>

                    {%- when 'product_blog' -%}
                      <div class="lmf-product-blog">
                        <section>
                          <h3 class="lmf-kicker">Featured products</h3>
                          <div class="lmf-product-grid">
                            {%- for block in section.blocks -%}
                              {%- assign block_trigger = block.settings.menu_trigger | handle -%}
                              {%- if block.type == 'featured_product' and block_trigger == trigger and block.settings.product != blank -%}
                                {%- assign product = block.settings.product -%}
                                <a href="{{ product.url }}" class="lmf-product-card lmf-animate" {{ block.shopify_attributes }}>
                                  <div class="lmf-product-card__media">
                                    {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'lmf-product-card__image', alt: product.title }}
                                  </div>
                                  <strong>{{ product.title }}</strong>
                                  <span>{{ product.price | money }}</span>
                                </a>
                              {%- endif -%}
                            {%- endfor -%}
                          </div>
                        </section>

                        <section>
                          <h3 class="lmf-kicker">Journal</h3>
                          <div class="lmf-blog-grid">
                            {%- for block in section.blocks -%}
                              {%- assign block_trigger = block.settings.menu_trigger | handle -%}
                              {%- if block.type == 'blog_card' and block_trigger == trigger and block.settings.article != blank -%}
                                {%- assign article = block.settings.article -%}
                                {%- assign article_image = block.settings.custom_image | default: article.image -%}
                                <a href="{{ article.url }}" class="lmf-blog-card lmf-animate" {{ block.shopify_attributes }}>
                                  <div class="lmf-blog-card__media">
                                    {%- if article_image != blank -%}
                                      {{ article_image | image_url: width: 850 | image_tag: loading: 'lazy', class: 'lmf-blog-card__image', alt: article.title }}
                                    {%- endif -%}
                                  </div>
                                  <span>{{ article.title }}</span>
                                </a>
                              {%- endif -%}
                            {%- endfor -%}
                          </div>
                        </section>
                      </div>

                    {%- when 'visual_tiles' -%}
                      {%- assign tile_count = 0 -%}
                      {%- for block in section.blocks -%}
                        {%- assign block_trigger = block.settings.menu_trigger | handle -%}
                        {%- if block.type == 'visual_tile' and block_trigger == trigger -%}
                          {%- assign tile_count = tile_count | plus: 1 -%}
                        {%- endif -%}
                      {%- endfor -%}
                      <div class="lmf-visual-grid{% if tile_count <= 4 %} lmf-visual-grid--fill{% endif %}"{% if tile_count <= 4 %} style="--lmf-fill-count:{{ tile_count }}"{% endif %}>
                        {%- for block in section.blocks -%}
                          {%- assign block_trigger = block.settings.menu_trigger | handle -%}
                          {%- if block.type == 'visual_tile' and block_trigger == trigger -%}
                            <a href="{{ block.settings.link | default: link.url }}" class="lmf-visual-tile lmf-animate" {{ block.shopify_attributes }}>
                              <div class="lmf-visual-tile__media">
                                {%- if block.settings.image != blank -%}
                                  {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', class: 'lmf-visual-tile__image', alt: block.settings.title }}
                                {%- else -%}
                                  {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg lmf-visual-tile__image' }}
                                {%- endif -%}
                              </div>
                              <div class="lmf-visual-tile__overlay"></div>
                              <div class="lmf-visual-tile__copy">
                                <span>{{ block.settings.eyebrow | escape }}</span>
                                <strong>{{ block.settings.title | escape }}</strong>
                              </div>
                            </a>
                          {%- endif -%}
                        {%- endfor -%}
                      </div>

                    {%- else -%}
                      <div class="lmf-brand-groups">
                        {%- for childlink in link.links -%}
                          {%- assign child_handle = childlink.title | handle -%}
                          <section class="lmf-brand-group lmf-animate">
                            <div class="lmf-brand-group__head">
                              <a href="{{ childlink.url }}" class="lmf-brand-group__title">
                                {{ childlink.title | escape }}
                              </a>
                              <span class="lmf-brand-group__line"></span>
                            </div>

                            <div class="lmf-brand-card-list">
                              {%- assign custom_brand_count = 0 -%}

                              {%- for block in section.blocks -%}
                                {%- assign block_trigger = block.settings.menu_trigger | handle -%}
                                {%- assign block_group = block.settings.group_title | handle -%}

                                {%- if block.type == 'brand_card' and block_trigger == trigger and block_group == child_handle -%}
                                  {%- assign custom_brand_count = custom_brand_count | plus: 1 -%}
                                  <a href="{{ block.settings.link | default: childlink.url }}" class="lmf-brand-card" {{ block.shopify_attributes }}>
                                    <span class="lmf-brand-card__logo">
                                      {%- if block.settings.logo != blank -%}
                                        {{
                                          block.settings.logo
                                          | image_url: width: 180
                                          | image_tag:
                                            loading: 'lazy',
                                            widths: '80,120,180',
                                            sizes: '54px',
                                            class: 'lmf-brand-card__logo-image',
                                            alt: block.settings.title
                                        }}
                                      {%- else -%}
                                        <span class="lmf-brand-card__initial">
                                          {{ block.settings.title | slice: 0, 1 | upcase }}
                                        </span>
                                      {%- endif -%}
                                    </span>

                                    <span class="lmf-brand-card__copy">
                                      <strong>{{ block.settings.title | escape }}</strong>
                                      {%- if block.settings.subtitle != blank -%}
                                        <small>{{ block.settings.subtitle | escape }}</small>
                                      {%- endif -%}
                                    </span>

                                    <span class="lmf-brand-card__arrow" aria-hidden="true">→</span>
                                  </a>
                                {%- endif -%}
                              {%- endfor -%}

                              {%- if custom_brand_count == 0 and childlink.links != blank -%}
                                {%- for grandchildlink in childlink.links -%}
                                  <a href="{{ grandchildlink.url }}" class="lmf-brand-card lmf-brand-card--fallback">
                                    <span class="lmf-brand-card__logo">
                                      <span class="lmf-brand-card__initial">
                                        {{ grandchildlink.title | slice: 0, 1 | upcase }}
                                      </span>
                                    </span>

                                    <span class="lmf-brand-card__copy">
                                      <strong>{{ grandchildlink.title | escape }}</strong>
                                    </span>

                                    <span class="lmf-brand-card__arrow" aria-hidden="true">→</span>
                                  </a>
                                {%- endfor -%}
                              {%- endif -%}
                            </div>
                          </section>
                        {%- endfor -%}
                      </div>

