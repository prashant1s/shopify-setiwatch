<script>
(() => {
  function init(scope=document){
    scope.querySelectorAll('.lmf-discover').forEach(root=>{
      if(root.dataset.ready)return;
      root.dataset.ready='1';
      const slider=root.querySelector('[data-lmf-slider]');
      const prev=root.querySelector('[data-lmf-prev]');
      const next=root.querySelector('[data-lmf-next]');
      if(!slider||!prev||!next)return;

      const step=()=>{
        const card=slider.querySelector('.lmf-category-card');
        if(!card)return slider.clientWidth*.8;
        const styles=getComputedStyle(slider);
        const gap=parseFloat(styles.columnGap||styles.gap||0);
        return card.getBoundingClientRect().width+gap;
      };

      const update=()=>{
        const max=slider.scrollWidth-slider.clientWidth;
        prev.disabled=slider.scrollLeft<=2;
        next.disabled=slider.scrollLeft>=max-2;
      };

      prev.addEventListener('click',()=>slider.scrollBy({left:-step(),behavior:'smooth'}));
      next.addEventListener('click',()=>slider.scrollBy({left:step(),behavior:'smooth'}));
      slider.addEventListener('scroll',update,{passive:true});
      requestAnimationFrame(update);
    });
  }

  document.addEventListener('DOMContentLoaded',()=>init());
  document.addEventListener('shopify:section:load',e=>init(e.target));
})();
</script>


