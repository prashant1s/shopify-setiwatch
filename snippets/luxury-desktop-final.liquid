<script>
(() => {
  const initLuxuryHoverMenus = (scope = document) => {
    if (!window.matchMedia('(min-width: 990px)').matches) return;

    scope.querySelectorAll('.lmf-menu').forEach((menu) => {
      if (menu.dataset.hoverReady === 'true') return;
      menu.dataset.hoverReady = 'true';

      let closeTimer;

      const openMenu = () => {
        clearTimeout(closeTimer);

        document.querySelectorAll('.lmf-menu[open]').forEach((other) => {
          if (other !== menu) other.removeAttribute('open');
        });

        menu.setAttribute('open', '');
      };

      const scheduleClose = () => {
        clearTimeout(closeTimer);
        closeTimer = setTimeout(() => {
          menu.removeAttribute('open');
        }, 140);
      };

      menu.addEventListener('mouseenter', openMenu);
      menu.addEventListener('mouseleave', scheduleClose);

      const panel = menu.querySelector('.lmf-menu__panel');
      if (panel) {
        panel.addEventListener('mouseenter', () => clearTimeout(closeTimer));
        panel.addEventListener('mouseleave', scheduleClose);
      }

      menu.addEventListener('focusin', openMenu);
      menu.addEventListener('focusout', (event) => {
        if (!menu.contains(event.relatedTarget)) scheduleClose();
      });
    });
  };

  document.addEventListener('DOMContentLoaded', () => initLuxuryHoverMenus());
  document.addEventListener('shopify:section:load', (event) => initLuxuryHoverMenus(event.target));
})();
</script>


