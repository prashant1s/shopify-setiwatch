                                <a href="{{ block.settings.link | default: childlink.url }}" class="lux-mobile-brand-card" {{ block.shopify_attributes }}>
                                  <span class="lux-mobile-brand-card__logo">
                                    {%- if block.settings.logo != blank -%}
                                      {{
                                        block.settings.logo
                                        | image_url: width: 180
                                        | image_tag:
                                          loading: 'lazy',
                                          widths: '80,120,180',
                                          sizes: '50px',
                                          class: 'lux-mobile-brand-card__logo-image',
                                          alt: block.settings.title
                                      }}
                                    {%- else -%}
                                      <span class="lux-mobile-brand-card__initial">
                                        {{ block.settings.title | slice: 0, 1 | upcase }}
                                      </span>
                                    {%- endif -%}
                                  </span>

                                  <span class="lux-mobile-brand-card__copy">
                                    <strong>{{ block.settings.title | escape }}</strong>
                                    {%- if block.settings.subtitle != blank -%}
                                      <small>{{ block.settings.subtitle | escape }}</small>
                                    {%- endif -%}
                                  </span>

                                  <span class="lux-mobile-brand-card__arrow">→</span>
                                </a>
                              {%- endif -%}
                            {%- endfor -%}

                            {%- if custom_brand_count == 0 and childlink.links != blank -%}
                              {%- for grandchildlink in childlink.links -%}
                                <a href="{{ grandchildlink.url }}" class="lux-mobile-brand-card">
                                  <span class="lux-mobile-brand-card__logo">
                                    <span class="lux-mobile-brand-card__initial">
                                      {{ grandchildlink.title | slice: 0, 1 | upcase }}
                                    </span>
                                  </span>
                                  <span class="lux-mobile-brand-card__copy">
                                    <strong>{{ grandchildlink.title | escape }}</strong>
                                  </span>
                                  <span class="lux-mobile-brand-card__arrow">→</span>
                                </a>
                              {%- endfor -%}
                            {%- endif -%}
                          </div>
                        </section>
                      {%- endfor -%}
                    </div>

                    <h3 class="lux-mobile-kicker">Discover by category</h3>
                    <div class="lux-mobile-card-track">
                      {%- for block in section.blocks -%}
                        {%- assign block_trigger = block.settings.menu_trigger | handle -%}
                        {%- if block.type == 'category_card' and block_trigger == trigger -%}
                          <a href="{{ block.settings.link | default: link.url }}" class="lux-mobile-card" {{ block.shopify_attributes }}>
                            <div class="lux-mobile-card__media">
                              {%- if block.settings.image != blank -%}
                                {{
                                  block.settings.image
                                  | image_url: width: 900
                                  | image_tag:
                                    loading: 'lazy',
                                    widths: '360,540,720,900',
                                    sizes: '78vw',
                                    class: 'lux-mobile-card__image',
                                    alt: block.settings.title
                                }}
                              {%- endif -%}
                            </div>
                            <span class="lux-mobile-card__title">{{ block.settings.title | escape }}</span>
                          </a>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                {%- endcase -%}
              </div>
            </details>
          {%- else -%}
            <a href="{{ link.url }}" class="lux-mobile-menu__direct">
              {{ link.title | escape }}
            </a>
          {%- endif -%}
        {%- endfor -%}

        <div class="lux-mobile-drawer__footer">

  <a href="/pages/track-your-order" class="lux-mobile-track-order">
    <span class="lux-mobile-track-order__left">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M3 7h11v10H3z"/>
