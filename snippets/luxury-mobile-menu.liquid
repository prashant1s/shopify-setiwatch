{%- comment -%}
  Luxury Mobile Menu
  Uses the same Header blocks as the desktop Luxury Menu.
  One uploaded image is rendered responsively through Shopify image_tag/srcset.
{%- endcomment -%}

<style>
  @media screen and (min-width: 990px) {
    .lux-mobile-drawer { display: none !important; }
  }

  @media screen and (max-width: 989px) {
    .lux-mobile-drawer {
      display: block;
      justify-self: start;
    }

    .lux-mobile-drawer .lux-mobile-details {
      display: block;
    }

    .lux-mobile-drawer__toggle {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 4.4rem;
      height: 4.4rem;
      padding: 0;
      border: 0;
      border-radius: 0;
      background: transparent !important;
      box-shadow: none !important;
      color: rgb(var(--color-foreground));
      cursor: pointer;
    }

    /* Remove Dawn's native menu overlay/pseudo layer from this custom toggle. */
    .lux-mobile-drawer__toggle::before,
    .lux-mobile-drawer__toggle::after,
    .lux-mobile-drawer__toggle > span::before,
    .lux-mobile-drawer__toggle > span::after {
      content: none !important;
      display: none !important;
    }

    .lux-mobile-drawer__toggle > span {
      position: relative;
      display: grid;
      place-items: center;
      width: 100%;
      height: 100%;
      background: transparent !important;
      box-shadow: none !important;
    }

    .lux-mobile-drawer__toggle .icon {
      width: 2rem;
      height: 2rem;
    }

    .lux-mobile-drawer__toggle .icon-close {
      display: none;
    }

    .lux-mobile-drawer details[open] > summary .icon-hamburger {
      display: none;
    }

    .lux-mobile-drawer details[open] > summary .icon-close {
      display: block;
    }

    .lux-mobile-drawer__panel {
      position: fixed;
      z-index: 2147483639;
      top: var(--lux-mobile-drawer-top, 0px);
      left: 0;
      width: min(94vw, 44rem);
      height: calc(100dvh - var(--lux-mobile-drawer-top, 0px));
      overflow: hidden;
      background: rgb(var(--color-background));
      color: rgb(var(--color-foreground));
      box-shadow: 2rem 0 5rem rgba(0,0,0,.15);
      transform: translateX(-105%);
      visibility: hidden;
      transition: transform .35s cubic-bezier(.22,.61,.36,1), visibility .35s;
    }

    .lux-mobile-drawer__backdrop {
      position: fixed;
      z-index: 2147483638;
      top: var(--lux-mobile-drawer-top, 0px);
      right: 0;
      bottom: 0;
      left: 0;
      display: block;
      width: 100%;
      height: auto;
      margin: 0;
      padding: 0;
      border: 0;
      border-radius: 0;
      background: rgba(0, 0, 0, .34);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      cursor: default;
      transition: opacity .25s ease, visibility .25s ease;
    }

    .lux-mobile-drawer details[open] > .lux-mobile-drawer__backdrop {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    .lux-mobile-drawer details[open] > .lux-mobile-drawer__panel {
      transform: translateX(0);
      visibility: visible;
    }

    .lux-mobile-drawer__scroll {
      height: 100%;
      overflow-y: auto;
      overscroll-behavior: contain;
      padding: 1.4rem 1.6rem 4rem;
    }

    .lux-mobile-drawer__brand {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: .8rem .2rem 1.5rem;
      border-bottom: 1px solid rgba(var(--color-foreground),.09);
      margin-bottom: 1rem;
    }

    .lux-mobile-drawer__brand strong {
      font-size: 1.3rem;
      letter-spacing: .12em;
      text-transform: uppercase;
    }

    .lux-mobile-menu__group {
      border-bottom: 1px solid rgba(var(--color-foreground),.09);
    }

    .lux-mobile-menu__summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 1.8rem .2rem;
      cursor: pointer;
      font-size: 1.65rem;
      font-weight: 600;
      list-style: none;
    }

    .lux-mobile-menu__direct {
      display: flex;
      align-items: center;
      width: 100%;
      padding: 1.8rem .2rem;
      border-bottom: 1px solid rgba(var(--color-foreground),.09);
      color: rgb(var(--color-foreground));
      font-size: 1.65rem;
      font-weight: 600;
      line-height: 1.25;
      text-decoration: none;
    }

    .lux-mobile-menu__direct:visited,
    .lux-mobile-menu__direct:hover,
    .lux-mobile-menu__direct:focus {
      color: rgb(var(--color-foreground));
      text-decoration: none;
    }

    .lux-mobile-menu__summary::-webkit-details-marker {
      display: none;
    }

    .lux-mobile-menu__summary::after {
      content: "→";
      font-size: 1.8rem;
      font-weight: 400;
      transition: transform .25s ease;
    }

    .lux-mobile-menu__group[open] > .lux-mobile-menu__summary::after {
      transform: rotate(90deg);
    }

    .lux-mobile-menu__content {
      padding: 0 0 2rem;
      animation: luxMobileFade .3s ease;
    }

    @keyframes luxMobileFade {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: none; }
    }

    .lux-mobile-kicker {
      margin: 1.35rem 0 .9rem;
      font-size: .96rem;
      letter-spacing: .16em;
      text-transform: uppercase;
      font-weight: 700;
      opacity: .68;
    }

    .lux-mobile-link-groups {
      display: grid;
      gap: 1.35rem;
    }

    .lux-mobile-link-group__title {
      display: block;
      margin-bottom: .9rem;
      color: rgb(var(--color-foreground));
      font-size: 1.45rem;
      font-weight: 600;
      text-decoration: none;
    }

    .lux-mobile-pills {
      display: flex;
      flex-wrap: wrap;
      gap: .65rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .lux-mobile-pill {
      display: inline-flex;
      align-items: center;
      min-height: 3.5rem;
      padding: .75rem 1rem;
      border: 1px solid rgba(var(--color-foreground),.12);
      border-radius: 999px;
      background: rgba(var(--color-background),.98);
      color: rgb(var(--color-foreground));
      box-shadow: 0 .45rem 1.25rem rgba(0,0,0,.04);
      font-size: 1.18rem;
      line-height: 1;
      text-decoration: none;
      transition: transform .18s ease, box-shadow .18s ease;
    }

    .lux-mobile-pill:active {
      transform: scale(.97);
      box-shadow: 0 .25rem .8rem rgba(0,0,0,.035);
    }

    .lux-mobile-card-track {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: 76%;
      gap: 1.2rem;
      overflow-x: auto;
      padding: .2rem .2rem 1.2rem;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: .2rem;
      scrollbar-width: none;
    }

    .lux-mobile-card-track::-webkit-scrollbar {
      display: none;
    }

    .lux-mobile-card {
      min-width: 0;
      overflow: hidden;
      padding: .9rem;
      border: 1px solid rgba(var(--color-foreground),.10);
      border-radius: 1.7rem;
      background: rgba(var(--color-background),.98);
      color: rgb(var(--color-foreground));
      box-shadow: 0 .9rem 2.4rem rgba(0,0,0,.055);
      text-decoration: none;
      scroll-snap-align: start;
      transition: transform .18s ease, box-shadow .18s ease;
    }

    .lux-mobile-card:active {
      transform: scale(.985);
      box-shadow: 0 .5rem 1.5rem rgba(0,0,0,.045);
    }

    .lux-mobile-card__media {
      position: relative;
      display: grid;
      place-items: center;
      overflow: hidden;
      width: 100%;
      aspect-ratio: 1 / 1;
      border-radius: 1.25rem;
      background:
        radial-gradient(circle at 50% 38%, rgba(var(--color-foreground),.025), transparent 58%),
        rgba(var(--color-foreground),.035);
    }

    .lux-mobile-card__image {
      display: block;
      width: 100%;
      height: 100%;
      padding: 1.4rem;
      object-fit: contain;
      object-position: center;
    }

    .lux-mobile-card__title {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 1rem .2rem .2rem;
      font-size: 1.36rem;
      font-weight: 600;
      line-height: 1.25;
    }

    .lux-mobile-card__title::after {
      content: "→";
      flex: 0 0 auto;
      font-size: 1.5rem;
      font-weight: 400;
      opacity: .72;
    }

    .lux-mobile-editorial-list {
      display: grid;
      gap: .8rem;
    }

    .lux-mobile-editorial-row {
      display: grid;
      grid-template-columns: 5rem 1fr auto;
      align-items: center;
      gap: 1rem;
      padding: .7rem;
      border: 1px solid rgba(var(--color-foreground),.1);
      border-radius: 1.2rem;
      color: rgb(var(--color-foreground));
      text-decoration: none;
    }

    .lux-mobile-editorial-row__media {
      width: 5rem;
      height: 5rem;
      overflow: hidden;
      border-radius: 50%;
      background: rgba(var(--color-foreground),.04);
    }

    .lux-mobile-editorial-row__image {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .lux-mobile-editorial-row__copy {
      display: grid;
      gap: .15rem;
    }

    .lux-mobile-editorial-row__copy strong {
      font-size: 1.3rem;
    }

    .lux-mobile-editorial-row__copy small {
      font-size: 1.05rem;
      opacity: .62;
    }

    .lux-mobile-price-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0,1fr));
      gap: .9rem;
    }

    .lux-mobile-price-card {
      color: rgb(var(--color-foreground));
      text-decoration: none;
    }

    .lux-mobile-price-card__media {
      overflow: hidden;
      aspect-ratio: 1.2 / 1;
      border-radius: 1.3rem;
      background: rgba(var(--color-foreground),.04);
    }

    .lux-mobile-price-card__image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
    }

    .lux-mobile-price-card span {
      display: block;
      padding-top: .6rem;
      text-align: center;
      font-size: 1.18rem;
      font-weight: 500;
    }

    .lux-mobile-feature-track,
    .lux-mobile-product-track,
    .lux-mobile-blog-track,
    .lux-mobile-visual-track {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: 84%;
      gap: 1rem;
      overflow-x: auto;
      padding-bottom: .8rem;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .lux-mobile-feature-track::-webkit-scrollbar,
    .lux-mobile-product-track::-webkit-scrollbar,
    .lux-mobile-blog-track::-webkit-scrollbar,
    .lux-mobile-visual-track::-webkit-scrollbar {
      display: none;
    }

    .lux-mobile-feature,
    .lux-mobile-visual {
      position: relative;
      min-height: 25rem;
      overflow: hidden;
      border-radius: 1.6rem;
      color: #fff;
      text-decoration: none;
      scroll-snap-align: start;
      background: #111;
    }

    .lux-mobile-feature__media,
    .lux-mobile-feature__image,
    .lux-mobile-visual__media,
    .lux-mobile-visual__image {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }

    .lux-mobile-feature__image,
    .lux-mobile-visual__image {
      object-fit: cover;
      object-position: center;
    }

    .lux-mobile-feature::after,
    .lux-mobile-visual::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg,transparent 35%,rgba(0,0,0,.74));
    }

    .lux-mobile-feature__copy,
    .lux-mobile-visual__copy {
      position: absolute;
      z-index: 2;
      left: 1.6rem;
      right: 1.6rem;
      bottom: 1.5rem;
      display: grid;
      gap: .35rem;
    }

    .lux-mobile-feature__copy span,
    .lux-mobile-visual__copy span {
      font-size: .92rem;
      letter-spacing: .15em;
      text-transform: uppercase;
      opacity: .82;
    }

    .lux-mobile-feature__copy strong,
    .lux-mobile-visual__copy strong {
      font-size: 1.9rem;
      line-height: 1.1;
    }

    .lux-mobile-product,
    .lux-mobile-blog {
      color: rgb(var(--color-foreground));
      text-decoration: none;
      scroll-snap-align: start;
    }

    .lux-mobile-product__media {
      overflow: hidden;
      aspect-ratio: 1 / 1;
      border-radius: 1.4rem;
      background: rgba(var(--color-foreground),.04);
    }

    .lux-mobile-product__image {
      width: 100%;
      height: 100%;
      object-fit: contain;
      padding: 1rem;
    }

    .lux-mobile-product strong,
    .lux-mobile-product span,
    .lux-mobile-blog span {
      display: block;
      margin-top: .6rem;
    }

    .lux-mobile-blog__media {
      overflow: hidden;
      aspect-ratio: 1.55 / 1;
      border-radius: 1.4rem;
      background: rgba(var(--color-foreground),.04);
    }

    .lux-mobile-blog__image {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .lux-mobile-drawer__footer {
      display: grid;
      gap: .9rem;
      margin-top: 2rem;
      padding-top: 1.5rem;
      border-top: 1px solid rgba(var(--color-foreground),.09);
    }

    .lux-mobile-drawer__footer a {
      color: rgb(var(--color-foreground));
      font-size: 1.3rem;
      text-decoration: none;
    }
    .lux-mobile-menu__content {
      padding-bottom: 1.5rem;
    }

    .lux-mobile-link-group__title {
      margin-bottom: .8rem;
      font-size: 1.42rem;
    }

    .lux-mobile-drawer__scroll {
      padding-inline: 1.4rem;
    }

    @media screen and (max-width: 420px) {
      .lux-mobile-card-track {
        grid-auto-columns: 78%;
      }

      .lux-mobile-card {
        padding: .8rem;
        border-radius: 1.55rem;
      }

      .lux-mobile-card__image {
        padding: 1.15rem;
      }

      .lux-mobile-card__title {
        font-size: 1.28rem;
      }

      .lux-mobile-price-grid {
        gap: .75rem;
      }

      .lux-mobile-feature-track,
      .lux-mobile-product-track,
      .lux-mobile-blog-track,
      .lux-mobile-visual-track {
        grid-auto-columns: 86%;
      }
    }

  }
</style>

<header-drawer data-breakpoint="tablet" class="lux-mobile-drawer">
  <details class="lux-mobile-details">
    <summary
      class="header__icon header__icon--menu header__icon--summary link focus-inset lux-mobile-drawer__toggle"
      aria-label="{{ 'sections.header.menu' | t }}"
    >
      <span>
        {{- 'icon-hamburger.svg' | inline_asset_content -}}
        {{- 'icon-close.svg' | inline_asset_content -}}
      </span>
    </summary>

    <div
      class="lux-mobile-drawer__backdrop"
      aria-hidden="true"
    ></div>

    <div class="lux-mobile-drawer__panel color-{{ section.settings.menu_color_scheme }} gradient">
      <div class="lux-mobile-drawer__scroll">
        <div class="lux-mobile-drawer__brand">
          <strong>{{ shop.name }}</strong>
        </div>

        {%- for link in section.settings.menu.links -%}
          {%- assign trigger = link.title | handle -%}
          {%- assign layout = 'columns_slider' -%}

          {%- for block in section.blocks -%}
            {%- if block.type == 'menu_design' -%}
              {%- assign design_trigger = block.settings.menu_trigger | handle -%}
              {%- if design_trigger == trigger -%}
                {%- assign layout = block.settings.layout -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}

          {%- if link.links != blank -%}
            <details class="lux-mobile-menu__group">
              <summary class="lux-mobile-menu__summary">
                <span>{{ link.title | escape }}</span>
              </summary>

              <div class="lux-mobile-menu__content">
                {%- case layout -%}

                  {%- when 'editorial_commerce' -%}
                    <h3 class="lux-mobile-kicker">Collection</h3>
                    <div class="lux-mobile-editorial-list">
                      {%- for block in section.blocks -%}
                        {%- assign block_trigger = block.settings.menu_trigger | handle -%}
                        {%- if block.type == 'editorial_item' and block_trigger == trigger -%}
                          <a href="{{ block.settings.link | default: link.url }}" class="lux-mobile-editorial-row" {{ block.shopify_attributes }}>
                            <span class="lux-mobile-editorial-row__media">
                              {%- if block.settings.image != blank -%}
                                {{
                                  block.settings.image
                                  | image_url: width: 320
                                  | image_tag:
                                    loading: 'lazy',
                                    widths: '100,160,240,320',
                                    sizes: '50px',
                                    class: 'lux-mobile-editorial-row__image',
                                    alt: block.settings.title
                                }}
                              {%- endif -%}
                            </span>
                            <span class="lux-mobile-editorial-row__copy">
                              <strong>{{ block.settings.title | escape }}</strong>
                              <small>{{ block.settings.subtitle | escape }}</small>
                            </span>
                            <span>→</span>
                          </a>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>

                    <h3 class="lux-mobile-kicker">By price</h3>
                    <div class="lux-mobile-price-grid">
                      {%- for block in section.blocks -%}
                        {%- assign block_trigger = block.settings.menu_trigger | handle -%}
                        {%- if block.type == 'price_card' and block_trigger == trigger -%}
                          {%- assign price_url = block.settings.link -%}
                          {%- if price_url == blank -%}
                            {%- assign price_url = routes.all_products_collection_url -%}
                          {%- endif -%}
                          {%- assign price_url = price_url | append: '?filter.v.price.gte=' | append: block.settings.min_price -%}
                          {%- if block.settings.max_price > 0 -%}
                            {%- assign price_url = price_url | append: '&filter.v.price.lte=' | append: block.settings.max_price -%}
                          {%- endif -%}

                          <a href="{{ price_url }}" class="lux-mobile-price-card" {{ block.shopify_attributes }}>
                            <div class="lux-mobile-price-card__media">
                              {%- if block.settings.image != blank -%}
                                {{
                                  block.settings.image
                                  | image_url: width: 700
                                  | image_tag:
                                    loading: 'lazy',
                                    widths: '240,360,480,700',
                                    sizes: '45vw',
                                    class: 'lux-mobile-price-card__image',
                                    alt: block.settings.title
                                }}
                              {%- endif -%}
                            </div>
                            <span>{{ block.settings.title | escape }}</span>
                          </a>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>

                    <h3 class="lux-mobile-kicker">Trending</h3>
                    <div class="lux-mobile-feature-track">
                      {%- for block in section.blocks -%}
                        {%- assign block_trigger = block.settings.menu_trigger | handle -%}
                        {%- if block.type == 'feature_tile' and block_trigger == trigger -%}
                          <a href="{{ block.settings.link | default: link.url }}" class="lux-mobile-feature" {{ block.shopify_attributes }}>
                            <div class="lux-mobile-feature__media">
                              {%- if block.settings.image != blank -%}
                                {{
                                  block.settings.image
                                  | image_url: width: 1000
                                  | image_tag:
                                    loading: 'lazy',
                                    widths: '360,540,720,1000',
                                    sizes: '84vw',
                                    class: 'lux-mobile-feature__image',
                                    alt: block.settings.title
                                }}
                              {%- endif -%}
                            </div>
                            <div class="lux-mobile-feature__copy">
                              <span>{{ block.settings.eyebrow | escape }}</span>
                              <strong>{{ block.settings.title | escape }}</strong>
                            </div>
                          </a>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>

                  {%- when 'product_blog' -%}
                    <h3 class="lux-mobile-kicker">Featured products</h3>
                    <div class="lux-mobile-product-track">
                      {%- for block in section.blocks -%}
                        {%- assign block_trigger = block.settings.menu_trigger | handle -%}
                        {%- if block.type == 'featured_product' and block_trigger == trigger and block.settings.product != blank -%}
                          {%- assign product = block.settings.product -%}
                          <a href="{{ product.url }}" class="lux-mobile-product" {{ block.shopify_attributes }}>
                            <div class="lux-mobile-product__media">
                              {{
                                product.featured_image
                                | image_url: width: 800
                                | image_tag:
                                  loading: 'lazy',
                                  widths: '300,450,600,800',
                                  sizes: '84vw',
                                  class: 'lux-mobile-product__image',
                                  alt: product.title
                              }}
                            </div>
                            <strong>{{ product.title }}</strong>
                            <span>{{ product.price | money }}</span>
                          </a>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>

                    <h3 class="lux-mobile-kicker">Journal</h3>
                    <div class="lux-mobile-blog-track">
                      {%- for block in section.blocks -%}
                        {%- assign block_trigger = block.settings.menu_trigger | handle -%}
                        {%- if block.type == 'blog_card' and block_trigger == trigger and block.settings.article != blank -%}
                          {%- assign article = block.settings.article -%}
                          {%- assign article_image = block.settings.custom_image | default: article.image -%}
                          <a href="{{ article.url }}" class="lux-mobile-blog" {{ block.shopify_attributes }}>
                            <div class="lux-mobile-blog__media">
                              {%- if article_image != blank -%}
                                {{
                                  article_image
                                  | image_url: width: 900
                                  | image_tag:
                                    loading: 'lazy',
                                    widths: '360,540,720,900',
                                    sizes: '84vw',
                                    class: 'lux-mobile-blog__image',
                                    alt: article.title
                                }}
                              {%- endif -%}
                            </div>
                            <span>{{ article.title }}</span>
                          </a>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>

                  {%- when 'visual_tiles' -%}
                    <div class="lux-mobile-visual-track">
                      {%- for block in section.blocks -%}
                        {%- assign block_trigger = block.settings.menu_trigger | handle -%}
                        {%- if block.type == 'visual_tile' and block_trigger == trigger -%}
                          <a href="{{ block.settings.link | default: link.url }}" class="lux-mobile-visual" {{ block.shopify_attributes }}>
                            <div class="lux-mobile-visual__media">
                              {%- if block.settings.image != blank -%}
                                {{
                                  block.settings.image
                                  | image_url: width: 1000
                                  | image_tag:
                                    loading: 'lazy',
                                    widths: '360,540,720,1000',
                                    sizes: '84vw',
                                    class: 'lux-mobile-visual__image',
                                    alt: block.settings.title
                                }}
                              {%- endif -%}
                            </div>
                            <div class="lux-mobile-visual__copy">
                              <span>{{ block.settings.eyebrow | escape }}</span>
                              <strong>{{ block.settings.title | escape }}</strong>
                            </div>
                          </a>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>

                  {%- else -%}
