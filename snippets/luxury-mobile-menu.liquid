  {%- endif -%}

  <a href="{{ routes.search_url }}">Search</a>

  <a href="{{ routes.cart_url }}">
    Cart ({{ cart.item_count }})
  </a>

</div>
      </div>
    </div>
  </details>
</header-drawer>


<script>
  (() => {
    const initLuxuryMobileMenu = (scope = document) => {
      scope.querySelectorAll('.lux-mobile-drawer').forEach((drawer) => {
        if (drawer.dataset.luxMobileReady === 'true') return;
        drawer.dataset.luxMobileReady = 'true';

        const rootDetails = drawer.querySelector(':scope > details');
        if (!rootDetails) return;

        const toggle = rootDetails.querySelector(':scope > summary');
        const backdrop = rootDetails.querySelector(':scope > .lux-mobile-drawer__backdrop');
        const panel = rootDetails.querySelector(':scope > .lux-mobile-drawer__panel');
        const header = drawer.closest('header');
        const hostSection = drawer.closest('.shopify-section');

        const updateDrawerPosition = () => {
          const reference = header || drawer;
          const rect = reference.getBoundingClientRect();
          const toggleRect = toggle?.getBoundingClientRect();
          const viewportHeight = window.visualViewport?.height || window.innerHeight;
          let visibleHeaderBottom = rect.bottom;

          /*
           * Some sticky Shopify headers keep the announcement-bar offset inside
           * the header box after the announcement has scrolled away. Derive the
           * visible card bottom from the menu button's balanced top/bottom inset
           * whenever that hidden offset makes the box suspiciously tall.
           */
          if (toggleRect) {
            const visibleHeaderTop = Math.max(0, rect.top);
            const topInset = Math.max(0, toggleRect.top - visibleHeaderTop);
            const balancedBottom = toggleRect.bottom + topInset;

            if (visibleHeaderBottom - balancedBottom > 24) {
              visibleHeaderBottom = balancedBottom;
            }
          }

          const headerBottom = Math.max(
            0,
            Math.min(viewportHeight, Math.round(visibleHeaderBottom))
          );

          drawer.style.setProperty('--lux-mobile-drawer-top', `${headerBottom}px`);

          /*
           * A transformed/sticky ancestor can become the containing block for a
           * fixed child and silently add its own Y offset. Measure the real panel
           * position and cancel that offset so the drawer always touches the
           * visible header, regardless of the theme's sticky-header internals.
           */
          requestAnimationFrame(() => {
            if (!panel) return;

            const renderedTop = panel.getBoundingClientRect().top;
            const hiddenContainingBlockOffset = renderedTop - headerBottom;

            if (Math.abs(hiddenContainingBlockOffset) > 1) {
              const correctedTop = Math.max(
                0,
                Math.round(headerBottom - hiddenContainingBlockOffset)
              );

              drawer.style.setProperty('--lux-mobile-drawer-top', `${correctedTop}px`);
            }
          });
        };

        const closeDrawer = () => {
          rootDetails.removeAttribute('open');
        };

        const syncDrawerState = () => {
          const isOpen = rootDetails.open;

          if (isOpen) {
            updateDrawerPosition();
          }

          toggle?.setAttribute('aria-expanded', String(isOpen));
          document.documentElement.classList.toggle('lux-mobile-menu-open', isOpen);
          document.body.classList.toggle('lux-mobile-menu-open', isOpen);
          hostSection?.classList.toggle('lux-mobile-menu-host', isOpen);
          document.documentElement.style.overflow = isOpen ? 'hidden' : '';
          document.body.style.overflow = isOpen ? 'hidden' : '';
        };

        updateDrawerPosition();
        toggle?.addEventListener('click', updateDrawerPosition);
        rootDetails.addEventListener('toggle', syncDrawerState);
        backdrop?.addEventListener('click', closeDrawer);

        window.addEventListener('resize', () => {
          if (rootDetails.open) updateDrawerPosition();
        }, { passive: true });

        window.addEventListener('orientationchange', () => {
          if (rootDetails.open) requestAnimationFrame(updateDrawerPosition);
        });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && rootDetails.open) closeDrawer();
        });

        drawer.querySelectorAll('.lux-mobile-menu__group').forEach((group) => {
          group.addEventListener('toggle', () => {
            if (!group.open) return;

            drawer.querySelectorAll('.lux-mobile-menu__group[open]').forEach((other) => {
              if (other !== group) other.removeAttribute('open');
            });
          });
        });

        drawer.querySelectorAll('a[href]').forEach((link) => {
          link.addEventListener('click', () => {
            closeDrawer();
          });
        });
      });
    };

    document.addEventListener('DOMContentLoaded', () => initLuxuryMobileMenu());
    document.addEventListener('shopify:section:load', (event) => initLuxuryMobileMenu(event.target));
  })();
</script>


