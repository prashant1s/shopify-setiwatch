<section
  id="SethiLuxuryFooter-{{ section.id }}"
  class="sethi-luxury-footer sethi-luxury-footer--{{ section.id }}"
>
  <div class="sethi-luxury-footer__background">
    {% if section.settings.background_image != blank %}
      {{ section.settings.background_image | image_url: width: 2400 | image_tag: loading: 'lazy', class: 'sethi-luxury-footer__background-image', alt: '' }}
    {% endif %}
  </div>
  <div class="sethi-luxury-footer__overlay"></div>

  <div class="sethi-luxury-footer__inner">

    <!-- LOGO -->
    <div class="sethi-luxury-footer__logo-wrap">
      {% if section.settings.logo != blank %}
        {{
          section.settings.logo
          | image_url: width: 500
          | image_tag:
            loading: 'lazy',
            class: 'sethi-luxury-footer__logo',
            alt: shop.name
        }}
      {% else %}
        <h2 class="sethi-luxury-footer__wordmark">{{ shop.name }}</h2>
      {% endif %}
    </div>

    <!-- TOP NAVIGATION -->
    {% if section.settings.top_menu != blank %}
      <nav class="sethi-luxury-footer__top-nav" aria-label="Footer navigation">
        {% for link in section.settings.top_menu.links %}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {% endfor %}
      </nav>
    {% endif %}

    <!-- BRAND / MENU COLUMNS -->
    <div class="sethi-luxury-footer__columns">
      {% for block in section.blocks %}
        <div class="sethi-luxury-footer__column" {{ block.shopify_attributes }}>
          <button
            class="sethi-luxury-footer__column-toggle"
            type="button"
            aria-expanded="false"
          >
            <span>{{ block.settings.heading }}</span>
            <span class="sethi-luxury-footer__plus">+</span>
          </button>

          <div class="sethi-luxury-footer__column-content">
            {% if block.settings.menu != blank %}
              <ul>
                {% for link in block.settings.menu.links %}
                  <li>
                    <a href="{{ link.url }}">{{ link.title }}</a>
                  </li>
                {% endfor %}
              </ul>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>

    <!-- DIVIDER -->
    <div class="sethi-luxury-footer__divider"></div>

    <!-- BOTTOM -->
    <div class="sethi-luxury-footer__bottom">

      <div class="sethi-luxury-footer__copyright">
        © {{ 'now' | date: '%Y' }} {{ shop.name }}
      </div>

      <div class="sethi-luxury-footer__social">
        {% if settings.social_twitter_link != blank %}
          <a href="{{ settings.social_twitter_link }}" aria-label="Twitter" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M18.9 2H22l-6.77 7.74L23.2 22h-6.24l-4.89-6.39L6.48 22H3.37l7.24-8.28L2.8 2h6.4l4.42 5.84L18.9 2Zm-1.09 17.82h1.73L8.28 4.07H6.42l11.39 15.75Z"/>
            </svg>
          </a>
        {% endif %}

        {% if settings.social_facebook_link != blank %}
          <a href="{{ settings.social_facebook_link }}" aria-label="Facebook" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M14 8h3V4h-3c-3.31 0-5 1.69-5 5v3H6v4h3v8h4v-8h3.2l.8-4H13V9c0-.66.34-1 1-1Z"/>
            </svg>
          </a>
        {% endif %}

        {% if settings.social_pinterest_link != blank %}
          <a href="{{ settings.social_pinterest_link }}" aria-label="Pinterest" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2a10 10 0 0 0-3.65 19.31c-.09-1.64-.02-3.61.41-5.18l1.1-4.67s-.28-.56-.28-1.38c0-1.29.75-2.26 1.68-2.26.79 0 1.17.59 1.17 1.29 0 .79-.5 1.97-.76 3.07-.22.92.46 1.67 1.37 1.67 1.65 0 2.76-1.74 2.76-4.26 0-2.23-1.6-3.79-3.88-3.79-2.64 0-4.19 1.98-4.19 4.02 0 .8.31 1.66.69 2.13.08.1.09.19.07.29l-.26 1.05c-.04.17-.14.2-.32.12-1.2-.56-1.95-2.31-1.95-3.72 0-3.03 2.2-5.82 6.34-5.82 3.33 0 5.92 2.37 5.92 5.54 0 3.3-2.08 5.95-4.97 5.95-.97 0-1.88-.5-2.19-1.1l-.6 2.28c-.22.83-.81 1.87-1.21 2.5A10 10 0 1 0 12 2Z"/>
            </svg>
          </a>
        {% endif %}

        {% if settings.social_instagram_link != blank %}
          <a href="{{ settings.social_instagram_link }}" aria-label="Instagram" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"/>
              <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/>
              <circle cx="17.5" cy="6.5" r="1.2"/>
            </svg>
          </a>
        {% endif %}

        {% if settings.social_youtube_link != blank %}
          <a href="{{ settings.social_youtube_link }}" aria-label="YouTube" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M23.5 6.2a3 3 0 0 0-2.1-2.12C19.55 3.5 12 3.5 12 3.5s-7.55 0-9.4.58A3 3 0 0 0 .5 6.2 31.3 31.3 0 0 0 0 12a31.3 31.3 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.12c1.85.58 9.4.58 9.4.58s7.55 0 9.4-.58a3 3 0 0 0 2.1-2.12A31.3 31.3 0 0 0 24 12a31.3 31.3 0 0 0-.5-5.8ZM9.6 15.9V8.1l6.5 3.9-6.5 3.9Z"/>
            </svg>
          </a>
        {% endif %}

        {% if section.settings.whatsapp_link != blank %}
          <a href="{{ section.settings.whatsapp_link }}" aria-label="WhatsApp" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20.5 3.5A11.9 11.9 0 0 0 12.03 0C5.45 0 .1 5.35.1 11.93c0 2.1.55 4.15 1.6 5.96L0 24l6.26-1.64a11.9 11.9 0 0 0 5.77 1.47h.01c6.58 0 11.93-5.35 11.93-11.93 0-3.18-1.24-6.17-3.47-8.4ZM12.04 21.8h-.01a9.85 9.85 0 0 1-5.02-1.37l-.36-.21-3.71.97.99-3.62-.23-.37a9.88 9.88 0 1 1 8.34 4.6Zm5.42-7.39c-.3-.15-1.77-.87-2.05-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.38-1.46-.88-.78-1.47-1.75-1.64-2.05-.17-.3-.02-.46.13-.61.14-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.5s1.07 2.9 1.22 3.1c.15.2 2.1 3.2 5.08 4.49.71.31 1.27.49 1.7.63.72.23 1.38.2 1.9.12.58-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.12-.27-.2-.57-.35Z"/>
            </svg>
          </a>
        {% endif %}
      </div>

      {% if section.settings.bottom_logo != blank %}
        <div class="sethi-luxury-footer__bottom-logo">
          {{
            section.settings.bottom_logo
            | image_url: width: 180
            | image_tag:
              loading: 'lazy',
              alt: shop.name
          }}
        </div>
      {% else %}
        <div class="sethi-luxury-footer__bottom-mark" aria-hidden="true">CS</div>
      {% endif %}

    </div>
  </div>
</section>

<style>
  .sethi-luxury-footer--{{ section.id }} {
    --footer-text: {{ section.settings.text_color }};
    --footer-muted: {{ section.settings.muted_color }};
    --footer-accent: {{ section.settings.accent_color }};
    --footer-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    position: relative;
    width: 100%;
    overflow: hidden;
    background: #111;
    color: var(--footer-text);
  }

  .sethi-luxury-footer--{{ section.id }} .sethi-luxury-footer__background {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    background: #111;
  }

  .sethi-luxury-footer--{{ section.id }} .sethi-luxury-footer__background-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.background_size }};
    object-position: {{ section.settings.background_position }};
  }

  .sethi-luxury-footer--{{ section.id }} .sethi-luxury-footer__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgba(10, 10, 10, 0.42);
    pointer-events: none;
  }

  .sethi-luxury-footer--{{ section.id }} .sethi-luxury-footer__inner {
    position: relative;
    z-index: 2;
    width: min(100% - 64px, 1400px);
    margin: 0 auto;
    padding: 40px 0 20px;
  }

  /* LOGO */
  .sethi-luxury-footer--{{ section.id }} .sethi-luxury-footer__logo-wrap {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 90px;
  }

  .sethi-luxury-footer--{{ section.id }} .sethi-luxury-footer__logo {
    display: block;
    width: auto;
    max-width: 150px;
    max-height: 100px;
    object-fit: contain;
  }

  .sethi-luxury-footer--{{ section.id }} .sethi-luxury-footer__wordmark {
    margin: 0;
    color: var(--footer-text);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 34px;
    font-weight: 400;
    letter-spacing: 1px;
  }

  /* TOP NAV */
  .sethi-luxury-footer--{{ section.id }} .sethi-luxury-footer__top-nav {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px 26px;
    margin: 28px auto 0;
    text-align: center;
  }

  .sethi-luxury-footer--{{ section.id }} .sethi-luxury-footer__top-nav a {
    color: var(--footer-text);
    font-size: 13px;
    line-height: 1.5;
    text-decoration: none;
    transition: opacity .25s ease;
  }

  .sethi-luxury-footer--{{ section.id }} .sethi-luxury-footer__top-nav a:hover {
    opacity: .65;
  }

  /* BRAND COLUMNS */
  .sethi-luxury-footer--{{ section.id }} .sethi-luxury-footer__columns {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 48px;
    margin-top: 76px;
  }

  .sethi-luxury-footer--{{ section.id }} .sethi-luxury-footer__column-toggle {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    padding: 0;
    color: var(--footer-text);
    background: transparent;
    border: 0;
    font: inherit;
    font-size: 14px;
    font-weight: 500;
    text-align: left;
    cursor: default;
  }

  .sethi-luxury-footer--{{ section.id }} .sethi-luxury-footer__plus {
    display: none;
  }

  .sethi-luxury-footer--{{ section.id }} .sethi-luxury-footer__column-content {
    margin-top: 18px;
  }

  .sethi-luxury-footer--{{ section.id }} .sethi-luxury-footer__column-content ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sethi-luxury-footer--{{ section.id }} .sethi-luxury-footer__column-content li + li {
    margin-top: 12px;
  }

  .sethi-luxury-footer--{{ section.id }} .sethi-luxury-footer__column-content a {
    color: var(--footer-muted);
    font-size: 13px;
    line-height: 1.4;
    text-decoration: none;
    transition: color .25s ease;
  }

  .sethi-luxury-footer--{{ section.id }} .sethi-luxury-footer__column-content a:hover {
    color: var(--footer-text);
  }

  /* DIVIDER */
  .sethi-luxury-footer--{{ section.id }} .sethi-luxury-footer__divider {
    width: 100%;
    height: 1px;
    margin: 86px 0 28px;
    background: rgba(255,255,255,.18);
  }

  /* BOTTOM */
  .sethi-luxury-footer--{{ section.id }} .sethi-luxury-footer__bottom {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 30px;
    min-height: 46px;
  }

  .sethi-luxury-footer--{{ section.id }} .sethi-luxury-footer__copyright {
    color: var(--footer-muted);
    font-size: 13px;
  }

  .sethi-luxury-footer--{{ section.id }} .sethi-luxury-footer__social {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 22px;
  }

  .sethi-luxury-footer--{{ section.id }} .sethi-luxury-footer__social a {
    display: flex;
    width: 22px;
    height: 22px;
    align-items: center;
    justify-content: center;
    color: var(--footer-accent);
    text-decoration: none;
    transition: transform .25s ease, opacity .25s ease;
  }

  .sethi-luxury-footer--{{ section.id }} .sethi-luxury-footer__social a:hover {
    transform: translateY(-2px);
    opacity: .7;
  }

  .sethi-luxury-footer--{{ section.id }} .sethi-luxury-footer__social svg {
    display: block;
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  .sethi-luxury-footer--{{ section.id }} .sethi-luxury-footer__bottom-logo {
    display: flex;
    justify-content: flex-end;
    align-items: center;
  }

  .sethi-luxury-footer--{{ section.id }} .sethi-luxury-footer__bottom-logo img {
    display: block;
    width: auto;
    max-width: 100px;
    max-height: 34px;
    object-fit: contain;
    opacity: .7;
  }

  .sethi-luxury-footer--{{ section.id }} .sethi-luxury-footer__bottom-mark {
    justify-self: end;
    color: rgba(255,255,255,.28);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 24px;
    letter-spacing: -3px;
  }

  /* TABLET */
  @media screen and (max-width: 1100px) {
    .sethi-luxury-footer--{{ section.id }} .sethi-luxury-footer__columns {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      row-gap: 48px;
    }
  }

  /* MOBILE */
  @media screen and (max-width: 749px) {
    .sethi-luxury-footer--{{ section.id }} .sethi-luxury-footer__inner {
      width: min(100% - 28px, 1400px);
      padding-top: 46px;
      padding-bottom: 22px;
    }

    .sethi-luxury-footer--{{ section.id }} .sethi-luxury-footer__logo {
      max-width: 110px;
      max-height: 76px;
    }

    .sethi-luxury-footer--{{ section.id }} .sethi-luxury-footer__top-nav {
      gap: 10px 17px;
      margin-top: 22px;
    }

    .sethi-luxury-footer--{{ section.id }} .sethi-luxury-footer__top-nav a {
      font-size: 11px;
    }

    .sethi-luxury-footer--{{ section.id }} .sethi-luxury-footer__columns {
      grid-template-columns: 1fr;
      gap: 0;
      margin-top: 48px;
    }

    .sethi-luxury-footer--{{ section.id }} .sethi-luxury-footer__column {
      border-bottom: 1px solid rgba(255,255,255,.13);
    }

    .sethi-luxury-footer--{{ section.id }} .sethi-luxury-footer__column-toggle {
      padding: 16px 0;
      cursor: pointer;
      font-size: 13px;
    }

    .sethi-luxury-footer--{{ section.id }} .sethi-luxury-footer__plus {
      display: block;
      font-size: 20px;
      font-weight: 300;
      transition: transform .25s ease;
    }

    .sethi-luxury-footer--{{ section.id }} .sethi-luxury-footer__column-content {
      display: none;
      margin: 0 0 18px;
    }

    .sethi-luxury-footer--{{ section.id }} .sethi-luxury-footer__column.is-open .sethi-luxury-footer__column-content {
      display: block;
    }

    .sethi-luxury-footer--{{ section.id }} .sethi-luxury-footer__column.is-open .sethi-luxury-footer__plus {
      transform: rotate(45deg);
    }

    .sethi-luxury-footer--{{ section.id }} .sethi-luxury-footer__divider {
      margin: 46px 0 22px;
    }

    .sethi-luxury-footer--{{ section.id }} .sethi-luxury-footer__bottom {
      display: flex;
      flex-direction: column;
      gap: 22px;
      align-items: center;
      text-align: center;
    }

    .sethi-luxury-footer--{{ section.id }} .sethi-luxury-footer__copyright {
      order: 3;
      font-size: 11px;
    }

    .sethi-luxury-footer--{{ section.id }} .sethi-luxury-footer__social {
      order: 1;
      gap: 19px;
    }

    .sethi-luxury-footer--{{ section.id }} .sethi-luxury-footer__bottom-logo {
      order: 2;
      justify-content: center;
    }

    .sethi-luxury-footer--{{ section.id }} .sethi-luxury-footer__bottom-mark {
      order: 2;
      justify-self: auto;
    }
  }
</style>

<script>
  (() => {
    const initLuxuryFooter = (section) => {
      if (!section || section.dataset.luxuryFooterReady === 'true') return;

      section.dataset.luxuryFooterReady = 'true';

      section.querySelectorAll('.sethi-luxury-footer__column-toggle').forEach((button) => {
        button.addEventListener('click', () => {
          if (window.innerWidth > 749) return;

          const column = button.closest('.sethi-luxury-footer__column');
          const isOpen = column.classList.toggle('is-open');

          button.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        });
      });
    };

    const initAll = (root = document) => {
      root.querySelectorAll('[id^="SethiLuxuryFooter-"]').forEach(initLuxuryFooter);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => initAll());
    } else {
      initAll();
    }

    document.addEventListener('shopify:section:load', (event) => initAll(event.target));
  })();
</script>

{% schema %}
{
  "name": "Luxury image footer",
  "max_blocks": 5,
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Watch banner / background"
    },
    {
      "type": "select",
      "id": "background_size",
      "label": "Background size",
      "default": "cover",
      "options": [
        { "value": "cover", "label": "Cover" },
        { "value": "100% auto", "label": "Full width" },
        { "value": "contain", "label": "Contain" }
      ]
    },
    {
      "type": "select",
      "id": "background_position",
      "label": "Background position",
      "default": "center center",
      "options": [
        { "value": "center center", "label": "Center" },
        { "value": "center top", "label": "Top" },
        { "value": "center bottom", "label": "Bottom" },
        { "value": "left center", "label": "Left" },
        { "value": "right center", "label": "Right" }
      ]
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Main footer logo"
    },
    {
      "type": "link_list",
      "id": "top_menu",
      "label": "Top navigation menu"
    },
    {
      "type": "url",
      "id": "whatsapp_link",
      "label": "WhatsApp link"
    },
    {
      "type": "image_picker",
      "id": "bottom_logo",
      "label": "Bottom right logo"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Main text",
      "default": "#f5f2ed"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Secondary text",
      "default": "#c2bcb4"
    }
  ],
  "blocks": [
    {
      "type": "menu_column",
      "name": "Brand column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Column heading",
          "default": "Brands"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Brand menu"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Luxury image footer"
    }
  ]
}
{% endschema %}
