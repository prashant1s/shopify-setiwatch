<section
  id="SethiDialFooter-{{ section.id }}"
  class="sethi-dial-footer sethi-dial-footer--{{ section.id }}"
>
  <div class="sethi-dial-footer__dial" aria-hidden="true">
    <svg viewBox="0 0 700 700" role="presentation">
      <circle cx="350" cy="350" r="270" fill="none" stroke="currentColor" stroke-width="2"/>
      <circle cx="350" cy="350" r="220" fill="none" stroke="currentColor" stroke-width="1"/>
      <circle cx="350" cy="350" r="35" fill="none" stroke="currentColor" stroke-width="2"/>
      {% for i in (0..59) %}
        {% assign dial_remainder = i | modulo: 5 %}
        {% assign dial_rotation = i | times: 6 %}
        {% if dial_remainder == 0 %}
          {% assign dial_y1 = 82 %}
          {% assign dial_y2 = 116 %}
          {% assign dial_stroke = 3 %}
        {% else %}
          {% assign dial_y1 = 92 %}
          {% assign dial_y2 = 108 %}
          {% assign dial_stroke = 1 %}
        {% endif %}
        <line
          x1="350"
          y1="{{ dial_y1 }}"
          x2="350"
          y2="{{ dial_y2 }}"
          stroke="currentColor"
          stroke-width="{{ dial_stroke }}"
          transform="rotate({{ dial_rotation }} 350 350)"
        />
      {% endfor %}
      <line x1="350" y1="350" x2="350" y2="190" stroke="currentColor" stroke-width="5" stroke-linecap="round"/>
      <line x1="350" y1="350" x2="470" y2="390" stroke="currentColor" stroke-width="4" stroke-linecap="round"/>
      <circle cx="350" cy="350" r="9" fill="currentColor"/>
    </svg>
  </div>

  <div class="sethi-dial-footer__inner">
    <div class="sethi-dial-footer__top">
      <div class="sethi-dial-footer__brand">
        {% if section.settings.logo != blank %}
          {{
            section.settings.logo
            | image_url: width: 420
            | image_tag:
              loading: 'lazy',
              class: 'sethi-dial-footer__logo',
              alt: shop.name
          }}
        {% else %}
          <h2 class="sethi-dial-footer__wordmark">{{ shop.name }}</h2>
        {% endif %}

        {% if section.settings.tagline != blank %}
          <p class="sethi-dial-footer__tagline">{{ section.settings.tagline }}</p>
        {% endif %}

        {% if section.settings.brand_text != blank %}
          <p class="sethi-dial-footer__brand-text">{{ section.settings.brand_text }}</p>
        {% endif %}
      </div>

      <div class="sethi-dial-footer__menus">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'menu_column' %}
              <div class="sethi-dial-footer__column" {{ block.shopify_attributes }}>
                <button class="sethi-dial-footer__column-toggle" type="button" aria-expanded="false">
                  <span>{{ block.settings.heading }}</span>
                  <span class="sethi-dial-footer__plus">+</span>
                </button>

                <div class="sethi-dial-footer__column-content">
                  {% if block.settings.menu != blank %}
                    <ul>
                      {% for link in block.settings.menu.links %}
                        <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                      {% endfor %}
                    </ul>
                  {% endif %}
                </div>
              </div>
          {% endcase %}
        {% endfor %}
      </div>

      <div class="sethi-dial-footer__contact">
        <h3>{{ section.settings.contact_heading }}</h3>

        {% if section.settings.address != blank %}
          <p>{{ section.settings.address }}</p>
        {% endif %}

        {% if section.settings.phone != blank %}
          <a href="tel:{{ section.settings.phone | remove: ' ' }}">{{ section.settings.phone }}</a>
        {% endif %}

        {% if section.settings.whatsapp_link != blank %}
          <a href="{{ section.settings.whatsapp_link }}">Chat on WhatsApp</a>
        {% endif %}

        {% if section.settings.email != blank %}
          <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
        {% endif %}

        {% if section.settings.store_hours != blank %}
          <p>{{ section.settings.store_hours }}</p>
        {% endif %}

        <div class="sethi-dial-footer__social">
          {% if settings.social_instagram_link != blank %}
            <a href="{{ settings.social_instagram_link }}">Instagram</a>
          {% endif %}
          {% if settings.social_facebook_link != blank %}
            <a href="{{ settings.social_facebook_link }}">Facebook</a>
          {% endif %}
          {% if settings.social_youtube_link != blank %}
            <a href="{{ settings.social_youtube_link }}">YouTube</a>
          {% endif %}
        </div>

        {% if section.settings.newsletter_enable %}
          <div class="sethi-dial-footer__newsletter">
            <p class="sethi-dial-footer__newsletter-label">{{ section.settings.newsletter_heading }}</p>
            {%- form 'customer', id: 'SethiFooterNewsletter', class: 'sethi-dial-footer__newsletter-form' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <label class="visually-hidden" for="SethiFooterNewsletterEmail">{{ 'newsletter.label' | t }}</label>
              <input
                id="SethiFooterNewsletterEmail"
                type="email"
                name="contact[email]"
                value="{{ form.email }}"
                placeholder="{{ 'newsletter.label' | t }}"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                required
              >
              <button type="submit" aria-label="{{ 'newsletter.button_label' | t }}">→</button>
              {%- if form.posted_successfully? -%}
                <p class="sethi-dial-footer__newsletter-message" tabindex="-1" autofocus>{{ 'newsletter.success' | t }}</p>
              {%- elsif form.errors -%}
                <p class="sethi-dial-footer__newsletter-message">{{ form.errors.messages.email }}</p>
              {%- endif -%}
            {%- endform -%}
          </div>
        {% endif %}
      </div>
    </div>

    <div class="sethi-dial-footer__divider"></div>

    <div class="sethi-dial-footer__middle">
      <div class="sethi-dial-footer__service-links">
        {% if section.settings.service_link != blank %}
          <a href="{{ section.settings.service_link }}">Book a Service <span>→</span></a>
        {% endif %}
        {% if section.settings.repair_link != blank %}
          <a href="{{ section.settings.repair_link }}">Track Your Repair <span>→</span></a>
        {% endif %}
        {% if section.settings.store_link != blank %}
          <a href="{{ section.settings.store_link }}">Visit Our Boutiques <span>→</span></a>
        {% endif %}
      </div>

      {% if section.settings.show_payment_icons %}
        <div class="sethi-dial-footer__payments" aria-label="Payment methods">
          {% for type in shop.enabled_payment_types %}
            {{ type | payment_type_svg_tag }}
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="sethi-dial-footer__divider"></div>

    <div class="sethi-dial-footer__bottom">
      <p>© {{ 'now' | date: '%Y' }} {{ shop.name }}. All Rights Reserved.</p>

      {% if section.settings.policy_menu != blank %}
        <nav class="sethi-dial-footer__policies" aria-label="Footer policies">
          {% for link in section.settings.policy_menu.links %}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {% endfor %}
        </nav>
      {% endif %}

      {% if section.settings.bottom_line != blank %}
        <p class="sethi-dial-footer__bottom-line">{{ section.settings.bottom_line }}</p>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .sethi-dial-footer--{{ section.id }} {
    --footer-bg-1: {{ section.settings.background_top }};
    --footer-bg-2: {{ section.settings.background_bottom }};
    --footer-text: {{ section.settings.text_color }};
    --footer-muted: {{ section.settings.muted_color }};
    --footer-accent: {{ section.settings.accent_color }};
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 15% 0%, rgba(255,255,255,.035), transparent 24%),
      linear-gradient(180deg, var(--footer-bg-1), var(--footer-bg-2));
    color: var(--footer-text);
  }

  .sethi-dial-footer--{{ section.id }} * {
    box-sizing: border-box;
  }

  .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__dial {
    position: absolute;
    right: -110px;
    bottom: -210px;
    width: min(48vw, 720px);
    color: {{ section.settings.dial_color }};
    opacity: {{ section.settings.dial_opacity | divided_by: 100.0 }};
    pointer-events: none;
    transform: rotate(-8deg);
  }

  .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__dial svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__inner {
    position: relative;
    z-index: 2;
    width: min(100% - 48px, {{ section.settings.container_width }}px);
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__top {
    display: grid;
    grid-template-columns: 1.1fr 1.8fr .9fr;
    align-items: start;
    gap: 58px;
  }

  .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__logo {
    display: block;
    width: auto;
    max-width: 180px;
    max-height: 74px;
    object-fit: contain;
    filter: brightness(0) invert(1);
  }

  .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__wordmark {
    margin: 0;
    color: var(--footer-text);
    font-family: var(--font-display-family);
    font-size: 38px;
    font-weight: 400;
    line-height: 1;
  }

  .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__tagline {
    margin: 18px 0 0;
    color: var(--footer-accent);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 2.2px;
    text-transform: uppercase;
  }

  .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__brand-text {
    max-width: 300px;
    margin: 16px 0 0;
    color: var(--footer-muted);
    font-size: 12px;
    line-height: 1.75;
  }

  .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__menus {
    display: grid;
    grid-template-columns: repeat(3, minmax(0,1fr));
    gap: 34px;
  }

  .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__column-toggle,
  .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__contact h3 {
    margin: 0;
    padding: 0;
    color: var(--footer-text);
    background: transparent;
    border: 0;
    font-family: var(--font-display-family);
    font-size: 20px;
    font-weight: 400;
    line-height: 1.2;
  }

  .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__column-toggle {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    cursor: default;
    text-align: left;
  }

  .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__plus {
    display: none;
  }

  .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__column-content {
    margin-top: 20px;
  }

  .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__column-content ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__column-content li + li {
    margin-top: 11px;
  }

  .sethi-dial-footer--{{ section.id }} a {
    color: inherit;
    text-decoration: none;
  }

  .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__column-content a,
  .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__contact > a,
  .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__contact > p {
    color: var(--footer-muted);
    font-size: 11px;
    line-height: 1.5;
    transition: color .25s ease, transform .25s ease;
  }

  .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__column-content a {
    position: relative;
    display: inline-block;
  }

  .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__column-content a::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: -3px;
    left: 0;
    height: 1px;
    background: var(--footer-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform .25s ease;
  }

  .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__column-content a:hover,
  .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__contact > a:hover {
    color: var(--footer-text);
  }

  .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__column-content a:hover::after {
    transform: scaleX(1);
  }

  .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__contact {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__contact > a {
    margin-top: 12px;
  }

  .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__contact > p {
    margin: 14px 0 0;
  }

  .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__social {
    display: flex;
    margin-top: 24px;
    gap: 14px;
    flex-wrap: wrap;
  }

  .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__social a {
    color: var(--footer-muted);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 1.1px;
    text-transform: uppercase;
    transition: color .25s ease;
  }

  .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__social a:hover {
    color: var(--footer-accent);
  }

  .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__newsletter {
    margin-top: 24px;
    max-width: 280px;
  }

  .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__newsletter-label {
    margin: 0 0 10px;
    color: var(--footer-muted);
    font-size: 11px;
    line-height: 1.5;
  }

  .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__newsletter-form {
    display: flex;
    align-items: stretch;
    border: 1px solid rgba(255,255,255,.28);
    border-radius: var(--sethi-radius-sm);
    overflow: hidden;
  }

  .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__newsletter-form input[type="email"] {
    flex: 1;
    min-width: 0;
    padding: 10px 12px;
    background: transparent;
    border: 0;
    color: var(--footer-text);
    font-size: 12px;
  }

  .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__newsletter-form input[type="email"]::placeholder {
    color: var(--footer-muted);
  }

  .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__newsletter-form button {
    flex-shrink: 0;
    padding: 0 16px;
    background: transparent;
    border: 0;
    border-left: 1px solid rgba(255,255,255,.28);
    color: var(--footer-accent);
    font-size: 14px;
    cursor: pointer;
    transition: color .25s ease;
  }

  .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__newsletter-form button:hover {
    color: var(--footer-text);
  }

  .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__newsletter-message {
    margin: 8px 0 0;
    color: var(--footer-accent);
    font-size: 11px;
  }

  .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__divider {
    height: 1px;
    margin: 38px 0 26px;
    background: rgba(255,255,255,.12);
  }

  .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__middle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
  }

  .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__service-links {
    display: flex;
    gap: 26px;
    flex-wrap: wrap;
  }

  .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__service-links a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--footer-text);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 1.2px;
    text-transform: uppercase;
  }

  .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__service-links a span {
    transition: transform .25s ease;
  }

  .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__service-links a:hover span {
    transform: translateX(4px);
  }

  .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__payments {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__payments svg {
    width: 34px;
    height: 22px;
  }

  .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__bottom {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    color: var(--footer-muted);
    font-size: 9px;
  }

  .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__bottom p {
    margin: 0;
  }

  .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__policies {
    display: flex;
    justify-content: center;
    gap: 18px;
    flex-wrap: wrap;
  }

  .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__policies a {
    color: var(--footer-muted);
    transition: color .25s ease;
  }

  .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__policies a:hover {
    color: var(--footer-text);
  }

  .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__bottom-line {
    text-align: right;
  }

  @media screen and (max-width: 989px) {
    .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__top {
      grid-template-columns: 1fr 1.6fr;
    }

    .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__contact {
      grid-column: 1 / -1;
      padding-top: 8px;
    }

    .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__dial {
      width: 70vw;
      right: -180px;
      bottom: -160px;
    }
  }

  @media screen and (max-width: 749px) {
    .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__inner {
      width: min(100% - 28px, {{ section.settings.container_width }}px);
      padding-top: 52px;
      padding-bottom: 24px;
    }

    .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__top {
      grid-template-columns: 1fr;
      gap: 34px;
    }

    .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__menus {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__column {
      border-bottom: 1px solid rgba(255,255,255,.1);
    }

    .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__column-toggle {
      padding: 16px 0;
      cursor: pointer;
    }

    .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__plus {
      display: block;
      transition: transform .25s ease;
    }

    .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__column-content {
      display: none;
      margin: 0 0 18px;
    }

    .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__column.is-open .sethi-dial-footer__column-content {
      display: block;
    }

    .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__column.is-open .sethi-dial-footer__plus {
      transform: rotate(45deg);
    }

    .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__middle,
    .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__bottom {
      align-items: flex-start;
      flex-direction: column;
    }

    .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__middle {
      display: flex;
    }

    .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__bottom {
      display: flex;
    }

    .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__bottom-line {
      text-align: left;
    }

    .sethi-dial-footer--{{ section.id }} .sethi-dial-footer__dial {
      width: 115vw;
      right: -250px;
      bottom: -120px;
      opacity: calc({{ section.settings.dial_opacity | divided_by: 100.0 }} * .8);
    }
  }
</style>

<script>
  (() => {
    const initDialFooter = (section) => {
      if (!section || section.dataset.dialFooterReady === 'true') return;
      section.dataset.dialFooterReady = 'true';

      section.querySelectorAll('.sethi-dial-footer__column-toggle').forEach((button) => {
        button.addEventListener('click', () => {
          if (window.innerWidth > 749) return;
          const column = button.closest('.sethi-dial-footer__column');
          const isOpen = column.classList.toggle('is-open');
          button.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        });
      });
    };

    const initAll = (root = document) => {
      root.querySelectorAll('[id^="SethiDialFooter-"]').forEach(initDialFooter);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => initAll());
    } else {
      initAll();
    }

    document.addEventListener('shopify:section:load', (event) => initAll(event.target));
  })();
</script>

{% schema %}
{
  "name": "Sethi dial footer",
  "max_blocks": 3,
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer logo"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Small legacy line",
      "default": "Luxury timepieces since 1950"
    },
    {
      "type": "textarea",
      "id": "brand_text",
      "label": "Brand description",
      "default": "A trusted destination for authentic watches, expert service and enduring craftsmanship."
    },
    {
      "type": "text",
      "id": "contact_heading",
      "label": "Contact heading",
      "default": "Contact Us"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Store address"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone number"
    },
    {
      "type": "url",
      "id": "whatsapp_link",
      "label": "WhatsApp link"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email address"
    },
    {
      "type": "textarea",
      "id": "store_hours",
      "label": "Store timings",
      "default": "Monday–Sunday • 10:30 AM–8:30 PM"
    },
    {
      "type": "url",
      "id": "service_link",
      "label": "Book service link"
    },
    {
      "type": "url",
      "id": "repair_link",
      "label": "Track repair link"
    },
    {
      "type": "url",
      "id": "store_link",
      "label": "Boutiques link"
    },
