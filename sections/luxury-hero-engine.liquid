<script>
(() => {
  const initHero = (scope = document) => {
    scope.querySelectorAll('.gd-hero').forEach((hero) => {
      if (hero.dataset.ready === 'true') return;
      hero.dataset.ready = 'true';

      const slides = [...hero.querySelectorAll('.gd-hero__slide')];
      const dots = [...hero.querySelectorAll('.gd-hero__dot')];
      const prev = hero.querySelector('.gd-hero__nav--prev');
      const next = hero.querySelector('.gd-hero__nav--next');
      const duration = {{ section.settings.autoplay_speed | times: 1000 }};
      let current = 0;
      let timer;

      const triggerShine = () => {
        hero.classList.remove('is-changing');
        void hero.offsetWidth;
        hero.classList.add('is-changing');
        setTimeout(() => hero.classList.remove('is-changing'), 1250);
      };

      const updateDots = () => {
        dots.forEach((dot, i) => dot.classList.toggle('is-active', i === current));
      };

      const show = (index) => {
        slides[current]?.classList.remove('is-active');
        current = (index + slides.length) % slides.length;
        slides[current]?.classList.add('is-active');
        updateDots();
        triggerShine();
      };

      const start = () => {
        clearInterval(timer);
        if (slides.length > 1 && {{ section.settings.autoplay | json }}) {
          timer = setInterval(() => show(current + 1), duration);
        }
      };

      prev?.addEventListener('click', () => {
        show(current - 1);
        start();
      });

      next?.addEventListener('click', () => {
        show(current + 1);
        start();
      });

      dots.forEach((dot, i) => {
        dot.addEventListener('click', () => {
          show(i);
          start();
        });
      });

      hero.addEventListener('mouseenter', () => clearInterval(timer));
      hero.addEventListener('mouseleave', start);

      hero.querySelectorAll('[data-countdown]').forEach((el) => {
        const endTime = new Date(el.dataset.end).getTime();

        const update = () => {
          const distance = endTime - Date.now();
          const d = el.querySelector('[data-days]');
          const h = el.querySelector('[data-hours]');
          const m = el.querySelector('[data-minutes]');
          const s = el.querySelector('[data-seconds]');

          if (!Number.isFinite(endTime) || distance <= 0) {
            d.textContent = h.textContent = m.textContent = s.textContent = '00';
            return;
          }

          d.textContent = String(Math.floor(distance / 86400000)).padStart(2,'0');
          h.textContent = String(Math.floor((distance % 86400000) / 3600000)).padStart(2,'0');
          m.textContent = String(Math.floor((distance % 3600000) / 60000)).padStart(2,'0');
          s.textContent = String(Math.floor((distance % 60000) / 1000)).padStart(2,'0');
        };

        update();
        setInterval(update,1000);
      });

      updateDots();
      triggerShine();
      start();
    });
  };

  document.addEventListener('DOMContentLoaded', () => initHero());
  document.addEventListener('shopify:section:load', (event) => initHero(event.target));
})();
</script>
