{%- comment -%}
  Go Digital Luxury Hero Engine v1
  Multi-layout hero carousel:
  - Full edge hero
  - Main + 2 stacked
  - Main top + 2 bottom
  - Sale countdown
{%- endcomment -%}

{%- if section.blocks.size > 0 -%}
<section
  class="gd-hero"
  data-section-id="{{ section.id }}"
  style="
    --gd-hero-height-desktop: {{ section.settings.desktop_height }}px;
    --gd-hero-height-mobile: {{ section.settings.mobile_height }}px;
    --gd-hero-radius: {{ section.settings.radius }}px;
    --gd-hero-gap: {{ section.settings.gap }}px;
    --gd-hero-speed: {{ section.settings.autoplay_speed }}s;
  "
>
  <div class="gd-hero__viewport">
    {%- for block in section.blocks -%}
      <article
        class="gd-hero__slide gd-hero__slide--{{ block.settings.layout }}{% if forloop.first %} is-active{% endif %}"
        data-index="{{ forloop.index0 }}"
        data-layout="{{ block.settings.layout }}"
        {{ block.shopify_attributes }}
      >

        {%- case block.settings.layout -%}

          {%- when 'full' -%}
            <a href="{{ block.settings.main_link | default: '#' }}" class="gd-hero__panel gd-hero__panel--full">
              <div class="gd-hero__media">
                {%- if block.settings.main_image != blank -%}
                  {{
                    block.settings.main_image
                    | image_url: width: 2400
                    | image_tag:
                      loading: 'eager',
                      widths: '750,1100,1500,2000,2400',
                      sizes: '100vw',
                      class: 'gd-hero__image gd-hero__image--desktop',
                      alt: block.settings.heading,
                      style: 'object-fit: ' | append: block.settings.main_fit | append: '; object-position: ' | append: block.settings.main_image.presentation.focal_point | append: ';'
                  }}
                {%- endif -%}
                {%- if block.settings.mobile_main_image != blank -%}
                  {{
                    block.settings.mobile_main_image
                    | image_url: width: 1200
                    | image_tag:
                      loading: 'lazy',
                      widths: '360,480,750,1000,1200',
                      sizes: '100vw',
                      class: 'gd-hero__image gd-hero__image--mobile',
                      alt: block.settings.heading,
                      style: 'object-fit: ' | append: block.settings.main_fit | append: '; object-position: ' | append: block.settings.mobile_main_image.presentation.focal_point | append: ';'
                  }}
                {%- endif -%}
              </div>

              <div class="gd-hero__overlay"></div>

              <div class="gd-hero__content gd-hero__content--{{ block.settings.content_position }}">
                {%- if block.settings.eyebrow != blank -%}
                  <span class="gd-hero__eyebrow">{{ block.settings.eyebrow | escape }}</span>
                {%- endif -%}

                {%- if block.settings.heading != blank -%}
                  <h2>{{ block.settings.heading | escape }}</h2>
                {%- endif -%}

                {%- if block.settings.text != blank -%}
                  <p>{{ block.settings.text | escape }}</p>
                {%- endif -%}

                {%- if block.settings.button_text != blank -%}
                  <span class="gd-hero__cta">
                    {{ block.settings.button_text | escape }}
                    <span>→</span>
                  </span>
                {%- endif -%}
              </div>
            </a>

          {%- when 'stacked' -%}
            <div class="gd-hero__layout gd-hero__layout--stacked">
              <a href="{{ block.settings.main_link | default: '#' }}" class="gd-hero__panel gd-hero__panel--main">
                <div class="gd-hero__media">
                  {%- if block.settings.main_image != blank -%}
                    {{
                      block.settings.main_image
                      | image_url: width: 1800
                      | image_tag:
                        loading: 'lazy',
                        widths: '750,1100,1500,1800',
                        sizes: '(min-width: 990px) 68vw, 100vw',
                        class: 'gd-hero__image gd-hero__image--desktop',
                        alt: block.settings.heading,
                        style: 'object-fit: ' | append: block.settings.main_fit | append: '; object-position: ' | append: block.settings.main_image.presentation.focal_point | append: ';'
                    }}
                  {%- endif -%}
                {%- if block.settings.mobile_main_image != blank -%}
                  {{
                    block.settings.mobile_main_image
                    | image_url: width: 1200
                    | image_tag:
                      loading: 'lazy',
                      widths: '360,480,750,1000,1200',
                      sizes: '100vw',
                      class: 'gd-hero__image gd-hero__image--mobile',
                      alt: block.settings.heading,
                      style: 'object-fit: ' | append: block.settings.main_fit | append: '; object-position: ' | append: block.settings.mobile_main_image.presentation.focal_point | append: ';'
                  }}
                {%- endif -%}
                </div>
                <div class="gd-hero__overlay"></div>
                <div class="gd-hero__content gd-hero__content--bottom-left">
                  {%- if block.settings.eyebrow != blank -%}<span class="gd-hero__eyebrow">{{ block.settings.eyebrow | escape }}</span>{%- endif -%}
                  {%- if block.settings.heading != blank -%}<h2>{{ block.settings.heading | escape }}</h2>{%- endif -%}
                  {%- if block.settings.button_text != blank -%}<span class="gd-hero__cta">{{ block.settings.button_text | escape }} <span>→</span></span>{%- endif -%}
                </div>
              </a>

              <div class="gd-hero__side-stack">
                <a href="{{ block.settings.small_link_1 | default: '#' }}" class="gd-hero__panel gd-hero__panel--small">
                  <div class="gd-hero__media">
                    {%- if block.settings.small_image_1 != blank -%}
                      {{
                        block.settings.small_image_1
                        | image_url: width: 1000
                        | image_tag:
                          loading: 'lazy',
                          widths: '400,700,1000',
                          sizes: '(min-width: 990px) 30vw, 100vw',
                          class: 'gd-hero__image gd-hero__image--desktop',
                          alt: block.settings.small_title_1,
                          style: 'object-fit: ' | append: block.settings.small_fit | append: '; object-position: ' | append: block.settings.small_image_1.presentation.focal_point | append: ';'
                      }}
                    {%- endif -%}
                {%- if block.settings.mobile_small_image_1 != blank -%}
                  {{
                    block.settings.mobile_small_image_1
                    | image_url: width: 1200
                    | image_tag:
                      loading: 'lazy',
                      widths: '360,480,750,1000,1200',
                      sizes: '100vw',
                      class: 'gd-hero__image gd-hero__image--mobile',
                      alt: block.settings.small_title_1,
                      style: 'object-fit: ' | append: block.settings.small_fit | append: '; object-position: ' | append: block.settings.mobile_small_image_1.presentation.focal_point | append: ';'
                  }}
                {%- endif -%}
                  </div>
                  <div class="gd-hero__overlay"></div>
                  <div class="gd-hero__mini-copy">
                    <strong>{{ block.settings.small_title_1 | escape }}</strong>
                    <span>Explore →</span>
                  </div>
                </a>

                <a href="{{ block.settings.small_link_2 | default: '#' }}" class="gd-hero__panel gd-hero__panel--small">
                  <div class="gd-hero__media">
                    {%- if block.settings.small_image_2 != blank -%}
                      {{
                        block.settings.small_image_2
                        | image_url: width: 1000
                        | image_tag:
                          loading: 'lazy',
                          widths: '400,700,1000',
                          sizes: '(min-width: 990px) 30vw, 100vw',
                          class: 'gd-hero__image gd-hero__image--desktop',
                          alt: block.settings.small_title_2,
                          style: 'object-fit: ' | append: block.settings.small_fit | append: '; object-position: ' | append: block.settings.small_image_2.presentation.focal_point | append: ';'
                      }}
                    {%- endif -%}
                {%- if block.settings.mobile_small_image_2 != blank -%}
                  {{
                    block.settings.mobile_small_image_2
                    | image_url: width: 1200
                    | image_tag:
                      loading: 'lazy',
                      widths: '360,480,750,1000,1200',
                      sizes: '100vw',
                      class: 'gd-hero__image gd-hero__image--mobile',
                      alt: block.settings.small_title_2,
                      style: 'object-fit: ' | append: block.settings.small_fit | append: '; object-position: ' | append: block.settings.mobile_small_image_2.presentation.focal_point | append: ';'
                  }}
                {%- endif -%}
                  </div>
                  <div class="gd-hero__overlay"></div>
                  <div class="gd-hero__mini-copy">
                    <strong>{{ block.settings.small_title_2 | escape }}</strong>
                    <span>Explore →</span>
                  </div>
                </a>
              </div>
            </div>

          {%- when 'bottom_grid' -%}
            {%- comment -%}Legacy layout retained for old saved blocks.{%- endcomment -%}
            <div class="gd-hero__layout gd-hero__layout--bottom-grid">
              <a href="{{ block.settings.main_link | default: '#' }}" class="gd-hero__panel gd-hero__panel--wide">
                <div class="gd-hero__media">
                  {%- if block.settings.main_image != blank -%}
                    {{
                      block.settings.main_image
                      | image_url: width: 2200
                      | image_tag:
                        loading: 'lazy',
                        widths: '750,1100,1500,1900,2200',
                        sizes: '100vw',
                        class: 'gd-hero__image gd-hero__image--desktop',
                        alt: block.settings.heading,
                        style: 'object-fit: ' | append: block.settings.main_fit | append: '; object-position: ' | append: block.settings.main_image.presentation.focal_point | append: ';'
                    }}
                  {%- endif -%}
                {%- if block.settings.mobile_main_image != blank -%}
                  {{
                    block.settings.mobile_main_image
                    | image_url: width: 1200
                    | image_tag:
                      loading: 'lazy',
                      widths: '360,480,750,1000,1200',
                      sizes: '100vw',
                      class: 'gd-hero__image gd-hero__image--mobile',
                      alt: block.settings.heading,
                      style: 'object-fit: ' | append: block.settings.main_fit | append: '; object-position: ' | append: block.settings.mobile_main_image.presentation.focal_point | append: ';'
                  }}
                {%- endif -%}
                </div>
                <div class="gd-hero__overlay"></div>
                <div class="gd-hero__content gd-hero__content--center">
                  {%- if block.settings.eyebrow != blank -%}<span class="gd-hero__eyebrow">{{ block.settings.eyebrow | escape }}</span>{%- endif -%}
                  {%- if block.settings.heading != blank -%}<h2>{{ block.settings.heading | escape }}</h2>{%- endif -%}
                  {%- if block.settings.button_text != blank -%}<span class="gd-hero__cta">{{ block.settings.button_text | escape }} <span>→</span></span>{%- endif -%}
                </div>
              </a>

              <div class="gd-hero__bottom-cards">
                <a href="{{ block.settings.small_link_1 | default: '#' }}" class="gd-hero__panel gd-hero__panel--bottom">
                  <div class="gd-hero__media">
                    {%- if block.settings.small_image_1 != blank -%}
                      {{
                        block.settings.small_image_1
                        | image_url: width: 1200
                        | image_tag:
                          loading: 'lazy',
                          widths: '500,800,1200',
                          sizes: '(min-width: 990px) 50vw, 100vw',
                          class: 'gd-hero__image gd-hero__image--desktop',
                          alt: block.settings.small_title_1,
                          style: 'object-fit: ' | append: block.settings.small_fit | append: '; object-position: ' | append: block.settings.small_image_1.presentation.focal_point | append: ';'
                      }}
                    {%- endif -%}
                {%- if block.settings.mobile_small_image_1 != blank -%}
                  {{
                    block.settings.mobile_small_image_1
                    | image_url: width: 1200
                    | image_tag:
                      loading: 'lazy',
                      widths: '360,480,750,1000,1200',
                      sizes: '100vw',
                      class: 'gd-hero__image gd-hero__image--mobile',
                      alt: block.settings.small_title_1,
                      style: 'object-fit: ' | append: block.settings.small_fit | append: '; object-position: ' | append: block.settings.mobile_small_image_1.presentation.focal_point | append: ';'
                  }}
                {%- endif -%}
                  </div>
                  <div class="gd-hero__overlay"></div>
                  <div class="gd-hero__mini-copy">
                    <strong>{{ block.settings.small_title_1 | escape }}</strong>
                    <span>Explore →</span>
                  </div>
                </a>

                <a href="{{ block.settings.small_link_2 | default: '#' }}" class="gd-hero__panel gd-hero__panel--bottom">
                  <div class="gd-hero__media">
                    {%- if block.settings.small_image_2 != blank -%}
                      {{
                        block.settings.small_image_2
                        | image_url: width: 1200
                        | image_tag:
                          loading: 'lazy',
                          widths: '500,800,1200',
                          sizes: '(min-width: 990px) 50vw, 100vw',
                          class: 'gd-hero__image gd-hero__image--desktop',
                          alt: block.settings.small_title_2,
                          style: 'object-fit: ' | append: block.settings.small_fit | append: '; object-position: ' | append: block.settings.small_image_2.presentation.focal_point | append: ';'
                      }}
                    {%- endif -%}
                {%- if block.settings.mobile_small_image_2 != blank -%}
                  {{
                    block.settings.mobile_small_image_2
                    | image_url: width: 1200
                    | image_tag:
                      loading: 'lazy',
                      widths: '360,480,750,1000,1200',
                      sizes: '100vw',
                      class: 'gd-hero__image gd-hero__image--mobile',
                      alt: block.settings.small_title_2,
                      style: 'object-fit: ' | append: block.settings.small_fit | append: '; object-position: ' | append: block.settings.mobile_small_image_2.presentation.focal_point | append: ';'
                  }}
                {%- endif -%}
                  </div>
                  <div class="gd-hero__overlay"></div>
                  <div class="gd-hero__mini-copy">
                    <strong>{{ block.settings.small_title_2 | escape }}</strong>
                    <span>Explore →</span>
                  </div>
                </a>
              </div>
            </div>


          {%- when 'split' -%}
            <div class="gd-hero__layout gd-hero__layout--split">
              <a href="{{ block.settings.main_link | default: '#' }}" class="gd-hero__panel gd-hero__panel--split">
                <div class="gd-hero__media">
                  {%- if block.settings.main_image != blank -%}
                    {{
                      block.settings.main_image
                      | image_url: width: 1600
                      | image_tag:
                        loading: 'lazy',
                        widths: '600,900,1200,1600',
                        sizes: '(min-width: 990px) 50vw, 100vw',
                        class: 'gd-hero__image gd-hero__image--desktop',
                        alt: block.settings.heading,
                        style: 'object-fit: ' | append: block.settings.main_fit | append: '; object-position: ' | append: block.settings.main_image.presentation.focal_point | append: ';'
                    }}
                  {%- endif -%}
                  {%- if block.settings.mobile_main_image != blank -%}
                    {{
                      block.settings.mobile_main_image
                      | image_url: width: 1200
                      | image_tag:
                        loading: 'lazy',
                        widths: '360,480,750,1000,1200',
                        sizes: '100vw',
                        class: 'gd-hero__image gd-hero__image--mobile',
                        alt: block.settings.heading,
                        style: 'object-fit: ' | append: block.settings.main_fit | append: '; object-position: ' | append: block.settings.mobile_main_image.presentation.focal_point | append: ';'
                    }}
                  {%- endif -%}
                </div>
                <div class="gd-hero__overlay"></div>
                <div class="gd-hero__content gd-hero__content--bottom-left">
                  {%- if block.settings.eyebrow != blank -%}<span class="gd-hero__eyebrow">{{ block.settings.eyebrow | escape }}</span>{%- endif -%}
                  {%- if block.settings.heading != blank -%}<h2>{{ block.settings.heading | escape }}</h2>{%- endif -%}
                  {%- if block.settings.button_text != blank -%}<span class="gd-hero__cta">{{ block.settings.button_text | escape }} <span>→</span></span>{%- endif -%}
                </div>
              </a>

              <a href="{{ block.settings.small_link_1 | default: '#' }}" class="gd-hero__panel gd-hero__panel--split">
                <div class="gd-hero__media">
                  {%- if block.settings.small_image_1 != blank -%}
                    {{
                      block.settings.small_image_1
                      | image_url: width: 1600
                      | image_tag:
                        loading: 'lazy',
                        widths: '600,900,1200,1600',
                        sizes: '(min-width: 990px) 50vw, 100vw',
                        class: 'gd-hero__image gd-hero__image--desktop',
                        alt: block.settings.small_title_1,
                        style: 'object-fit: ' | append: block.settings.small_fit | append: '; object-position: ' | append: block.settings.small_image_1.presentation.focal_point | append: ';'
                    }}
                  {%- endif -%}
                  {%- if block.settings.mobile_small_image_1 != blank -%}
                    {{
                      block.settings.mobile_small_image_1
                      | image_url: width: 1200
                      | image_tag:
                        loading: 'lazy',
                        widths: '360,480,750,1000,1200',
                        sizes: '100vw',
                        class: 'gd-hero__image gd-hero__image--mobile',
                        alt: block.settings.small_title_1,
                        style: 'object-fit: ' | append: block.settings.small_fit | append: '; object-position: ' | append: block.settings.mobile_small_image_1.presentation.focal_point | append: ';'
                    }}
                  {%- endif -%}
                </div>
                <div class="gd-hero__overlay"></div>
                <div class="gd-hero__content gd-hero__content--bottom-left">
                  {%- if block.settings.split_eyebrow_2 != blank -%}<span class="gd-hero__eyebrow">{{ block.settings.split_eyebrow_2 | escape }}</span>{%- endif -%}
                  {%- if block.settings.small_title_1 != blank -%}<h2>{{ block.settings.small_title_1 | escape }}</h2>{%- endif -%}
                  {%- if block.settings.split_button_2 != blank -%}<span class="gd-hero__cta">{{ block.settings.split_button_2 | escape }} <span>→</span></span>{%- endif -%}
                </div>
              </a>
            </div>

          {%- when 'sale' -%}
            <a href="{{ block.settings.main_link | default: '#' }}" class="gd-hero__panel gd-hero__panel--sale">
              <div class="gd-hero__media">
                {%- if block.settings.main_image != blank -%}
                  {{
                    block.settings.main_image
                    | image_url: width: 2400
                    | image_tag:
                      loading: 'lazy',
                      widths: '750,1100,1500,2000,2400',
                      sizes: '100vw',
                      class: 'gd-hero__image gd-hero__image--desktop',
                      alt: block.settings.heading,
                      style: 'object-fit: ' | append: block.settings.main_fit | append: '; object-position: ' | append: block.settings.main_image.presentation.focal_point | append: ';'
                  }}
                {%- endif -%}
                {%- if block.settings.mobile_main_image != blank -%}
                  {{
                    block.settings.mobile_main_image
                    | image_url: width: 1200
                    | image_tag:
                      loading: 'lazy',
                      widths: '360,480,750,1000,1200',
                      sizes: '100vw',
                      class: 'gd-hero__image gd-hero__image--mobile',
                      alt: block.settings.heading,
                      style: 'object-fit: ' | append: block.settings.main_fit | append: '; object-position: ' | append: block.settings.mobile_main_image.presentation.focal_point | append: ';'
                  }}
                {%- endif -%}
              </div>
              <div class="gd-hero__overlay gd-hero__overlay--sale"></div>

              <div class="gd-hero__sale-content">
                {%- if block.settings.eyebrow != blank -%}
                  <span class="gd-hero__eyebrow">{{ block.settings.eyebrow | escape }}</span>
                {%- endif -%}

                {%- if block.settings.heading != blank -%}
                  <h2>{{ block.settings.heading | escape }}</h2>
                {%- endif -%}

                <div
                  class="gd-hero__countdown"
                  data-countdown
                  data-end="{{ block.settings.end_date | escape }}T{{ block.settings.end_time | default: '23:59' }}:00"
                >
                  <span><strong data-days>00</strong><small>Days</small></span>
                  <span><strong data-hours>00</strong><small>Hours</small></span>
                  <span><strong data-minutes>00</strong><small>Minutes</small></span>
                  <span><strong data-seconds>00</strong><small>Seconds</small></span>
                </div>

                {%- if block.settings.button_text != blank -%}
                  <span class="gd-hero__cta">{{ block.settings.button_text | escape }} <span>→</span></span>
                {%- endif -%}
              </div>
            </a>

        {%- endcase -%}
      </article>
    {%- endfor -%}

    {%- if section.blocks.size > 1 -%}
      <button class="gd-hero__nav gd-hero__nav--prev" type="button" aria-label="Previous slide">←</button>
      <button class="gd-hero__nav gd-hero__nav--next" type="button" aria-label="Next slide">→</button>

      <div class="gd-hero__progress">
        {%- for block in section.blocks -%}
          <button
            type="button"
            class="gd-hero__dot{% if forloop.first %} is-active{% endif %}"
            data-dot="{{ forloop.index0 }}"
            aria-label="Show slide {{ forloop.index }}"
          >
            <span></span>
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <span class="gd-hero__shine" aria-hidden="true"></span>
  </div>
</section>

<style>
  .gd-hero{
    position:relative;
    padding:var(--gd-hero-gap);
  }

  .gd-hero__viewport{
    position:relative;
    height:min(var(--gd-hero-height-desktop), calc(100svh - 150px));
    min-height:400px;
    overflow:hidden;
    border-radius:var(--gd-hero-radius);
    background:#111;
    box-shadow:0 2rem 5rem rgba(0,0,0,.14);
  }

  .gd-hero__slide{
    position:absolute;
    inset:0;
    opacity:0;
    transform:scale(1.015);
    pointer-events:none;
    transition:opacity .65s ease,transform .9s cubic-bezier(.22,.61,.36,1);
  }

  .gd-hero__slide.is-active{
    opacity:1;
    transform:none;
    pointer-events:auto;
  }

  .gd-hero__layout{
    display:grid;
    width:100%;
    height:100%;
    gap:var(--gd-hero-gap);
    padding:var(--gd-hero-gap);
  }

  .gd-hero__layout--stacked{
    grid-template-columns:minmax(0,2fr) minmax(26rem,.9fr);
  }

  .gd-hero__side-stack{
    display:grid;
    grid-template-rows:repeat(2,minmax(0,1fr));
    gap:var(--gd-hero-gap);
  }

  .gd-hero__layout--bottom-grid{
    grid-template-rows:minmax(0,1.45fr) minmax(0,.75fr);
  }

  .gd-hero__bottom-cards{
    display:grid;
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:var(--gd-hero-gap);
  }

  .gd-hero__panel{
    position:relative;
    display:block;
    overflow:hidden;
    border-radius:calc(var(--gd-hero-radius) * .72);
    color:#fff;
    text-decoration:none;
    background:#111;
  }

  .gd-hero__panel--full,
  .gd-hero__panel--sale{
    position:absolute;
    inset:0;
    border-radius:0;
  }

  .gd-hero__media,
  .gd-hero__image{
    position:absolute;
    inset:0;
    width:100%;
    height:100%;
  }

  .gd-hero__image{
    object-fit:cover;
    object-position:center;
    transition:transform 1.2s cubic-bezier(.22,.61,.36,1);
  }

  .gd-hero__image[style*="object-fit: contain"]{
    padding:clamp(1rem,2vw,2.4rem);
    background:rgba(255,255,255,.035);
  }

  .gd-hero__panel:hover .gd-hero__image{
    transform:scale(1.045);
  }

  .gd-hero__overlay{
    position:absolute;
    inset:0;
    background:
      linear-gradient(180deg,rgba(0,0,0,.02) 25%,rgba(0,0,0,.7)),
      linear-gradient(90deg,rgba(0,0,0,.42),transparent 58%);
  }

  .gd-hero__overlay--sale{
    background:
      linear-gradient(90deg,rgba(20,0,0,.82),rgba(20,0,0,.22)),
      linear-gradient(180deg,rgba(0,0,0,.08),rgba(0,0,0,.72));
  }

  .gd-hero__content,
