{{ 'sethi-product-complete.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sethi-product-complete.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign selected_variant = product.selected_or_first_available_variant
  assign selected_media = selected_variant.featured_media | default: product.featured_media

  assign compare_price = selected_variant.compare_at_price
  assign selling_price = selected_variant.price
  assign discount_percentage = 0

  if compare_price > selling_price
    assign discount_amount = compare_price | minus: selling_price
    assign discount_percentage = discount_amount | times: 100.0 | divided_by: compare_price | round
  endif

  assign product_brand = product.vendor
  assign product_model = selected_variant.sku

  assign lifestyle_image = product.metafields.custom.lifestyle_image.value
  assign product_video = product.metafields.custom.product_video.value
  assign expected_restock = product.metafields.custom.expected_restock_date.value
  assign compatible_straps = product.metafields.custom.compatible_straps.value
  assign bundle_products = product.metafields.custom.bundle_products.value
  assign product_faqs = product.metafields.custom.product_faqs.value
  assign ar_model = product.metafields.custom.ar_model.value

  assign product_form_id = 'SethiCompleteProductForm-' | append: section.id
-%}

<section
  id="SethiCompleteProduct-{{ section.id }}"
  class="sethi-complete-product"
  data-sethi-product
  data-product-id="{{ product.id }}"
  data-product-handle="{{ product.handle }}"
  data-product-url="{{ product.url }}"
>
  <div class="sethi-product-shell">

    <nav class="sethi-breadcrumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>

      {% if product.collections.first %}
        <span aria-hidden="true">/</span>
        <a href="{{ product.collections.first.url }}">
          {{ product.collections.first.title }}
        </a>
      {% endif %}

      <span aria-hidden="true">/</span>
      <span aria-current="page">{{ product.title }}</span>
    </nav>

    <div class="sethi-product-hero">

      <!-- PRODUCT GALLERY -->
      <div class="sethi-gallery" data-product-gallery>

        {% if product.media.size > 1 %}
          <div class="sethi-gallery__thumbnails" aria-label="Product media">
            {% for media in product.media %}
              <button
                type="button"
                class="sethi-gallery__thumbnail{% if media.id == selected_media.id %} is-active{% endif %}"
                data-gallery-thumbnail
                data-media-id="{{ media.id }}"
                aria-label="View media {{ forloop.index }}"
              >
                {{
                  media.preview_image
                  | image_url: width: 180
                  | image_tag:
                    loading: 'lazy',
                    widths: '90, 120, 180',
                    sizes: '76px',
                    alt: media.alt
                }}

                {% case media.media_type %}
                  {% when 'video' %}
                    <span class="sethi-gallery__badge">Video</span>
                  {% when 'external_video' %}
                    <span class="sethi-gallery__badge">Video</span>
                  {% when 'model' %}
                    <span class="sethi-gallery__badge">3D</span>
                {% endcase %}
              </button>
            {% endfor %}
          </div>
        {% endif %}

        <div class="sethi-gallery__stage">

          <button
            type="button"
            class="sethi-gallery__wishlist"
            aria-label="Add to wishlist"
            data-wishlist-button
          >
            <span aria-hidden="true">♡</span>
          </button>

          {% for media in product.media %}
            <div
              class="sethi-gallery__media{% if media.id == selected_media.id %} is-active{% endif %}"
              data-gallery-media
              data-media-id="{{ media.id }}"
              data-media-type="{{ media.media_type }}"
              {% unless media.id == selected_media.id %}hidden{% endunless %}
            >
              {% case media.media_type %}

                {% when 'image' %}
                  <button
                    type="button"
                    class="sethi-gallery__zoom-trigger"
                    data-open-lightbox
                    aria-label="Open full-screen image"
                  >
                    <span aria-hidden="true">⌕</span>
                  </button>

                  {{
                    media
                    | image_url: width: 2000
                    | image_tag:
                      loading: 'eager',
                      fetchpriority: 'high',
                      widths: '600, 900, 1200, 1600, 2000',
                      sizes: '(min-width: 990px) 55vw, 100vw',
                      class: 'sethi-gallery__image',
                      alt: media.alt
                  }}

                {% when 'video' %}
                  {{
                    media
                    | video_tag:
                      controls: true,
                      autoplay: false,
                      loop: false,
                      muted: false,
                      class: 'sethi-gallery__video'
                  }}

                {% when 'external_video' %}
                  <div class="sethi-gallery__external-video">
                    {{ media | external_video_tag }}
                  </div>

                {% when 'model' %}
                  {{
                    media
                    | model_viewer_tag:
                      reveal: 'interaction',
                      toggleable: true,
                      class: 'sethi-gallery__model'
                  }}

                {% else %}
                  {{ media | media_tag }}

              {% endcase %}
            </div>
          {% endfor %}

          {% if product.media.size > 1 %}
            <div class="sethi-gallery__controls">
              <button
                type="button"
                data-gallery-previous
                aria-label="Previous media"
              >
                ‹
              </button>

              <span>
                <strong data-gallery-current>1</strong>
                /
                {{ product.media.size }}
              </span>

              <button
                type="button"
                data-gallery-next
                aria-label="Next media"
              >
                ›
              </button>
            </div>
          {% endif %}

          {% assign product_models = product.media | where: 'media_type', 'model' %}

{% if ar_model != blank %}
  <button
    type="button"
    class="sethi-gallery__ar-button"
    data-open-ar
  >
    View on your wrist
  </button>

{% elsif product_models.size > 0 %}
  <button
    type="button"
    class="sethi-gallery__ar-button"
    data-open-model
  >
    View in 3D
  </button>
{% endif %}

        </div>
      </div>

      <!-- PRODUCT INFORMATION -->
      <div class="sethi-buybox">

        {% if product_brand != blank %}
          <a
            href="{{ routes.collections_url }}/vendors?q={{ product_brand | url_encode }}"
            class="sethi-buybox__brand"
          >
            {{ product_brand }}
          </a>
        {% endif %}

        <h1 class="sethi-buybox__title">
          {{ product.title }}
        </h1>

        <div class="sethi-buybox__meta">
          {% if product_model != blank %}
            <span data-product-sku>Model: {{ product_model }}</span>
          {% endif %}

          <button type="button" data-share-product>
            Share
          </button>
        </div>

        <button
          type="button"
          class="sethi-rating-summary"
          data-scroll-to-reviews
        >
          <span class="sethi-rating-summary__stars" aria-hidden="true">
            ★★★★★
          </span>

          <span>Reviews</span>

          <span class="sethi-rating-summary__divider"></span>

          <span>Ask a question</span>
        </button>

        <div class="sethi-product-price" aria-live="polite">
          <span class="sethi-product-price__current" data-product-price>
            {{ selling_price | money }}
          </span>

          <span
            class="sethi-product-price__compare"
            data-product-compare-price
            {% unless compare_price > selling_price %}hidden{% endunless %}
          >
            {{ compare_price | money }}
          </span>

          <span
            class="sethi-product-price__discount"
            data-product-discount
            {% unless compare_price > selling_price %}hidden{% endunless %}
          >
            {{ discount_percentage }}% OFF
          </span>
        </div>

        <p class="sethi-buybox__tax">
          Inclusive of all taxes
        </p>

        <div class="sethi-payment-card">
          <span class="sethi-payment-card__icon">₹</span>

          <div>
            <strong>Easy EMI options available</strong>
            <span>Flexible payment plans at checkout</span>
          </div>

          <button type="button" data-open-emi>
            View plans
          </button>
        </div>

        {% form
          'product',
          product,
          id: product_form_id,
          class: 'sethi-product-form',
          novalidate: 'novalidate',
          data-product-form: ''
        %}

          <input
            type="hidden"
            name="id"
            value="{{ selected_variant.id }}"
            data-variant-id
          >

          {% unless product.has_only_default_variant %}
            <div class="sethi-variant-picker">

              {% for option in product.options_with_values %}
                <fieldset class="sethi-product-option">

                  <legend>
                    {{ option.name }}:
                    <strong data-option-label="{{ option.position }}">
                      {{ option.selected_value }}
                    </strong>
                  </legend>

                  <div class="sethi-product-option__values">
                    {% for value in option.values %}
                      {% assign option_input_id = section.id
                        | append: '-option-'
                        | append: option.position
                        | append: '-'
                        | append: forloop.index0
                      %}

                      <input
                        type="radio"
                        id="{{ option_input_id }}"
                        name="options[{{ option.name | escape }}]"
                        value="{{ value | escape }}"
                        form="{{ product_form_id }}"
                        data-option-input
                        data-option-position="{{ option.position }}"
                        {% if option.selected_value == value %}checked{% endif %}
                      >

                      <label for="{{ option_input_id }}">
                        {{ value }}
                      </label>
                    {% endfor %}
                  </div>

                </fieldset>
              {% endfor %}

            </div>
          {% endunless %}

          <!-- OFFERS -->
          <div class="sethi-offers">
            <div class="sethi-offers__heading">
              <div>
                <span>Exclusive offers</span>
                <strong>Save more on this purchase</strong>
              </div>

              <button type="button" data-toggle-offers>
                View all
              </button>
            </div>

            <div class="sethi-offers__list">

              <article class="sethi-offer-card">
                <span class="sethi-offer-card__icon">%</span>
                <div>
                  <strong>Bank offers</strong>
                  <p>Additional savings on eligible cards.</p>
                </div>
              </article>

              <article class="sethi-offer-card">
                <span class="sethi-offer-card__icon">₹</span>
                <div>
                  <strong>No-cost EMI</strong>
                  <p>Available on selected payment methods.</p>
                </div>
              </article>

              <article class="sethi-offer-card" data-extra-offer hidden>
                <span class="sethi-offer-card__icon">⌚</span>
                <div>
                  <strong>Watch exchange</strong>
                  <p>Request an exchange-value assessment.</p>
                </div>
              </article>

              <article class="sethi-offer-card" data-extra-offer hidden>
                <span class="sethi-offer-card__icon">🎁</span>
                <div>
                  <strong>Premium gift wrapping</strong>
                  <p>Add gift packaging before checkout.</p>
                </div>
              </article>

            </div>
          </div>

          <!-- DELIVERY -->
          <div class="sethi-delivery-checker">
            <div class="sethi-delivery-checker__heading">
              <span aria-hidden="true">⌖</span>

              <div>
                <strong>Delivery and store availability</strong>
                <p>Enter your pincode for an estimated timeline.</p>
              </div>
            </div>

            <div class="sethi-delivery-checker__form">
              <input
                type="text"
                inputmode="numeric"
                maxlength="6"
                pattern="[0-9]{6}"
                placeholder="Enter 6-digit pincode"
                aria-label="Delivery pincode"
                data-pincode-input
              >

              <button type="button" data-check-pincode>
                Check
              </button>
            </div>

            <div
              class="sethi-delivery-checker__result"
              data-delivery-result
              hidden
            ></div>

            <div class="sethi-delivery-checker__services">
              <span>Free insured shipping</span>
              <span>COD eligibility</span>
              <span>Store pickup availability</span>
            </div>
          </div>

          <!-- STOCK -->
          <div
            class="sethi-stock-status{% unless selected_variant.available %} is-unavailable{% endunless %}"
            data-stock-status
          >
            <span class="sethi-stock-status__indicator"></span>

            <div>
              <strong data-stock-heading>
                {% if selected_variant.available %}
                  In stock
                {% else %}
                  Currently unavailable
                {% endif %}
              </strong>

              <span data-stock-text>
                {% if selected_variant.available %}
                  Ready for dispatch
                {% elsif expected_restock != blank %}
                  Expected restock: {{ expected_restock | date: '%d %b %Y' }}
                {% else %}
                  Enquire for availability or similar options
                {% endif %}
              </span>
            </div>
          </div>

          <!-- AVAILABLE PRODUCT ACTIONS -->
          <div
            class="sethi-purchase-actions"
            data-purchase-actions
            {% unless selected_variant.available %}hidden{% endunless %}
          >
            <div class="sethi-quantity-selector">
              <button
                type="button"
                aria-label="Decrease quantity"
                data-quantity-minus
              >
                −
              </button>

              <input
                type="number"
                name="quantity"
                value="1"
                min="1"
                aria-label="Quantity"
                data-quantity-input
              >

              <button
                type="button"
                aria-label="Increase quantity"
                data-quantity-plus
              >
                +
              </button>
            </div>

            <button
              type="submit"
              name="add"
              class="sethi-primary-button sethi-primary-button--dark"
              data-add-to-cart
            >
              <span data-add-to-cart-text>Add to cart</span>
            </button>

            <button
              type="button"
              class="sethi-primary-button sethi-primary-button--gold"
              data-buy-now
            >
              Buy now
            </button>
          </div>

          <!-- OUT OF STOCK ENQUIRY -->
          <div
            class="sethi-stock-enquiry"
            data-stock-enquiry
            {% if selected_variant.available %}hidden{% endif %}
          >
            <span class="sethi-stock-enquiry__eyebrow">
              Product availability
            </span>

            <h2>Enquire about this watch</h2>

            <p>
              Share your details and our watch expert will help with
              availability, restock updates or similar options.
            </p>

            <div class="sethi-stock-enquiry__fields">
              <input
                type="text"
                placeholder="Your name"
                autocomplete="name"
                data-enquiry-name
              >

              <input
                type="tel"
                placeholder="Phone number"
                autocomplete="tel"
                data-enquiry-phone
              >

              <input
                type="email"
                placeholder="Email address"
                autocomplete="email"
                data-enquiry-email
              >
            </div>

            <button
              type="button"
              class="sethi-primary-button sethi-primary-button--dark"
              data-submit-enquiry
            >
              Submit enquiry
            </button>

            <button
              type="button"
              class="sethi-secondary-button"
              data-notify-me
            >
              Notify me when available
            </button>

            <p
              class="sethi-stock-enquiry__message"
              data-enquiry-message
              aria-live="polite"
            ></p>
          </div>

        {% endform %}

        <div class="sethi-product-secondary-actions">
          <button type="button" data-wishlist-button>
            ♡ Wishlist
          </button>

          <button type="button" data-compare-product>
            ⇄ Compare
          </button>

          <button type="button" data-open-size-guide>
            Wrist-size guide
          </button>
        </div>

        <div class="sethi-shop-expert">
          <div>
            <span>Personal assistance</span>
            <strong>Shop with a watch expert</strong>
          </div>

          <div class="sethi-shop-expert__actions">
            <a
              href="https://wa.me/{{ section.settings.whatsapp_number | remove: '+' | remove: ' ' }}"
              target="_blank"
              rel="noopener"
              data-whatsapp-link
            >
              WhatsApp
            </a>

            <button type="button" data-request-video-call>
              Video call
            </button>

            <button type="button" data-request-callback>
              Request callback
            </button>
          </div>
        </div>

        <div class="sethi-buybox-trust">
          <article>
            <span>◇</span>
            <strong>100% Authentic</strong>
            <small>Original box and documents</small>
          </article>

          <article>
            <span>♢</span>
            <strong>Official Warranty</strong>
            <small>Manufacturer-backed coverage</small>
          </article>

          <article>
            <span>▣</span>
            <strong>Secure Payments</strong>
            <small>Protected payment processing</small>
          </article>

          <article>
            <span>↻</span>
            <strong>Easy Support</strong>
            <small>Dedicated after-sales assistance</small>
          </article>
        </div>

      </div>
    </div>
  </div>

    <!-- FULL-WIDTH TRUST STRIP -->
  <div class="sethi-page-trust">
    <div class="sethi-product-shell">
      <div class="sethi-page-trust__grid">

        <article>
          <span class="sethi-page-trust__icon">◇</span>
          <div>
            <strong>100% Authentic</strong>
            <small>Original products with box and documents</small>
          </div>
        </article>

        <article>
          <span class="sethi-page-trust__icon">♢</span>
          <div>
            <strong>Authorized Retailer</strong>
            <small>Shop confidently from Sethi Watch Company</small>
          </div>
        </article>

        <article>
          <span class="sethi-page-trust__icon">▣</span>
          <div>
            <strong>Insured Delivery</strong>
            <small>Secure shipping across India</small>
          </div>
        </article>

        <article>
          <span class="sethi-page-trust__icon">↻</span>
          <div>
            <strong>Easy Assistance</strong>
            <small>Dedicated support before and after purchase</small>
          </div>
        </article>

        <article>
          <span class="sethi-page-trust__icon">₹</span>
          <div>
            <strong>Flexible Payments</strong>
            <small>EMI and eligible bank offers</small>
          </div>
        </article>

      </div>
    </div>
  </div>

  <!-- PRODUCT HIGHLIGHTS -->
  <section class="sethi-section sethi-highlights-section">
    <div class="sethi-product-shell">

      <header class="sethi-section-heading">
        <span>{{ section.settings.highlights_eyebrow }}</span>
        <h2>{{ section.settings.highlights_heading }}</h2>

        {% if section.settings.highlights_description != blank %}
          <p>{{ section.settings.highlights_description }}</p>
        {% endif %}
      </header>

      <div class="sethi-highlights-grid">
        {% for block in section.blocks %}
          {% if block.type == 'highlight' %}
            <article
              class="sethi-highlight-card"
              {{ block.shopify_attributes }}
            >
              <div class="sethi-highlight-card__icon">
                {% case block.settings.icon %}
                  {% when 'movement' %}
                    ⌚
                  {% when 'water' %}
                    ◉
                  {% when 'glass' %}
                    ◇
                  {% when 'case' %}
                    ⊙
                  {% when 'strap' %}
                    ⌁
                  {% when 'warranty' %}
                    ✓
                  {% when 'design' %}
                    ✦
                  {% when 'comfort' %}
                    ♡
                  {% else %}
                    ✦
                {% endcase %}
              </div>

              <h3>{{ block.settings.heading }}</h3>

              {% if block.settings.text != blank %}
                <p>{{ block.settings.text }}</p>
              {% endif %}
            </article>
          {% endif %}
        {% endfor %}
      </div>

    </div>
  </section>

  <!-- PRODUCT STORY -->
  <section class="sethi-section sethi-story-section">
    <div class="sethi-product-shell">

      <div
        class="sethi-story-card{% if lifestyle_image == blank %} sethi-story-card--fallback{% endif %}"
      >
        <div class="sethi-story-card__media">

          {% if lifestyle_image != blank %}
            {{
              lifestyle_image
              | image_url: width: 2200
              | image_tag:
                loading: 'lazy',
                widths: '750, 1100, 1500, 1800, 2200',
                sizes: '(min-width: 990px) 62vw, 100vw',
                class: 'sethi-story-card__image',
                alt: product.title
            }}
          {% elsif section.settings.default_lifestyle_image != blank %}
            {{
              section.settings.default_lifestyle_image
              | image_url: width: 2200
              | image_tag:
                loading: 'lazy',
                widths: '750, 1100, 1500, 1800, 2200',
                sizes: '(min-width: 990px) 62vw, 100vw',
                class: 'sethi-story-card__image',
                alt: product.title
            }}
          {% else %}
            <div class="sethi-story-card__fallback-art">
              <span>{{ product_brand }}</span>
              <strong>{{ product.title }}</strong>
            </div>
          {% endif %}

          <div class="sethi-story-card__overlay"></div>
        </div>

        <div class="sethi-story-card__content">
          <span class="sethi-story-card__eyebrow">
            {{ product_brand }}
          </span>

          <h2>
            {{ section.settings.story_heading }}
          </h2>

          <div class="sethi-story-card__description">
            {% if product.description != blank %}
              {{ product.description | strip_html | truncatewords: 65 }}
            {% else %}
              A thoughtfully designed timepiece created to complement
              everyday moments, special occasions and personal style.
            {% endif %}
          </div>

          <div class="sethi-story-card__occasions">
            <article>
              <span>01</span>
              <strong>Business</strong>
            </article>

            <article>
              <span>02</span>
              <strong>Celebrations</strong>
            </article>

            <article>
              <span>03</span>
              <strong>Travel</strong>
            </article>

            <article>
              <span>04</span>
              <strong>Daily Wear</strong>
            </article>
          </div>

          {% if product.collections.first %}
            <a
              href="{{ product.collections.first.url }}"
              class="sethi-story-card__button"
            >
              Explore collection
              <span>→</span>
            </a>
          {% endif %}
        </div>
      </div>

    </div>
  </section>

  <!-- SPECIFICATIONS AND DESCRIPTION -->
  <section class="sethi-section sethi-information-section">
    <div class="sethi-product-shell">

      <header class="sethi-section-heading sethi-section-heading--center">
        <span>Every detail matters</span>
        <h2>Watch specifications</h2>
        <p>
          Important product details presented clearly to help you make
          the right choice.
        </p>
      </header>

      <div class="sethi-information-layout">

        <div class="sethi-specification-card">
          <div class="sethi-specification-card__heading">
            <span>Technical details</span>
            <h3>{{ product.title }}</h3>
          </div>

          <div class="sethi-specification-list">

            {% assign specification_count = 0 %}

            {% for block in section.blocks %}
              {% if block.type == 'specification' %}
                {% assign specification_value = blank %}

                {% case block.settings.source %}
                  {% when 'vendor' %}
                    {% assign specification_value = product.vendor %}

                  {% when 'sku' %}
                    {% assign specification_value = selected_variant.sku %}

                  {% when 'product_type' %}
                    {% assign specification_value = product.type %}

                  {% when 'metafield_case_size' %}
                    {% assign specification_value = product.metafields.custom.case_size.value %}

                  {% when 'metafield_case_shape' %}
                    {% assign specification_value = product.metafields.custom.case_shape.value %}

                  {% when 'metafield_movement' %}
                    {% assign specification_value = product.metafields.custom.movement.value %}

                  {% when 'metafield_strap_material' %}
                    {% assign specification_value = product.metafields.custom.strap_material.value %}

                  {% when 'metafield_strap_colour' %}
                    {% assign specification_value = product.metafields.custom.strap_colour.value %}

                  {% when 'metafield_dial_colour' %}
                    {% assign specification_value = product.metafields.custom.dial_colour.value %}

                  {% when 'metafield_water_resistance' %}
                    {% assign specification_value = product.metafields.custom.water_resistance.value %}

                  {% when 'metafield_glass_type' %}
                    {% assign specification_value = product.metafields.custom.glass_type.value %}

                  {% when 'metafield_case_material' %}
                    {% assign specification_value = product.metafields.custom.case_material.value %}

                  {% when 'metafield_gender' %}
                    {% assign specification_value = product.metafields.custom.gender.value %}

                  {% when 'metafield_collection' %}
                    {% assign specification_value = product.metafields.custom.collection_series.value %}

                  {% when 'metafield_functions' %}
                    {% assign specification_value = product.metafields.custom.functions.value %}

                  {% when 'metafield_warranty' %}
                    {% assign specification_value = product.metafields.custom.warranty.value %}

                  {% when 'custom' %}
                    {% assign specification_value = block.settings.custom_value %}
                {% endcase %}

                {% if specification_value != blank %}
                  {% assign specification_count = specification_count | plus: 1 %}

                  <div
                    class="sethi-specification-row"
                    {{ block.shopify_attributes }}
                  >
                    <span>{{ block.settings.label }}</span>

                    <strong>
                      {% if specification_value contains '<' %}
                        {{ specification_value | strip_html }}
                      {% else %}
                        {{ specification_value }}
                      {% endif %}
                    </strong>
                  </div>
                {% endif %}
              {% endif %}
            {% endfor %}

            {% if specification_count == 0 %}
              <div class="sethi-specification-row">
                <span>Brand</span>
                <strong>{{ product.vendor }}</strong>
              </div>

              {% if selected_variant.sku != blank %}
                <div class="sethi-specification-row">
                  <span>Model number</span>
                  <strong>{{ selected_variant.sku }}</strong>
                </div>
              {% endif %}

              {% if product.type != blank %}
                <div class="sethi-specification-row">
                  <span>Product type</span>
                  <strong>{{ product.type }}</strong>
                </div>
              {% endif %}
            {% endif %}

          </div>
        </div>

        <div class="sethi-description-card">
          <span class="sethi-description-card__eyebrow">
            Product details
          </span>

          <h3>
            Designed for the moments that matter
          </h3>

          <div class="sethi-description-card__content">
            {% if product.description != blank %}
              {{ product.description }}
            {% else %}
              <p>
                This timepiece combines distinctive styling with reliable
                everyday performance. Pair it with formal, casual or
                occasion wear for a refined finishing touch.
              </p>
            {% endif %}
          </div>

          <div class="sethi-description-card__support">
            <strong>Need help understanding the specifications?</strong>

            <a
              href="https://wa.me/{{ section.settings.whatsapp_number | remove: '+' | remove: ' ' }}?text={{ 'Hello, I need help with the specifications of ' | append: product.title | url_encode }}"
              target="_blank"
              rel="noopener"
            >
              Speak to an expert
            </a>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- COMPLETE THE WATCH / BUNDLE -->
  <section
    class="sethi-section sethi-bundle-section"
    data-bundle-section
  >
    <div class="sethi-product-shell">

      <header class="sethi-section-heading">
        <span>Pair it your way</span>
        <h2>Complete your timepiece</h2>
        <p>
          Discover compatible straps, accessories and watches selected to
          complement your choice.
        </p>
      </header>

      <div class="sethi-bundle-layout">

        <article
          class="sethi-bundle-main-product"
          data-bundle-item
          data-variant-id="{{ selected_variant.id }}"
          data-price="{{ selected_variant.price }}"
        >
          <div class="sethi-bundle-main-product__image">
            {% if product.featured_image != blank %}
              {{
                product.featured_image
                | image_url: width: 700
                | image_tag:
                  loading: 'lazy',
                  widths: '300, 500, 700',
                  sizes: '(min-width: 990px) 300px, 45vw',
                  alt: product.title
              }}
            {% endif %}
          </div>

          <div class="sethi-bundle-main-product__details">
            <span>Selected watch</span>
            <h3>{{ product.title }}</h3>
            <strong>{{ selected_variant.price | money }}</strong>
          </div>

          <div class="sethi-bundle-main-product__check">
            ✓
          </div>
        </article>

        <div class="sethi-bundle-products">

          {% assign bundle_item_count = 0 %}

          {% if compatible_straps != blank %}
            {% for strap_product in compatible_straps limit: 4 %}
              {% assign strap_variant = strap_product.selected_or_first_available_variant %}

              {% if strap_variant.available %}
                {% assign bundle_item_count = bundle_item_count | plus: 1 %}

                <article
                  class="sethi-bundle-product-card"
                  data-bundle-item
                  data-variant-id="{{ strap_variant.id }}"
                  data-price="{{ strap_variant.price }}"
                >
                  <label class="sethi-bundle-product-card__select">
                    <input
                      type="checkbox"
                      data-bundle-checkbox
                      value="{{ strap_variant.id }}"
                    >
                    <span></span>
                  </label>

                  <a
                    href="{{ strap_product.url }}"
                    class="sethi-bundle-product-card__image"
                  >
                    {% if strap_product.featured_image != blank %}
                      {{
                        strap_product.featured_image
                        | image_url: width: 500
                        | image_tag:
                          loading: 'lazy',
                          widths: '220, 360, 500',
                          sizes: '(min-width: 990px) 220px, 42vw',
                          alt: strap_product.title
                      }}
                    {% endif %}
                  </a>

                  <div class="sethi-bundle-product-card__details">
                    <span>Compatible strap</span>

                    <h3>
                      <a href="{{ strap_product.url }}">
                        {{ strap_product.title }}
                      </a>
                    </h3>

                    <strong>{{ strap_variant.price | money }}</strong>
                  </div>
                </article>
              {% endif %}
            {% endfor %}
          {% endif %}

          {% if bundle_products != blank %}
            {% for bundle_product in bundle_products limit: 4 %}
              {% assign bundle_variant = bundle_product.selected_or_first_available_variant %}

              {% if bundle_variant.available %}
                {% assign bundle_item_count = bundle_item_count | plus: 1 %}

                <article
                  class="sethi-bundle-product-card"
                  data-bundle-item
                  data-variant-id="{{ bundle_variant.id }}"
                  data-price="{{ bundle_variant.price }}"
                >
                  <label class="sethi-bundle-product-card__select">
                    <input
                      type="checkbox"
                      data-bundle-checkbox
                      value="{{ bundle_variant.id }}"
                    >
                    <span></span>
                  </label>

                  <a
                    href="{{ bundle_product.url }}"
                    class="sethi-bundle-product-card__image"
                  >
                    {% if bundle_product.featured_image != blank %}
                      {{
                        bundle_product.featured_image
                        | image_url: width: 500
                        | image_tag:
                          loading: 'lazy',
                          widths: '220, 360, 500',
                          sizes: '(min-width: 990px) 220px, 42vw',
                          alt: bundle_product.title
                      }}
                    {% endif %}
                  </a>

                  <div class="sethi-bundle-product-card__details">
                    <span>Recommended addition</span>

                    <h3>
                      <a href="{{ bundle_product.url }}">
                        {{ bundle_product.title }}
                      </a>
                    </h3>

                    <strong>{{ bundle_variant.price | money }}</strong>
                  </div>
                </article>
              {% endif %}
            {% endfor %}
          {% endif %}

          {% if bundle_item_count == 0 %}
            <div class="sethi-bundle-empty">
              <span>Bundle recommendations</span>

              <h3>
                Compatible straps and accessories will appear here
              </h3>

              <p>
                Add products in the compatible straps or bundle-products
                metafields to enable one-click bundles.
              </p>
            </div>
          {% endif %}

        </div>

        <aside class="sethi-bundle-summary">
          <span class="sethi-bundle-summary__eyebrow">
            Your bundle
          </span>

          <h3>Complete your selection</h3>

          <div class="sethi-bundle-summary__row">
            <span>Selected items</span>
            <strong data-bundle-count>1</strong>
          </div>

          <div class="sethi-bundle-summary__row">
            <span>Bundle subtotal</span>
            <strong data-bundle-total>
              {{ selected_variant.price | money }}
            </strong>
          </div>

          {% if section.settings.bundle_discount > 0 %}
            <div class="sethi-bundle-summary__saving">
              Save {{ section.settings.bundle_discount }}% when eligible
            </div>
          {% endif %}

          <button
            type="button"
            class="sethi-primary-button sethi-primary-button--gold"
            data-add-bundle
          >
            Add selected bundle
          </button>

          <p data-bundle-message aria-live="polite"></p>
        </aside>

      </div>

    </div>
  </section>

  <!-- AR / VIRTUAL TRY-ON -->
  <section class="sethi-section sethi-ar-section">
    <div class="sethi-product-shell">

      <div class="sethi-ar-card">
        <div class="sethi-ar-card__content">
          <span class="sethi-ar-card__eyebrow">
            Experience before you buy
          </span>

          <h2>See it on your wrist</h2>

          <p>
            Preview the watch through supported 3D or augmented-reality
            experiences directly from your mobile device.
          </p>

          <div class="sethi-ar-card__actions">
            {% assign product_models = product.media | where: 'media_type', 'model' %}

            {% if product_models.size > 0 %}
              <button
                type="button"
                class="sethi-primary-button sethi-primary-button--gold"
                data-open-model
              >
                View in 3D
              </button>
            {% elsif ar_model != blank %}
              <a
                href="{{ ar_model }}"
                class="sethi-primary-button sethi-primary-button--gold"
                target="_blank"
                rel="noopener"
              >
                Launch virtual try-on
              </a>
            {% else %}
              <button
                type="button"
                class="sethi-primary-button sethi-primary-button--gold"
                data-ar-unavailable
              >
                Check AR availability
              </button>
            {% endif %}

            <button
              type="button"
              class="sethi-secondary-button sethi-secondary-button--light"
              data-open-size-guide
            >
              Open wrist-size guide
            </button>
          </div>

          <p
            class="sethi-ar-card__message"
            data-ar-message
            aria-live="polite"
          ></p>
        </div>

        <div class="sethi-ar-card__visual">
          {% if product.featured_image != blank %}
            {{
              product.featured_image
              | image_url: width: 1100
              | image_tag:
                loading: 'lazy',
                widths: '500, 750, 900, 1100',
                sizes: '(min-width: 990px) 48vw, 100vw',
                alt: product.title
            }}
          {% endif %}

          <span class="sethi-ar-card__badge">
            AR / 3D Ready
          </span>
        </div>
      </div>

    </div>
  </section>

  <!-- SHOP WITH EXPERT -->
  <section class="sethi-section sethi-expert-section">
