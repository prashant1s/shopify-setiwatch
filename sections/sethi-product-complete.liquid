          <button type="button" data-book-appointment>
            <span>04</span>
            <strong>Book store appointment</strong>
            <small>Visit our boutique</small>
          </button>

        </div>
      </div>

    </div>
  </section>

  <!-- REVIEWS AND CUSTOMER PHOTOS -->
  <section
    class="sethi-section sethi-reviews-section"
    id="SethiReviews-{{ section.id }}"
    data-reviews-section
  >
    <div class="sethi-product-shell">

      <header class="sethi-section-heading">
        <span>Trusted by watch lovers</span>
        <h2>Customer reviews</h2>
        <p>
          Real experiences from customers who selected their watches
          through Sethi Watch Company.
        </p>
      </header>

      <div class="sethi-reviews-layout">

        <aside class="sethi-review-summary">
          <span class="sethi-review-summary__score">
            {{ section.settings.review_score }}
          </span>

          <div class="sethi-review-summary__stars">
            ★★★★★
          </div>

          <p>
            Based on verified customer feedback
          </p>

          <button
            type="button"
            class="sethi-primary-button sethi-primary-button--dark"
            data-write-review
          >
            Write a review
          </button>
        </aside>

        <div class="sethi-review-cards">
          {% assign review_block_count = 0 %}

          {% for block in section.blocks %}
            {% if block.type == 'review' %}
              {% assign review_block_count = review_block_count | plus: 1 %}

              <article
                class="sethi-review-card"
                {{ block.shopify_attributes }}
              >
                <div class="sethi-review-card__stars">
                  ★★★★★
                </div>

                <h3>{{ block.settings.heading }}</h3>

                <p>{{ block.settings.review }}</p>

                <div class="sethi-review-card__customer">
                  <strong>{{ block.settings.customer_name }}</strong>

                  {% if block.settings.verified %}
                    <span>Verified buyer</span>
                  {% endif %}
                </div>
              </article>
            {% endif %}
          {% endfor %}

          {% if review_block_count == 0 %}
            <article class="sethi-review-card">
              <div class="sethi-review-card__stars">★★★★★</div>
              <h3>Premium buying experience</h3>
              <p>
                Add review-app integration or review blocks through the
                Theme Editor to show verified customer feedback here.
              </p>
              <div class="sethi-review-card__customer">
                <strong>Sethi Watch Company</strong>
                <span>Review section ready</span>
              </div>
            </article>
          {% endif %}
        </div>

      </div>

      <div class="sethi-customer-gallery">
        {% for block in section.blocks %}
          {% if block.type == 'customer_image' and block.settings.image != blank %}
            <figure {{ block.shopify_attributes }}>
              {{
                block.settings.image
                | image_url: width: 700
                | image_tag:
                  loading: 'lazy',
                  widths: '250, 400, 550, 700',
                  sizes: '(min-width: 990px) 25vw, 70vw',
                  alt: block.settings.caption
              }}

              {% if block.settings.caption != blank %}
                <figcaption>{{ block.settings.caption }}</figcaption>
              {% endif %}
            </figure>
          {% endif %}
        {% endfor %}
      </div>

    </div>
  </section>

  <!-- FAQ -->
  <section class="sethi-section sethi-faq-section">
    <div class="sethi-product-shell">

      <div class="sethi-faq-layout">
        <header class="sethi-section-heading">
          <span>Everything you need to know</span>
          <h2>Frequently asked questions</h2>
          <p>
            Answers about authenticity, warranty, delivery, returns and
            product care.
          </p>
        </header>

        <div class="sethi-faq-list">

          {% assign faq_count = 0 %}

          {% if product_faqs != blank %}
            {% for faq in product_faqs %}
              {% assign faq_count = faq_count | plus: 1 %}

              <details class="sethi-faq-item">
                <summary>
                  <span>{{ faq.question }}</span>
                  <span class="sethi-faq-item__plus">+</span>
                </summary>

                <div class="sethi-faq-item__answer">
                  {{ faq.answer }}
                </div>
              </details>
            {% endfor %}
          {% endif %}

          {% for block in section.blocks %}
            {% if block.type == 'faq' %}
              {% assign faq_count = faq_count | plus: 1 %}

              <details
                class="sethi-faq-item"
                {{ block.shopify_attributes }}
              >
                <summary>
                  <span>{{ block.settings.question }}</span>
                  <span class="sethi-faq-item__plus">+</span>
                </summary>

                <div class="sethi-faq-item__answer">
                  {{ block.settings.answer }}
                </div>
              </details>
            {% endif %}
          {% endfor %}

          {% if faq_count == 0 %}
            <details class="sethi-faq-item">
              <summary>
                <span>Is this watch 100% authentic?</span>
                <span class="sethi-faq-item__plus">+</span>
              </summary>

              <div class="sethi-faq-item__answer">
                Yes. Products are supplied with the applicable original
                packaging, documents and manufacturer warranty.
              </div>
            </details>

            <details class="sethi-faq-item">
              <summary>
                <span>How can I check delivery availability?</span>
                <span class="sethi-faq-item__plus">+</span>
              </summary>

              <div class="sethi-faq-item__answer">
                Enter your six-digit pincode in the delivery checker above
                to view an estimated delivery timeline.
              </div>
            </details>

            <details class="sethi-faq-item">
              <summary>
                <span>Can I speak to a watch expert before ordering?</span>
                <span class="sethi-faq-item__plus">+</span>
              </summary>

              <div class="sethi-faq-item__answer">
                Yes. You can connect through WhatsApp, request a callback,
                book a video call or schedule a store appointment.
              </div>
            </details>
          {% endif %}

        </div>
      </div>

    </div>
  </section>

