  <!-- CONTACT / APPOINTMENT DIALOG -->
  <dialog
    class="sethi-dialog sethi-contact-dialog"
    data-contact-dialog
  >
    <button
      type="button"
      class="sethi-dialog__close"
      data-close-dialog
      aria-label="Close contact form"
    >
      ×
    </button>

    <div class="sethi-contact-dialog__content">
      <span data-contact-eyebrow>Personal assistance</span>
      <h2 data-contact-heading>Request assistance</h2>

      <p>
        Share your details and the Sethi Watch Company team will contact you.
      </p>

      <div class="sethi-contact-dialog__fields">
        <input
          type="text"
          placeholder="Your name"
          autocomplete="name"
          data-contact-name
        >

        <input
          type="tel"
          placeholder="Phone number"
          autocomplete="tel"
          data-contact-phone
        >

        <input
          type="email"
          placeholder="Email address"
          autocomplete="email"
          data-contact-email
        >

        <textarea
          rows="4"
          placeholder="Message"
          data-contact-message-input
        ></textarea>
      </div>

      <button
        type="button"
        class="sethi-primary-button sethi-primary-button--dark"
        data-submit-contact
      >
        Continue on WhatsApp
      </button>

      <p
        class="sethi-contact-dialog__status"
        data-contact-status
        aria-live="polite"
      ></p>
    </div>
  </dialog>

  <script type="application/json" data-product-variants-json>
    {{ product.variants | json }}
  </script>

  <script type="application/json" data-current-product-json>
    {
      "id": {{ product.id | json }},
      "title": {{ product.title | json }},
      "url": {{ product.url | json }},
      "image": {{ product.featured_image | image_url: width: 500 | json }},
      "price": {{ selected_variant.price | json }},
      "vendor": {{ product.vendor | json }}
    }
  </script>
</section>

