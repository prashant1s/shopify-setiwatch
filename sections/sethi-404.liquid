<section class="sethi-section sethi-section--deep sethi-404" data-sethi-404>
  <div class="sethi-container">
    <div class="sethi-404__inner">
      <span class="sethi-eyebrow">{{ section.settings.eyebrow | default: '404' }}</span>
      <div class="sethi-minute-track" role="presentation"></div>
      <h1 class="sethi-heading sethi-heading--h2">{{ section.settings.heading | default: "This page has wandered off" }}</h1>
      <p class="sethi-subheading">{{ section.settings.subheading | default: "The page you're looking for doesn't exist, or the link may be out of date. Here's where you probably meant to go." }}</p>

      <div class="sethi-404__links">
        {% for block in section.blocks %}
          <a href="{{ block.settings.link }}" class="sethi-404__link" {{ block.shopify_attributes }}>
            {{ block.settings.label }}
            <span aria-hidden="true">→</span>
          </a>
        {% endfor %}
      </div>

      {% if section.settings.help_text != blank %}
        <p class="sethi-404__help">
          {{ section.settings.help_text }}
          {% if section.settings.phone != blank %}<a href="tel:{{ section.settings.phone | remove: ' ' }}">{{ section.settings.phone }}</a>{% endif %}
          {% if section.settings.whatsapp_link != blank %}<a href="{{ section.settings.whatsapp_link }}" target="_blank" rel="noopener">WhatsApp us</a>{% endif %}
        </p>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .sethi-404__inner { max-width: 60rem; margin: 0 auto; text-align: center; }
  .sethi-404__inner .sethi-eyebrow,
  .sethi-404__inner .sethi-minute-track { margin-left: auto; margin-right: auto; }
  .sethi-404__inner .sethi-subheading { margin-left: auto; margin-right: auto; }
  .sethi-404__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
  .sethi-404__link {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    padding: 1.2rem 2.2rem;
    border-radius: var(--sethi-radius-pill);
    border: 1px solid var(--color-border);
    background: rgb(var(--color-surface));
    color: rgb(var(--color-ink));
    font-family: var(--font-body-family);
    font-size: 1.3rem;
    font-weight: 600;
    text-decoration: none;
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .sethi-404__link:hover { border-color: rgb(var(--color-gold)); color: rgb(var(--color-gold-deep)); }
  .sethi-404__link:focus-visible { outline: 2px solid rgb(var(--color-gold)); outline-offset: 3px; }
  .sethi-404__help {
    margin-top: var(--space-6);
    font-size: 1.3rem;
    color: rgb(var(--color-ink-muted));
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
  }
  .sethi-404__help a { color: rgb(var(--color-gold-deep)); text-decoration: underline; margin-left: 0.4rem; }
</style>

{% schema %}
{
  "name": "404 page",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "404" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "This page has wandered off" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "help_text", "label": "Help prompt text", "default": "Can't find what you're looking for?" },
    { "type": "text", "id": "phone", "label": "Support phone number" },
    { "type": "url", "id": "whatsapp_link", "label": "WhatsApp link" }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "url", "id": "link", "label": "Destination" }
      ]
    }
  ],
  "presets": [
    {
      "name": "404 page",
      "blocks": [
        { "type": "link", "settings": { "label": "Shop all watches" } },
        { "type": "link", "settings": { "label": "Browse brands" } },
        { "type": "link", "settings": { "label": "Go home" } }
      ]
    }
  ]
}
{% endschema %}
