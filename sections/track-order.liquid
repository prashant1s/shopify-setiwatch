<section class="track-order sethi-section" data-track-order>
  <div class="sethi-container">
    <div class="track-order__header sethi-section-header">
      {% if section.settings.eyebrow != blank %}
        <span class="sethi-eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}
      <div class="sethi-minute-track" role="presentation"></div>
      {% if section.settings.heading != blank %}
        <h1 class="sethi-heading sethi-heading--h2">{{ section.settings.heading }}</h1>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p class="sethi-subheading">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>

    <div class="track-order__grid">
      <div class="track-order__lookup">
        <h2 class="track-order__card-title">{{ section.settings.lookup_heading | default: 'Find your order' }}</h2>
        <p class="track-order__card-text">
          {{ section.settings.lookup_text | default: "Enter the email you used at checkout and we'll send you a secure link to your order status — no password needed." }}
        </p>
        <a href="{{ routes.account_login_url }}" class="track-order__button">
          {{ section.settings.lookup_button_label | default: 'Track my order' }}
          <span aria-hidden="true">→</span>
        </a>
        <p class="track-order__note">
          {{ section.settings.lookup_note | default: 'Have an account? Signing in shows your full order history in one place.' }}
        </p>
      </div>

      <div class="track-order__states">
        <h2 class="track-order__card-title">{{ section.settings.states_heading | default: "What each status means" }}</h2>
        <ul class="track-order__timeline" role="list">
          <li><span class="track-order__dot"></span><span class="track-order__state-label">Confirmed</span><span class="track-order__state-desc">We have your order and payment.</span></li>
          <li><span class="track-order__dot"></span><span class="track-order__state-label">Packed</span><span class="track-order__state-desc">Your watch is boxed and ready to ship.</span></li>
          <li><span class="track-order__dot"></span><span class="track-order__state-label">Shipped</span><span class="track-order__state-desc">Handed to our courier, tracking number active.</span></li>
          <li><span class="track-order__dot"></span><span class="track-order__state-label">Out for delivery</span><span class="track-order__state-desc">On the vehicle for delivery today.</span></li>
          <li><span class="track-order__dot"></span><span class="track-order__state-label">Delivered</span><span class="track-order__state-desc">Signed for at your address.</span></li>
        </ul>
        <div class="track-order__exceptions">
          <p class="track-order__exceptions-title">{{ section.settings.exceptions_heading | default: "If something's off" }}</p>
          <ul>
            <li><b>Delayed</b> — {{ section.settings.delayed_text | default: "the courier is running behind; the estimated date on your order page updates automatically." }}</li>
            <li><b>Failed delivery attempt</b> — {{ section.settings.failed_text | default: "no one was available; the courier will retry, usually the next working day." }}</li>
            <li><b>Returned to origin</b> — {{ section.settings.returned_text | default: "the parcel is on its way back to us; contact us and we'll sort it out." }}</li>
          </ul>
        </div>
      </div>
    </div>

    {% if section.settings.free_shipping_text != blank %}
      <p class="track-order__shipping-note">{{ section.settings.free_shipping_text }}</p>
    {% endif %}

    <div class="track-order__help">
      <span>{{ section.settings.help_text | default: "Still can't find your order?" }}</span>
      {% if section.settings.phone != blank %}
        <a href="tel:{{ section.settings.phone | remove: ' ' }}">{{ section.settings.phone }}</a>
      {% endif %}
      {% if section.settings.whatsapp_link != blank %}
        <a href="{{ section.settings.whatsapp_link }}" target="_blank" rel="noopener">WhatsApp us</a>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .track-order__grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: var(--space-6);
    align-items: start;
  }
  @media screen and (max-width: 749px) {
    .track-order__grid { grid-template-columns: 1fr; }
  }
  .track-order__lookup,
  .track-order__states {
    background: rgb(var(--color-surface));
    border: 1px solid var(--color-border);
    border-radius: var(--sethi-radius-md);
    padding: var(--space-5);
  }
  .track-order__card-title {
    font-family: var(--font-display-family);
    font-size: var(--text-h4);
    font-weight: 400;
    color: rgb(var(--color-ink));
    margin: 0 0 var(--space-3);
  }
  .track-order__card-text {
    font-family: var(--font-body-family);
    font-size: var(--text-body);
    color: rgb(var(--color-ink-muted));
    margin: 0 0 var(--space-4);
    max-width: 42ch;
  }
  .track-order__button {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    padding: 1.3rem 2.4rem;
    border-radius: var(--sethi-radius-pill);
    background: rgb(var(--color-gold));
    color: rgb(var(--color-ink-inverse));
    font-family: var(--font-body-family);
    font-size: 1.4rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .track-order__button:hover { background: rgb(var(--color-gold-deep)); }
  .track-order__button:focus-visible { outline: 2px solid rgb(var(--color-gold)); outline-offset: 3px; }
  .track-order__note {
    margin: var(--space-3) 0 0;
    font-size: 1.3rem;
    color: rgb(var(--color-ink-muted));
  }
  .track-order__timeline {
    list-style: none;
    margin: 0 0 var(--space-4);
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .track-order__timeline li {
    display: grid;
    grid-template-columns: 1.2rem auto 1fr;
    align-items: baseline;
    gap: 0 var(--space-3);
  }
  .track-order__dot {
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 50%;
    background: rgb(var(--color-gold-soft));
    align-self: center;
  }
  .track-order__state-label {
    font-family: var(--font-display-family);
    font-size: var(--text-body-lg);
    color: rgb(var(--color-ink));
  }
  .track-order__state-desc {
    grid-column: 2 / -1;
    font-size: 1.3rem;
    color: rgb(var(--color-ink-muted));
  }
  .track-order__exceptions {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-3);
  }
  .track-order__exceptions-title {
    font-size: 1.1rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgb(var(--color-gold));
    font-weight: 600;
    margin: 0 0 var(--space-2);
  }
  .track-order__exceptions ul {
    margin: 0;
    padding-left: 1.8rem;
    font-size: 1.3rem;
    color: rgb(var(--color-ink-muted));
  }
  .track-order__exceptions li { margin-bottom: 0.6rem; }
  .track-order__exceptions b { color: rgb(var(--color-ink)); font-weight: 600; }
  .track-order__shipping-note {
    text-align: center;
    margin: var(--space-5) 0 0;
    font-size: 1.3rem;
    color: rgb(var(--color-ink-muted));
  }
  .track-order__help {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-3);
    font-size: 1.3rem;
    color: rgb(var(--color-ink-muted));
  }
  .track-order__help a {
    color: rgb(var(--color-gold-deep));
    text-decoration: underline;
  }
</style>

{% schema %}
{
  "name": "Track order",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Order status" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Track Your Order" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Enter your email to see exactly where your watch is." },
    { "type": "text", "id": "lookup_heading", "label": "Lookup card heading", "default": "Find your order" },
    { "type": "textarea", "id": "lookup_text", "label": "Lookup card text" },
    { "type": "text", "id": "lookup_button_label", "label": "Lookup button label", "default": "Track my order" },
    { "type": "text", "id": "lookup_note", "label": "Lookup card note" },
    { "type": "text", "id": "states_heading", "label": "States card heading", "default": "What each status means" },
    { "type": "text", "id": "exceptions_heading", "label": "Exceptions heading", "default": "If something's off" },
    { "type": "textarea", "id": "delayed_text", "label": "Delayed — explanation" },
    { "type": "textarea", "id": "failed_text", "label": "Failed delivery attempt — explanation" },
    { "type": "textarea", "id": "returned_text", "label": "Returned to origin — explanation" },
    { "type": "text", "id": "free_shipping_text", "label": "Free shipping note", "default": "Free shipping on all orders above ₹4,999" },
    { "type": "text", "id": "help_text", "label": "Help prompt text", "default": "Still can't find your order?" },
    { "type": "text", "id": "phone", "label": "Support phone number" },
    { "type": "url", "id": "whatsapp_link", "label": "WhatsApp link" }
  ],
  "presets": [{ "name": "Track order" }]
}
{% endschema %}
