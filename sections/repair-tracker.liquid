    }

    .repair-tracker--{{ section.id }} .repair-step::before,
    .repair-tracker--{{ section.id }}
      .repair-step:nth-child(5)::before {
      display: block;
      top: -30px;
      right: auto;
      bottom: auto;
      left: 11px;
      width: 1px;
      height: 40px;
    }

    .repair-tracker--{{ section.id }}
