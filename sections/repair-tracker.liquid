<section
  id="RepairTracker-{{ section.id }}"
  class="repair-tracker repair-tracker--{{ section.id }}"
  data-repair-tracker
>
  <div class="repair-tracker__hero">
    {% if section.settings.background_image != blank %}
      {{
        section.settings.background_image
        | image_url: width: 2200
        | image_tag:
          loading: 'eager',
          widths: '900, 1300, 1700, 2200',
          sizes: '100vw',
          class: 'repair-tracker__hero-image',
          alt: section.settings.heading
      }}
    {% endif %}

    <div class="repair-tracker__hero-overlay"></div>

    <div class="repair-tracker__hero-content">
      {% if section.settings.eyebrow != blank %}
        <p class="repair-tracker__eyebrow">
          {{ section.settings.eyebrow }}
        </p>
      {% endif %}

      <h1>{{ section.settings.heading }}</h1>

      {% if section.settings.description != blank %}
        <p>{{ section.settings.description }}</p>
      {% endif %}
    </div>

    <div class="repair-tracker__search-card">
      <div class="repair-tracker__search-heading">
        <div>
          <span>Secure repair lookup</span>
          <strong>Track your service journey</strong>
        </div>

        <span class="repair-tracker__secure-badge">
          Verified access
        </span>
      </div>

      <form class="repair-tracker__form" data-repair-form>
        <div class="repair-tracker__field">
          <label for="RepairId-{{ section.id }}">
            Repair tracking ID
          </label>

          <input
            id="RepairId-{{ section.id }}"
            type="text"
            name="repair_id"
            placeholder="{{ section.settings.placeholder }}"
            autocomplete="off"
            spellcheck="false"
            maxlength="32"
            required
            data-repair-id
          >
        </div>

        <div class="repair-tracker__field">
          <label for="RepairPhone-{{ section.id }}">
            Registered phone last 4 digits
          </label>

          <input
            id="RepairPhone-{{ section.id }}"
            type="text"
            name="phone_last4"
            placeholder="5588"
            inputmode="numeric"
            pattern="[0-9]{4}"
            maxlength="4"
            autocomplete="off"
            required
            data-repair-phone
          >
        </div>

        <button type="submit">
          <span data-track-button-text>Track repair</span>
          <span aria-hidden="true">→</span>
        </button>
      </form>

      <p class="repair-tracker__helper">
        {{ section.settings.helper_text }}
      </p>
    </div>
  </div>

  <div class="repair-tracker__content">
    <div class="repair-tracker__empty" data-repair-empty>
      <span class="repair-tracker__empty-icon" aria-hidden="true">⌚</span>
      <strong>Enter your repair details</strong>
      <p>
        Use the Repair ID and the last four digits of the registered
        mobile number to view the latest update.
      </p>
    </div>

    <div class="repair-tracker__loading" data-repair-loading hidden>
      <span></span>
      <strong>Checking repair status</strong>
      <p>Please wait while we verify your repair details.</p>
    </div>

    <div class="repair-tracker__error" data-repair-error hidden>
      <span aria-hidden="true">!</span>
      <strong>We could not verify those details.</strong>
      <p data-repair-error-message>
        Check the Repair ID and phone digits, then try again or contact
        the service centre.
      </p>
    </div>

    <div class="repair-tracker__error" data-repair-archived hidden>
      <span aria-hidden="true">!</span>
      <strong>This repair record has been archived.</strong>
      <p>
        This job was completed some time ago and its online tracking has
        been closed. For any questions, please contact the service centre.
      </p>
    </div>

    <div class="repair-tracker__result" data-repair-result hidden>
      <div class="repair-tracker__topbar">
        <div>
          <p class="repair-tracker__kicker">Service record</p>
          <h2 data-watch-name>Seiko Presage</h2>
          <p data-watch-details>Automatic • Stainless steel • 40.5mm</p>
        </div>

        <div class="repair-tracker__status-card">
          <span>Current status</span>
          <strong data-current-status>Repair in progress</strong>
          <small data-estimated-date>
            Promised by: 31 July 2026
          </small>
        </div>
      </div>

      <div class="repair-tracker__summary-grid">
        <div>
          <span>Repair ID</span>
          <strong data-repair-id-display>SWR-WEB-260804-1048</strong>
        </div>

        <div>
          <span>Intake date</span>
          <strong data-intake-date>4 August 2026</strong>
        </div>

        <div>
          <span>Reference / SKU</span>
          <strong data-reference-sku>—</strong>
        </div>

        <div>
          <span>Current location</span>
          <strong data-store-name>Krishna Nagar</strong>
        </div>

        <div>
          <span>Last updated</span>
          <strong data-last-updated>4 August 2026, 4:20 PM</strong>
        </div>

        <div>
          <span>Service type</span>
          <strong data-service-type>Estimate pending</strong>
        </div>
      </div>

      <div class="repair-tracker__timeline-wrap">
        <div class="repair-tracker__section-heading">
          <div>
            <p class="repair-tracker__kicker">Repair progress</p>
            <h3>Every stage, clearly tracked</h3>
          </div>

          <span data-progress-copy>Stage 4 of 8</span>
        </div>

        <div class="repair-tracker__progress" data-progress-list></div>
      </div>

      <div class="repair-tracker__detail-grid">
        <article class="repair-tracker__card">
          <p class="repair-tracker__kicker">Latest update</p>
          <h3 data-latest-title>Movement servicing underway</h3>
          <p data-latest-note>
            Movement dismantled and parts inspection completed.
          </p>
        </article>

        <article class="repair-tracker__card">
          <p class="repair-tracker__kicker">Service details</p>

          <dl>
            <div>
              <dt>Condition on arrival</dt>
              <dd data-issue>Low power reserve</dd>
            </div>

            <div>
              <dt>Accessories received</dt>
              <dd data-work>
                Movement service and gasket replacement
              </dd>
            </div>
          </dl>
        </article>

        <article class="repair-tracker__card repair-tracker__history-card">
          <p class="repair-tracker__kicker">Update history</p>
          <h3>Staff-logged updates</h3>
          <ul class="repair-tracker__history-list" data-history-list></ul>
        </article>

        <article class="repair-tracker__card repair-tracker__estimate-card">
          <p class="repair-tracker__kicker">Estimate & payment</p>

          <div class="repair-tracker__estimate-row">
            <span>Estimated amount</span>
            <strong data-estimate-amount>₹4,500</strong>
          </div>

          <div class="repair-tracker__estimate-row">
            <span>Approval</span>
            <strong data-approval-status>Approved</strong>
          </div>

          <div class="repair-tracker__estimate-row">
            <span>Payment</span>
            <strong data-payment-detail>₹1,000 deposit received</strong>
          </div>

          <div class="repair-tracker__decision" data-decision-panel hidden>
            <p class="repair-tracker__decision-copy">
              Let us know how you'd like to proceed with this repair.
            </p>
            <div class="repair-tracker__decision-actions">
              <button type="button" class="repair-tracker__decision-approve" data-decision-approve>
                Approve &amp; pay <span data-decision-amount>₹0</span>
              </button>
              <button type="button" class="repair-tracker__decision-decline" data-decision-decline>
                Don't repair
              </button>
            </div>
            <p class="repair-tracker__decision-error" data-decision-error hidden></p>
          </div>

          <div class="repair-tracker__decision-result" data-decision-result hidden></div>
        </article>

        <article class="repair-tracker__card">
          <p class="repair-tracker__kicker">Service contact</p>

          <h3>Our service centre</h3>
          <p>
            For assistance, contact our service team during business hours.
          </p>

          {% if section.settings.support_link != blank %}
            <a href="{{ section.settings.support_link }}">
              Contact service centre →
            </a>
          {% endif %}
        </article>
      </div>

      <div class="repair-tracker__privacy-note">
        <strong>Privacy protected</strong>
        <span>
          Only customer-safe service information is shown. Internal notes,
          full contact details and technician records remain private.
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  .repair-tracker--{{ section.id }} {
    --bg: rgb(var(--color-canvas));
    --surface: rgb(var(--color-surface));
    --text: rgb(var(--color-ink));
    --muted: rgb(var(--color-ink-muted));
    --accent: rgb(var(--color-gold));
    --line: var(--color-border);

    background: var(--bg);
    color: var(--text);
  }

  .repair-tracker--{{ section.id }} *,
  .repair-tracker--{{ section.id }} *::before,
  .repair-tracker--{{ section.id }} *::after {
    box-sizing: border-box;
  }

  .repair-tracker--{{ section.id }} .repair-tracker__hero {
    position: relative;
    min-height: 470px;
    padding: 76px 24px 150px;
    overflow: hidden;
    text-align: center;
    background: rgb(var(--color-ink-deep));
  }

  .repair-tracker--{{ section.id }} .repair-tracker__hero-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .repair-tracker--{{ section.id }} .repair-tracker__hero-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        rgba(8, 7, 6, 0.42),
        rgba(8, 7, 6, 0.8)
      ),
      radial-gradient(
        circle at 50% 34%,
        rgba(255, 255, 255, 0.09),
        transparent 42%
      );
  }

  .repair-tracker--{{ section.id }} .repair-tracker__hero-content {
    position: relative;
    z-index: 2;
    width: min(100%, 780px);
    margin: 0 auto;
    color: #fff;
  }

  .repair-tracker--{{ section.id }} .repair-tracker__eyebrow,
  .repair-tracker--{{ section.id }} .repair-tracker__kicker {
    margin: 0 0 10px;
    color: var(--accent);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2.1px;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .repair-tracker--{{ section.id }} .repair-tracker__hero-content h1 {
    margin: 0;
    color: #fff;
    font-family: var(--font-heading-family);
    font-size: clamp(46px, 5.8vw, 74px);
    font-weight: 400;
    letter-spacing: -1px;
    line-height: 0.98;
  }

  .repair-tracker--{{ section.id }}
    .repair-tracker__hero-content
    > p:last-child {
    max-width: 660px;
    margin: 18px auto 0;
    color: rgba(255, 255, 255, 0.8);
    font-size: 15px;
    line-height: 1.7;
  }

  .repair-tracker--{{ section.id }} .repair-tracker__search-card {
    position: absolute;
    z-index: 1;
    right: 24px;
    bottom: 34px;
    left: 24px;
    width: min(calc(100% - 48px), 980px);
    margin: 0 auto;
    padding: 24px;
    text-align: left;
    background: rgba(255, 255, 255, 0.96);
    border: 1px solid rgba(255, 255, 255, 0.72);
    box-shadow: 0 22px 65px rgba(0, 0, 0, 0.22);
    backdrop-filter: blur(18px);
  }

  .repair-tracker--{{ section.id }} .repair-tracker__search-heading {
    display: flex;
    margin-bottom: 17px;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .repair-tracker--{{ section.id }}
    .repair-tracker__search-heading
    span,
  .repair-tracker--{{ section.id }}
    .repair-tracker__search-heading
    strong {
    display: block;
  }

  .repair-tracker--{{ section.id }}
    .repair-tracker__search-heading
    > div
    > span {
    color: var(--accent);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  .repair-tracker--{{ section.id }}
    .repair-tracker__search-heading
    strong {
    margin-top: 4px;
    font-family: var(--font-heading-family);
    font-size: 21px;
    font-weight: 400;
  }

  .repair-tracker--{{ section.id }} .repair-tracker__secure-badge {
    padding: 8px 11px;
    color: rgb(var(--color-success));
    background: rgba(var(--color-success), 0.1);
    border: 1px solid rgba(var(--color-success), 0.18);
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .repair-tracker--{{ section.id }} .repair-tracker__form {
    display: grid;
    grid-template-columns: 1.35fr 0.85fr auto;
    align-items: end;
    gap: 12px;
  }

  .repair-tracker--{{ section.id }} .repair-tracker__field label {
    display: block;
    margin-bottom: 8px;
    color: var(--text);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 1.2px;
    text-transform: uppercase;
  }

  .repair-tracker--{{ section.id }} .repair-tracker__field input {
    width: 100%;
    min-height: 52px;
    padding: 0 15px;
    color: var(--text);
    background: #fff;
    border: 1px solid rgba(23, 21, 19, 0.16);
    border-radius: 0;
    font: inherit;
    font-size: 14px;
  }

  .repair-tracker--{{ section.id }}
    .repair-tracker__field:first-child
    input {
    text-transform: uppercase;
  }

  .repair-tracker--{{ section.id }} .repair-tracker__field input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 2px rgba(152, 120, 70, 0.12);
  }

  .repair-tracker--{{ section.id }} .repair-tracker__form button {
    min-height: 52px;
    padding: 0 22px;
    color: #fff;
    background: var(--text);
    border: 0;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    cursor: pointer;
  }

  .repair-tracker--{{ section.id }}
    .repair-tracker__form
    button:hover {
    background: var(--accent);
  }

  .repair-tracker--{{ section.id }}
    .repair-tracker__form
    button:disabled {
    opacity: 0.65;
    cursor: wait;
  }

  .repair-tracker--{{ section.id }} .repair-tracker__helper {
    margin: 10px 0 0;
    color: var(--muted);
    font-size: 11px;
    line-height: 1.5;
  }

  .repair-tracker--{{ section.id }} .repair-tracker__content {
    width: min(100% - 48px, 1320px);
    margin: 0 auto;
    padding: 64px 0 90px;
  }

  .repair-tracker--{{ section.id }} .repair-tracker__empty,
  .repair-tracker--{{ section.id }} .repair-tracker__loading,
  .repair-tracker--{{ section.id }} .repair-tracker__error {
    padding: 72px 24px;
    text-align: center;
    background: var(--surface);
    border: 1px solid rgba(23, 21, 19, 0.08);
  }

  .repair-tracker--{{ section.id }}
    .repair-tracker__empty-icon {
    display: block;
    margin-bottom: 14px;
    font-size: 32px;
  }

  .repair-tracker--{{ section.id }} .repair-tracker__empty strong,
  .repair-tracker--{{ section.id }} .repair-tracker__loading strong,
  .repair-tracker--{{ section.id }} .repair-tracker__error strong {
    display: block;
    font-family: var(--font-heading-family);
    font-size: 25px;
    font-weight: 400;
  }

  .repair-tracker--{{ section.id }} .repair-tracker__empty p,
  .repair-tracker--{{ section.id }} .repair-tracker__loading p,
  .repair-tracker--{{ section.id }} .repair-tracker__error p {
    max-width: 560px;
    margin: 10px auto 0;
    color: var(--muted);
    line-height: 1.65;
  }

  .repair-tracker--{{ section.id }} .repair-tracker__loading > span {
    display: inline-block;
    width: 28px;
    height: 28px;
    margin-bottom: 14px;
    border: 2px solid rgba(23, 21, 19, 0.18);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: repair-spin 0.8s linear infinite;
  }

  .repair-tracker--{{ section.id }} .repair-tracker__error > span {
    display: inline-grid;
    width: 34px;
    height: 34px;
    margin-bottom: 14px;
    place-items: center;
    color: #fff;
    background: rgb(var(--color-error));
    border-radius: 50%;
    font-weight: 700;
  }

  .repair-tracker--{{ section.id }} .repair-tracker__result {
    padding: 42px;
    background: var(--surface);
    border: 1px solid rgba(23, 21, 19, 0.08);
  }

  .repair-tracker--{{ section.id }} .repair-tracker__topbar {
    display: flex;
    padding-bottom: 30px;
    align-items: flex-start;
    justify-content: space-between;
    gap: 32px;
    border-bottom: 1px solid var(--line);
  }

  .repair-tracker--{{ section.id }} .repair-tracker__topbar h2 {
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: clamp(34px, 4vw, 48px);
    font-weight: 400;
    line-height: 1.02;
  }

  .repair-tracker--{{ section.id }}
    .repair-tracker__topbar
    > div:first-child
    > p:last-child {
    margin: 10px 0 0;
    color: var(--muted);
    font-size: 14px;
  }

  .repair-tracker--{{ section.id }} .repair-tracker__status-card {
    min-width: 290px;
    padding: 19px 21px;
    background: #fff;
    border-left: 3px solid var(--accent);
  }

  .repair-tracker--{{ section.id }} .repair-tracker__status-card span,
  .repair-tracker--{{ section.id }} .repair-tracker__status-card strong,
  .repair-tracker--{{ section.id }} .repair-tracker__status-card small {
    display: block;
  }

  .repair-tracker--{{ section.id }} .repair-tracker__status-card span {
    color: var(--accent);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 1.4px;
    text-transform: uppercase;
  }

  .repair-tracker--{{ section.id }} .repair-tracker__status-card strong {
    margin-top: 7px;
    font-family: var(--font-heading-family);
    font-size: 22px;
    font-weight: 400;
  }

  .repair-tracker--{{ section.id }} .repair-tracker__status-card small {
    margin-top: 7px;
    color: var(--muted);
    font-size: 11px;
  }

  .repair-tracker--{{ section.id }} .repair-tracker__summary-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: 26px;
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .repair-tracker--{{ section.id }}
    .repair-tracker__summary-grid
    > div {
    padding: 18px;
    background: #fff;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .repair-tracker--{{ section.id }}
    .repair-tracker__summary-grid
    span,
  .repair-tracker--{{ section.id }}
    .repair-tracker__summary-grid
    strong {
    display: block;
  }

  .repair-tracker--{{ section.id }}
    .repair-tracker__summary-grid
    span {
    color: var(--muted);
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 1.1px;
    text-transform: uppercase;
  }

  .repair-tracker--{{ section.id }}
    .repair-tracker__summary-grid
    strong {
    margin-top: 7px;
    font-size: 12px;
  }

  .repair-tracker--{{ section.id }} .repair-tracker__timeline-wrap {
    margin-top: 44px;
  }

  .repair-tracker--{{ section.id }} .repair-tracker__section-heading {
    display: flex;
    margin-bottom: 28px;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
  }

  .repair-tracker--{{ section.id }}
    .repair-tracker__section-heading
    h3 {
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: 28px;
    font-weight: 400;
  }

  .repair-tracker--{{ section.id }}
    .repair-tracker__section-heading
    > span {
    color: var(--muted);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .repair-tracker--{{ section.id }} .repair-tracker__progress {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
  }

  .repair-tracker--{{ section.id }} .repair-step {
    position: relative;
    text-align: center;
  }

  .repair-tracker--{{ section.id }} .repair-step::before {
    content: "";
    position: absolute;
    top: 11px;
    right: 50%;
    left: -50%;
    height: 1px;
    background: rgba(23, 21, 19, 0.16);
  }

  .repair-tracker--{{ section.id }} .repair-step:first-child::before {
    display: none;
  }

  .repair-tracker--{{ section.id }} .repair-step__dot {
    position: relative;
    z-index: 2;
    display: inline-flex;
    width: 23px;
    height: 23px;
    align-items: center;
    justify-content: center;
    background: var(--surface);
    border: 1px solid rgba(23, 21, 19, 0.28);
    border-radius: 50%;
    font-size: 10px;
  }

  .repair-tracker--{{ section.id }}
    .repair-step.is-complete
    .repair-step__dot,
  .repair-tracker--{{ section.id }}
    .repair-step.is-current
    .repair-step__dot {
    color: #fff;
    background: var(--accent);
    border-color: var(--accent);
  }

  .repair-tracker--{{ section.id }}
    .repair-step.is-current
    .repair-step__dot {
    box-shadow: 0 0 0 6px rgba(152, 120, 70, 0.12);
  }

  .repair-tracker--{{ section.id }} .repair-step__label {
    display: block;
    margin-top: 11px;
    color: var(--muted);
    font-size: 9px;
    line-height: 1.35;
  }

  .repair-tracker--{{ section.id }}
    .repair-step.is-complete
    .repair-step__label,
  .repair-tracker--{{ section.id }}
    .repair-step.is-current
    .repair-step__label {
    color: var(--text);
  }

  .repair-tracker--{{ section.id }} .repair-tracker__detail-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    margin-top: 46px;
    gap: 18px;
  }

  .repair-tracker--{{ section.id }} .repair-tracker__card {
    padding: 28px;
    background: #fff;
    border: 1px solid rgba(23, 21, 19, 0.08);
  }

  .repair-tracker--{{ section.id }} .repair-tracker__card h3 {
