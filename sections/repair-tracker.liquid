<script>
  (() => {
    const section = document.getElementById(
      'RepairTracker-{{ section.id }}'
    );

    if (!section || section.dataset.initialised === 'true') return;
    section.dataset.initialised = 'true';

    const form = section.querySelector('[data-repair-form]');
    const idInput = section.querySelector('[data-repair-id]');
    const phoneInput = section.querySelector('[data-repair-phone]');
    const emptyState = section.querySelector('[data-repair-empty]');
    const loadingState = section.querySelector('[data-repair-loading]');
    const errorState = section.querySelector('[data-repair-error]');
    const errorMessage = section.querySelector('[data-repair-error-message]');
    const archivedState = section.querySelector('[data-repair-archived]');
    const resultState = section.querySelector('[data-repair-result]');
    const progressList = section.querySelector('[data-progress-list]');
    const historyList = section.querySelector('[data-history-list]');
    const button = form?.querySelector('button[type="submit"]');
    const buttonText = section.querySelector('[data-track-button-text]');
    const decisionPanel = section.querySelector('[data-decision-panel]');
    const decisionAmount = section.querySelector('[data-decision-amount]');
    const decisionApproveButton = section.querySelector('[data-decision-approve]');
    const decisionDeclineButton = section.querySelector('[data-decision-decline]');
    const decisionError = section.querySelector('[data-decision-error]');
    const decisionResult = section.querySelector('[data-decision-result]');

    if (!form || !idInput || !phoneInput || !resultState) return;

    /*
      LIVE DATA WIRING.

      This looks up the `sethi_repair_job` metaobject (Storefront access:
      PUBLIC_READ) directly from the browser via Shopify's Storefront
      GraphQL API. This is the correct, supported way for a theme to read
      public metaobject data client-side — no backend/app-proxy needed for
      reads. It requires a Storefront API "public" access token, which
      Shopify explicitly designs to be safe to expose in client-side code
      (unlike Admin API tokens). See the section settings for how to obtain
      one: Shopify Admin > Settings > Apps and sales channels > Develop
      apps > create an app > enable Storefront API access (with metaobject
      read access) > install > copy the Storefront API access token.

      If the token setting below is left blank, every lookup will fail and
      a console error will explain why — this is intentional so failures
      are visible to whoever is testing, rather than silently broken.
    */
    const SHOP_DOMAIN = {{ shop.permanent_domain | json }};
    const STOREFRONT_ACCESS_TOKEN = {{ section.settings.storefront_access_token | json }};
    const STOREFRONT_API_VERSION = {{ section.settings.storefront_api_version | json }};
    const METAOBJECT_TYPE = 'sethi_repair_job';

    const REPAIR_JOB_QUERY = `
      query RepairJobLookup($handle: String!) {
        metaobject(handle: { type: "${METAOBJECT_TYPE}", handle: $handle }) {
          handle
          updatedAt
          fields {
            key
            value
          }
        }
      }
    `;

    /*
      The 13 fixed values configured on the live "status" field, in the
      order staff can pick them in Shopify Admin, mapped onto the 8
      positions of the existing progress bar below. "Cancelled" and
      "Returned unrepaired" are terminal/abnormal exits rather than forward
      progress, so their step position is a judgement call (see report) —
      the status text itself (shown verbatim above the timeline) is the
      authoritative signal, the stepper is only a supporting visual.
    */
    const STATUS_STEP_MAP = {
      'Received at counter': 0,
      'Inspected & quoted': 2,
      'Awaiting customer approval': 3,
      'Awaiting parts': 5,
      'In workshop': 4,
      'Sent to brand service centre': 4,
      'Returned from service centre': 5,
      'Final quality check': 6,
      'Ready for collection': 7,
      'Collected in store': 7,
      'Delivered by courier': 7,
      'Cancelled': 3,
      'Returned unrepaired': 5
    };

    /* The 4 terminal / closed statuses out of the 13 fixed choices. */
    const TERMINAL_STATUSES = new Set([
      'Collected in store',
      'Delivered by courier',
      'Cancelled',
      'Returned unrepaired'
    ]);

    const ARCHIVE_AFTER_DAYS = 30;

    const steps = [
      'Received',
      'Under review',
      'Inspected & quoted',
      'Awaiting approval',
      'In progress',
      'Finishing up',
      'Quality check',
      'Ready'
    ];

    /*
      SOFT, CLIENT-SIDE-ONLY RATE LIMIT.
      This is a speed bump, not real protection — sessionStorage and JS can
      both be cleared/bypassed trivially (incognito, dev tools, disabling
      JS execution of this check, etc). Genuine rate-limiting has to happen
      server-side, which this project does not have yet. Do not describe
      this to customers as a security measure.
    */
    const RATE_LIMIT_KEY = 'sethiRepairTrackerAttempts';
    const RATE_LIMIT_WINDOW_MS = 10 * 60 * 1000;
    const RATE_LIMIT_MAX_ATTEMPTS = 5;
    const COOLDOWN_MS = 4000;
    const GENERIC_ERROR_TEXT =
      'Check the Repair ID and phone digits, then try again or contact the service centre.';
    const RATE_LIMIT_TEXT =
      'Too many attempts. Please wait a few minutes before trying again, or contact the service centre for help.';

    const getRecentAttempts = () => {
      try {
        const raw = window.sessionStorage.getItem(RATE_LIMIT_KEY);
        const list = raw ? JSON.parse(raw) : [];
        const cutoff = Date.now() - RATE_LIMIT_WINDOW_MS;
        return Array.isArray(list) ? list.filter((t) => typeof t === 'number' && t > cutoff) : [];
      } catch (err) {
        return [];
      }
    };

    const recordAttempt = () => {
      try {
        const attempts = getRecentAttempts();
        attempts.push(Date.now());
        window.sessionStorage.setItem(RATE_LIMIT_KEY, JSON.stringify(attempts));
      } catch (err) {
        /* sessionStorage unavailable (private mode, blocked storage, etc). */
      }
    };

    const isRateLimited = () => getRecentAttempts().length >= RATE_LIMIT_MAX_ATTEMPTS;

    const setText = (selector, value) => {
      const element = section.querySelector(selector);
      if (element) element.textContent = value || '—';
    };

    const formatDate = (value) => {
      if (!value) return '';
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return '';
      return date.toLocaleDateString('en-IN', {
        day: 'numeric',
        month: 'long',
        year: 'numeric'
      });
    };

    const formatDateTime = (value) => {
      if (!value) return '';
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return '';
      return (
        date.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' }) +
        ', ' +
        date.toLocaleTimeString('en-IN', { hour: 'numeric', minute: '2-digit' })
      );
    };

    const formatINR = (value) => {
      const num = parseFloat(value);
      if (Number.isNaN(num)) return '';
      return '₹' + num.toLocaleString('en-IN', { maximumFractionDigits: 0 });
    };

    const fieldsToObject = (metaobject) => {
      const map = {};
      if (metaobject && Array.isArray(metaobject.fields)) {
        metaobject.fields.forEach((field) => {
          map[field.key] = field.value;
        });
      }
      return map;
    };

    const isArchived = (fields) => {
      if (!TERMINAL_STATUSES.has(fields.status)) return false;

      const promisedBy = fields.promised_by_date ? new Date(fields.promised_by_date) : null;
      if (!promisedBy || Number.isNaN(promisedBy.getTime())) return false;

      const diffDays = (Date.now() - promisedBy.getTime()) / (1000 * 60 * 60 * 24);
      return diffDays > ARCHIVE_AFTER_DAYS;
    };

    const fetchRepairJob = async (handle) => {
      const endpoint = `https://${SHOP_DOMAIN}/api/${STOREFRONT_API_VERSION}/graphql.json`;

      const response = await fetch(endpoint, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-Shopify-Storefront-Access-Token': STOREFRONT_ACCESS_TOKEN || ''
        },
        body: JSON.stringify({
          query: REPAIR_JOB_QUERY,
          variables: { handle }
        })
      });

      if (!response.ok) {
        throw new Error('Storefront API request failed with status ' + response.status);
      }

      const payload = await response.json();

      if (payload.errors && payload.errors.length) {
        throw new Error(payload.errors[0].message || 'Storefront API returned an error');
      }

      return payload.data ? payload.data.metaobject : null;
    };

    /*
      APPROVAL & PAYMENT — BACKEND CONTRACT

      Everything below talks to a backend service at PAYMENT_API_BASE_URL
      (this section's settings -> "Payment backend base URL"). That
      service does not exist yet — this is the exact contract it needs to
      implement. Neither endpoint can run safely without it: writing
      payment_status / customer_decision back to the repair job needs the
      Shopify Admin API, which can't be exposed to the browser. Until the
      URL setting is filled in, the buttons below show a "contact us"
      message instead of pretending to work.

      Payment itself goes through the store's own Shopify checkout (which
      already has Razorpay, cards, etc. configured) via a Draft Order —
      not a custom Razorpay integration. See "Approve & pay" below.

      POST {base}/decision
        Body:    { handle, decision: 'declined' }
        Does:    Sets customer_decision = "Declined" and
                 customer_decision_at = now on the sethi_repair_job
                 metaobject matching `handle`.
        Returns: { ok: true } or { ok: false, error }

      POST {base}/create-order
        Body:    { handle, amount }
        Does:    Re-reads the repair job's own estimated_cost server-side
                 and uses THAT amount, not the one the browser sent, then
                 creates a Shopify Draft Order for it and returns its
                 checkout URL. The browser then navigates there — a real
                 Shopify checkout page, same as any other purchase.
        Returns: { ok: true, checkout_url } or { ok: false, error }

      Payment confirmation is NOT a client-side callback from this flow —
      the backend listens for Shopify's own orders/paid webhook and marks
      the repair job paid from that, which is the only trustworthy signal.
      That means after redirecting to checkout, this page has no more
      work to do; the customer can look the repair up again afterwards to
      see the updated status.
    */
    const PAYMENT_API_BASE_URL = {{ section.settings.payment_api_base_url | json }};
    const PAYMENT_UNAVAILABLE_TEXT =
      "Online approval isn't available yet — please contact the service centre to confirm.";

    let currentJob = null;

    const showDecisionError = (text) => {
      if (!decisionError) return;
      decisionError.textContent = text || '';
      decisionError.hidden = !text;
    };

    const setDecisionButtonsBusy = (isBusy) => {
      if (decisionApproveButton) decisionApproveButton.disabled = isBusy;
      if (decisionDeclineButton) decisionDeclineButton.disabled = isBusy;
    };

    const showDecisionResult = (state, text) => {
      if (decisionPanel) decisionPanel.hidden = true;
      if (!decisionResult) return;
      decisionResult.hidden = false;
      decisionResult.dataset.state = state;
      decisionResult.textContent = text;
    };

    const renderDecisionState = (handle, fields) => {
      if (!decisionPanel || !decisionResult) return;

      const estimatedCost = parseFloat(fields.estimated_cost);
      const decision = (fields.customer_decision || '').toLowerCase();
      const paymentStatus = (fields.payment_status || '').toLowerCase();
      const isWarranty = fields.warranty_or_paid === 'Warranty';

      if (paymentStatus === 'paid' || decision === 'approved') {
        showDecisionResult(
          'approved',
          fields.customer_decision_at
            ? `Approved and paid on ${formatDate(fields.customer_decision_at)}.`
            : 'Approved and paid — thank you.'
        );
        return;
      }

      if (decision === 'declined') {
        showDecisionResult(
          'declined',
          fields.customer_decision_at
            ? `You declined this repair on ${formatDate(fields.customer_decision_at)}. Contact the service centre if you've changed your mind.`
            : "You declined this repair. Contact the service centre if you've changed your mind."
        );
        return;
      }

      if (isWarranty || !(estimatedCost > 0)) {
        decisionPanel.hidden = true;
        decisionResult.hidden = true;
        return;
      }

      decisionResult.hidden = true;
      decisionPanel.hidden = false;
      showDecisionError('');
      setDecisionButtonsBusy(false);
      if (decisionAmount) decisionAmount.textContent = formatINR(estimatedCost);
      currentJob = { handle, amount: estimatedCost };
    };

    if (decisionDeclineButton) {
      decisionDeclineButton.addEventListener('click', async () => {
        if (!currentJob?.handle) return;
        if (!window.confirm("Confirm you don't want this repair done? The watch can be collected unrepaired.")) return;

        if (!PAYMENT_API_BASE_URL) {
          showDecisionError(PAYMENT_UNAVAILABLE_TEXT);
          return;
        }

        setDecisionButtonsBusy(true);
        showDecisionError('');

        try {
          const response = await fetch(`${PAYMENT_API_BASE_URL.replace(/\/$/, '')}/decision`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ handle: currentJob.handle, decision: 'declined' })
          });
          const data = await response.json();
          if (!response.ok || !data.ok) throw new Error(data.error || 'Request failed');
          showDecisionResult(
            'declined',
            "Noted — you don't want this repair done. Contact the service centre if you've changed your mind."
          );
        } catch (err) {
          console.error('[repair-tracker] decision (decline) failed:', err);
          showDecisionError('Something went wrong recording your decision. Please try again or contact the service centre.');
          setDecisionButtonsBusy(false);
        }
      });
    }

    if (decisionApproveButton) {
      decisionApproveButton.addEventListener('click', async () => {
        if (!currentJob?.handle || !(currentJob.amount > 0)) return;

        if (!PAYMENT_API_BASE_URL) {
          showDecisionError(PAYMENT_UNAVAILABLE_TEXT);
          return;
        }

        setDecisionButtonsBusy(true);
        showDecisionError('');

        try {
          const base = PAYMENT_API_BASE_URL.replace(/\/$/, '');
          const orderResponse = await fetch(`${base}/create-order`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ handle: currentJob.handle, amount: currentJob.amount })
          });
          const orderData = await orderResponse.json();
          if (!orderResponse.ok || !orderData.ok) throw new Error(orderData.error || 'Could not start payment');
          if (!orderData.checkout_url) throw new Error('No checkout link was returned');

          /*
            Full-page navigation to a real Shopify checkout — the same
            checkout your regular product purchases use, with whatever
            payment methods the store already has configured. Payment
            confirmation happens via a Shopify webhook server-side, not
            a callback here, so there's nothing further to do on this
            page once the customer completes checkout.
          */
          window.location.href = orderData.checkout_url;
        } catch (err) {
          console.error('[repair-tracker] approve & pay failed:', err);
          showDecisionError('Something went wrong starting the payment. Please try again or contact the service centre.');
          setDecisionButtonsBusy(false);
        }
      });
    }

    const renderProgress = (currentStep) => {
      progressList.innerHTML = '';

      steps.forEach((label, index) => {
        const step = document.createElement('div');
        step.className = 'repair-step';

        if (index < currentStep) {
          step.classList.add('is-complete');
        }

        if (index === currentStep) {
          step.classList.add('is-current');
        }

        step.innerHTML = `
          <span class="repair-step__dot">
            ${index < currentStep ? '✓' : ''}
          </span>
          <span class="repair-step__label">${label}</span>
        `;

        progressList.appendChild(step);
      });

      setText(
        '[data-progress-copy]',
        `Stage ${Math.min(currentStep + 1, steps.length)} of ${steps.length}`
      );
    };

    const renderHistory = (rawLog) => {
      historyList.innerHTML = '';

      const lines = (rawLog || '')
        .split('\n')
        .map((line) => line.trim())
        .filter((line) => line.length > 0);

      if (!lines.length) {
        const empty = document.createElement('li');
        empty.className = 'repair-tracker__history-empty';
        empty.textContent = 'No staff updates have been logged yet.';
        historyList.appendChild(empty);
        return;
      }

      lines.forEach((line) => {
        const item = document.createElement('li');
        item.textContent = line;
        historyList.appendChild(item);
      });
    };

    const showState = (state) => {
      emptyState.hidden = state !== 'empty';
      loadingState.hidden = state !== 'loading';
      errorState.hidden = state !== 'error';
      if (archivedState) archivedState.hidden = state !== 'archived';
      resultState.hidden = state !== 'result';
    };

    const showError = (message) => {
      if (errorMessage) errorMessage.textContent = message;
      showState('error');
    };

    const renderRecord = (displayRepairId, fields, updatedAt) => {
      const watchName = `${fields.brand || ''} ${fields.model || ''}`.trim();
      const currentStep = STATUS_STEP_MAP[fields.status] ?? 0;

      setText('[data-repair-id-display]', displayRepairId);
      setText('[data-watch-name]', watchName);
      setText(
        '[data-watch-details]',
        fields.reference_sku ? `Ref. ${fields.reference_sku}` : ''
      );
      setText('[data-intake-date]', formatDate(fields.intake_date));
      setText('[data-reference-sku]', fields.reference_sku);
      setText('[data-store-name]', fields.current_location);
      setText('[data-last-updated]', formatDateTime(updatedAt));
      setText('[data-service-type]', fields.warranty_or_paid);
      setText('[data-current-status]', fields.status);
      setText(
        '[data-estimated-date]',
        fields.promised_by_date
          ? `Promised by: ${formatDate(fields.promised_by_date)}`
          : 'Promised-by date not yet set'
      );
      setText('[data-latest-title]', fields.latest_update_note);
      setText(
        '[data-latest-note]',
        fields.customer_facing_summary || 'No additional details have been shared yet.'
      );
      setText('[data-issue]', fields.condition_on_arrival);
      setText('[data-work]', fields.accessories_received);
      setText('[data-estimate-amount]', formatINR(fields.estimated_cost));

      const approvedCost = parseFloat(fields.approved_cost);
      setText(
        '[data-approval-status]',
        approvedCost > 0 ? 'Approved' : 'Pending approval'
      );

      let paymentDetail = 'Awaiting cost estimate';
      if (fields.warranty_or_paid === 'Warranty') {
        paymentDetail = 'Covered under warranty — no charge.';
      } else if (approvedCost > 0) {
        paymentDetail = `${formatINR(fields.approved_cost)} approved`;
      } else if (parseFloat(fields.estimated_cost) > 0) {
        paymentDetail = `Estimate ${formatINR(fields.estimated_cost)} shared — awaiting approval`;
      }
      setText('[data-payment-detail]', paymentDetail);
      renderDecisionState(displayRepairId.toLowerCase(), fields);

      renderHistory(fields.status_history_log);
      renderProgress(currentStep);
      showState('result');

      resultState.scrollIntoView({
        behavior: 'smooth',
        block: 'start'
      });
    };

    const setSubmitting = (isSubmitting) => {
      if (button) button.disabled = isSubmitting;
      if (buttonText) buttonText.textContent = isSubmitting ? 'Checking' : 'Track repair';
    };

    const startCooldown = () => {
      if (!button) return;
      button.disabled = true;
      window.setTimeout(() => {
        button.disabled = false;
      }, COOLDOWN_MS);
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      if (isRateLimited()) {
        showError(RATE_LIMIT_TEXT);
        startCooldown();
        return;
      }

      recordAttempt();

      const displayRepairId = idInput.value.trim().toUpperCase();
      const handle = idInput.value.trim().toLowerCase();
      const phoneLast4 = phoneInput.value.trim();

      showState('loading');
      setSubmitting(true);

      let metaobject = null;

      try {
        metaobject = await fetchRepairJob(handle);
      } catch (err) {
        /*
          Logged so a broken/missing Storefront API token is visible in
          the console during setup/QA rather than failing silently.
        */
        console.error('[repair-tracker] Storefront API lookup failed:', err);
        metaobject = null;
      }

      const fields = fieldsToObject(metaobject);
      const verified =
        !!metaobject &&
        !!fields.contact_phone_last4 &&
        fields.contact_phone_last4 === phoneLast4;

      if (!verified) {
        /*
          Deliberately the same generic message whether the job does not
          exist or the phone digits were wrong, so the error state never
          reveals which part failed.
        */
        showError(GENERIC_ERROR_TEXT);
      } else if (isArchived(fields)) {
        showState('archived');
      } else {
        renderRecord(displayRepairId, fields, metaobject.updatedAt);
      }

      setSubmitting(false);
      startCooldown();
    });
  })();
</script>

