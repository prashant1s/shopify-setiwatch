</style>

<script>
  (() => {
    const section = document.getElementById(
      'RepairTracker-{{ section.id }}'
    );

    if (!section || section.dataset.initialised === 'true') return;
    section.dataset.initialised = 'true';

    const form = section.querySelector('[data-repair-form]');
    const idInput = section.querySelector('[data-repair-id]');
    const phoneInput = section.querySelector('[data-repair-phone]');
    const emptyState = section.querySelector('[data-repair-empty]');
    const loadingState = section.querySelector('[data-repair-loading]');
    const errorState = section.querySelector('[data-repair-error]');
    const resultState = section.querySelector('[data-repair-result]');
    const progressList = section.querySelector('[data-progress-list]');
    const button = form?.querySelector('button[type="submit"]');
    const buttonText = section.querySelector('[data-track-button-text]');

    if (!form || !idInput || !phoneInput || !resultState) return;

    /*
      DEMO DATA ONLY.
      Backend phase mein is object ko secure API request se replace karna hai.
    */
    const repairs = {
      'SWR-WEB-260804-1048': {
        phoneLast4: '5588',
        watchName: 'Seiko Presage Cocktail Time',
        watchDetails: 'Automatic • Stainless steel • 40.5mm',
        customerName: 'Aman Agarwal',
        bookingSource: 'Website',
        storeName: 'Krishna Nagar',
        currentStatus: 'Repair in progress',
        estimatedDate: 'Estimated completion: 12 August 2026',
        lastUpdated: '4 August 2026, 4:20 PM',
        paymentStatus: 'Part payment received',
        latestTitle: 'Movement servicing underway',
        latestNote:
          'Movement dismantled and parts inspection completed. Timing calibration is now in progress.',
        issue: 'Low power reserve and inconsistent timekeeping',
        work: 'Movement service, gasket replacement and calibration',
        warranty: '180 days after completion',
        estimateAmount: '₹4,500',
        approvalStatus: 'Approved',
        paymentDetail: '₹1,000 deposit received',
        serviceCentre: 'Krishna Nagar Service Centre',
        serviceContact:
          'Our service advisor will contact you if any additional work is required.',
        currentStep: 4
      },

      'SWR-N18-260804-1052': {
        phoneLast4: '2210',
        watchName: 'Citizen Eco-Drive',
        watchDetails: 'Solar • Stainless steel • 41mm',
        customerName: 'Demo Customer',
        bookingSource: 'Retail Store',
        storeName: 'Noida Sector 18',
        currentStatus: 'Quality check',
        estimatedDate: 'Estimated completion: 7 August 2026',
        lastUpdated: '4 August 2026, 5:05 PM',
        paymentStatus: 'Paid',
        latestTitle: 'Final testing in progress',
        latestNote:
          'Water resistance and timekeeping accuracy are being verified before release.',
        issue: 'Watch stopped charging',
        work: 'Cell replacement and circuit inspection',
        warranty: '90 days after completion',
        estimateAmount: '₹2,800',
        approvalStatus: 'Approved',
        paymentDetail: 'Payment completed',
        serviceCentre: 'Noida Sector 18 Service Centre',
        serviceContact:
          'The service team will notify you when the watch is ready for collection.',
        currentStep: 6
      }
    };

    const steps = [
      'Request received',
      'Verification',
      'Inspection',
      'Estimate approval',
      'Repair',
      'Parts / testing',
      'Quality check',
      'Ready'
    ];

    const setText = (selector, value) => {
      const element = section.querySelector(selector);
      if (element) element.textContent = value || '—';
    };

    const renderProgress = (currentStep) => {
      progressList.innerHTML = '';

      steps.forEach((label, index) => {
        const step = document.createElement('div');
        step.className = 'repair-step';

        if (index < currentStep) {
          step.classList.add('is-complete');
        }

        if (index === currentStep) {
          step.classList.add('is-current');
        }

        step.innerHTML = `
          <span class="repair-step__dot">
            ${index < currentStep ? '✓' : ''}
          </span>
          <span class="repair-step__label">${label}</span>
        `;

        progressList.appendChild(step);
      });

      setText(
        '[data-progress-copy]',
        `Stage ${Math.min(currentStep + 1, steps.length)} of ${steps.length}`
      );
    };

    const showState = (state) => {
      emptyState.hidden = state !== 'empty';
      loadingState.hidden = state !== 'loading';
      errorState.hidden = state !== 'error';
      resultState.hidden = state !== 'result';
    };

    const renderRecord = (repairId, record) => {
      setText('[data-repair-id]', repairId);
      setText('[data-watch-name]', record.watchName);
      setText('[data-watch-details]', record.watchDetails);
      setText('[data-customer-name]', record.customerName);
      setText('[data-booking-source]', record.bookingSource);
      setText('[data-store-name]', record.storeName);
      setText('[data-current-status]', record.currentStatus);
      setText('[data-estimated-date]', record.estimatedDate);
      setText('[data-last-updated]', record.lastUpdated);
      setText('[data-payment-status]', record.paymentStatus);
      setText('[data-latest-title]', record.latestTitle);
      setText('[data-latest-note]', record.latestNote);
      setText('[data-issue]', record.issue);
      setText('[data-work]', record.work);
      setText('[data-warranty]', record.warranty);
      setText('[data-estimate-amount]', record.estimateAmount);
      setText('[data-approval-status]', record.approvalStatus);
      setText('[data-payment-detail]', record.paymentDetail);
      setText('[data-service-centre]', record.serviceCentre);
      setText('[data-service-contact]', record.serviceContact);

      renderProgress(record.currentStep);
      showState('result');

      resultState.scrollIntoView({
        behavior: 'smooth',
        block: 'start'
      });
    };

    form.addEventListener('submit', (event) => {
      event.preventDefault();

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const repairId = idInput.value.trim().toUpperCase();
      const phoneLast4 = phoneInput.value.trim();

      showState('loading');

      if (button) button.disabled = true;
      if (buttonText) buttonText.textContent = 'Checking';

      window.setTimeout(() => {
        const record = repairs[repairId];

        if (!record || record.phoneLast4 !== phoneLast4) {
          showState('error');
        } else {
          renderRecord(repairId, record);
        }

        if (button) button.disabled = false;
        if (buttonText) buttonText.textContent = 'Track repair';
      }, 700);
    });
  })();
</script>

