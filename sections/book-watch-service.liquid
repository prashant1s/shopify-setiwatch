<section
  id="BookService-{{ section.id }}"
  class="book-service book-service--{{ section.id }}"
  data-book-service
>
  <div class="book-service__hero">
    {% if section.settings.background_image != blank %}
      {{
        section.settings.background_image
        | image_url: width: 2200
        | image_tag:
          loading: 'eager',
          widths: '900, 1300, 1700, 2200',
          sizes: '100vw',
          class: 'book-service__hero-image',
          alt: section.settings.heading
      }}
    {% endif %}

    <div class="book-service__hero-overlay"></div>

    <div class="book-service__hero-content">
      <p class="book-service__eyebrow">
        {{ section.settings.eyebrow }}
      </p>

      <h1>{{ section.settings.heading }}</h1>

      <p>{{ section.settings.description }}</p>
    </div>
  </div>

  <div class="book-service__mode-section">
    <div class="book-service__mode-heading">
      <p class="book-service__eyebrow">Choose booking mode</p>

      <h2>How are you booking this service?</h2>

      <p>
        Select whether you are submitting a new online request or the watch
        has been received at one of our retail stores.
      </p>
    </div>

    <div
      class="book-service__mode-grid"
      role="tablist"
      aria-label="Service booking mode"
    >
      <button
        type="button"
        class="book-service__mode-card is-active"
        data-booking-tab="online"
        role="tab"
        aria-selected="true"
      >
        <span class="book-service__mode-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <rect x="3" y="4" width="18" height="13" rx="1"></rect>
            <path d="M8 21h8M10 17v4M14 17v4"></path>
          </svg>
        </span>

        <span class="book-service__mode-copy">
          <strong>Book Online</strong>
          <small>
            Submit the service request directly through the website.
          </small>
        </span>

        <span class="book-service__arrow">→</span>
      </button>

      <button
        type="button"
        class="book-service__mode-card"
        data-booking-tab="retail"
        role="tab"
        aria-selected="false"
      >
        <span class="book-service__mode-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M4 9h16M5 9v11h14V9"></path>
            <path d="M5 9l2-5h10l2 5M9 20v-6h6v6"></path>
          </svg>
        </span>

        <span class="book-service__mode-copy">
          <strong>Retail Store Booking</strong>
          <small>
            For watches received at an authorised Sethi retail counter.
          </small>
        </span>

        <span class="book-service__arrow">→</span>
      </button>
    </div>
  </div>

  <div class="book-service__body">
    <aside class="book-service__info">
      <p class="book-service__eyebrow">
        {{ section.settings.info_eyebrow }}
      </p>

      <h2>{{ section.settings.info_heading }}</h2>

      <p>{{ section.settings.info_text }}</p>

      <div class="book-service__steps">
        <div>
          <span>01</span>
          <p>Choose your booking source</p>
        </div>

        <div>
          <span>02</span>
          <p>Provide complete watch details</p>
        </div>

        <div>
          <span>03</span>
          <p>Receive verification and Repair ID</p>
        </div>
      </div>

      {% if section.settings.track_link != blank %}
        <a
          href="{{ section.settings.track_link }}"
          class="book-service__track-link"
        >
          Already submitted? Track your repair →
        </a>
      {% endif %}
    </aside>

    <div class="book-service__form-card">

      <!-- ONLINE BOOKING -->
      <div
        class="book-service__panel is-active"
        data-booking-panel="online"
      >
        <div class="book-service__panel-heading">
          <p>Online service request</p>
          <h3>Tell us about your timepiece</h3>
          <span>
            Our team will verify the request before issuing a Repair ID.
          </span>
        </div>

        <div class="book-service__success" data-online-success hidden>
          <strong>Service request received.</strong>
          <span>
            Your request reference is <b data-online-request-id></b>. Our
            team will verify the details and contact you shortly.
          </span>
        </div>

        <div
          class="book-service__errors"
          role="alert"
          data-online-error
          hidden
        ></div>

        <form
          id="BookServiceOnlineForm"
          class="book-service__form"
          data-online-form
          novalidate
        >
          <div class="book-service__honeypot" aria-hidden="true">
            <label for="OnlineWebsite-{{ section.id }}">Website</label>

            <input
              id="OnlineWebsite-{{ section.id }}"
              type="text"
              name="website"
              tabindex="-1"
              autocomplete="off"
            >
          </div>

          <div class="book-service__grid">
            <label>
              <span>Full name *</span>
              <input
                type="text"
                name="name"
                minlength="3"
                maxlength="80"
                autocomplete="name"
                required
              >
            </label>

            <label>
              <span>Phone number *</span>
              <input
                type="tel"
                name="phone"
                inputmode="tel"
                autocomplete="tel"
                minlength="10"
                maxlength="16"
                pattern="[0-9+\-\s()]{10,16}"
                required
              >
            </label>

            <label>
              <span>Email address *</span>
              <input
                type="email"
                name="email"
                maxlength="120"
                autocomplete="email"
                required
              >
            </label>

            <label>
              <span>Preferred store *</span>
              <select name="preferred_store" required>
                <option value="" selected disabled>
                  Select store or pickup
                </option>
                <option>Krishna Nagar</option>
                <option>Noida Sector 18</option>
                <option>Noida Sector 120</option>
                <option>Pickup request</option>
              </select>
            </label>

            <label>
              <span>Watch brand *</span>
              <input
                type="text"
                name="watch_brand"
                minlength="2"
                maxlength="60"
                required
              >
            </label>

            <label>
              <span>Model / reference number *</span>
              <input
                type="text"
                name="watch_model"
                minlength="2"
                maxlength="100"
                placeholder="Example: SRPM06J1"
                required
              >
            </label>

            <label>
              <span>Serial number</span>
              <input
                type="text"
                name="serial_number"
                maxlength="100"
              >
            </label>

            <label>
              <span>Service type *</span>
              <select name="service_type" required>
                <option value="" selected disabled>Select service</option>
                <option>Complete servicing</option>
                <option>Battery replacement</option>
                <option>Strap or bracelet service</option>
                <option>Glass or crystal replacement</option>
                <option>Water resistance check</option>
                <option>Polishing and restoration</option>
                <option>Other</option>
              </select>
            </label>

            <label>
              <span>Purchase source *</span>
              <select name="purchase_source" required>
                <option value="" selected disabled>
                  Select purchase source
                </option>
                <option>Sethi Watches</option>
                <option>Another authorised retailer</option>
                <option>Online marketplace</option>
                <option>Gift</option>
                <option>Other / unknown</option>
              </select>
            </label>

            <label>
              <span>Invoice available *</span>
              <select name="invoice_available" required>
                <option value="" selected disabled>Select option</option>
                <option>Yes</option>
                <option>No</option>
              </select>
            </label>

            <label>
              <span>Warranty status *</span>
              <select name="warranty_status" required>
                <option value="" selected disabled>
                  Select warranty status
                </option>
                <option>Under manufacturer warranty</option>
                <option>Out of warranty</option>
                <option>Not sure</option>
              </select>
            </label>

            <label>
              <span>Preferred service mode *</span>
              <select
                name="preferred_service_mode"
                required
              >
                <option value="" selected disabled>
                  Select service mode
                </option>
                <option>Visit service centre</option>
                <option>Pickup request</option>
                <option>Call me first</option>
              </select>
            </label>

            <label class="book-service__full">
              <span>Issue or service requirement *</span>

              <textarea
                name="issue_description"
                rows="5"
                minlength="20"
                maxlength="1500"
                placeholder="Describe the issue in at least 20 characters."
                required
              ></textarea>
            </label>

            <label class="book-service__full">
              <span>Visible condition notes</span>

              <textarea
                name="condition_notes"
                rows="3"
                maxlength="800"
                placeholder="Mention scratches, dents, broken parts or visible damage."
              ></textarea>
            </label>
          </div>

          <div class="book-service__future-feature">
            <div>
              <strong>Watch photographs</strong>
              <span>
                Front, back and damage-image uploads will be activated with
                the backend.
              </span>
            </div>

            <b>Backend phase</b>
          </div>

          <label class="book-service__consent">
            <input
              type="checkbox"
              name="confirmed"
              required
            >

            <span>
              I confirm that the information provided is correct and agree
              to be contacted regarding this service request.
            </span>
          </label>

          <button type="submit">
            <span data-online-button-text>
              Submit online request
            </span>
            <span aria-hidden="true">→</span>
          </button>

          <p class="book-service__note">
            A Repair ID will be issued only after request verification.
          </p>
        </form>
      </div>

      <!-- RETAIL STORE BOOKING -->
      <div
        class="book-service__panel"
        data-booking-panel="retail"
        hidden
      >
        <div class="book-service__panel-heading">
          <p>Retail store booking</p>
          <h3>For Sethi Watch staff</h3>
          <span>
            This public website page is not used to create repair jobs.
          </span>
        </div>

        <div class="book-service__staff-notice">
          <strong>Please use Shopify Admin instead.</strong>

          <span>
            Repair jobs for watches received in store are created directly
            in Shopify Admin, under Content → Metaobjects → Repair Job.
            Creating jobs there — rather than through a public storefront
            form — keeps customer contact details secure. If you're a
            staff member looking for the intake tool, please sign in to
            Shopify Admin.
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .book-service--{{ section.id }} {
    --page-bg: rgb(var(--color-canvas));
    --surface: rgb(var(--color-surface));
    --text: rgb(var(--color-ink));
    --muted: rgb(var(--color-ink-muted));
    --accent: rgb(var(--color-gold));
    --line: var(--color-border);

    background: var(--page-bg);
    color: var(--text);
  }

  .book-service--{{ section.id }} *,
  .book-service--{{ section.id }} *::before,
  .book-service--{{ section.id }} *::after {
    box-sizing: border-box;
  }

  .book-service--{{ section.id }} .book-service__hero {
    position: relative;
    display: flex;
    min-height: 310px;
    padding: 58px 24px;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    text-align: center;
    background: rgb(var(--color-ink-deep));
  }

  .book-service--{{ section.id }} .book-service__hero-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.image_position }};
  }

  .book-service--{{ section.id }} .book-service__hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(10, 9, 8, 0.4),
      rgba(10, 9, 8, 0.76)
    );
  }

  .book-service--{{ section.id }} .book-service__hero-content {
    position: relative;
    z-index: 2;
    width: min(100%, 820px);
    color: #fff;
  }

  .book-service--{{ section.id }} .book-service__eyebrow {
    margin: 0 0 10px;
    color: var(--accent);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2.2px;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .book-service--{{ section.id }} h1,
  .book-service--{{ section.id }} h2,
  .book-service--{{ section.id }} h3 {
    font-family: var(--font-heading-family);
    font-weight: 400;
  }

  .book-service--{{ section.id }} .book-service__hero h1 {
    margin: 0;
    color: #fff;
    font-size: clamp(42px, 5vw, 66px);
    line-height: 1.02;
  }

  .book-service--{{ section.id }}
  .book-service__hero-content > p:last-child {
    max-width: 680px;
    margin: 14px auto 0;
    color: rgba(255, 255, 255, 0.8);
    font-size: 15px;
    line-height: 1.65;
  }

  .book-service--{{ section.id }} .book-service__mode-section {
    width: min(100% - 48px, 1180px);
    margin: 0 auto;
    padding: 54px 0 18px;
  }

  .book-service--{{ section.id }} .book-service__mode-heading {
    max-width: 700px;
    margin: 0 auto 28px;
    text-align: center;
  }

  .book-service--{{ section.id }} .book-service__mode-heading h2 {
    margin: 0;
    font-size: clamp(32px, 3vw, 44px);
    line-height: 1.05;
  }

  .book-service--{{ section.id }}
  .book-service__mode-heading > p:last-child {
    margin: 12px 0 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.65;
  }

  .book-service--{{ section.id }} .book-service__mode-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .book-service--{{ section.id }} .book-service__mode-card {
    display: grid;
    grid-template-columns: 52px 1fr auto;
    min-height: 112px;
    padding: 22px;
    align-items: center;
    gap: 16px;
    color: var(--text);
    text-align: left;
    background: rgba(255, 255, 255, 0.52);
    border: 1px solid var(--line);
    cursor: pointer;
    transition: 0.25s ease;
  }

  .book-service--{{ section.id }} .book-service__mode-card:hover,
  .book-service--{{ section.id }} .book-service__mode-card.is-active {
    background: #fff;
    border-color: var(--accent);
    box-shadow: 0 18px 45px rgba(35, 28, 20, 0.08);
    transform: translateY(-2px);
  }

  .book-service--{{ section.id }} .book-service__mode-icon {
    display: grid;
    width: 52px;
    height: 52px;
    place-items: center;
    color: var(--accent);
    background: rgb(var(--color-canvas-deep));
    border-radius: 50%;
  }

  .book-service--{{ section.id }} .book-service__mode-icon svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .book-service--{{ section.id }} .book-service__mode-copy strong,
  .book-service--{{ section.id }} .book-service__mode-copy small {
    display: block;
  }

  .book-service--{{ section.id }} .book-service__mode-copy strong {
    font-family: var(--font-heading-family);
    font-size: 21px;
    font-weight: 400;
  }

  .book-service--{{ section.id }} .book-service__mode-copy small {
    margin-top: 7px;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.45;
  }

  .book-service--{{ section.id }} .book-service__arrow {
    color: var(--accent);
    font-size: 18px;
  }

  .book-service--{{ section.id }} .book-service__body {
    display: grid;
    grid-template-columns: minmax(300px, 0.72fr) minmax(580px, 1.28fr);
    width: min(100% - 64px, 1380px);
    margin: 0 auto;
    padding: 54px 0 88px;
    gap: 64px;
  }

  .book-service--{{ section.id }} .book-service__info {
    padding-top: 20px;
  }

  .book-service--{{ section.id }} .book-service__info h2 {
    margin: 0;
    font-size: clamp(38px, 3.4vw, 54px);
    line-height: 1.04;
  }

  .book-service--{{ section.id }}
  .book-service__info > p:nth-of-type(2) {
    margin: 18px 0 0;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.75;
  }

  .book-service--{{ section.id }} .book-service__steps {
    margin-top: 36px;
    border-top: 1px solid var(--line);
  }

  .book-service--{{ section.id }} .book-service__steps > div {
    display: grid;
    grid-template-columns: 50px 1fr;
    padding: 20px 0;
    align-items: center;
    border-bottom: 1px solid var(--line);
  }

  .book-service--{{ section.id }} .book-service__steps span {
    color: var(--accent);
    font-size: 10px;
  }

  .book-service--{{ section.id }} .book-service__steps p {
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: 17px;
  }

  .book-service--{{ section.id }} .book-service__track-link {
    display: inline-flex;
    margin-top: 24px;
    color: var(--text);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.3px;
    text-decoration: none;
    text-transform: uppercase;
  }

  .book-service--{{ section.id }} .book-service__form-card {
    min-width: 0;
    padding: 38px;
    background: rgb(var(--color-surface));
    border: 1px solid var(--line);
    box-shadow: 0 24px 60px rgba(35, 28, 20, 0.08);
  }

  .book-service--{{ section.id }} .book-service__panel[hidden] {
    display: none;
  }

  .book-service--{{ section.id }} .book-service__panel-heading {
    margin-bottom: 28px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--line);
  }

  .book-service--{{ section.id }} .book-service__panel-heading p {
    margin: 0 0 8px;
    color: var(--accent);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 1.8px;
    text-transform: uppercase;
  }

  .book-service--{{ section.id }} .book-service__panel-heading h3 {
    margin: 0;
    font-size: 30px;
  }

  .book-service--{{ section.id }} .book-service__panel-heading span {
    display: block;
    margin-top: 10px;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.55;
  }

  .book-service--{{ section.id }} .book-service__form {
    position: relative;
  }

  .book-service--{{ section.id }} .book-service__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .book-service--{{ section.id }} label {
    display: block;
  }

  .book-service--{{ section.id }} label > span,
  .book-service--{{ section.id }} .book-service__items legend {
    display: block;
    margin-bottom: 9px;
    color: rgb(var(--color-ink-muted));
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .book-service--{{ section.id }} input,
  .book-service--{{ section.id }} select,
  .book-service--{{ section.id }} textarea {
    width: 100%;
    padding: 14px 15px;
    color: var(--text);
    background: #fff;
    border: 1px solid rgba(23, 21, 19, 0.19);
    border-radius: 0;
    font: inherit;
    font-size: 14px;
  }

  .book-service--{{ section.id }} input,
  .book-service--{{ section.id }} select {
    min-height: 52px;
  }

  .book-service--{{ section.id }} textarea {
    min-height: 125px;
    resize: vertical;
  }

  .book-service--{{ section.id }} input:focus,
  .book-service--{{ section.id }} select:focus,
  .book-service--{{ section.id }} textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 2px rgba(152, 120, 70, 0.12);
  }

  .book-service--{{ section.id }} .book-service__full {
    grid-column: 1 / -1;
  }

  .book-service--{{ section.id }} .book-service__items {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin: 0;
    padding: 18px;
    gap: 12px;
    border: 1px solid var(--line);
  }

  .book-service--{{ section.id }} .book-service__items legend {
    grid-column: 1 / -1;
  }

  .book-service--{{ section.id }} .book-service__items label {
    display: flex;
    align-items: center;
    gap: 9px;
  }

  .book-service--{{ section.id }} .book-service__items input {
    width: 17px;
    height: 17px;
    min-height: 0;
    margin: 0;
    accent-color: var(--accent);
  }

  .book-service--{{ section.id }} .book-service__items label span {
    margin: 0;
    color: var(--text);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
  }

  .book-service--{{ section.id }} .book-service__future-feature {
    display: flex;
    margin-top: 20px;
    padding: 18px;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    background: rgb(var(--color-canvas-deep));
    border: 1px dashed rgba(var(--color-gold), 0.42);
  }

  .book-service--{{ section.id }}
  .book-service__future-feature strong,
  .book-service--{{ section.id }}
  .book-service__future-feature span {
    display: block;
  }

  .book-service--{{ section.id }}
  .book-service__future-feature strong {
    font-family: var(--font-heading-family);
    font-size: 16px;
    font-weight: 400;
  }

  .book-service--{{ section.id }}
  .book-service__future-feature span {
    margin-top: 5px;
    color: var(--muted);
    font-size: 11px;
  }

  .book-service--{{ section.id }}
  .book-service__future-feature b {
    flex: 0 0 auto;
    padding: 7px 10px;
    color: #fff;
    background: var(--accent);
    font-size: 8px;
    letter-spacing: 0.8px;
    text-transform: uppercase;
  }

  .book-service--{{ section.id }} .book-service__consent {
    display: flex;
    margin-top: 20px;
    align-items: flex-start;
    gap: 11px;
  }

  .book-service--{{ section.id }} .book-service__consent input {
    width: 18px;
    height: 18px;
    min-height: 0;
    margin: 2px 0 0;
    accent-color: var(--accent);
  }

  .book-service--{{ section.id }}
  .book-service__consent > span {
    margin: 0;
    color: var(--muted);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.55;
    text-transform: none;
  }

  .book-service--{{ section.id }} button[type="submit"] {
    display: inline-flex;
    min-height: 56px;
    margin-top: 26px;
    padding: 0 30px;
    align-items: center;
    justify-content: center;
    gap: 10px;
    color: #fff;
    background: var(--text);
    border: 0;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.3px;
    text-transform: uppercase;
    cursor: pointer;
  }

  .book-service--{{ section.id }} button[type="submit"]:hover {
    background: var(--accent);
  }

