<script>
  (() => {
    const section = document.getElementById(
      'BookService-{{ section.id }}'
    );

    if (!section) return;

    const tabs = section.querySelectorAll(
      '[data-booking-tab]'
    );

    const panels = section.querySelectorAll(
      '[data-booking-panel]'
    );

    const activatePanel = (mode) => {
      tabs.forEach((tab) => {
        const active = tab.dataset.bookingTab === mode;

        tab.classList.toggle('is-active', active);
        tab.setAttribute(
          'aria-selected',
          active ? 'true' : 'false'
        );
      });

      panels.forEach((panel) => {
        const active = panel.dataset.bookingPanel === mode;

        panel.classList.toggle('is-active', active);
        panel.hidden = !active;
      });
    };

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        activatePanel(tab.dataset.bookingTab);
      });
    });

    const onlineForm = section.querySelector('[data-online-form]');

    if (onlineForm) {
      /*
        Submissions are stored via the same Cloudflare Worker used for
        repair approval & payment (repair-payments-worker) — its /intake
        endpoint writes a `sethi_service_request` metaobject so staff can
        review the request in Shopify Admin. See that worker's README for
        setup. Until the URL below is filled in, submitting shows a
        "contact us" message instead of silently failing.
      */
      const INTAKE_API_BASE_URL = {{ section.settings.intake_api_base_url | json }};
      const INTAKE_UNAVAILABLE_TEXT =
        "Online submission isn't available yet — please call or visit us to book your service.";

      const honeypot = onlineForm.querySelector('input[name="website"]');
      const submitButton = onlineForm.querySelector('button[type="submit"]');
      const buttonText = onlineForm.querySelector('[data-online-button-text]');
      const successBox = section.querySelector('[data-online-success]');
      const requestIdEl = section.querySelector('[data-online-request-id]');
      const errorBox = section.querySelector('[data-online-error]');

      const showOnlineError = (text) => {
        if (!errorBox) return;
        errorBox.textContent = text || '';
        errorBox.hidden = !text;
      };

      const setSubmitting = (isSubmitting) => {
        if (submitButton) submitButton.disabled = isSubmitting;
        if (buttonText) {
          buttonText.textContent = isSubmitting
            ? 'Submitting request'
            : 'Submit online request';
        }
      };

      let submitting = false;

      onlineForm.addEventListener('submit', async (event) => {
        event.preventDefault();

        if (honeypot && honeypot.value.trim() !== '') return;

        if (!onlineForm.checkValidity()) {
          onlineForm.reportValidity();
          return;
        }

        if (submitting) return;

        if (!INTAKE_API_BASE_URL) {
          showOnlineError(INTAKE_UNAVAILABLE_TEXT);
          return;
        }

        submitting = true;
        showOnlineError('');
        setSubmitting(true);

        const formData = new FormData(onlineForm);
        const payload = Object.fromEntries(formData.entries());
        payload.confirmed = formData.get('confirmed') === 'on';

        try {
          const base = INTAKE_API_BASE_URL.replace(/\/$/, '');
          const response = await fetch(`${base}/intake`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          const data = await response.json();
          if (!response.ok || !data.ok) {
            throw new Error(data.error || 'Request failed');
          }

          onlineForm.hidden = true;
          if (successBox) {
            successBox.hidden = false;
            if (requestIdEl) requestIdEl.textContent = data.request_id || '';
          }
        } catch (err) {
          console.error('[book-watch-service] intake submit failed:', err);
          showOnlineError(
            'Something went wrong submitting your request. Please try again or contact us directly.'
          );
          submitting = false;
          setSubmitting(false);
        }
      });
    }

  })();
</script>

