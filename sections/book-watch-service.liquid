<script>
  (() => {
    const section = document.getElementById(
      'BookService-{{ section.id }}'
    );

    if (!section) return;

    const tabs = section.querySelectorAll(
      '[data-booking-tab]'
    );

    const panels = section.querySelectorAll(
      '[data-booking-panel]'
    );

    const activatePanel = (mode) => {
      tabs.forEach((tab) => {
        const active = tab.dataset.bookingTab === mode;

        tab.classList.toggle('is-active', active);
        tab.setAttribute(
          'aria-selected',
          active ? 'true' : 'false'
        );
      });

      panels.forEach((panel) => {
        const active = panel.dataset.bookingPanel === mode;

        panel.classList.toggle('is-active', active);
        panel.hidden = !active;
      });
    };

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        activatePanel(tab.dataset.bookingTab);
      });
    });

    const onlineForm = section.querySelector(
      '#BookServiceOnlineForm'
    );

    if (onlineForm) {
      const honeypot = onlineForm.querySelector(
        'input[name="contact[website]"]'
      );

      const submitButton = onlineForm.querySelector(
        'button[type="submit"]'
      );

      const buttonText = onlineForm.querySelector(
        '[data-online-button-text]'
      );

      let submitting = false;

      onlineForm.addEventListener('submit', (event) => {
        if (honeypot && honeypot.value.trim() !== '') {
          event.preventDefault();
          return;
        }

        if (!onlineForm.checkValidity()) return;

        if (submitting) {
          event.preventDefault();
          return;
        }

        submitting = true;

        if (submitButton) {
          submitButton.disabled = true;
        }

        if (buttonText) {
          buttonText.textContent = 'Submitting request';
        }
      });
    }

  })();
</script>

