  }

  .sethi-cart__empty a {
    display: inline-flex;
    min-height: 52px;
    margin-top: 18px;
    padding: 0 24px;
    align-items: center;
    gap: 10px;
    color: #fff;
    background: var(--cart-text);
    text-decoration: none;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.2px;
    text-transform: uppercase;
  }

  @media screen and (max-width: 989px) {
    .sethi-cart__layout {
      grid-template-columns: 1fr;
    }

    .sethi-cart__summary {
      position: static;
    }
  }

  @keyframes sethi-cart-reminder-rotate-mobile {
    0%,20% { transform:translateY(0); }
    25%,45% { transform:translateY(-44px); }
    50%,70% { transform:translateY(-88px); }
    75%,95% { transform:translateY(-132px); }
    100% { transform:translateY(0); }
  }

  @media screen and (max-width: 749px) {
    .sethi-cart {
      padding: 28px 0 60px;
    }

    .sethi-cart__header {
      align-items: flex-start;
      flex-direction: column;
    }

    .sethi-cart__shipping-copy {
      align-items: flex-start;
      flex-direction: column;
    }

    .sethi-cart__shipping-reminder {
      min-height: 44px;
      padding: 0 10px;
    }

    .sethi-cart__shipping-reminder-window { height: 44px; }

    .sethi-cart__shipping-reminder-track span {
      height: 44px;
      flex-basis: 44px;
      font-size: 10px;
    }

    .sethi-cart__shipping-reminder-track {
      animation-name: sethi-cart-reminder-rotate-mobile;
    }

    .sethi-cart__progress {
      margin-top: 20px;
    }

    .sethi-cart__delivery-truck {
      width: 28px;
      height: 28px;
      font-size: 18px;
    }

    .sethi-cart__items-head {
      display: none;
    }

    .sethi-cart__item {
      grid-template-columns: 88px 1fr;
      padding: 18px;
      align-items: start;
      gap: 14px;
    }

    .sethi-cart__image {
      height: 96px;
    }

    .sethi-cart__details h2 {
      font-size: 17px;
    }

    .sethi-cart__quantity-wrap {
      grid-column: 1 / -1;
      display: flex;
      align-items: center;
      justify-content: space-between;
      text-align: left;
    }

    .sethi-cart__quantity {
      margin: 0;
    }

    .sethi-cart__remove {
      margin-top: 0;
    }

    .sethi-cart__line-total {
      grid-column: 1 / -1;
      margin-top: -46px;
      pointer-events: none;
    }

    .sethi-cart__summary {
      padding: 22px 18px;
    }

    .sethi-cart__trust {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  (() => {
    const section = document.getElementById('SethiLuxuryCart-{{ section.id }}');
    if (!section) return;

    const form = section.querySelector('#cart');
    const updateButton = section.querySelector('[data-cart-update]');

    section.querySelectorAll('[data-cart-item]').forEach((item) => {
      const input = item.querySelector('[data-quantity-input]');
      const minus = item.querySelector('[data-quantity-minus]');
      const plus = item.querySelector('[data-quantity-plus]');

      minus?.addEventListener('click', () => {
        const current = Number(input.value) || 0;
        input.value = Math.max(0, current - 1);
      });

      plus?.addEventListener('click', () => {
        const current = Number(input.value) || 0;
        input.value = current + 1;
      });
    });

    updateButton?.addEventListener('click', () => {
      form?.submit();
    });
  })();
</script>

