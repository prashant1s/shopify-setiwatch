{{ 'component-cart.css' | asset_url | stylesheet_tag }}
{{ 'component-totals.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-discounts.css' | asset_url | stylesheet_tag }}

<section
  id="SethiLuxuryCart-{{ section.id }}"
  class="sethi-cart"
  data-section-id="{{ section.id }}"
>
  {%- assign free_shipping_threshold = 500000 -%}
  {%- assign remaining_for_free_shipping = free_shipping_threshold | minus: cart.total_price -%}
  {%- assign shipping_progress = cart.total_price | times: 100 | divided_by: free_shipping_threshold -%}
  {%- if shipping_progress > 100 -%}
    {%- assign shipping_progress = 100 -%}
  {%- endif -%}

  <div class="sethi-cart__container page-width">
    <div class="sethi-cart__header">
      <div>
        <p class="sethi-cart__eyebrow">Your Selection</p>
        <h1>Your Cart{% if cart.item_count > 0 %} ({{ cart.item_count }}){% endif %}</h1>
      </div>

      <a href="{{ routes.all_products_collection_url }}" class="sethi-cart__continue">
        Continue Shopping
        <span aria-hidden="true">→</span>
      </a>
    </div>

    {% if cart.item_count > 0 %}
      <div class="sethi-cart__shipping">
        <div class="sethi-cart__shipping-copy">
          {% if cart.total_price >= free_shipping_threshold %}
            <div>
              <strong>Free shipping unlocked</strong>
              <span>Your order qualifies for complimentary shipping.</span>
            </div>
            <span class="sethi-cart__shipping-badge">Unlocked</span>
          {% else %}
            <div>
              <strong>
                Add {{ remaining_for_free_shipping | money }} more for free shipping
              </strong>
              <span>Free shipping is available on orders above {{ free_shipping_threshold | money }}.</span>
            </div>
            <span class="sethi-cart__shipping-badge">
              {{ shipping_progress }}%
            </span>
          {% endif %}
        </div>

        <div
          class="sethi-cart__progress"
          role="progressbar"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="{{ shipping_progress }}"
        >
          <span
            class="sethi-cart__progress-fill"
            style="width: {{ shipping_progress }}%;"
          ></span>

          <span
            class="sethi-cart__delivery-truck{% if cart.total_price >= free_shipping_threshold %} is-unlocked{% endif %}"
            style="left: clamp(15px, {{ shipping_progress }}%, calc(100% - 15px));"
            aria-hidden="true"
          >
            🚚
          </span>
        </div>

        {% if cart.total_price < free_shipping_threshold %}
          <div class="sethi-cart__shipping-reminder">
            <span class="sethi-cart__shipping-reminder-icon" aria-hidden="true">✦</span>

            <div class="sethi-cart__shipping-reminder-window">
              <div class="sethi-cart__shipping-reminder-track">
                <span>Add {{ remaining_for_free_shipping | money }} more to unlock free shipping.</span>
                <span>Your cart is only {{ remaining_for_free_shipping | money }} away from complimentary delivery.</span>
                <span>Complete your cart above {{ free_shipping_threshold | money }} and enjoy free shipping.</span>
                <span>Add another watch or accessory to unlock free shipping.</span>
              </div>
            </div>
          </div>
        {% else %}
          <div class="sethi-cart__shipping-celebration">
            <span aria-hidden="true">✓</span>
            <div>
              <strong>Complimentary shipping unlocked</strong>
              <small>Your order now qualifies for free delivery.</small>
            </div>
          </div>
        {% endif %}
      </div>

      <form action="{{ routes.cart_url }}" method="post" id="cart" class="sethi-cart__form">
        <div class="sethi-cart__layout">
          <div class="sethi-cart__items">
            <div class="sethi-cart__items-head">
              <span>Product</span>
              <span>Quantity</span>
              <span>Total</span>
            </div>

            {% for item in cart.items %}
              <article class="sethi-cart__item" data-cart-item>
                <a href="{{ item.url }}" class="sethi-cart__image-link">
                  {% if item.image %}
                    {{
                      item.image
                      | image_url: width: 360
                      | image_tag:
                        loading: 'lazy',
                        widths: '120, 180, 240, 360',
                        sizes: '(max-width: 749px) 88px, 120px',
                        class: 'sethi-cart__image',
                        alt: item.image.alt | default: item.product.title
                    }}
                  {% endif %}
                </a>

                <div class="sethi-cart__details">
                  {% if item.product.vendor != blank %}
                    <p class="sethi-cart__vendor">{{ item.product.vendor }}</p>
                  {% endif %}

                  <h2>
                    <a href="{{ item.url }}">{{ item.product.title }}</a>
                  </h2>

                  {% unless item.product.has_only_default_variant %}
                    <dl class="sethi-cart__variant">
                      {% for option in item.options_with_values %}
                        <div>
                          <dt>{{ option.name }}:</dt>
                          <dd>{{ option.value }}</dd>
                        </div>
                      {% endfor %}
                    </dl>
                  {% endunless %}

                  {% if item.sku != blank %}
                    <p class="sethi-cart__sku">Ref. {{ item.sku }}</p>
                  {% endif %}

                  <div class="sethi-cart__unit-price">
                    {% if item.original_price != item.final_price %}
                      <s>{{ item.original_price | money }}</s>
                    {% endif %}
                    <span>{{ item.final_price | money }}</span>
                  </div>

                  {% if item.discounts.size > 0 %}
                    <ul class="sethi-cart__discounts" role="list">
                      {% for discount in item.discounts %}
                        <li>{{ discount.title }}</li>
                      {% endfor %}
                    </ul>
                  {% endif %}

                  <div class="sethi-cart__assurance">
                    <span>100% Genuine</span>
                    <span>Manufacturer Warranty</span>
                  </div>
                </div>

                <div class="sethi-cart__quantity-wrap">
                  <label class="visually-hidden" for="Quantity-{{ item.index | plus: 1 }}">
                    Quantity for {{ item.product.title }}
                  </label>

                  <div class="sethi-cart__quantity">
                    <button
                      type="button"
                      class="sethi-cart__qty-button"
                      data-quantity-minus
                      aria-label="Decrease quantity"
                    >−</button>

                    <input
                      id="Quantity-{{ item.index | plus: 1 }}"
                      class="sethi-cart__qty-input"
                      type="number"
                      name="updates[]"
                      value="{{ item.quantity }}"
                      min="0"
                      step="1"
                      data-quantity-input
                    >

                    <button
                      type="button"
                      class="sethi-cart__qty-button"
                      data-quantity-plus
                      aria-label="Increase quantity"
                    >+</button>
                  </div>

                  <a
                    href="{{ item.url_to_remove }}"
                    class="sethi-cart__remove"
                    aria-label="Remove {{ item.product.title }}"
                  >
                    Remove
                  </a>
                </div>

                <div class="sethi-cart__line-total">
                  {% if item.original_line_price != item.final_line_price %}
                    <s>{{ item.original_line_price | money }}</s>
                  {% endif %}
                  <strong>{{ item.final_line_price | money }}</strong>
                </div>
              </article>
            {% endfor %}

            <div class="sethi-cart__utility">
              <label for="CartNote-{{ section.id }}">Order note</label>
              <textarea
                id="CartNote-{{ section.id }}"
                name="note"
                rows="3"
                placeholder="Add gifting instructions, preferred delivery note or any special request."
              >{{ cart.note }}</textarea>
            </div>
          </div>

          <aside class="sethi-cart__summary">
            <p class="sethi-cart__eyebrow">Order Summary</p>
            <h2>Complete Your Purchase</h2>

            <div class="sethi-cart__summary-lines">
              <div>
                <span>Subtotal</span>
                <strong>{{ cart.items_subtotal_price | money }}</strong>
              </div>

              {% if cart.cart_level_discount_applications.size > 0 %}
                {% for discount in cart.cart_level_discount_applications %}
                  <div class="sethi-cart__discount-line">
                    <span>{{ discount.title }}</span>
                    <strong>−{{ discount.total_allocated_amount | money }}</strong>
                  </div>
                {% endfor %}
              {% endif %}

              <div>
                <span>Shipping</span>
                <strong>
                  {% if cart.total_price >= free_shipping_threshold %}
                    Free
                  {% else %}
                    Calculated at checkout
                  {% endif %}
                </strong>
              </div>

              <div class="sethi-cart__total">
                <span>Estimated Total</span>
                <strong>{{ cart.total_price | money_with_currency }}</strong>
              </div>
            </div>

            <p class="sethi-cart__tax-note">
              Taxes included. Discounts and shipping are calculated at checkout.
            </p>

            <button
              type="submit"
              name="checkout"
              class="sethi-cart__checkout"
            >
              Secure Checkout
              <span aria-hidden="true">→</span>
            </button>

            <button
              type="submit"
              name="update"
              class="sethi-cart__update"
              data-cart-update
            >
              Update Cart
            </button>

            <div class="sethi-cart__trust">
              <div>
                <strong>100% Genuine</strong>
                <span>Authentic products only</span>
              </div>
              <div>
                <strong>Brand Warranty</strong>
                <span>Manufacturer-backed cover</span>
              </div>
              <div>
                <strong>Secure Checkout</strong>
                <span>Protected payment process</span>
              </div>
              <div>
                <strong>Premium Packaging</strong>
                <span>Handled with care</span>
              </div>
            </div>
          </aside>
        </div>
      </form>
    {% else %}
      <div class="sethi-cart__empty">
        <p class="sethi-cart__eyebrow">Your Selection</p>
        <h2>Your cart is waiting</h2>
        <p>Explore our curated collection of authentic timepieces.</p>
        <a href="{{ routes.all_products_collection_url }}">
          Explore Watches
          <span aria-hidden="true">→</span>
        </a>
      </div>
    {% endif %}
  </div>
</section>

<style>
  .sethi-cart {
    --cart-bg: #f5f2ec;
    --cart-surface: #ffffff;
    --cart-text: #181614;
    --cart-muted: #746d65;
    --cart-accent: #9b7b4a;
    --cart-line: rgba(24, 22, 20, 0.12);

    padding: 46px 0 88px;
    background: var(--cart-bg);
    color: var(--cart-text);
  }

  .sethi-cart * {
    box-sizing: border-box;
  }

  .sethi-cart__header {
    display: flex;
    margin-bottom: 28px;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
  }

  .sethi-cart__eyebrow {
    margin: 0 0 8px;
    color: var(--cart-accent);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .sethi-cart__header h1,
  .sethi-cart__summary h2,
  .sethi-cart__empty h2 {
    margin: 0;
    font-family: var(--font-heading-family);
    font-weight: 400;
  }

  .sethi-cart__header h1 {
    font-size: clamp(38px, 4vw, 56px);
    line-height: 1;
  }

  .sethi-cart__continue {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--cart-text);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    text-decoration: none;
    text-transform: uppercase;
  }

  .sethi-cart__shipping {
    margin-bottom: 24px;
    padding: 20px 22px;
    background: var(--cart-surface);
    border: 1px solid var(--cart-line);
  }

  .sethi-cart__shipping-copy {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .sethi-cart__shipping-copy strong,
  .sethi-cart__shipping-copy span {
    display: block;
  }

  .sethi-cart__shipping-copy strong {
    font-family: var(--font-heading-family);
    font-size: 18px;
    font-weight: 400;
  }

  .sethi-cart__shipping-copy div span {
    margin-top: 5px;
    color: var(--cart-muted);
    font-size: 12px;
  }

  .sethi-cart__shipping-badge {
    flex: 0 0 auto;
    padding: 7px 10px;
    color: #fff;
    background: var(--cart-text);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .sethi-cart__progress {
    position: relative;
    height: 7px;
    margin-top: 22px;
    overflow: visible;
    background: rgba(24, 22, 20, 0.1);
  }

  .sethi-cart__progress-fill {
    display: block;
    height: 100%;
    background: var(--cart-accent);
    transition: width 0.55s ease;
  }

  .sethi-cart__delivery-truck {
    position: absolute;
    z-index: 4;
    top: 50%;
    display: grid;
    width: 32px;
    height: 32px;
    place-items: center;
    transform: translate(-50%, -54%);
    font-size: 21px;
    line-height: 1;
    filter: grayscale(1) contrast(1.05);
    transition: left 0.55s ease;
    animation: sethi-cart-truck-bounce 1.25s ease-in-out infinite;
  }

  .sethi-cart__delivery-truck::after {
    content: "";
    position: absolute;
    right: 4px;
    bottom: -2px;
    left: 4px;
    height: 5px;
    background: rgba(24, 22, 20, 0.16);
    border-radius: 50%;
    filter: blur(2px);
  }

  .sethi-cart__delivery-truck.is-unlocked {
    animation:
      sethi-cart-truck-arrive 0.8s ease both,
      sethi-cart-truck-bounce 1.25s ease-in-out 0.8s infinite;
  }

  .sethi-cart__progress::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: -28%;
    width: 24%;
    pointer-events: none;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,.72), transparent);
    transform: skewX(-18deg);
    animation: sethi-cart-progress-shine 3.8s ease-in-out infinite;
  }

  .sethi-cart__shipping-reminder {
    display: flex;
    min-height: 40px;
    margin-top: 14px;
    padding: 0 14px;
    align-items: center;
    gap: 10px;
    overflow: hidden;
    color: var(--cart-text);
    background: #f7f3ec;
    border-left: 2px solid var(--cart-accent);
  }

  .sethi-cart__shipping-reminder-icon {
    display: grid;
    width: 20px;
    height: 20px;
    flex: 0 0 auto;
    place-items: center;
    color: var(--cart-accent);
    font-size: 12px;
    animation: sethi-cart-reminder-pulse 1.8s ease-in-out infinite;
  }

  .sethi-cart__shipping-reminder-window {
    position: relative;
    height: 40px;
    flex: 1;
    overflow: hidden;
  }

  .sethi-cart__shipping-reminder-track {
    display: flex;
    flex-direction: column;
    animation: sethi-cart-reminder-rotate 12s ease-in-out infinite;
  }

  .sethi-cart__shipping-reminder-track span {
    display: flex;
    height: 40px;
    align-items: center;
    flex: 0 0 40px;
    color: var(--cart-muted);
    font-size: 11px;
    line-height: 1.4;
  }

  .sethi-cart__shipping-celebration {
    display: flex;
    min-height: 46px;
    margin-top: 14px;
    padding: 10px 14px;
    align-items: center;
    gap: 12px;
    background: #edf4ef;
    border-left: 3px solid #4d7659;
  }

  .sethi-cart__shipping-celebration > span {
    display: grid;
    width: 24px;
    height: 24px;
    flex: 0 0 auto;
    place-items: center;
    color: #fff;
    background: #4d7659;
    border-radius: 50%;
    font-size: 11px;
    font-weight: 700;
  }

  .sethi-cart__shipping-celebration strong,
  .sethi-cart__shipping-celebration small { display: block; }

  .sethi-cart__shipping-celebration strong {
    color: #294a34;
    font-family: var(--font-heading-family);
    font-size: 15px;
    font-weight: 400;
  }

  .sethi-cart__shipping-celebration small {
    margin-top: 3px;
    color: #55725d;
    font-size: 10px;
  }

  @keyframes sethi-cart-truck-bounce {
    0%,
    100% {
      transform: translate(-50%, -54%) translateX(0);
    }

    50% {
      transform: translate(-50%, -62%) translateX(2px);
    }
  }

  @keyframes sethi-cart-truck-arrive {
    from {
      transform: translate(-50%, -54%) translateX(-24px);
      opacity: 0;
    }

    to {
      transform: translate(-50%, -54%) translateX(0);
      opacity: 1;
    }
  }

  @keyframes sethi-cart-progress-shine {
    0%,45% { left:-28%; opacity:0; }
    52% { opacity:1; }
    78% { left:108%; opacity:.85; }
    100% { left:108%; opacity:0; }
  }

  @keyframes sethi-cart-reminder-pulse {
    0%,100% { transform:scale(1); opacity:.72; }
    50% { transform:scale(1.15); opacity:1; }
  }

  @keyframes sethi-cart-reminder-rotate {
    0%,20% { transform:translateY(0); }
    25%,45% { transform:translateY(-40px); }
    50%,70% { transform:translateY(-80px); }
    75%,95% { transform:translateY(-120px); }
    100% { transform:translateY(0); }
  }

  .sethi-cart__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(320px, 0.75fr);
    align-items: start;
    gap: 28px;
  }

  .sethi-cart__items,
  .sethi-cart__summary {
    background: var(--cart-surface);
    border: 1px solid var(--cart-line);
  }

  .sethi-cart__items-head {
    display: grid;
    grid-template-columns: 1fr 170px 130px;
    padding: 16px 22px;
    color: var(--cart-muted);
    border-bottom: 1px solid var(--cart-line);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 1.4px;
    text-transform: uppercase;
  }

  .sethi-cart__items-head span:nth-child(2),
  .sethi-cart__items-head span:nth-child(3) {
    text-align: center;
  }

  .sethi-cart__item {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr) 170px 130px;
    padding: 24px 22px;
    align-items: center;
    gap: 20px;
    border-bottom: 1px solid var(--cart-line);
  }

  .sethi-cart__image-link {
    display: block;
    padding: 10px;
    background: #f7f6f3;
  }

  .sethi-cart__image {
    display: block;
    width: 100%;
    height: 126px;
    object-fit: contain;
  }

  .sethi-cart__vendor {
    margin: 0 0 6px;
    color: var(--cart-accent);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  .sethi-cart__details h2 {
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: 20px;
    font-weight: 400;
    line-height: 1.25;
  }

  .sethi-cart__details h2 a {
    color: inherit;
    text-decoration: none;
  }

  .sethi-cart__variant {
    margin: 9px 0 0;
    color: var(--cart-muted);
    font-size: 11px;
  }

  .sethi-cart__variant div {
    display: flex;
    gap: 5px;
  }

  .sethi-cart__variant dt {
    font-weight: 600;
  }

  .sethi-cart__variant dd {
    margin: 0;
  }

  .sethi-cart__sku {
    margin: 8px 0 0;
    color: var(--cart-muted);
    font-size: 10px;
  }

  .sethi-cart__unit-price {
    display: flex;
    margin-top: 10px;
    align-items: center;
    gap: 8px;
    font-size: 13px;
  }

  .sethi-cart__unit-price s,
  .sethi-cart__line-total s {
    color: var(--cart-muted);
  }

  .sethi-cart__discounts {
    margin: 8px 0 0;
    padding: 0;
    color: #3f704d;
    font-size: 10px;
    list-style: none;
  }

  .sethi-cart__assurance {
    display: flex;
    margin-top: 12px;
    flex-wrap: wrap;
    gap: 8px;
  }

  .sethi-cart__assurance span {
    padding: 5px 7px;
    color: var(--cart-muted);
    background: #f4f0e9;
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.7px;
    text-transform: uppercase;
  }

  .sethi-cart__quantity-wrap {
    text-align: center;
  }

  .sethi-cart__quantity {
    display: grid;
    grid-template-columns: 38px 54px 38px;
    width: max-content;
    margin: 0 auto;
    border: 1px solid var(--cart-line);
  }

  .sethi-cart__qty-button,
  .sethi-cart__qty-input {
    height: 42px;
    color: var(--cart-text);
    background: #fff;
    border: 0;
    text-align: center;
  }

  .sethi-cart__qty-button {
    font-size: 18px;
    cursor: pointer;
  }

  .sethi-cart__qty-input {
    width: 54px;
    border-right: 1px solid var(--cart-line);
    border-left: 1px solid var(--cart-line);
    appearance: textfield;
  }

  .sethi-cart__qty-input::-webkit-inner-spin-button,
  .sethi-cart__qty-input::-webkit-outer-spin-button {
    margin: 0;
    appearance: none;
  }

  .sethi-cart__remove {
    display: inline-block;
    margin-top: 10px;
    color: var(--cart-muted);
    font-size: 9px;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .sethi-cart__line-total {
    text-align: right;
  }

  .sethi-cart__line-total strong,
  .sethi-cart__line-total s {
    display: block;
  }

  .sethi-cart__line-total strong {
    font-size: 14px;
  }

  .sethi-cart__utility {
    padding: 22px;
  }

  .sethi-cart__utility label {
    display: block;
    margin-bottom: 8px;
    color: var(--cart-muted);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 1.2px;
    text-transform: uppercase;
  }

  .sethi-cart__utility textarea {
    width: 100%;
    min-height: 96px;
    padding: 13px;
    resize: vertical;
    border: 1px solid var(--cart-line);
    border-radius: 0;
    font: inherit;
  }

  .sethi-cart__summary {
    position: sticky;
    top: 24px;
    padding: 28px;
  }

  .sethi-cart__summary h2 {
    font-size: 29px;
    line-height: 1.08;
  }

  .sethi-cart__summary-lines {
    margin-top: 24px;
    border-top: 1px solid var(--cart-line);
  }

  .sethi-cart__summary-lines > div {
    display: flex;
