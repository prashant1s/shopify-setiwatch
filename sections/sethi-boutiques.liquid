<section
  id="SethiBoutiques-{{ section.id }}"
  class="sethi-boutiques sethi-boutiques--{{ section.id }}"
  data-sethi-boutiques
>
  <div class="sethi-boutiques__wrap">
    <div class="sethi-boutiques__media">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 1800
          | image_tag:
            loading: 'lazy',
            widths: '700, 1000, 1400, 1800',
            sizes: '(min-width: 990px) 56vw, 100vw',
            class: 'sethi-boutiques__image',
            alt: section.settings.heading
        }}
      {% else %}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'sethi-boutiques__placeholder' }}
      {% endif %}

      <div class="sethi-boutiques__overlay"></div>

      <div class="sethi-boutiques__media-copy">
        {% if section.settings.image_eyebrow != blank %}
          <p>{{ section.settings.image_eyebrow }}</p>
        {% endif %}

        {% if section.settings.image_heading != blank %}
          <h3>{{ section.settings.image_heading }}</h3>
        {% endif %}
      </div>

      <div class="sethi-boutiques__stats">
        <div><strong>3</strong><span>Boutiques</span></div>
        <div><strong>40+</strong><span>Brands</span></div>
        <div><strong>5000+</strong><span>Timepieces</span></div>
      </div>
    </div>

    <div class="sethi-boutiques__content">
      {% if section.settings.eyebrow != blank %}
        <p class="sethi-boutiques__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="sethi-boutiques__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <p class="sethi-boutiques__description">{{ section.settings.description }}</p>
      {% endif %}

      <div class="sethi-boutiques__stores">
        {% for block in section.blocks %}
          <article
            class="sethi-store"
            data-store
            {{ block.shopify_attributes }}
          >
            <button
              type="button"
              class="sethi-store__toggle"
              data-store-toggle
              aria-expanded="false"
            >
              <span class="sethi-store__index">0{{ forloop.index }}</span>

              <span class="sethi-store__title">
                <small>{{ block.settings.city }}</small>
                <strong>{{ block.settings.store_name }}</strong>
              </span>

              <span class="sethi-store__icon" aria-hidden="true"></span>
            </button>

            <div class="sethi-store__panel">
              <div class="sethi-store__panel-inner">
                {% if block.settings.address != blank %}
                  <p class="sethi-store__address">{{ block.settings.address }}</p>
                {% endif %}

                <div class="sethi-store__meta">
                  {% if block.settings.hours != blank %}
                    <div>
                      <span>Store hours</span>
                      <strong>{{ block.settings.hours }}</strong>
                    </div>
                  {% endif %}

                  {% if block.settings.phone != blank %}
                    <div>
                      <span>Call boutique</span>
                      <strong>{{ block.settings.phone }}</strong>
                    </div>
                  {% endif %}
                </div>

                <div class="sethi-store__actions">
                  {% if block.settings.directions_link != blank %}
                    <a
                      href="{{ block.settings.directions_link }}"
                      target="_blank"
                      rel="noopener"
                      class="sethi-store__primary"
                    >
                      Get directions →
                    </a>
                  {% endif %}

                  {% if block.settings.appointment_link != blank %}
                    <a href="{{ block.settings.appointment_link }}" class="sethi-store__secondary">
                      Book appointment
                    </a>
                  {% endif %}

                  {% if block.settings.phone != blank %}
                    <a
                      href="tel:{{ block.settings.phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')' }}"
                      class="sethi-store__call"
                    >
                      Call store
                    </a>
                  {% endif %}
                </div>
              </div>
            </div>
          </article>
        {% endfor %}
      </div>

      {% if section.settings.note != blank %}
        <p class="sethi-boutiques__note">{{ section.settings.note }}</p>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .sethi-boutiques--{{ section.id }} {
    --bg: {{ section.settings.background }};
    --surface: {{ section.settings.surface }};
    --text: {{ section.settings.text_color }};
    --muted: {{ section.settings.muted_color }};
    --accent: {{ section.settings.accent_color }};
    width: 100%;
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: var(--bg);
    color: var(--text);
  }

  .sethi-boutiques--{{ section.id }} * {
    box-sizing: border-box;
  }

  .sethi-boutiques--{{ section.id }} .sethi-boutiques__wrap {
    display: grid;
    grid-template-columns: {{ section.settings.image_width }}% calc(100% - {{ section.settings.image_width }}%);
    width: min(100% - 48px, {{ section.settings.container_width }}px);
    min-height: {{ section.settings.height }}px;
    margin: 0 auto;
  }

  .sethi-boutiques--{{ section.id }} .sethi-boutiques__media {
    position: relative;
    overflow: hidden;
    background: #171513;
  }

  .sethi-boutiques--{{ section.id }} .sethi-boutiques__image,
  .sethi-boutiques--{{ section.id }} .sethi-boutiques__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_fit }};
    object-position: {{ section.settings.image_position }};
    transition: transform .9s ease;
  }

  .sethi-boutiques--{{ section.id }} .sethi-boutiques__media:hover .sethi-boutiques__image {
    transform: scale(1.025);
  }

  .sethi-boutiques--{{ section.id }} .sethi-boutiques__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,.02) 34%, rgba(0,0,0,.68) 100%);
  }

  .sethi-boutiques--{{ section.id }} .sethi-boutiques__media-copy {
    position: absolute;
    z-index: 2;
    right: 38px;
    bottom: 112px;
    left: 38px;
    color: #fff;
  }

  .sethi-boutiques--{{ section.id }} .sethi-boutiques__media-copy p,
  .sethi-boutiques--{{ section.id }} .sethi-boutiques__eyebrow {
    margin: 0 0 10px;
    color: var(--accent);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 2.4px;
    text-transform: uppercase;
  }

  .sethi-boutiques--{{ section.id }} .sethi-boutiques__media-copy p {
    color: rgba(255,255,255,.72);
  }

  .sethi-boutiques--{{ section.id }} .sethi-boutiques__media-copy h3 {
    margin: 0;
    font-family: var(--font-display-family);
    font-size: 36px;
    font-weight: 400;
    line-height: 1.05;
  }

  .sethi-boutiques--{{ section.id }} .sethi-boutiques__stats {
    position: absolute;
    z-index: 3;
    right: 0;
    bottom: 0;
    left: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    background: rgba(18,16,14,.86);
    border-top: 1px solid rgba(255,255,255,.15);
    backdrop-filter: blur(14px);
  }

  .sethi-boutiques--{{ section.id }} .sethi-boutiques__stats > div {
    padding: 18px;
    color: #fff;
    border-right: 1px solid rgba(255,255,255,.12);
  }

  .sethi-boutiques--{{ section.id }} .sethi-boutiques__stats > div:last-child {
    border-right: 0;
  }

  .sethi-boutiques--{{ section.id }} .sethi-boutiques__stats strong,
  .sethi-boutiques--{{ section.id }} .sethi-boutiques__stats span {
    display: block;
  }

  .sethi-boutiques--{{ section.id }} .sethi-boutiques__stats strong {
    font-family: var(--font-display-family);
    font-size: 22px;
    font-weight: 400;
  }

  .sethi-boutiques--{{ section.id }} .sethi-boutiques__stats span {
    margin-top: 4px;
    color: rgba(255,255,255,.62);
    font-size: 9px;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .sethi-boutiques--{{ section.id }} .sethi-boutiques__content {
    display: flex;
    min-width: 0;
    padding: 54px 56px;
    flex-direction: column;
    justify-content: center;
    background:
      radial-gradient(circle at 88% 8%, rgba(255,255,255,.9), transparent 35%),
      var(--surface);
    border: 1px solid rgba(23,21,19,.08);
  }

  .sethi-boutiques--{{ section.id }} .sethi-boutiques__heading {
    margin: 0;
    font-family: var(--font-display-family);
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 400;
    line-height: 1.03;
    letter-spacing: -.7px;
  }

  .sethi-boutiques--{{ section.id }} .sethi-boutiques__heading::after {
    content: "";
    display: block;
    width: 46px;
    height: 1px;
    margin-top: 17px;
    background: var(--accent);
  }

  .sethi-boutiques--{{ section.id }} .sethi-boutiques__description {
    max-width: 520px;
    margin: 17px 0 0;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.75;
  }

  .sethi-boutiques--{{ section.id }} .sethi-boutiques__stores {
    margin-top: 30px;
    border-top: 1px solid rgba(23,21,19,.13);
  }

  .sethi-boutiques--{{ section.id }} .sethi-store {
    border-bottom: 1px solid rgba(23,21,19,.13);
  }

  .sethi-boutiques--{{ section.id }} .sethi-store__toggle {
    display: grid;
    grid-template-columns: 32px 1fr 24px;
    width: 100%;
    padding: 20px 0;
    align-items: center;
    gap: 14px;
    color: var(--text);
    background: transparent;
    border: 0;
    text-align: left;
    cursor: pointer;
  }

  .sethi-boutiques--{{ section.id }} .sethi-store__index {
    color: var(--accent);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 1.4px;
  }

  .sethi-boutiques--{{ section.id }} .sethi-store__title small,
  .sethi-boutiques--{{ section.id }} .sethi-store__title strong {
    display: block;
  }

  .sethi-boutiques--{{ section.id }} .sethi-store__title small {
    margin-bottom: 5px;
    color: var(--muted);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 1.4px;
    text-transform: uppercase;
  }

  .sethi-boutiques--{{ section.id }} .sethi-store__title strong {
    font-family: var(--font-display-family);
    font-size: 20px;
    font-weight: 400;
  }

  .sethi-boutiques--{{ section.id }} .sethi-store__icon {
    position: relative;
    width: 18px;
    height: 18px;
  }

  .sethi-boutiques--{{ section.id }} .sethi-store__icon::before,
  .sethi-boutiques--{{ section.id }} .sethi-store__icon::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 14px;
    height: 1px;
    background: var(--text);
    transform: translate(-50%, -50%);
    transition: transform .3s ease;
  }

  .sethi-boutiques--{{ section.id }} .sethi-store__icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .sethi-boutiques--{{ section.id }} .sethi-store.is-open .sethi-store__icon::after {
    transform: translate(-50%, -50%) rotate(0);
  }

  .sethi-boutiques--{{ section.id }} .sethi-store__panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows .35s ease;
  }

  .sethi-boutiques--{{ section.id }} .sethi-store.is-open .sethi-store__panel {
    grid-template-rows: 1fr;
  }

  .sethi-boutiques--{{ section.id }} .sethi-store__panel-inner {
    min-height: 0;
    overflow: hidden;
  }

  .sethi-boutiques--{{ section.id }} .sethi-store.is-open .sethi-store__panel-inner {
    padding-bottom: 22px;
  }

  .sethi-boutiques--{{ section.id }} .sethi-store__address {
    margin: 0;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.65;
  }

  .sethi-boutiques--{{ section.id }} .sethi-store__meta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-top: 16px;
    gap: 18px;
  }

  .sethi-boutiques--{{ section.id }} .sethi-store__meta span,
  .sethi-boutiques--{{ section.id }} .sethi-store__meta strong {
    display: block;
  }

  .sethi-boutiques--{{ section.id }} .sethi-store__meta span {
    color: var(--muted);
    font-size: 9px;
    letter-spacing: 1.1px;
    text-transform: uppercase;
  }

  .sethi-boutiques--{{ section.id }} .sethi-store__meta strong {
    margin-top: 5px;
    font-size: 11px;
  }

  .sethi-boutiques--{{ section.id }} .sethi-store__actions {
    display: flex;
    margin-top: 19px;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .sethi-boutiques--{{ section.id }} .sethi-store__primary,
  .sethi-boutiques--{{ section.id }} .sethi-store__secondary {
    display: inline-flex;
    min-height: 42px;
    padding: 0 17px;
    align-items: center;
    justify-content: center;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 1.2px;
    text-decoration: none;
    text-transform: uppercase;
  }

  .sethi-boutiques--{{ section.id }} .sethi-store__primary {
    color: #fff;
    background: var(--text);
  }

  .sethi-boutiques--{{ section.id }} .sethi-store__secondary {
    color: var(--text);
    border: 1px solid rgba(23,21,19,.2);
  }

  .sethi-boutiques--{{ section.id }} .sethi-store__call {
    color: var(--text);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 1.1px;
    text-decoration: none;
    text-transform: uppercase;
  }

  .sethi-boutiques--{{ section.id }} .sethi-boutiques__note {
    margin: 22px 0 0;
    color: var(--muted);
    font-size: 11px;
    line-height: 1.6;
  }

  @media screen and (max-width: 1100px) {
    .sethi-boutiques--{{ section.id }} .sethi-boutiques__wrap {
      grid-template-columns: 1fr;
    }

    .sethi-boutiques--{{ section.id }} .sethi-boutiques__media {
      min-height: 560px;
    }
  }

  @media screen and (max-width: 749px) {
    .sethi-boutiques--{{ section.id }} {
      padding-top: calc({{ section.settings.padding_top }}px * .72);
      padding-bottom: calc({{ section.settings.padding_bottom }}px * .72);
    }

    .sethi-boutiques--{{ section.id }} .sethi-boutiques__wrap {
      width: min(100% - 28px, {{ section.settings.container_width }}px);
    }

    .sethi-boutiques--{{ section.id }} .sethi-boutiques__media {
      min-height: 470px;
    }

    .sethi-boutiques--{{ section.id }} .sethi-boutiques__media-copy {
      right: 22px;
      bottom: 112px;
      left: 22px;
    }

    .sethi-boutiques--{{ section.id }} .sethi-boutiques__media-copy h3 {
      font-size: 29px;
    }

    .sethi-boutiques--{{ section.id }} .sethi-boutiques__stats > div {
      padding: 14px 9px;
    }

    .sethi-boutiques--{{ section.id }} .sethi-boutiques__content {
      padding: 36px 22px;
    }

    .sethi-boutiques--{{ section.id }} .sethi-boutiques__heading {
      font-size: calc({{ section.settings.heading_size }}px * .72);
    }

    .sethi-boutiques--{{ section.id }} .sethi-store__meta {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  (() => {
    const initialise = (section) => {
      if (!section || section.dataset.initialised === 'true') return;
      section.dataset.initialised = 'true';

      const stores = Array.from(section.querySelectorAll('[data-store]'));

      stores.forEach((store) => {
        const toggle = store.querySelector('[data-store-toggle]');
        if (!toggle) return;

        toggle.addEventListener('click', () => {
          const wasOpen = store.classList.contains('is-open');

          stores.forEach((item) => {
            item.classList.remove('is-open');
            const button = item.querySelector('[data-store-toggle]');
            if (button) button.setAttribute('aria-expanded', 'false');
          });

          if (!wasOpen) {
            store.classList.add('is-open');
            toggle.setAttribute('aria-expanded', 'true');
          }
        });
      });
    };

    const initialiseAll = (root = document) => {
      root.querySelectorAll('[data-sethi-boutiques]').forEach(initialise);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => initialiseAll());
    } else {
      initialiseAll();
    }

    document.addEventListener('shopify:section:load', (event) => {
      initialiseAll(event.target);
    });
  })();
</script>

