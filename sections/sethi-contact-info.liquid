<section class="sethi-section sethi-contact-info" data-contact-info>
  <div class="sethi-container">
    <div class="sethi-section-header">
      {% if section.settings.eyebrow != blank %}
        <span class="sethi-eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}
      <div class="sethi-minute-track" role="presentation"></div>
      {% if section.settings.heading != blank %}
        <h1 class="sethi-heading sethi-heading--h2">{{ section.settings.heading }}</h1>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p class="sethi-subheading">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>

    <div class="sethi-contact-info__grid">
      <div class="sethi-contact-info__details">
        {% if section.settings.address != blank %}
          <div class="sethi-contact-info__row">
            <span class="sethi-contact-info__label">Visit us</span>
            <p>{{ section.settings.address }}</p>
            {% if section.settings.directions_link != blank %}
              <a href="{{ section.settings.directions_link }}" target="_blank" rel="noopener">Get directions →</a>
            {% endif %}
          </div>
        {% endif %}

        {% if section.settings.phone != blank %}
          <div class="sethi-contact-info__row">
            <span class="sethi-contact-info__label">Call us</span>
            <a href="tel:{{ section.settings.phone | remove: ' ' }}">{{ section.settings.phone }}</a>
          </div>
        {% endif %}

        {% if section.settings.whatsapp_link != blank %}
          <div class="sethi-contact-info__row">
            <span class="sethi-contact-info__label">WhatsApp</span>
            <a href="{{ section.settings.whatsapp_link }}" target="_blank" rel="noopener">{{ section.settings.whatsapp_label | default: 'Chat with us' }}</a>
          </div>
        {% endif %}

        {% if section.settings.email != blank %}
          <div class="sethi-contact-info__row">
            <span class="sethi-contact-info__label">Email</span>
            <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
          </div>
        {% endif %}

        {% if section.settings.hours != blank %}
          <div class="sethi-contact-info__row">
            <span class="sethi-contact-info__label">Hours</span>
            <p>{{ section.settings.hours }}</p>
          </div>
        {% endif %}

        {% if section.settings.appointment_link != blank %}
          <a href="{{ section.settings.appointment_link }}" target="_blank" rel="noopener" class="sethi-contact-info__appointment">
            {{ section.settings.appointment_label | default: 'Request an appointment' }}
            <span aria-hidden="true">→</span>
          </a>
        {% endif %}

        {% if section.settings.other_stores_link != blank %}
          <p class="sethi-contact-info__more"><a href="{{ section.settings.other_stores_link }}">See all our boutiques →</a></p>
        {% endif %}
      </div>

      {% if section.settings.map_embed_url != blank %}
        <div class="sethi-contact-info__map">
          <iframe
            src="{{ section.settings.map_embed_url }}"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="{{ section.settings.heading | default: 'Store location' }}"
          ></iframe>
        </div>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .sethi-contact-info__grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: var(--space-6);
    align-items: stretch;
  }
  @media screen and (max-width: 749px) {
    .sethi-contact-info__grid { grid-template-columns: 1fr; }
  }
  .sethi-contact-info__row {
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-border);
  }
  .sethi-contact-info__row:first-child { padding-top: 0; }
  .sethi-contact-info__label {
    display: block;
    font-size: 1.1rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgb(var(--color-gold));
    font-weight: 600;
    margin-bottom: 0.5rem;
  }
  .sethi-contact-info__row p {
    margin: 0;
    font-family: var(--font-body-family);
    font-size: var(--text-body);
    color: rgb(var(--color-ink));
  }
  .sethi-contact-info__row a {
    font-family: var(--font-body-family);
    font-size: var(--text-body);
    color: rgb(var(--color-ink));
    text-decoration: none;
  }
  .sethi-contact-info__row a:hover { color: rgb(var(--color-gold-deep)); }
  .sethi-contact-info__row > a[href^="tel:"],
  .sethi-contact-info__row > a[href*="wa.me"],
  .sethi-contact-info__row > a[href^="mailto:"] { display: inline-block; }
  .sethi-contact-info__row a[href^="http"]:not([href*="wa.me"]) {
    display: inline-block;
    margin-top: 0.6rem;
    font-size: 1.3rem;
    color: rgb(var(--color-gold-deep));
    text-decoration: underline;
  }
  .sethi-contact-info__appointment {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    margin-top: var(--space-4);
    padding: 1.2rem 2.2rem;
    border-radius: var(--sethi-radius-pill);
    background: rgb(var(--color-gold));
    color: rgb(var(--color-ink-inverse));
    font-family: var(--font-body-family);
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.2s ease;
  }
  .sethi-contact-info__appointment:hover { background: rgb(var(--color-gold-deep)); }
  .sethi-contact-info__more { margin-top: var(--space-4); font-size: 1.3rem; }
  .sethi-contact-info__more a { color: rgb(var(--color-gold-deep)); }
  .sethi-contact-info__map {
    min-height: 320px;
    border-radius: var(--sethi-radius-md);
    overflow: hidden;
    border: 1px solid var(--color-border);
  }
</style>

{% schema %}
{
  "name": "Contact info",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Get in touch" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Contact Us" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "textarea", "id": "address", "label": "Address" },
    { "type": "url", "id": "directions_link", "label": "Get directions link" },
    { "type": "text", "id": "phone", "label": "Phone number" },
    { "type": "url", "id": "whatsapp_link", "label": "WhatsApp link" },
    { "type": "text", "id": "whatsapp_label", "label": "WhatsApp label", "default": "Chat with us" },
    { "type": "text", "id": "email", "label": "Email address" },
    { "type": "textarea", "id": "hours", "label": "Opening hours" },
    { "type": "url", "id": "appointment_link", "label": "Appointment request link" },
    { "type": "text", "id": "appointment_label", "label": "Appointment button label", "default": "Request an appointment" },
    { "type": "url", "id": "other_stores_link", "label": "\"See all boutiques\" link" },
    { "type": "text", "id": "map_embed_url", "label": "Map embed URL (Google Maps → Share → Embed a map → copy the src URL)" }
  ],
  "presets": [{ "name": "Contact info" }]
}
{% endschema %}
