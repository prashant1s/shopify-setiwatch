{{ 'sethi-product-v2.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sethi-product-v2.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_media = current_variant.featured_media | default: product.featured_media
  assign form_id = 'SethiV2Form-' | append: section.id
  assign discount = 0
  if current_variant.compare_at_price > current_variant.price
    assign saving = current_variant.compare_at_price | minus: current_variant.price
    assign discount = saving | times: 100.0 | divided_by: current_variant.compare_at_price | round
  endif
  assign models = product.media | where: 'media_type', 'model'
  assign straps = product.metafields.custom.compatible_straps.value
  assign frequently_bought = product.metafields.custom.frequently_bought_together.value
  assign deposit_variant = product.metafields.custom.reservation_deposit_variant.value
  assign spin_images = product.metafields.custom.watch_360_images.value
-%}

<section id="SethiV2-{{ section.id }}" class="sethi-v2" data-sethi-v2 data-product-id="{{ product.id }}" data-whatsapp="{{ section.settings.whatsapp_number | remove: '+' | remove: ' ' }}">
  <div class="sethi-v2__container">
    <nav class="sethi-v2__breadcrumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      {% if product.collections.first %}<span>/</span><a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>{% endif %}
      <span>/</span><span>{{ product.title }}</span>
    </nav>

    <div class="sethi-v2__hero">
      <div class="sethi-v2-gallery">
        <div class="sethi-v2-gallery__thumbs">
          {% for media in product.media %}
            <button type="button" class="sethi-v2-gallery__thumb{% if media.id == featured_media.id %} is-active{% endif %}" data-gallery-thumb="{{ media.id }}">
              {{ media.preview_image | image_url: width: 180 | image_tag: loading: 'lazy', alt: media.alt }}
              {% if media.media_type == 'video' or media.media_type == 'external_video' %}<span>Video</span>{% elsif media.media_type == 'model' %}<span>3D</span>{% endif %}
            </button>
          {% endfor %}
          {% if spin_images != blank %}<button type="button" class="sethi-v2-gallery__thumb sethi-v2-gallery__special" data-open-360><strong>360°</strong><span>Spin</span></button>{% endif %}
        </div>

        <div class="sethi-v2-gallery__stage">
          <button type="button" class="sethi-v2-gallery__wishlist" data-wishlist aria-label="Add to wishlist">♡</button>
          {% for media in product.media %}
            <div class="sethi-v2-gallery__media" data-gallery-media="{{ media.id }}" data-media-type="{{ media.media_type }}" {% unless media.id == featured_media.id %}hidden{% endunless %}>
              {% case media.media_type %}
                {% when 'image' %}
                  <button type="button" class="sethi-v2-gallery__zoom" data-open-lightbox aria-label="Open full-screen image">⌕</button>
                  {{ media | image_url: width: 2000 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600,900,1200,1600,2000', sizes: '(min-width:990px) 55vw,100vw', class: 'sethi-v2-gallery__image', alt: media.alt }}
                {% when 'video' %}
                  {{ media | video_tag: controls: true, class: 'sethi-v2-gallery__video' }}
                {% when 'external_video' %}
                  <div class="sethi-v2-gallery__external-video">{{ media | external_video_tag }}</div>
                {% when 'model' %}
                  {{ media | model_viewer_tag: reveal: 'interaction', toggleable: true, class: 'sethi-v2-gallery__model' }}
              {% endcase %}
            </div>
          {% endfor %}

          {% if product.media.size > 1 %}
            <div class="sethi-v2-gallery__nav">
              <button type="button" data-gallery-prev aria-label="Previous media">‹</button><span><strong data-gallery-current>1</strong> / {{ product.media.size }}</span><button type="button" data-gallery-next aria-label="Next media">›</button>
            </div>
          {% endif %}

          <div class="sethi-v2-gallery__experience">
            {% if models.size > 0 %}<button type="button" data-open-3d><strong>3D</strong> View</button>{% endif %}
            {% if spin_images != blank %}<button type="button" data-open-360><strong>360°</strong> Spin</button>{% endif %}
          </div>
        </div>
      </div>

      <aside class="sethi-v2-buybox">
        <div class="sethi-v2-product-heading">
  <a
    class="sethi-v2-buybox__brand"
    href="{{ routes.collections_url }}/vendors?q={{ product.vendor | url_encode }}"
  >
    {{ product.vendor }}
  </a>

  <h1>{{ product.title }}</h1>

  {% if current_variant.sku != blank %}
    <p class="sethi-v2-buybox__model" data-product-sku>
      Model No. {{ current_variant.sku }}
    </p>
  {% endif %}

  <button
    type="button"
    class="sethi-v2-rating"
    data-scroll-reviews
  >
    <span class="sethi-v2-rating__stars">★★★★★</span>

    <strong>{{ section.settings.rating_score }}</strong>

    <small>Verified reviews</small>

    <i></i>

    <small>Ask a question</small>
  </button>
</div>

<div class="sethi-v2-price-panel">
  <div class="sethi-v2-price">
    <strong data-product-price>
      {{ current_variant.price | money }}
    </strong>

    <div class="sethi-v2-price__secondary">
      <del
        data-compare-price
        {% unless current_variant.compare_at_price > current_variant.price %}
          hidden
        {% endunless %}
      >
        {{ current_variant.compare_at_price | money }}
      </del>

      <span
        data-discount
        {% unless current_variant.compare_at_price > current_variant.price %}
          hidden
        {% endunless %}
      >
        Save {{ discount }}%
      </span>
    </div>
  </div>

  {% if current_variant.compare_at_price > current_variant.price %}
    <p class="sethi-v2-price__saving">
      You save {{ saving | money }}
    </p>
  {% endif %}

  <p class="sethi-v2-buybox__tax">
    Inclusive of all taxes
  </p>
</div>

        {% form 'product', product, id: form_id, class: 'sethi-v2-form', novalidate: 'novalidate', data-product-form: '' %}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

          {% unless product.has_only_default_variant %}
            <div class="sethi-v2-variants">
              {% for option in product.options_with_values %}
                <fieldset>
                  <legend>
                    {{ option.name }}:
                    <strong data-option-label="{{ option.position }}">
                      {{ option.selected_value }}
                    </strong>
                  </legend>

                  <div>
                    {% for value in option.values %}
                      {% assign oid = section.id | append: '-' | append: option.position | append: '-' | append: forloop.index0 %}

                      <input
                        type="radio"
                        id="{{ oid }}"
                        name="options[{{ option.name | escape }}]"
                        value="{{ value | escape }}"
                        form="{{ form_id }}"
                        data-option-input
                        data-option-position="{{ option.position }}"
                        {% if option.selected_value == value %}checked{% endif %}
                      >

                      <label for="{{ oid }}">{{ value }}</label>
                    {% endfor %}
                  </div>
                </fieldset>
              {% endfor %}
            </div>
          {% endunless %}

          <div
            class="sethi-v2-purchase"
            data-purchase-actions
            {% unless current_variant.available %}hidden{% endunless %}
          >
            <button
              type="submit"
              class="sethi-v2-button sethi-v2-button--outline"
              data-add-cart
            >
              <span data-add-cart-text>Add to cart</span>
            </button>

            <button
              type="button"
              class="sethi-v2-button sethi-v2-button--dark"
              data-buy-now
            >
              Buy now
            </button>
          </div>

          <div
            class="sethi-v2-stock{% unless current_variant.available %} is-out{% endunless %}"
            data-stock
          >
            <span></span>

            <div>
              <strong data-stock-title>
                {% if current_variant.available %}
                  In stock
                {% else %}
                  Currently unavailable
                {% endif %}
              </strong>

              <small data-stock-message>
                {% if current_variant.available %}
                  Ready for dispatch
                {% else %}
                  Submit an enquiry and our watch expert will contact you.
                {% endif %}
              </small>
            </div>
          </div>

          <div
            class="sethi-v2-enquiry"
            data-enquiry
            {% if current_variant.available %}hidden{% endif %}
          >
            <span class="sethi-v2-enquiry__eyebrow">Availability assistance</span>
            <strong>Enquire about this watch</strong>
            <p>
              Share your details and our watch expert will help with availability,
              expected restock or an alternative timepiece.
            </p>

            <div class="sethi-v2-enquiry__fields">
              <input
                type="text"
                placeholder="Your name"
                data-enquiry-name
              >

              <input
                type="tel"
                placeholder="Phone number"
                data-enquiry-phone
              >
            </div>

            <button
              type="button"
              class="sethi-v2-button sethi-v2-button--dark"
              data-submit-enquiry
            >
              Submit enquiry
            </button>

            <button
              type="button"
              class="sethi-v2-button sethi-v2-button--outline"
              data-notify-me
            >
              Notify me when available
            </button>

            <p data-enquiry-message></p>
          </div>

          <div class="sethi-v2-service-menu">
            <div class="sethi-v2-service-menu__heading">
              <span>Premium services</span>
              <strong>More ways to experience this timepiece</strong>
            </div>

            <div class="sethi-v2-service-menu__grid">
              <button
                type="button"
                class="sethi-v2-service-tile"
                data-open-dialog="emi"
              >
                <span class="sethi-v2-service-tile__icon">₹</span>

                <span class="sethi-v2-service-tile__copy">
                  <strong>EMI options</strong>
                  <small>No-cost EMI and bank plans</small>
                </span>

                <b>View</b>
              </button>

              <button
                type="button"
                class="sethi-v2-service-tile"
                data-open-dialog="tryon"
              >
                <span class="sethi-v2-service-tile__icon">AR</span>

                <span class="sethi-v2-service-tile__copy">
                  <strong>Virtual try-on</strong>
                  <small>Preview the watch on your wrist</small>
                </span>

                <b>Explore</b>
              </button>

              <button
                type="button"
                class="sethi-v2-service-tile"
                data-open-reservation
              >
                <span class="sethi-v2-service-tile__icon">⌂</span>

                <span class="sethi-v2-service-tile__copy">
                  <strong>Book in store</strong>
                  <small>Reserve a boutique visit</small>
                </span>

                <b>Reserve</b>
              </button>
            </div>

            {% if models.size > 0 or spin_images != blank %}
              <div class="sethi-v2-service-menu__interactive">
                <span>Interactive product view</span>

                <div>
                  {% if models.size > 0 %}
                    <button type="button" data-open-3d>3D View</button>
                  {% endif %}

                  {% if spin_images != blank %}
                    <button type="button" data-open-360>360° Spin</button>
                  {% endif %}
                </div>
              </div>
            {% endif %}
          </div>

          <div class="sethi-v2-delivery">
            <strong>Check delivery and availability</strong>
            <small>Enter your pincode for an estimated delivery timeline.</small>

            <div>
              <input
                type="text"
                inputmode="numeric"
                maxlength="6"
                placeholder="Enter 6-digit pincode"
                data-pincode
              >

              <button type="button" data-check-pincode>Check</button>
            </div>

            <p data-delivery-result hidden></p>

            <footer>
              <span>Free insured shipping</span>
              <span>COD eligibility</span>
              <span>Boutique assistance</span>
            </footer>
          </div>
        {% endform %}

<div class="sethi-v2-trust">
  <article>
    <span class="sethi-v2-trust__icon">
      <svg viewBox="0 0 24 24" fill="none">
        <path d="M12 3L19 6V11C19 15.5 16.2 19.6 12 21C7.8 19.6 5 15.5 5 11V6L12 3Z" stroke="currentColor" stroke-width="1.5"/>
        <path d="M9 12L11 14L15 10" stroke="currentColor" stroke-width="1.5"/>
      </svg>
    </span>

    <div>
      <strong>100% Authentic</strong>
      <small>Original timepiece</small>
    </div>
  </article>

  <article>
    <span class="sethi-v2-trust__icon">
      <svg viewBox="0 0 24 24" fill="none">
        <circle cx="12" cy="9" r="6" stroke="currentColor" stroke-width="1.5"/>
        <path d="M8.5 14L7 21L12 18L17 21L15.5 14" stroke="currentColor" stroke-width="1.5"/>
      </svg>
    </span>

    <div>
      <strong>Official Warranty</strong>
      <small>Brand-backed cover</small>
    </div>
  </article>

  <article>
    <span class="sethi-v2-trust__icon">
      <svg viewBox="0 0 24 24" fill="none">
        <rect x="3" y="6" width="18" height="13" rx="2" stroke="currentColor" stroke-width="1.5"/>
        <path d="M3 10H21M7 15H10" stroke="currentColor" stroke-width="1.5"/>
      </svg>
    </span>

    <div>
      <strong>Secure Payments</strong>
      <small>Protected checkout</small>
    </div>
  </article>

  <article>
    <span class="sethi-v2-trust__icon">
      <svg viewBox="0 0 24 24" fill="none">
        <path d="M20 7V12H15" stroke="currentColor" stroke-width="1.5"/>
        <path d="M18.5 16A8 8 0 1 1 20 12" stroke="currentColor" stroke-width="1.5"/>
      </svg>
    </span>

    <div>
      <strong>Easy Assistance</strong>
      <small>Expert support</small>
    </div>
  </article>
</div>
        <div class="sethi-v2-accordions">
          <details><summary>Product description <strong>+</strong></summary><div class="rte">{{ product.description }}</div></details>
          <details>
  <summary>
    Product specifications
    <strong>+</strong>
  </summary>

  <div class="sethi-v2-specs">

    <article>
      <span>Brand</span>
      <strong>{{ product.vendor }}</strong>
    </article>

    {% if current_variant.sku != blank %}
      <article>
        <span>Model</span>
        <strong>{{ current_variant.sku }}</strong>
      </article>
    {% endif %}

    {% if product.metafields.custom.watch_collection.value != blank %}
      <article>
        <span>Watch Collection</span>
        <strong>{{ product.metafields.custom.watch_collection.value }}</strong>
      </article>
    {% endif %}

    {% if product.metafields.custom.watch_color.value != blank %}
      <article>
        <span>Watch Color</span>
        <strong>{{ product.metafields.custom.watch_color.value }}</strong>
      </article>
    {% endif %}

    {% if product.metafields.custom.case_shape.value != blank %}
      <article>
        <span>Case Shape</span>
        <strong>{{ product.metafields.custom.case_shape.value }}</strong>
      </article>
    {% endif %}

    {% if product.metafields.custom.case_size.value != blank %}
      <article>
        <span>Case Size</span>
        <strong>{{ product.metafields.custom.case_size.value }}</strong>
      </article>
    {% endif %}

    {% if product.metafields.custom.strap_material.value != blank %}
      <article>
        <span>Strap Material</span>
        <strong>{{ product.metafields.custom.strap_material.value }}</strong>
      </article>
    {% endif %}

    {% if product.metafields.custom.movement.value != blank %}
      <article>
        <span>Movement</span>
        <strong>{{ product.metafields.custom.movement.value }}</strong>
      </article>
    {% endif %}

    {% if product.metafields.custom.product_details.value != blank %}
      <article>
        <span>Specification</span>
        <strong>{{ product.metafields.custom.product_details.value }}</strong>
      </article>
    {% endif %}

    {% if product.metafields.custom.warranty_.value != blank %}
      <article>
        <span>Warranty</span>
        <strong>{{ product.metafields.custom.warranty_.value }}</strong>
      </article>
    {% endif %}

    {% assign category_color = product.metafields.shopify['color'] %}
    {% if category_color.value != blank %}
      <article>
        <span>Color</span>
        <strong>{{ category_color.value }}</strong>
      </article>
    {% endif %}

    {% assign dial_color = product.metafields.shopify['dial-color'] %}
    {% if dial_color.value != blank %}
      <article>
        <span>Dial Color</span>
        <strong>{{ dial_color.value }}</strong>
      </article>
    {% endif %}

    {% assign band_color = product.metafields.shopify['band-color'] %}
    {% if band_color.value != blank %}
      <article>
        <span>Band Color</span>
        <strong>{{ band_color.value }}</strong>
      </article>
    {% endif %}

    {% assign case_color = product.metafields.shopify['case-color'] %}
    {% if case_color.value != blank %}
      <article>
        <span>Case Color</span>
        <strong>{{ case_color.value }}</strong>
      </article>
    {% endif %}

    {% assign material = product.metafields.shopify['material'] %}
    {% if material.value != blank %}
      <article>
        <span>Material</span>
        <strong>{{ material.value }}</strong>
      </article>
    {% endif %}

    {% assign watch_material = product.metafields.shopify['watch-material'] %}
    {% if watch_material.value != blank %}
      <article>
        <span>Watch Material</span>
        <strong>{{ watch_material.value }}</strong>
      </article>
    {% endif %}

    {% assign target_gender = product.metafields.shopify['target-gender'] %}
    {% if target_gender.value != blank %}
      <article>
        <span>Target Gender</span>
        <strong>{{ target_gender.value }}</strong>
      </article>
    {% endif %}

    {% assign age_group = product.metafields.shopify['age-group'] %}
    {% if age_group.value != blank %}
      <article>
        <span>Age Group</span>
        <strong>{{ age_group.value }}</strong>
      </article>
    {% endif %}

    {% assign watch_display = product.metafields.shopify['watch-display'] %}
    {% if watch_display.value != blank %}
      <article>
        <span>Watch Display</span>
        <strong>{{ watch_display.value }}</strong>
      </article>
    {% endif %}

    {% assign watch_features = product.metafields.shopify['watch-features'] %}
    {% if watch_features.value != blank %}
      <article>
        <span>Watch Features</span>
        <strong>
          {% if watch_features.list? %}
            {{ watch_features.value | join: ', ' }}
          {% else %}
            {{ watch_features.value }}
          {% endif %}
        </strong>
      </article>
    {% endif %}

    {% assign accessory_style = product.metafields.shopify['watch-accessory-style'] %}
    {% if accessory_style.value != blank %}
      <article>
        <span>Watch Accessory Style</span>
        <strong>{{ accessory_style.value }}</strong>
      </article>
    {% endif %}

  </div>
</details>
<details>
  <summary>
    Offers and EMI
    <strong>+</strong>
  </summary>

  <div class="sethi-v2-offers">
    <article class="sethi-v2-offer-card">
      <span class="sethi-v2-offer-card__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <rect
            x="3"
            y="6"
            width="18"
            height="13"
            rx="2"
            stroke="currentColor"
            stroke-width="1.5"
          />
          <path
            d="M3 10H21M7 15H11"
            stroke="currentColor"
            stroke-width="1.5"
          />
        </svg>
      </span>

      <div>
        <strong>Bank offers</strong>
        <span>
          Additional savings on eligible credit and debit cards.
        </span>
      </div>
    </article>

    <article class="sethi-v2-offer-card">
      <span class="sethi-v2-offer-card__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <circle
            cx="12"
            cy="12"
            r="9"
            stroke="currentColor"
            stroke-width="1.5"
          />
          <path
            d="M8 8H16M8 12H14M10 16L15 8"
            stroke="currentColor"
            stroke-width="1.5"
          />
        </svg>
      </span>

      <div>
        <strong>No-cost EMI</strong>
        <span>
          Flexible monthly payment plans on selected methods.
        </span>
      </div>
    </article>

    <article class="sethi-v2-offer-card">
      <span class="sethi-v2-offer-card__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <rect
            x="4"
            y="9"
            width="16"
            height="11"
            rx="1.5"
            stroke="currentColor"
            stroke-width="1.5"
          />
          <path
            d="M12 9V20M4 13H20M8.5 9C7 9 6 8.2 6 7C6 5.8 7 5 8.2 5C10 5 12 9 12 9M15.5 9C17 9 18 8.2 18 7C18 5.8 17 5 15.8 5C14 5 12 9 12 9"
            stroke="currentColor"
            stroke-width="1.5"
          />
        </svg>
      </span>

      <div>
        <strong>Complimentary gift wrap</strong>
        <span>
          Premium gift packaging available for special occasions.
        </span>
      </div>
    </article>
  </div>
</details>
          <details><summary>Warranty and returns <strong>+</strong></summary><div><p>Includes applicable manufacturer warranty, original packaging and documents.</p></div></details>
        </div>
      </aside>
    </div>

    <section class="sethi-v2-section sethi-v2-bundle" data-bundle>
      <header><span>Pair it your way</span><h2>Complete your watch</h2><p>Choose compatible straps and accessories.</p></header>
      <div class="sethi-v2-bundle__layout">
        <article class="sethi-v2-bundle__main" data-bundle-item data-variant-id="{{ current_variant.id }}" data-price="{{ current_variant.price }}">
          {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: product.title }}
          <div><small>Selected watch</small><strong>{{ product.title }}</strong><span>{{ current_variant.price | money }}</span></div>
        </article>
        <div class="sethi-v2-bundle__products">
          {% assign strap_count = 0 %}
          {% if straps != blank %}
            {% for item in straps limit: 4 %}
              {% assign v = item.selected_or_first_available_variant %}
              {% if v.available %}
                {% assign strap_count = strap_count | plus: 1 %}
                <article data-bundle-item data-price="{{ v.price }}"><label><input type="checkbox" value="{{ v.id }}" data-bundle-checkbox><span></span></label>{{ item.featured_image | image_url: width: 450 | image_tag: loading: 'lazy', alt: item.title }}<div><small>Compatible strap</small><strong>{{ item.title }}</strong><span>{{ v.price | money }}</span></div></article>
              {% endif %}
            {% endfor %}
          {% endif %}
          {% if strap_count == 0 %}
  <div class="sethi-v2-bundle__empty">
    <div>
      <span>Compatible accessories</span>
      <strong>Straps and watch accessories coming soon</strong>
      <p>
        Speak to our watch expert for compatible strap and accessory options.
      </p>
    </div>

    <a
      href="https://wa.me/{{ section.settings.whatsapp_number | remove: '+' | remove: ' ' }}?text={{ 'Hello, I need compatible accessories for ' | append: product.title | url_encode }}"
      target="_blank"
      rel="noopener"
    >
      Ask an expert
    </a>
  </div>
{% endif %}
        </div>
        <aside class="sethi-v2-bundle__summary"><small>Bundle total</small><strong data-bundle-total>{{ current_variant.price | money }}</strong><span><b data-bundle-count>1</b> item selected</span><button type="button" class="sethi-v2-button sethi-v2-button--dark" data-add-bundle>Add selected bundle</button><p data-bundle-message></p></aside>
      </div>
    </section>

{% if frequently_bought != blank %}
  <section class="sethi-v2-section">
    <header>
      <span>Customers also choose</span>
      <h2>Frequently purchased together</h2>
    </header>

    <div class="sethi-v2-products">
      {% for item_product in frequently_bought limit: 5 %}
        {% render 'sethi-product-card-v2',
          card_product: item_product
        %}
      {% endfor %}
    </div>
  </section>
{% endif %}
<header class="sethi-v2-section-header sethi-v2-section-header--trending">
  <div class="sethi-v2-section-icon" aria-hidden="true">
    ↗
  </div>

  <div>
    <span>Trending now</span>
    <h2>Watches everyone is watching</h2>
    <p>
      Discover this week's most-viewed and most-wanted timepieces.
    </p>
  </div>
</header>
    <section class="sethi-v2-section sethi-v2-reviews" data-reviews><header><span>Customer experiences</span><h2>Reviews</h2></header><div class="sethi-v2-reviews__layout"><aside><strong>{{ section.settings.rating_score }}</strong><span>★★★★★</span><p>Customer rating</p></aside><div>{% for block in section.blocks %}{% if block.type == 'review' %}<article {{ block.shopify_attributes }}><span>★★★★★</span><h3>{{ block.settings.heading }}</h3><p>{{ block.settings.review }}</p><strong>{{ block.settings.customer }}</strong><small>Verified buyer</small></article>{% endif %}{% endfor %}</div></div></section>

    <section class="sethi-v2-section"><header><span>More options</span><h2>Similar watches</h2></header><div class="sethi-v2-products" data-recommendations data-product-id="{{ product.id }}" data-limit="5"><div class="sethi-v2-empty">Loading similar watches…</div></div></section>

    <section class="sethi-v2-section">
      <header>
        <span>{{ product.vendor }}</span>
        <h2>More from the same brand</h2>
      </header>
      <div
        class="sethi-v2-products"
        data-same-brand-products
        data-vendor="{{ product.vendor | escape }}"
        data-current-product="{{ product.id }}"
      >
        <div class="sethi-v2-empty">Loading more {{ product.vendor }} watches…</div>
      </div>
    </section>

    <section class="sethi-v2-section sethi-v2-faq"><header><span>Need help?</span><h2>Frequently asked questions</h2></header><div>{% for block in section.blocks %}{% if block.type == 'faq' %}<details {{ block.shopify_attributes }}><summary>{{ block.settings.question }} <strong>+</strong></summary><div>{{ block.settings.answer }}</div></details>{% endif %}{% endfor %}</div></section>
  </div>

  <div class="sethi-v2-sticky" data-sticky-bar><div>{{ product.featured_image | image_url: width: 100 | image_tag: loading: 'lazy', width: 54, height: 54, alt: product.title }}<p><span>{{ product.title | truncate: 35 }}</span><strong data-sticky-price>{{ current_variant.price | money }}</strong></p></div><button type="button" class="sethi-v2-button sethi-v2-button--dark" data-sticky-cart {% unless current_variant.available %}data-action="enquiry"{% endunless %}>{% if current_variant.available %}Add to cart{% else %}Enquire now{% endif %}</button></div>

  <dialog class="sethi-v2-dialog sethi-v2-lightbox" data-dialog="lightbox"><button type="button" data-close-dialog>×</button><div data-lightbox-content></div></dialog>
  <dialog class="sethi-v2-dialog" data-dialog="emi"><button type="button" data-close-dialog>×</button><div class="sethi-v2-dialog__content"><span>Payment options</span><h2>Available EMI plans</h2><p>Final eligibility appears at checkout.</p></div></dialog>
  <dialog class="sethi-v2-dialog" data-dialog="tryon"><button type="button" data-close-dialog>×</button><div class="sethi-v2-dialog__content"><span>Virtual experience</span><h2>Try this watch on your wrist</h2><p>Available when a supported AR model is assigned.</p></div></dialog>
  <dialog class="sethi-v2-dialog" data-dialog="360"><button type="button" data-close-dialog>×</button><div class="sethi-v2-dialog__content"><span>Interactive view</span><h2>360° watch view</h2><div data-360-viewer data-images="{{ spin_images | json | escape }}"></div></div></dialog>

  <dialog class="sethi-v2-dialog" data-dialog="reservation"><button type="button" data-close-dialog>×</button><div class="sethi-v2-dialog__content"><span>Reserve in boutique</span><h2>Reserve your timepiece</h2><p>Pay the configured advance and collect from your selected store.</p>
    <div class="sethi-v2-reservation__steps">
      <label><span>Store</span><select data-reservation-store><option value="">Select boutique</option>{% for block in section.blocks %}{% if block.type == 'store' %}<option value="{{ block.settings.name | escape }}">{{ block.settings.name }}</option>{% endif %}{% endfor %}</select></label>
      <label><span>Pickup date</span><input type="date" data-reservation-date></label>
      <label><span>Time slot</span><select data-reservation-slot><option value="">Select time</option><option>11:00 AM</option><option>12:00 PM</option><option>2:00 PM</option><option>4:00 PM</option><option>6:00 PM</option></select></label>
      <label><span>Name</span><input type="text" data-reservation-name></label><label><span>Phone</span><input type="tel" data-reservation-phone></label><label><span>Email</span><input type="email" data-reservation-email></label>
    </div>
    <div class="sethi-v2-reservation__summary"><span>Reservation advance</span><strong>{% if deposit_variant != blank %}{{ deposit_variant.price | money }}{% else %}Configure deposit variant{% endif %}</strong></div>
    <button type="button" class="sethi-v2-button sethi-v2-button--dark" data-pay-reservation data-deposit-variant="{% if deposit_variant != blank %}{{ deposit_variant.id }}{% endif %}">Pay advance and reserve</button><p data-reservation-message></p>
  </div></dialog>

  <script type="application/json" data-variants-json>{{ product.variants | json }}</script>
</section>

