<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">
<script src="{{ 'sethi-product-v3.js' | asset_url }}" defer="defer"></script>

{% liquid
  assign variant = product.selected_or_first_available_variant
  assign featured = variant.featured_media | default: product.featured_media
  assign product_form_id = 'SethiV3Form-' | append: section.id
  assign display_title = product.metafields.custom.display_title.value | default: product.title
  if variant.sku != blank and display_title contains variant.sku
    assign display_title = display_title | remove: variant.sku | strip
  endif
  assign models = product.media | where: 'media_type', 'model'
  assign spin_images = product.metafields.custom.watch_360_images.value
  assign deposit_variant = product.metafields.custom.reservation_deposit_variant.value
  assign rating_value = product.metafields.reviews.rating.value.rating
  assign rating_count = product.metafields.reviews.rating_count.value | default: 0 | plus: 0
  assign units_sold = product.metafields.custom.units_sold.value | default: 0 | plus: 0
  assign is_expensive_watch = false
  if variant.price >= 5000000 or product.tags contains 'premium-watch' or product.tags contains 'luxury-watch'
    assign is_expensive_watch = true
  endif
  assign is_best_seller = false
  if units_sold > 4 or product.tags contains 'best-seller'
    assign is_best_seller = true
  endif
  assign is_new_arrival = false
  assign arrival_date = product.metafields.custom.stock_added_date.value | default: product.published_at
  if arrival_date != blank
    assign current_timestamp = 'now' | date: '%s' | plus: 0
    assign arrival_timestamp = arrival_date | date: '%s' | plus: 0
    assign product_age = current_timestamp | minus: arrival_timestamp
    if product_age >= 0 and product_age <= 1296000
      assign is_new_arrival = true
    endif
  endif
  assign information_blocks = section.blocks | where: 'type', 'content_accordion'
  assign faq_blocks = section.blocks | where: 'type', 'faq'
  assign showroom_blocks = section.blocks | where: 'type', 'showroom'
  assign specification_namespace = section.settings.specification_namespace | default: 'custom'
  assign specification_key = section.settings.specification_key | default: 'specifications'
  assign specification_metafield = product.metafields.custom.product_details
  if specification_metafield == blank
    assign specification_metafield = product.metafields[specification_namespace][specification_key]
  endif
  assign spec_color = product.metafields.shopify['color-pattern']
  if spec_color == blank
    assign spec_color = product.metafields.shopify['color']
  endif
  assign spec_band_color = product.metafields.shopify['band-color']
  assign spec_case_color = product.metafields.shopify['case-color']
  assign spec_dial_color = product.metafields.shopify['dial-color']
  assign spec_material = product.metafields.shopify['material']
  assign spec_watch_material = product.metafields.shopify['watch-material']
  assign spec_age_group = product.metafields.shopify['age-group']
  assign spec_target_gender = product.metafields.shopify['target-gender']
  assign spec_display = product.metafields.shopify['watch-display']
  assign spec_features = product.metafields.shopify['watch-features']
  assign spec_movement = product.metafields.shopify['clock-movement-type']
  if spec_movement == blank
    assign spec_movement = product.metafields.custom.movement
  endif
  assign spec_case_shape = product.metafields.custom.case_shape
  assign spec_collection = product.metafields.custom.watch_collection
  assign spec_watch_color = product.metafields.custom.watch_color
  assign spec_strap_material = product.metafields.custom.strap_material
  assign spec_case_size = product.metafields.custom.case_size
  assign spec_warranty = product.metafields.custom.warranty_
  assign structured_spec_count = 0
  if spec_color != blank
    assign structured_spec_count = structured_spec_count | plus: 1
  endif
  if spec_band_color != blank
    assign structured_spec_count = structured_spec_count | plus: 1
  endif
  if spec_case_color != blank
    assign structured_spec_count = structured_spec_count | plus: 1
  endif
  if spec_dial_color != blank
    assign structured_spec_count = structured_spec_count | plus: 1
  endif
  if spec_material != blank
    assign structured_spec_count = structured_spec_count | plus: 1
  endif
  if spec_watch_material != blank
    assign structured_spec_count = structured_spec_count | plus: 1
  endif
  if spec_age_group != blank
    assign structured_spec_count = structured_spec_count | plus: 1
  endif
  if spec_target_gender != blank
    assign structured_spec_count = structured_spec_count | plus: 1
  endif
  if spec_display != blank
    assign structured_spec_count = structured_spec_count | plus: 1
  endif
  if spec_features != blank
    assign structured_spec_count = structured_spec_count | plus: 1
  endif
  if spec_movement != blank
    assign structured_spec_count = structured_spec_count | plus: 1
  endif
  if spec_case_shape != blank
    assign structured_spec_count = structured_spec_count | plus: 1
  endif
  if spec_collection != blank
    assign structured_spec_count = structured_spec_count | plus: 1
  endif
  if spec_watch_color != blank
    assign structured_spec_count = structured_spec_count | plus: 1
  endif
  if spec_strap_material != blank
    assign structured_spec_count = structured_spec_count | plus: 1
  endif
  if spec_case_size != blank
    assign structured_spec_count = structured_spec_count | plus: 1
  endif
  if spec_warranty != blank
    assign structured_spec_count = structured_spec_count | plus: 1
  endif
  assign app_block_count = 0
  assign visible_faq_count = 0
  assign vendor_handle = product.vendor | handle
  for utility_block in section.blocks
    if utility_block.type == '@app'
      assign app_block_count = app_block_count | plus: 1
    elsif utility_block.type == 'faq'
      assign faq_brand_handle = utility_block.settings.brand | handle
      if utility_block.settings.brand == blank or faq_brand_handle == vendor_handle
        assign visible_faq_count = visible_faq_count | plus: 1
      endif
    endif
  endfor
%}

{% style %}
  #SethiV3-{{ section.id }} {
    --sv3-body: "Manrope", sans-serif;
    --sv3-display: "Cormorant Garamond", serif;
    --sv3-border: color-mix(in srgb, var(--sv3-ink) 14%, transparent);
    --sv3-muted: color-mix(in srgb, var(--sv3-ink) 62%, transparent);
    --sv3-shadow: 0 22px 65px rgba(20, 18, 13, 0.08);
    display: block;
    width: 100%;
    max-width: 1560px;
    margin: 0 auto;
    padding: 0 clamp(18px, 4vw, 72px) 100px;
    overflow: clip;
    background: var(--sv3-paper);
    color: var(--sv3-ink);
    font-family: var(--sv3-body);
    font-size: 15px;
    line-height: 1.55;
  }

  #SethiV3-{{ section.id }} *,
  #SethiV3-{{ section.id }} *::before,
  #SethiV3-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #SethiV3-{{ section.id }} button,
  #SethiV3-{{ section.id }} input,
  #SethiV3-{{ section.id }} select,
  #SethiV3-{{ section.id }} textarea {
    font: inherit;
  }

  #SethiV3-{{ section.id }} button,
  #SethiV3-{{ section.id }} summary,
  #SethiV3-{{ section.id }} a {
    -webkit-tap-highlight-color: transparent;
  }

  #SethiV3-{{ section.id }} button:focus-visible,
  #SethiV3-{{ section.id }} summary:focus-visible,
  #SethiV3-{{ section.id }} a:focus-visible,
  #SethiV3-{{ section.id }} input:focus-visible,
  #SethiV3-{{ section.id }} select:focus-visible,
  #SethiV3-{{ section.id }} textarea:focus-visible {
    outline: 2px solid var(--sv3-accent);
    outline-offset: 3px;
  }

  #SethiV3-{{ section.id }} [hidden] {
    display: none !important;
  }

  #SethiV3-{{ section.id }} .sv3__breadcrumbs {
    display: flex;
    align-items: center;
    gap: 9px;
    min-height: 54px;
    overflow: hidden;
    color: var(--sv3-muted);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  #SethiV3-{{ section.id }} .sv3__breadcrumbs a {
    color: inherit;
    text-decoration: none;
    transition: color 180ms ease;
  }

  #SethiV3-{{ section.id }} .sv3__breadcrumbs a:hover {
    color: var(--sv3-ink);
  }

  #SethiV3-{{ section.id }} .sv3__breadcrumbs > span:last-child {
    min-width: 0;
    overflow: hidden;
    color: var(--sv3-ink);
    text-overflow: ellipsis;
  }

  #SethiV3-{{ section.id }} .sv3__hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(390px, 0.85fr);
    align-items: start;
    gap: clamp(42px, 6vw, 92px);
    padding-top: 12px;
  }

  #SethiV3-{{ section.id }} .sv3-gallery {
    position: sticky;
    top: 20px;
    display: grid;
    grid-template-columns: 76px minmax(0, 1fr);
    align-items: start;
    gap: 14px;
    min-width: 0;
  }

  #SethiV3-{{ section.id }} .sv3-gallery__thumbs {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-height: 650px;
    padding: 2px;
    overflow: auto;
    scrollbar-width: none;
  }

  #SethiV3-{{ section.id }} .sv3-gallery__thumbs::-webkit-scrollbar {
    display: none;
  }

  #SethiV3-{{ section.id }} .sv3-thumb {
    position: relative;
    display: grid;
    place-items: center;
    width: 72px;
    height: 82px;
    flex: 0 0 82px;
    padding: 5px;
    overflow: hidden;
    border: 1px solid transparent;
    border-radius: 0;
    background: var(--sv3-soft);
    color: var(--sv3-ink);
    cursor: pointer;
    transition: border-color 180ms ease, background 180ms ease, transform 180ms ease;
  }

  #SethiV3-{{ section.id }} .sv3-thumb:hover {
    transform: translateY(-2px);
  }

  #SethiV3-{{ section.id }} .sv3-thumb.is-active {
    border-color: var(--sv3-ink);
    background: var(--sv3-paper);
  }

  #SethiV3-{{ section.id }} .sv3-thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  #SethiV3-{{ section.id }} .sv3-thumb > span {
    position: absolute;
    right: 4px;
    bottom: 4px;
    padding: 2px 5px;
    background: var(--sv3-ink);
    color: #fff;
    font-size: 8px;
    font-style: normal;
  }

  #SethiV3-{{ section.id }} .sv3-thumb--special {
    border-color: var(--sv3-border);
    background: var(--sv3-paper);
    font-size: 12px;
    letter-spacing: 0.06em;
  }

  #SethiV3-{{ section.id }} .sv3-gallery__stage {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    min-height: 640px;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--sv3-ink) 8%, transparent);
    background: linear-gradient(145deg, #fbfaf7 0%, var(--sv3-soft) 100%);
  }

  #SethiV3-{{ section.id }} .sv3-media {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: clamp(24px, 5vw, 76px);
  }

  #SethiV3-{{ section.id }} .sv3-media > img,
  #SethiV3-{{ section.id }} .sv3-media video,
  #SethiV3-{{ section.id }} .sv3-media iframe,
  #SethiV3-{{ section.id }} .sv3-media model-viewer {
    display: block;
    width: 100%;
    height: 100%;
    max-height: 570px;
    object-fit: contain;
    transition: transform 500ms cubic-bezier(.2,.65,.25,1);
  }

  #SethiV3-{{ section.id }} .sv3-media[data-media-type="image"]:hover > img {
    transform: scale(1.035);
  }

  #SethiV3-{{ section.id }} .sv3-gallery__badge {
    position: absolute;
    z-index: 4;
    top: 18px;
    left: 18px;
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 5px 10px;
    background: var(--sv3-paper);
    color: var(--sv3-ink);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    box-shadow: 0 5px 18px rgba(0,0,0,.06);
  }

  #SethiV3-{{ section.id }} .sv3-icon-button {
    position: absolute;
    z-index: 4;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid var(--sv3-border);
    border-radius: 50%;
    background: rgba(255,255,255,.9);
    color: var(--sv3-ink);
    font-size: 22px;
    cursor: pointer;
    backdrop-filter: blur(8px);
    transition: color 180ms ease, border-color 180ms ease, transform 180ms ease;
  }

  #SethiV3-{{ section.id }} .sv3-icon-button:hover {
    border-color: var(--sv3-accent);
    color: var(--sv3-accent);
    transform: translateY(-2px);
  }

  #SethiV3-{{ section.id }} .sv3-gallery__wish { top: 18px; right: 18px; }
  #SethiV3-{{ section.id }} .sv3-gallery__zoom { right: 18px; bottom: 18px; }

  #SethiV3-{{ section.id }} .sv3-gallery__counter {
    position: absolute;
    z-index: 4;
    bottom: 18px;
    left: 50%;
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 38px;
    padding: 4px 8px;
    background: rgba(255,255,255,.9);
    box-shadow: 0 7px 24px rgba(0,0,0,.06);
    transform: translateX(-50%);
    backdrop-filter: blur(8px);
  }

  #SethiV3-{{ section.id }} .sv3-gallery__counter button {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--sv3-ink);
    font-size: 24px;
    cursor: pointer;
  }

  #SethiV3-{{ section.id }} .sv3-gallery__counter span {
    min-width: 48px;
    text-align: center;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .06em;
  }

  #SethiV3-{{ section.id }} .sv3-gallery__actions {
    grid-column: 2;
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 44px;
    color: var(--sv3-muted);
    font-size: 11px;
  }

  #SethiV3-{{ section.id }} .sv3-gallery__actions > button {
    padding: 8px 0;
    border: 0;
    border-bottom: 1px solid var(--sv3-ink);
    background: transparent;
    color: var(--sv3-ink);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .04em;
    cursor: pointer;
  }

  #SethiV3-{{ section.id }} .sv3-buybox {
    position: relative !important;
    z-index: 2;
    display: block !important;
    visibility: visible !important;
    width: 100% !important;
    height: auto !important;
    max-height: none !important;
    min-width: 0;
    padding-top: 6px;
    overflow: visible !important;
    opacity: 1 !important;
    transform: none !important;
    color: var(--sv3-ink, #171614);
  }

  #SethiV3-{{ section.id }} .sv3-form {
    position: relative !important;
    display: flex !important;
    visibility: visible !important;
    width: 100% !important;
    height: auto !important;
    max-height: none !important;
    flex-direction: column;
    gap: 0;
    overflow: visible !important;
    opacity: 1 !important;
    transform: none !important;
  }

  #SethiV3-{{ section.id }} .sv3-form > *:not([hidden]) {
    visibility: visible !important;
    opacity: 1 !important;
  }

  #SethiV3-{{ section.id }} .sv3-title {
    padding-bottom: 15px;
    border-bottom: 1px solid var(--sv3-border);
  }

  #SethiV3-{{ section.id }} .sv3-title__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 11px;
  }

  #SethiV3-{{ section.id }} .sv3-title__top > span {
    color: var(--sv3-accent);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .18em;
    text-transform: uppercase;
  }

  #SethiV3-{{ section.id }} .sv3-title__badges {
    display: flex;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 6px;
  }

  #SethiV3-{{ section.id }} .sv3-title__badges b {
    display: inline-flex;
    align-items: center;
    min-height: 25px;
    padding: 4px 8px;
    background: var(--sv3-soft);
    color: var(--sv3-ink);
    font-size: 8px;
    font-weight: 700;
    letter-spacing: .09em;
    text-transform: uppercase;
  }

  #SethiV3-{{ section.id }} .sv3-title__badges .is-best {
    background: var(--sv3-accent);
    color: #fff;
  }

  #SethiV3-{{ section.id }} .sv3-title__badges .is-new {
    background: var(--sv3-ink);
    color: #fff;
  }

  #SethiV3-{{ section.id }} .sv3-title h1 {
    max-width: 760px;
    margin: 0;
    color: var(--sv3-ink);
    font-family: var(--sv3-display);
    font-size: clamp(34px, 3.2vw, 49px);
    line-height: 1.02;
    font-weight: 600;
    letter-spacing: -.018em;
  }

  #SethiV3-{{ section.id }} .sv3-title p {
    margin: 11px 0 0;
    color: var(--sv3-muted);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  #SethiV3-{{ section.id }} .sv3-rating {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 8px;
    margin: 13px 0 0;
    padding: 5px 0;
    border: 0;
    background: transparent;
    color: var(--sv3-ink);
    cursor: pointer;
  }

  #SethiV3-{{ section.id }} .sv3-rating > span {
    color: var(--sv3-accent);
    font-size: 12px;
    letter-spacing: 2px;
  }

  #SethiV3-{{ section.id }} .sv3-rating b,
  #SethiV3-{{ section.id }} .sv3-rating u {
    font-size: 11px;
    font-style: normal;
    font-weight: 600;
    text-decoration: none;
  }

  #SethiV3-{{ section.id }} .sv3-rating u {
    color: var(--sv3-muted);
    border-bottom: 1px solid currentColor;
  }

  #SethiV3-{{ section.id }} .sv3-rating i {
    width: 1px;
    height: 13px;
    background: var(--sv3-border);
  }

  #SethiV3-{{ section.id }} .sv3-price {
    padding: 15px 0 17px;
  }

  #SethiV3-{{ section.id }} .sv3-price > div {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }

  #SethiV3-{{ section.id }} .sv3-price strong {
    color: var(--sv3-ink);
    font-size: clamp(24px, 2.2vw, 32px);
    line-height: 1;
    font-weight: 600;
    letter-spacing: -.02em;
  }

  #SethiV3-{{ section.id }} .sv3-price del {
    color: var(--sv3-muted);
    font-size: 14px;
  }

  #SethiV3-{{ section.id }} .sv3-price > div > b {
    padding: 4px 7px;
    background: #edf7ef;
    color: #1d6a34;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: .04em;
    text-transform: uppercase;
  }

  #SethiV3-{{ section.id }} .sv3-price > small {
    display: block;
    margin-top: 7px;
    color: var(--sv3-muted);
    font-size: 10px;
  }

  #SethiV3-{{ section.id }} .sv3-price__emi {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-top: 10px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--sv3-muted);
    font-size: 11px;
    cursor: pointer;
  }

  #SethiV3-{{ section.id }} .sv3-price__emi b { color: var(--sv3-ink); }
  #SethiV3-{{ section.id }} .sv3-price__emi span { margin-left: 4px; color: var(--sv3-accent); font-weight: 700; }

  #SethiV3-{{ section.id }} .sv3-campaign {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
    padding: 13px 14px;
    border-left: 3px solid var(--sv3-accent);
    background: var(--campaign-bg);
    color: var(--campaign-text);
  }

  #SethiV3-{{ section.id }} .sv3-campaign > span { color: var(--sv3-accent); font-size: 18px; }
  #SethiV3-{{ section.id }} .sv3-campaign div { display: grid; gap: 2px; }
  #SethiV3-{{ section.id }} .sv3-campaign b { font-size: 11px; font-weight: 700; }
  #SethiV3-{{ section.id }} .sv3-campaign small { color: inherit; opacity: .72; font-size: 10px; }
  #SethiV3-{{ section.id }} .sv3-campaign em { padding: 4px 7px; border: 1px solid currentColor; font-size: 8px; font-style: normal; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }

  #SethiV3-{{ section.id }} .sv3-try,
  #SethiV3-{{ section.id }} .sv3-delivery,
  #SethiV3-{{ section.id }} .sv3-reserve-card {
    width: 100%;
    color: var(--sv3-ink);
  }

  #SethiV3-{{ section.id }} .sv3-try {
    display: grid;
    grid-template-columns: 58px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
    padding: 10px;
    border: 1px solid var(--sv3-border);
    background: var(--sv3-paper);
    text-align: left;
    cursor: pointer;
  }

  #SethiV3-{{ section.id }} .sv3-try > img,
  #SethiV3-{{ section.id }} .sv3-try > span {
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    object-fit: cover;
    background: var(--sv3-soft);
    color: var(--sv3-accent);
    font-weight: 700;
  }

  #SethiV3-{{ section.id }} .sv3-try div,
  #SethiV3-{{ section.id }} .sv3-delivery > div,
  #SethiV3-{{ section.id }} .sv3-reserve-card div { display: grid; gap: 3px; }
  #SethiV3-{{ section.id }} .sv3-try b,
  #SethiV3-{{ section.id }} .sv3-delivery b,
