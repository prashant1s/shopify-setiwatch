{% schema %}
{
  "name": "Sethi product V2",
  "tag": "section",
  "class": "section-sethi-product-v2",
  "settings": [
    {"type":"text","id":"whatsapp_number","label":"WhatsApp number","default":"918076625588"},
    {"type":"range","id":"rating_score","label":"Displayed rating","min":1,"max":5,"step":0.1,"default":4.9},
    {"type":"collection","id":"trending_collection","label":"Trending products collection"}
  ],
  "blocks": [
    {"type":"store","name":"Pickup store","settings":[{"type":"text","id":"name","label":"Store name","default":"Rajouri Garden"}]},
    {"type":"review","name":"Review","settings":[{"type":"text","id":"heading","label":"Heading","default":"Excellent buying experience"},{"type":"textarea","id":"review","label":"Review","default":"The product arrived safely and matched the description."},{"type":"text","id":"customer","label":"Customer name","default":"Verified customer"}]},
    {"type":"faq","name":"FAQ","settings":[{"type":"text","id":"question","label":"Question","default":"Is this watch authentic?"},{"type":"richtext","id":"answer","label":"Answer","default":"<p>Yes. The watch includes applicable original packaging, documents and manufacturer warranty.</p>"}]}
  ],
  "presets": [
    {
      "name": "Sethi product V2",
      "blocks": [
        {"type": "store"},
        {"type": "review"},
        {
          "type": "faq",
          "settings": {
            "question": "Is this watch 100% authentic?",
            "answer": "<p>Yes. Every watch includes applicable original packaging, documents and manufacturer warranty.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "How does boutique reservation work?",
            "answer": "<p>Select a boutique, pickup date and time slot, then pay the configured reservation advance to reserve the timepiece.</p>"
          }
        }
      ]
    }
  ],
  "enabled_on":{"templates":["product"]}
}
{% endschema %}
