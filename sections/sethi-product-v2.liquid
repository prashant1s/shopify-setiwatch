  }

  #SethiV3-{{ section.id }} .sv3-specification-value .metafield-rich_text_field > *:first-child {
    margin-top: 0;
  }

  #SethiV3-{{ section.id }} .sv3-specification-value ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px 28px;
    margin: 0;
    padding-left: 20px;
  }

  #SethiV3-{{ section.id }} .sv3-specification-value table {
    width: 100%;
    border-collapse: collapse;
  }

  #SethiV3-{{ section.id }} .sv3-specification-value td,
  #SethiV3-{{ section.id }} .sv3-specification-value th {
    padding: 13px 10px;
    border-bottom: 1px solid var(--sv3-border);
    text-align: left;
    vertical-align: top;
  }

  #SethiV3-{{ section.id }} .sv3-spec-table th {
    width: 34%;
    color: var(--sv3-muted);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  #SethiV3-{{ section.id }} .sv3-spec-table td {
    color: var(--sv3-ink);
    font-size: 13px;
    font-weight: 600;
  }

  #SethiV3-{{ section.id }} .sv3-spec-table tr:last-child > * {
    border-bottom: 0;
  }

  #SethiV3-{{ section.id }} .sv3-spec-table td ul,
  #SethiV3-{{ section.id }} .sv3-spec-table td .metafield-single_line_text_field-array {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #SethiV3-{{ section.id }} .sv3-spec-table td li {
    padding: 3px 8px;
    border: 1px solid rgba(23,23,20,.1);
    background: #fff;
    font-size: 11px;
  }

  #SethiV3-{{ section.id }} .sv3-specification-notes {
    margin-top: 18px;
    padding-top: 18px;
    border-top: 1px solid var(--sv3-border);
  }

  #SethiV3-{{ section.id }} .sv3-reviews-app__widget {
    width: min(100%, 1120px);
    margin: 0 auto;
    padding: clamp(22px, 4vw, 42px);
    border: 1px solid rgba(23,23,20,.11);
    background: #fff;
    box-shadow: 0 20px 55px rgba(26,22,15,.055);
  }

  #SethiV3-{{ section.id }} .sv3-reviews-app__widget .shopify-block {
    width: 100%;
    max-width: none;
  }

  #SethiV3-{{ section.id }} .sv3-app-placeholder {
    display: grid;
    gap: 7px;
    min-height: 130px;
    place-content: center;
    border: 1px dashed rgba(178,122,43,.48);
    background: #fbf8f1;
    text-align: center;
  }

  #SethiV3-{{ section.id }} .sv3-app-placeholder b {
    font-family: var(--sv3-display);
    font-size: 25px;
  }

  #SethiV3-{{ section.id }} .sv3-app-placeholder span {
    color: var(--sv3-muted);
    font-size: 11px;
  }

  #SethiV3-{{ section.id }} .sv3-product-showcase {
    position: relative;
    padding-top: 6px;
  }

  #SethiV3-{{ section.id }} .sv3-product-showcase--trending {
    padding: clamp(42px, 6vw, 72px) clamp(20px, 5vw, 72px);
    background: linear-gradient(135deg, #f7f3eb 0%, #fcfaf6 54%, #f3ecdf 100%);
  }

  #SethiV3-{{ section.id }} .sv3-product-showcase--trending .sv3-product-card__media {
    background: #fff;
  }

  #SethiV3-{{ section.id }} .sv3-product-showcase .sv3-product-card > b {
    min-height: 2.5em;
    font-size: 20px;
  }

  #SethiV3-{{ section.id }} .sv3-product-showcase .sv3-product-card strong {
    font-size: 13px;
  }

  #SethiV3-{{ section.id }} .sv3-product-skeleton {
    display: grid;
    gap: 10px;
  }

  #SethiV3-{{ section.id }} .sv3-product-skeleton > * {
    display: block;
    overflow: hidden;
    background: linear-gradient(90deg, #f1eee8 25%, #faf8f4 50%, #f1eee8 75%);
    background-size: 200% 100%;
    animation: sv3-skeleton-{{ section.id }} 1.35s ease-in-out infinite;
  }

  #SethiV3-{{ section.id }} .sv3-product-skeleton i {
    aspect-ratio: 1;
  }

  #SethiV3-{{ section.id }} .sv3-product-skeleton span { width: 34%; height: 8px; }
  #SethiV3-{{ section.id }} .sv3-product-skeleton b { width: 82%; height: 19px; }
  #SethiV3-{{ section.id }} .sv3-product-skeleton small { width: 44%; height: 12px; }

  @keyframes sv3-skeleton-{{ section.id }} {
    from { background-position: 200% 0; }
    to { background-position: -200% 0; }
  }

  @media screen and (max-width: 1180px) {
    #SethiV3-{{ section.id }} .sv3__hero { grid-template-columns: minmax(0, 1.05fr) minmax(360px, .95fr); gap: 38px; }
    #SethiV3-{{ section.id }} .sv3-gallery__stage { min-height: 560px; }
    #SethiV3-{{ section.id }} .sv3-trust { grid-template-columns: 1fr 1fr; }
    #SethiV3-{{ section.id }} .sv3-trust > span:nth-child(3) { border-left: 0; border-top: 1px solid var(--sv3-border); }
    #SethiV3-{{ section.id }} .sv3-trust > span:nth-child(4) { border-top: 1px solid var(--sv3-border); }
  }

  @media screen and (max-width: 989px) {
    #SethiV3-{{ section.id }} { padding-right: 18px; padding-bottom: 110px; padding-left: 18px; overflow: visible; }
    #SethiV3-{{ section.id }} .sv3__hero { grid-template-columns: 1fr; gap: 29px; padding-top: 0; }
    #SethiV3-{{ section.id }} .sv3-gallery { position: relative; top: auto; display: flex; flex-direction: column-reverse; gap: 10px; }
    #SethiV3-{{ section.id }} .sv3-gallery__thumbs { flex-direction: row; width: 100%; max-height: none; overflow-x: auto; }
    #SethiV3-{{ section.id }} .sv3-thumb { width: 65px; height: 70px; flex-basis: 65px; }
    #SethiV3-{{ section.id }} .sv3-gallery__stage { order: 2; min-height: 0; aspect-ratio: 1; }
    #SethiV3-{{ section.id }} .sv3-gallery__actions { order: 1; width: 100%; min-height: 35px; }
    #SethiV3-{{ section.id }} .sv3-gallery__thumbs { order: 0; }
    #SethiV3-{{ section.id }} .sv3-media { padding: 9%; }
    #SethiV3-{{ section.id }} .sv3-title h1 { font-size: clamp(32px, 9vw, 43px); }
    #SethiV3-{{ section.id }} .sv3-reviews__grid { grid-template-columns: 1fr 1fr; }
    #SethiV3-{{ section.id }} .sv3-recommendations__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    #SethiV3-{{ section.id }} .sv3-sticky { display: flex; }
    #SethiV3-{{ section.id }} .sv3-below { gap: 70px; margin-top: 85px; }
  }

  @media screen and (max-width: 620px) {
    #SethiV3-{{ section.id }} .sv3__breadcrumbs { min-height: 44px; font-size: 9px; }
    #SethiV3-{{ section.id }} .sv3-gallery__stage { margin-right: -18px; margin-left: -18px; width: calc(100% + 36px); border-right: 0; border-left: 0; }
    #SethiV3-{{ section.id }} .sv3-gallery__badge { top: 12px; left: 12px; }
    #SethiV3-{{ section.id }} .sv3-icon-button { width: 36px; height: 36px; }
    #SethiV3-{{ section.id }} .sv3-gallery__wish { top: 12px; right: 12px; }
    #SethiV3-{{ section.id }} .sv3-gallery__zoom { right: 12px; bottom: 12px; }
    #SethiV3-{{ section.id }} .sv3-gallery__counter { bottom: 12px; }
    #SethiV3-{{ section.id }} .sv3-gallery__actions > span { max-width: 70%; }
    #SethiV3-{{ section.id }} .sv3-title__top { align-items: flex-start; }
    #SethiV3-{{ section.id }} .sv3-title h1 { font-size: 34px; }
    #SethiV3-{{ section.id }} .sv3-price strong { font-size: 27px; }
    #SethiV3-{{ section.id }} .sv3-purchase__buttons { grid-template-columns: 1fr; }
    #SethiV3-{{ section.id }} .sv3-button { min-height: 52px; }
    #SethiV3-{{ section.id }} .sv3-enquiry > div { grid-template-columns: 1fr; }
    #SethiV3-{{ section.id }} .sv3-services { grid-template-columns: 1fr; }
    #SethiV3-{{ section.id }} .sv3-information { margin-right: -18px; margin-left: -18px; padding: 46px 18px; }
    #SethiV3-{{ section.id }} .sv3-section-heading { margin-bottom: 27px; }
    #SethiV3-{{ section.id }} .sv3-section-heading h2 { font-size: 39px; }
    #SethiV3-{{ section.id }} .sv3-reviews__grid { grid-template-columns: 1fr; }
    #SethiV3-{{ section.id }} .sv3-review { min-height: 220px; }
    #SethiV3-{{ section.id }} .sv3-product-card > b { font-size: 17px; }
    #SethiV3-{{ section.id }} .sv3-booking { grid-template-columns: 1fr; }
    #SethiV3-{{ section.id }} .sv3-booking textarea,
    #SethiV3-{{ section.id }} .sv3-booking .sv3-button,
    #SethiV3-{{ section.id }} .sv3-booking > p { grid-column: auto; }
    #SethiV3-{{ section.id }} .sv3-spin { min-height: 380px; }
    #SethiV3-{{ section.id }} .sv3-spin img { height: 360px; }
  }

  @media (prefers-reduced-motion: reduce) {
    #SethiV3-{{ section.id }} *,
    #SethiV3-{{ section.id }} *::before,
    #SethiV3-{{ section.id }} *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; animation-duration: .01ms !important; }
  }
{% endstyle %}

<section
  id="SethiV3-{{ section.id }}"
  class="sv3"
  data-sethi-v3
  data-section-id="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-product-url="{{ product.url }}"
  data-whatsapp="{{ section.settings.whatsapp_number | remove: '+' | remove: ' ' }}"
  data-deposit-variant="{% if deposit_variant != blank %}{{ deposit_variant.id }}{% endif %}"
  data-money-format="{{ shop.money_format | escape }}"
  style="--sv3-accent:{{ section.settings.accent_color }};--sv3-ink:{{ section.settings.ink_color }};--sv3-paper:{{ section.settings.paper_color }};--sv3-soft:{{ section.settings.soft_color }}"
>
  {% if section.settings.show_breadcrumbs %}
    <nav class="sv3__breadcrumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a><span>/</span>
      {% if product.collections.first %}<a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a><span>/</span>{% endif %}
      <span>{{ product.title }}</span>
    </nav>
  {% endif %}

  <div class="sv3__hero">
    <div class="sv3-gallery" data-gallery>
      <div class="sv3-gallery__thumbs" aria-label="Product media">
        {% for media in product.media %}
          <button type="button" class="sv3-thumb{% if media.id == featured.id %} is-active{% endif %}" data-thumb="{{ media.id }}" aria-label="View media {{ forloop.index }}">
            {{ media.preview_image | image_url: width: 150 | image_tag: loading: 'lazy', widths: '70,100,150', alt: media.alt | default: product.title }}
            {% if media.media_type == 'video' or media.media_type == 'external_video' %}<span>▶</span>{% endif %}
            {% if media.media_type == 'model' %}<span>3D</span>{% endif %}
          </button>
        {% endfor %}
        {% if spin_images != blank %}
          <button type="button" class="sv3-thumb sv3-thumb--special" data-open-spin><b>360°</b></button>
        {% endif %}
      </div>

      <div class="sv3-gallery__stage">
        {% if section.settings.gallery_badge != blank %}<span class="sv3-gallery__badge">{{ section.settings.gallery_badge }}</span>{% endif %}
        <button type="button" class="sv3-icon-button sv3-gallery__wish" data-wishlist aria-label="Add to wishlist">♡</button>
        <button type="button" class="sv3-icon-button sv3-gallery__zoom" data-zoom aria-label="Zoom product image">⌕</button>

        {% for media in product.media %}
          <div class="sv3-media" data-media="{{ media.id }}" data-media-type="{{ media.media_type }}" {% unless media.id == featured.id %}hidden{% endunless %}>
            {% case media.media_type %}
              {% when 'image' %}
                {{ media | image_url: width: 1800 | image_tag: loading: 'eager', widths: '500,750,1000,1400,1800', sizes: '(min-width: 990px) 55vw, 100vw', alt: media.alt | default: product.title, data-zoom-image: '' }}
              {% when 'video' %}
                {{ media | video_tag: controls: true, preload: 'metadata', image_size: '1200x' }}
              {% when 'external_video' %}
                {{ media | external_video_tag }}
              {% when 'model' %}
                {{ media | model_viewer_tag: image_size: '1200x', reveal: 'interaction', toggleable: true, data-model-viewer: '' }}
            {% endcase %}
          </div>
        {% endfor %}

        <div class="sv3-gallery__counter"><button type="button" data-gallery-prev>‹</button><span data-gallery-counter>1 / {{ product.media.size }}</span><button type="button" data-gallery-next>›</button></div>
      </div>

      <div class="sv3-gallery__actions">
        <span>Hover or tap the image to explore details</span>
        {% if section.settings.enable_share %}<button type="button" data-share>↗ Share</button>{% endif %}
      </div>
    </div>

    <aside class="sv3-buybox">
      {% form 'product', product, id: product_form_id, class: 'sv3-form', data-product-form: '' %}
        <input type="hidden" name="id" value="{{ variant.id }}" data-variant-id>

        {% comment %}
          The essential buy box is deliberately rendered outside section.blocks.
          This prevents a blank right column when an older product template has
          no blocks configured for this section.
        {% endcomment %}
          <div class="sv3-title">
            <div class="sv3-title__top">
              <span>{{ product.vendor }}</span>
              <div class="sv3-title__badges">
                {% if is_expensive_watch %}<b class="is-best">Premium Pick</b>{% endif %}
                {% if is_best_seller %}<b class="is-best">Best Seller</b>{% endif %}
                {% if is_new_arrival %}<b class="is-new">New Arrival</b>{% endif %}
              </div>
            </div>
            <h1>{{ display_title }}</h1>
            <p data-sku>{% if variant.sku != blank %}Model No. {{ variant.sku }}{% endif %}</p>
          </div>

          {% if rating_value != blank and rating_count > 0 %}
            <button type="button" class="sv3-rating" data-scroll-reviews>
              <span aria-label="{{ rating_value }} out of 5">★★★★★</span><b>{{ rating_value }}</b><i></i><u>{{ rating_count }} verified reviews</u>
            </button>
          {% else %}
            <button type="button" class="sv3-rating sv3-rating--empty" data-scroll-reviews>
              <span aria-hidden="true">☆</span><b>Be the first to review</b><i></i><u>Write a review</u>
            </button>
          {% endif %}

          {% assign fallback_saving_amount = variant.compare_at_price | minus: variant.price %}
          {% assign fallback_saving_percent = 0 %}
          {% if variant.compare_at_price > variant.price %}{% assign fallback_saving_percent = fallback_saving_amount | times: 100 | divided_by: variant.compare_at_price %}{% endif %}
          <div class="sv3-price">
            <span class="sv3-price__label">Your price</span>
            <div>
              <strong data-price>{{ variant.price | money }}</strong>
              <del data-compare {% unless variant.compare_at_price > variant.price %}hidden{% endunless %}>{{ variant.compare_at_price | money }}</del>
              <b data-save {% unless variant.compare_at_price > variant.price %}hidden{% endunless %}>Save {{ fallback_saving_amount | money }} · {{ fallback_saving_percent }}%</b>
            </div>
            <small>Inclusive of all taxes</small>
            <button type="button" class="sv3-price__emi" data-open-emi>EMI from <b>{{ variant.price | divided_by: 3 | money }}/month</b> <span>View plans →</span></button>
            {% if is_expensive_watch %}
              <div class="sv3-luxury-note"><span>High value watch</span><b>Premium showroom assistance recommended</b><small>Book a video call or reserve a private showroom viewing before checkout.</small></div>
            {% endif %}
          </div>

          {% unless product.has_only_default_variant %}
            <div class="sv3-variants">
              {% for option in product.options_with_values %}
                <fieldset>
                  <legend>{{ option.name }}: <b data-option-value="{{ option.position }}">{{ option.selected_value }}</b></legend>
                  <div>
                    {% for value in option.values %}
                      {% assign fallback_input_id = section.id | append: '-fallback-' | append: option.position | append: '-' | append: forloop.index0 %}
                      <input id="{{ fallback_input_id }}" type="radio" name="options[{{ option.name | escape }}]" value="{{ value | escape }}" data-option data-position="{{ option.position }}" {% if option.selected_value == value %}checked{% endif %}>
                      <label for="{{ fallback_input_id }}">{{ value }}</label>
                    {% endfor %}
                  </div>
                </fieldset>
              {% endfor %}
            </div>
          {% endunless %}

          <div class="sv3-purchase" data-low-stock-threshold="5">
            <div class="sv3-purchase__heading"><span>Purchase with confidence</span><b>Secure checkout</b></div>
            <p class="sv3-stock{% unless variant.available %} is-out{% endunless %}" data-stock><i></i><b data-stock-text>{% if variant.available %}{% if variant.inventory_management and variant.inventory_quantity > 0 and variant.inventory_quantity <= 5 %}Only {{ variant.inventory_quantity }} left — order soon{% else %}In stock — ready for dispatch{% endif %}{% else %}Out of stock — submit an enquiry{% endif %}</b></p>

            <div class="sv3-purchase__available" data-purchase-available {% unless variant.available %}hidden{% endunless %}>
              <div class="sv3-purchase__buttons">
                <button type="submit" class="sv3-button sv3-button--outline" data-atc><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 4h2l2.2 10.1a2 2 0 0 0 2 1.6h7.9a2 2 0 0 0 1.9-1.4L21 7H7M10 20h.01M17 20h.01"/></svg><span data-atc-text>Add to cart</span></button>
                <button type="button" class="sv3-button sv3-button--dark" data-buy-now>Buy now securely <span aria-hidden="true">→</span></button>
              </div>

              <div class="sv3-checkout-proof"><svg aria-hidden="true" viewBox="0 0 24 24"><rect x="5" y="10" width="14" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg><span><b>Encrypted & secure payment</b><small>Your payment information is protected</small></span></div>

              {% if models.size > 0 or spin_images != blank %}
                <div class="sv3-interactive-pair" aria-label="Interactive product views">
                  {% if models.size > 0 %}<button type="button" data-open-model><span>AR</span><b>View in AR</b></button>{% endif %}
                  {% if spin_images != blank %}<button type="button" data-open-spin><span>360°</span><b>360° Spin</b></button>{% endif %}
                </div>
              {% endif %}

              <button type="button" class="sv3-reserve-card" data-open-visit>
                <span><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5M9 21v-7h6v7"/></svg></span><div><small>Private showroom experience</small><b>Reserve this watch with 30%</b><em>See it in person, then pay the remaining balance</em><u>Krishna Nagar&nbsp; · &nbsp;Noida Sec 18&nbsp; · &nbsp;Noida Sec 120</u></div><i>›</i>
              </button>

              <button type="button" class="sv3-videocall" data-video-call data-open-label="Available now" data-closed-label="Available 12 PM - 8 PM">
                <span><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 7h11v10H4z"/><path d="m15 11 5-3v8l-5-3z"/></svg></span><div><small data-video-call-status>Available 12 PM - 8 PM</small><b>Shop on video call</b><em>See the watch live with our expert before buying</em></div><i>›</i>
              </button>
            </div>

            <div class="sv3-enquiry" data-enquiry {% if variant.available %}hidden{% endif %}>
              <span>Currently unavailable</span>
              <h3>Enquire about this watch</h3>
              <p>Share your details and our watch expert will help with availability or a suitable alternative.</p>
              <div><input type="text" placeholder="Your name" data-enquiry-name><input type="tel" placeholder="Phone number" data-enquiry-phone></div>
              <button type="button" class="sv3-button sv3-button--dark" data-submit-enquiry>Request availability</button>
              <small data-enquiry-result></small>
            </div>
          </div>

          <div class="sv3-delivery" data-delivery>
            <span><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 6h11v11H3zM14 10h4l3 3v4h-7z"/><circle cx="7" cy="19" r="2"/><circle cx="18" cy="19" r="2"/></svg></span><div><b>Bluedart delivery ETA</b><small>Enter pincode to check actual Bluedart delivery time</small><div class="sv3-delivery__form"><input type="text" inputmode="numeric" maxlength="6" placeholder="Enter 6-digit pincode" data-pincode><button type="button" data-check-pincode>Check</button></div><p data-pincode-result hidden></p></div>
          </div>

          <div class="sv3-trust">
            <span><i><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m12 3 7 3v5c0 4.6-2.8 8.1-7 10-4.2-1.9-7-5.4-7-10V6z"/><path d="m9 12 2 2 4-4"/></svg></i><b>100% Genuine</b><small>Authorised sourcing</small></span>
            <span><i><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M8 12.5 10.5 15 16 9"/></svg></i><b>Brand Warranty</b><small>Original warranty</small></span>
            <span><i><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 7h11v10H3zM14 10h4l3 3v4h-7z"/><circle cx="7" cy="19" r="2"/><circle cx="18" cy="19" r="2"/></svg></i><b>Bluedart Shipping</b><small>Insured tracking</small></span>
            <span><i><svg aria-hidden="true" viewBox="0 0 24 24"><rect x="4" y="9" width="16" height="11" rx="2"/><path d="M8 9V6a4 4 0 0 1 8 0v3"/></svg></i><b>Secure Payment</b><small>Protected checkout</small></span>
          </div>
        {% for block in section.blocks %}
          {% liquid
            assign skip_core_block = false
            if block.type == 'brand_title' or block.type == 'rating' or block.type == 'price' or block.type == 'variant_picker' or block.type == 'purchase' or block.type == 'delivery' or block.type == 'trust_icons' or block.type == 'service_buttons' or block.type == 'try_on'
              assign skip_core_block = true
            endif
            if skip_core_block
              continue
            endif
          %}
          {% case block.type %}
            {% when 'brand_title' %}
              <div class="sv3-title" {{ block.shopify_attributes }}>
                <div class="sv3-title__top">
                  <span>{{ product.vendor }}</span>
              <div class="sv3-title__badges">
                    {% if is_expensive_watch %}<b class="is-best">Premium Pick</b>{% endif %}
                    {% if block.settings.badge != blank and block.settings.badge != 'Best seller' %}<b>{{ block.settings.badge }}</b>{% endif %}
                    {% if is_best_seller %}<b class="is-best">Best Seller</b>{% endif %}
                    {% if is_new_arrival %}<b class="is-new">New Arrival</b>{% endif %}
                  </div>
                </div>
                <h1>{{ product.title }}</h1>
                <p data-sku>{% if variant.sku != blank %}Model No. {{ variant.sku }}{% endif %}</p>
              </div>

            {% when 'rating' %}
              <button type="button" class="sv3-rating" data-scroll-reviews {{ block.shopify_attributes }}>
                <span aria-label="{{ rating_value }} out of 5">★★★★★</span><b>{{ rating_value }}</b><i></i><u>{{ rating_count }} verified reviews</u>
              </button>

            {% when 'price' %}
              <div class="sv3-price" {{ block.shopify_attributes }}>
                {% assign saving_amount = variant.compare_at_price | minus: variant.price %}
                {% assign saving_percent = 0 %}
                {% if variant.compare_at_price > variant.price %}{% assign saving_percent = saving_amount | times: 100 | divided_by: variant.compare_at_price %}{% endif %}
                <div><strong data-price>{{ variant.price | money }}</strong><del data-compare {% unless variant.compare_at_price > variant.price %}hidden{% endunless %}>{{ variant.compare_at_price | money }}</del><b data-save {% unless variant.compare_at_price > variant.price %}hidden{% endunless %}>Save {{ saving_amount | money }} · {{ saving_percent }}%</b></div>
                <small>{{ block.settings.tax_text }}</small>
                {% if block.settings.show_emi_hint %}<button type="button" class="sv3-price__emi" data-open-emi>EMI from <b>{{ variant.price | divided_by: 3 | money }}/month</b> <span>View plans →</span></button>{% endif %}
                {% if is_expensive_watch %}<div class="sv3-luxury-note"><span>High value watch</span><b>Premium showroom assistance recommended</b><small>Book a video call or reserve a private showroom viewing before checkout.</small></div>{% endif %}
              </div>

            {% when 'campaign_strip' %}
              {% assign show_campaign = true %}
              {% if block.settings.collection != blank %}
                {% assign show_campaign = false %}
                {% for collection in product.collections %}{% if collection.id == block.settings.collection.id %}{% assign show_campaign = true %}{% break %}{% endif %}{% endfor %}
              {% endif %}
              {% if show_campaign %}
                <div class="sv3-campaign" style="--campaign-bg:{{ block.settings.background }};--campaign-text:{{ block.settings.text_color }}" {{ block.shopify_attributes }}>
                  <span>{{ block.settings.icon }}</span><div><b>{{ block.settings.heading }}</b><small>{{ block.settings.text }}</small></div>{% if block.settings.badge != blank %}<em>{{ block.settings.badge }}</em>{% endif %}
                </div>
              {% endif %}

            {% when 'try_on' %}
              <button type="button" class="sv3-try" data-open-tryon {{ block.shopify_attributes }}>
                {% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 180 | image_tag: loading: 'lazy', alt: block.settings.heading }}{% else %}<span>AR</span>{% endif %}
                <div><b>{{ block.settings.heading }}</b><small>{{ block.settings.text }}</small></div><i>›</i>
              </button>

            {% when 'variant_picker' %}
              {% unless product.has_only_default_variant %}
                <div class="sv3-variants" {{ block.shopify_attributes }}>
                  {% for option in product.options_with_values %}
                    <fieldset><legend>{{ option.name }}: <b data-option-value="{{ option.position }}">{{ option.selected_value }}</b></legend><div>
                      {% for value in option.values %}
                        {% assign input_id = section.id | append: '-' | append: option.position | append: '-' | append: forloop.index0 %}
                        <input id="{{ input_id }}" type="radio" name="options[{{ option.name | escape }}]" value="{{ value | escape }}" data-option data-position="{{ option.position }}" {% if option.selected_value == value %}checked{% endif %}>
                        <label for="{{ input_id }}">{{ value }}</label>
                      {% endfor %}
                    </div></fieldset>
                  {% endfor %}
                </div>
              {% endunless %}

            {% when 'purchase' %}
              <div class="sv3-purchase" data-low-stock-threshold="{{ block.settings.low_stock_threshold }}" {{ block.shopify_attributes }}>
                <p class="sv3-stock{% unless variant.available %} is-out{% endunless %}" data-stock><i></i><b data-stock-text>{% if variant.available %}{% if variant.inventory_management and variant.inventory_quantity > 0 and variant.inventory_quantity <= block.settings.low_stock_threshold %}Only {{ variant.inventory_quantity }} left — order soon{% else %}In stock — ready for dispatch{% endif %}{% else %}Out of stock — submit an enquiry{% endif %}</b></p>
                {% if block.settings.show_quantity %}<div class="sv3-qty"><button type="button" data-qty-minus>−</button><input type="number" name="quantity" value="1" min="1" data-quantity><button type="button" data-qty-plus>+</button></div>{% endif %}
                <div class="sv3-purchase__available" data-purchase-available {% unless variant.available %}hidden{% endunless %}>
                  <div class="sv3-purchase__buttons">
                    <button type="submit" class="sv3-button sv3-button--outline" data-atc><span aria-hidden="true">＋</span><span data-atc-text>{{ block.settings.atc_label }}</span></button>
                    {% if block.settings.show_buy_now %}<button type="button" class="sv3-button sv3-button--dark" data-buy-now>{{ block.settings.buy_now_label }} <span aria-hidden="true">→</span></button>{% endif %}
                  </div>

                  <div class="sv3-interactive-pair" aria-label="Interactive product views">
                    {% if models.size > 0 %}<button type="button" data-open-model><span>AR</span><b>{{ block.settings.ar_label }}</b></button>{% endif %}
                    {% if spin_images != blank %}<button type="button" data-open-spin><span>360°</span><b>{{ block.settings.spin_label }}</b></button>{% endif %}
                  </div>

                  <button type="button" class="sv3-reserve-card" data-open-visit>
                    <span>⌂</span><div><small>{{ block.settings.reserve_eyebrow }}</small><b>{{ block.settings.reserve_heading }}</b><em>{{ block.settings.reserve_text }}</em></div><i>›</i>
                  </button>
                  <button type="button" class="sv3-videocall" data-video-call data-open-label="Available now" data-closed-label="Available 12 PM - 8 PM">
                    <span>▣</span><div><small data-video-call-status>Available 12 PM - 8 PM</small><b>Shop on video call</b><em>See the watch live with our expert before buying</em></div><i>›</i>
                  </button>
                </div>

                <div class="sv3-enquiry" data-enquiry {% if variant.available %}hidden{% endif %}>
                  <span>{{ block.settings.enquiry_eyebrow }}</span>
                  <h3>{{ block.settings.enquiry_heading }}</h3>
                  <p>{{ block.settings.enquiry_text }}</p>
                  <div><input type="text" placeholder="Your name" data-enquiry-name><input type="tel" placeholder="Phone number" data-enquiry-phone></div>
                  <button type="button" class="sv3-button sv3-button--dark" data-submit-enquiry>{{ block.settings.enquiry_button }}</button>
                  <small data-enquiry-result></small>
                </div>
              </div>

            {% when 'delivery' %}
              <div class="sv3-delivery" data-delivery {{ block.shopify_attributes }}>
                <span>▱</span><div><b>{{ block.settings.heading }}</b><small>{{ block.settings.text }}</small><div class="sv3-delivery__form"><input type="text" inputmode="numeric" maxlength="6" placeholder="Enter 6-digit pincode" data-pincode><button type="button" data-check-pincode>{{ block.settings.button_label }}</button></div><p data-pincode-result hidden></p></div><i>›</i>
              </div>

            {% when 'trust_icons' %}
              <div class="sv3-trust" {{ block.shopify_attributes }}>
                <span><i>◇</i><b>{{ block.settings.item_1 }}</b><small>{{ block.settings.caption_1 }}</small></span>
                <span><i>▱</i><b>{{ block.settings.item_2 }}</b><small>{{ block.settings.caption_2 }}</small></span>
                <span><i>↺</i><b>{{ block.settings.item_3 }}</b><small>{{ block.settings.caption_3 }}</small></span>
                <span><i>♙</i><b>{{ block.settings.item_4 }}</b><small>{{ block.settings.caption_4 }}</small></span>
              </div>

            {% when 'offer_accordion' %}
              {% assign show_offer = true %}
              {% if block.settings.collection != blank %}{% assign show_offer = false %}{% for collection in product.collections %}{% if collection.id == block.settings.collection.id %}{% assign show_offer = true %}{% break %}{% endif %}{% endfor %}{% endif %}
              {% if show_offer %}
                <details class="sv3-offer" {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
                  <summary><span>{{ block.settings.icon }}</span><div><b>{{ block.settings.heading }}</b><small>{{ block.settings.subheading }}</small></div><i>⌄</i></summary>
                  <div class="sv3-offer__body">{{ block.settings.content }}{% if block.settings.code != blank %}<button type="button" data-copy-code="{{ block.settings.code | escape }}"><b>{{ block.settings.code }}</b><span>Tap to copy</span></button>{% endif %}</div>
                </details>
              {% endif %}

            {% when 'bundle' %}
              {% assign show_bundle = true %}
              {% if block.settings.collection != blank %}{% assign show_bundle = false %}{% for collection in product.collections %}{% if collection.id == block.settings.collection.id %}{% assign show_bundle = true %}{% break %}{% endif %}{% endfor %}{% endif %}
              {% if show_bundle %}
                <div class="sv3-bundle" data-bundle {{ block.shopify_attributes }}>
                  <header><span>{{ block.settings.eyebrow }}</span><b>{{ block.settings.heading }}</b><small>{{ block.settings.text }}</small></header>
                  {% if block.settings.products != blank %}<div class="sv3-bundle__products">{% for bundle_product in block.settings.products limit: 3 %}{% assign bundle_variant = bundle_product.selected_or_first_available_variant %}<label><input type="checkbox" value="{{ bundle_variant.id }}" data-bundle-product {% if block.settings.preselect %}checked{% endif %} {% unless bundle_variant.available %}disabled{% endunless %}><i>✓</i>{{ bundle_product.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: bundle_product.title }}<span><b>{{ bundle_product.title }}</b><small>{{ bundle_variant.price | money }}</small></span></label>{% endfor %}</div>{% endif %}
                  <footer><span>{{ block.settings.note }}</span><b>{{ block.settings.badge }}</b></footer>
                </div>
              {% endif %}

            {% when 'pickup' %}
              <div class="sv3-pickup" data-pickup-shell {{ block.shopify_attributes }}>
                <header><span>⌖</span><div><b>{{ block.settings.heading }}</b><small>{{ block.settings.text }}</small></div></header>
                {% assign pickup_list = variant.store_availabilities | where: 'pick_up_enabled', true %}
                {% if pickup_list.size > 0 %}<div>{% for availability in pickup_list limit: 3 %}<article><i class="{% if availability.available %}is-available{% endif %}"></i><span><b>{{ availability.location.name }}</b><small>{% if availability.available %}Pickup available{% else %}Currently unavailable{% endif %}{% if availability.pick_up_time != blank %} · {{ availability.pick_up_time }}{% endif %}</small></span></article>{% endfor %}</div>{% else %}<p>{{ block.settings.empty_text }}</p>{% endif %}
              </div>

            {% when 'service_buttons' %}
              <div class="sv3-services" {{ block.shopify_attributes }}>
                {% if block.settings.show_emi %}<button type="button" data-open-emi><span>₹</span><div><b>{{ block.settings.emi_heading }}</b><small>{{ block.settings.emi_text }}</small></div><i>›</i></button>{% endif %}
                {% if block.settings.show_authenticity %}<button type="button" data-scroll-authenticity><span>✓</span><div><b>{{ block.settings.authenticity_heading }}</b><small>{{ block.settings.authenticity_text }}</small></div><i>›</i></button>{% endif %}
              </div>
          {% endcase %}
        {% endfor %}
      {% endform %}
    </aside>
  </div>

  <div class="sv3-below">
    {% for block in section.blocks %}
      {% case block.type %}

        {% when '@app' %}
          <section class="sv3-reviews-app sv3-reveal" {{ block.shopify_attributes }}>
            <div class="sv3-reviews-app__widget">{% render block %}</div>
          </section>

        {% when 'specifications' %}
          {% if specification_metafield != blank or structured_spec_count > 0 %}
            <section class="sv3-information sv3-reveal" data-authenticity-section {{ block.shopify_attributes }}>
              <header class="sv3-section-heading">
                <span>{{ block.settings.eyebrow }}</span>
                <h2>{{ block.settings.heading }}</h2>
                <p>{{ block.settings.text }}</p>
              </header>
              <div class="sv3-information__grid">
                <details class="sv3-content sv3-content--specifications" {% if block.settings.open %}open{% endif %}>
                  <summary><b>{{ block.settings.accordion_heading }}</b><i>+</i></summary>
                  <div class="rte sv3-specification-value">
                    {% if structured_spec_count > 0 %}
                      <table class="sv3-spec-table"><tbody>
                        {% if spec_collection != blank %}<tr><th>Collection</th><td>{{ spec_collection | metafield_tag }}</td></tr>{% endif %}
                        {% if spec_color != blank %}<tr><th>Color</th><td>{{ spec_color | metafield_tag: field: 'label' }}</td></tr>{% endif %}
                        {% if spec_band_color != blank %}<tr><th>Band color</th><td>{{ spec_band_color | metafield_tag: field: 'label' }}</td></tr>{% endif %}
                        {% if spec_case_color != blank %}<tr><th>Case color</th><td>{{ spec_case_color | metafield_tag: field: 'label' }}</td></tr>{% endif %}
                        {% if spec_dial_color != blank %}<tr><th>Dial color</th><td>{{ spec_dial_color | metafield_tag: field: 'label' }}</td></tr>{% endif %}
                        {% if spec_watch_color != blank %}<tr><th>Watch color</th><td>{{ spec_watch_color | metafield_tag }}</td></tr>{% endif %}
                        {% if spec_case_shape != blank %}<tr><th>Case shape</th><td>{{ spec_case_shape | metafield_tag }}</td></tr>{% endif %}
                        {% if spec_case_size != blank %}<tr><th>Case size</th><td>{{ spec_case_size | metafield_tag }}</td></tr>{% endif %}
                        {% if spec_material != blank %}<tr><th>Material</th><td>{{ spec_material | metafield_tag: field: 'label' }}</td></tr>{% endif %}
                        {% if spec_watch_material != blank %}<tr><th>Watch material</th><td>{{ spec_watch_material | metafield_tag: field: 'label' }}</td></tr>{% endif %}
                        {% if spec_strap_material != blank %}<tr><th>Strap material</th><td>{{ spec_strap_material | metafield_tag }}</td></tr>{% endif %}
                        {% if spec_display != blank %}<tr><th>Display</th><td>{{ spec_display | metafield_tag: field: 'label' }}</td></tr>{% endif %}
                        {% if spec_movement != blank %}<tr><th>Movement</th><td>{% if spec_movement.type contains 'metaobject_reference' %}{{ spec_movement | metafield_tag: field: 'label' }}{% else %}{{ spec_movement | metafield_tag }}{% endif %}</td></tr>{% endif %}
                        {% if spec_features != blank %}<tr><th>Features</th><td>{{ spec_features | metafield_tag: field: 'label' }}</td></tr>{% endif %}
                        {% if spec_age_group != blank %}<tr><th>Age group</th><td>{{ spec_age_group | metafield_tag: field: 'label' }}</td></tr>{% endif %}
                        {% if spec_target_gender != blank %}<tr><th>Target gender</th><td>{{ spec_target_gender | metafield_tag: field: 'label' }}</td></tr>{% endif %}
                        {% if spec_warranty != blank %}<tr><th>Warranty</th><td>{{ spec_warranty | metafield_tag }}</td></tr>{% endif %}
                      </tbody></table>
                    {% endif %}
                    {% if specification_metafield != blank %}<div class="sv3-specification-notes">{{ specification_metafield | metafield_tag }}</div>{% endif %}
                  </div>
                </details>
              </div>
            </section>
          {% endif %}

        {% when 'product_description' %}
          {% if product.description != blank %}
            <section class="sv3-information sv3-reveal" {{ block.shopify_attributes }}>
              <div class="sv3-information__grid">
                <details class="sv3-content" {% if block.settings.open %}open{% endif %}>
                  <summary><b>{{ block.settings.heading }}</b><i>+</i></summary>
                  <div class="rte">{{ product.description }}</div>
                </details>
              </div>
            </section>
          {% endif %}

        {% when 'content_accordion' %}
          {% if block.settings.content != blank %}
            <section class="sv3-information sv3-reveal" {{ block.shopify_attributes }}>
              <div class="sv3-information__grid">
                <details class="sv3-content" {% if block.settings.open %}open{% endif %}>
                  <summary><b>{{ block.settings.heading }}</b><i>+</i></summary>
                  <div class="rte">{{ block.settings.content }}</div>
                </details>
              </div>
            </section>
          {% endif %}

        {% when 'review' %}
          <section class="sv3-reviews-app sv3-reveal" {{ block.shopify_attributes }}>
            <header class="sv3-section-heading"><span>{{ section.settings.reviews_eyebrow }}</span><h2>{{ section.settings.reviews_heading }}</h2><p>Ratings and feedback submitted by real customers.</p></header>
            <div class="sv3-reviews-app__widget">
              <article class="sv3-content">
                <div class="rte"><p>“{{ block.settings.review }}”</p><strong>{{ block.settings.name }}</strong></div>
              </article>
              {% for app_block in section.blocks %}{% if app_block.type == '@app' %}{% render app_block %}{% endif %}{% endfor %}
            </div>
          </section>

        {% when 'faq_section' %}
          <section class="sv3-faqs sv3-reveal" {{ block.shopify_attributes }}>
            <header class="sv3-section-heading"><span>{{ block.settings.eyebrow }}</span><h2>{{ block.settings.heading }}</h2><p>{{ block.settings.text }}</p></header>
            <div class="sv3-faqs__list">
              {% for faq in section.blocks %}
                {% if faq.type == 'faq' %}
                  {% assign faq_brand_handle = faq.settings.brand | handle %}
                  {% if faq.settings.brand == blank or faq_brand_handle == vendor_handle %}
                    <details class="sv3-faq" {{ faq.shopify_attributes }}><summary><b>{{ faq.settings.question }}</b><i>+</i></summary><div class="rte">{{ faq.settings.answer }}</div></details>
                  {% endif %}
                {% endif %}
              {% endfor %}
            </div>
          </section>

        {% when 'recommendations' %}
          <section class="sv3-recommendations sv3-product-showcase sv3-reveal" data-similar-watches data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ block.settings.limit }}&intent=related" {{ block.shopify_attributes }}>
            <header class="sv3-section-heading"><span>{{ block.settings.eyebrow }}</span><h2>{{ block.settings.heading }}</h2><p>Premium watches selected for a similar look, value and style.</p></header>
            <div class="sv3-recommendations__grid" data-similar-grid>
              {% if recommendations.performed and recommendations.products_count > 0 %}
                {% for item in recommendations.products %}
                  <a href="{{ item.url }}" class="sv3-product-card"><div class="sv3-product-card__media">{{ item.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '220,360,520,700', alt: item.title }}{% if item.compare_at_price > item.price %}<em>Sale</em>{% endif %}</div><span>{{ item.vendor }}</span><b>{{ item.title }}</b><div><strong>{{ item.price | money }}</strong>{% if item.compare_at_price > item.price %}<del>{{ item.compare_at_price | money }}</del>{% endif %}</div></a>
                {% endfor %}
              {% else %}
                {% for index in (1..4) %}<div class="sv3-product-skeleton" aria-hidden="true"><i></i><span></span><b></b><small></small></div>{% endfor %}
              {% endif %}
            </div>
          </section>

        {% when 'trending' %}
          {% assign trending_source = block.settings.collection | default: product.collections.first %}
          {% if trending_source != blank and trending_source.all_products_count > 0 %}
            <section class="sv3-recommendations sv3-product-showcase sv3-product-showcase--trending sv3-reveal" {{ block.shopify_attributes }}>
              <header class="sv3-section-heading"><span>{{ block.settings.eyebrow }}</span><h2>{{ block.settings.heading }}</h2><p>{{ block.settings.text }}</p></header>
              <div class="sv3-recommendations__grid">
                {% assign trending_rendered = 0 %}
                {% for item in trending_source.products %}
                  {% if item.id != product.id and trending_rendered < block.settings.limit %}
                    {% assign trending_rendered = trending_rendered | plus: 1 %}
                    <a href="{{ item.url }}" class="sv3-product-card"><div class="sv3-product-card__media">{{ item.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '220,360,520,700', alt: item.title }}<em>Trending</em></div><span>{{ item.vendor }}</span><b>{{ item.title }}</b><div><strong>{{ item.price | money }}</strong>{% if item.compare_at_price > item.price %}<del>{{ item.compare_at_price | money }}</del>{% endif %}</div></a>
                  {% endif %}
                {% endfor %}
              </div>
            </section>
          {% endif %}

      {% endcase %}
    {% endfor %}
  </div>

  <div class="sv3-sticky" data-sticky-bar><div>{{ featured.preview_image | image_url: width: 100 | image_tag: loading: 'lazy', alt: product.title }}<span><b>{{ product.title }}</b><small data-sticky-price>{{ variant.price | money }}</small></span></div><button type="button" data-sticky-atc {% unless variant.available %}disabled{% endunless %}>Add to cart</button></div>

  <dialog class="sv3-dialog" data-dialog="spin"><button type="button" class="sv3-dialog__close" data-close-dialog>×</button><div class="sv3-dialog__heading"><span>Interactive view</span><h2>360° watch experience</h2><p>Drag horizontally to rotate the watch.</p></div><div class="sv3-spin" data-spin-viewer>{% if spin_images != blank %}{% for spin_image in spin_images %}{% if forloop.first %}{{ spin_image | image_url: width: 1400 | image_tag: loading: 'eager', alt: product.title, data-spin-frame: '' }}{% else %}{{ spin_image | image_url: width: 1400 | image_tag: loading: 'lazy', alt: product.title, data-spin-frame: '', hidden: true }}{% endif %}{% endfor %}{% endif %}<span>↔ Drag to rotate</span></div></dialog>
  <dialog class="sv3-dialog sv3-dialog--form" data-dialog="visit">
    <button type="button" class="sv3-dialog__close" data-close-dialog>×</button>
    <div class="sv3-dialog__heading"><span>Boutique reservation</span><h2>{{ section.settings.visit_heading }}</h2><p>{{ section.settings.visit_text }}</p></div>
    <div class="sv3-deposit-summary"><span>Reservation advance</span><strong>{% if deposit_variant != blank %}{{ deposit_variant.price | money }}{% else %}30% of product value{% endif %}</strong><small>Remaining amount is payable when you visit the showroom and complete the purchase.</small></div>
    <div class="sv3-booking">
      <input type="text" placeholder="Your name" data-visit-name>
      <input type="tel" placeholder="Phone number" data-visit-phone>
      <input type="date" data-visit-date>
      <select data-visit-store>{% if showroom_blocks.size > 0 %}{% for block in showroom_blocks %}<option value="{{ block.settings.name | escape }}">{{ block.settings.name }}</option>{% endfor %}{% else %}<option value="Krishna Nagar">Krishna Nagar</option><option value="Noida Sector 18">Noida Sector 18</option><option value="Noida Sector 120">Noida Sector 120</option>{% endif %}</select>
      <textarea placeholder="Anything we should prepare for your visit?" data-visit-note></textarea>
      {% if deposit_variant != blank %}<button type="button" class="sv3-button sv3-button--gold" data-pay-deposit>Pay 30% advance & reserve</button>{% endif %}
      <button type="button" class="sv3-button sv3-button--outline" data-submit-visit>Confirm details on WhatsApp</button>
      <p data-visit-result></p>
    </div>
  </dialog>
  <dialog class="sv3-dialog sv3-dialog--form" data-dialog="emi"><button type="button" class="sv3-dialog__close" data-close-dialog>×</button><div class="sv3-dialog__heading"><span>Flexible payments</span><h2>Estimate your EMI</h2><p>Indicative calculation; final bank terms may differ.</p></div><div class="sv3-emi"><label>Tenure<select data-emi-months><option value="3">3 months</option><option value="6">6 months</option><option value="9">9 months</option><option value="12">12 months</option></select></label><div><span>Estimated monthly payment</span><strong data-emi-value>{{ variant.price | divided_by: 3 | money }}</strong></div><small>{{ section.settings.emi_disclaimer }}</small></div></dialog>
  <dialog class="sv3-dialog sv3-dialog--zoom" data-dialog="zoom"><button type="button" class="sv3-dialog__close" data-close-dialog>×</button><div data-zoom-target></div></dialog>

  <script>
    (() => {
      const root = document.getElementById('SethiV3-{{ section.id }}');
      if (!root || root.dataset.premiumUiReady === 'true') return;
      root.dataset.premiumUiReady = 'true';

      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const reveals = root.querySelectorAll('.sv3-reveal');

      if (!reducedMotion && 'IntersectionObserver' in window) {
        root.classList.add('sv3-has-motion');
        const revealObserver = new IntersectionObserver((entries, observer) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -40px' });
        reveals.forEach((element) => revealObserver.observe(element));
      } else {
        reveals.forEach((element) => element.classList.add('is-visible'));
      }

      const STOCK_REQUEST_URL = 'https://script.google.com/macros/s/AKfycbxulVevZV6Pp3fjn_ackXs0NFDOPcvrzvtF-HArdk0e3ABDHumpPhQmUEzDCztVGAn2xg/exec';

      root.querySelectorAll('[data-submit-enquiry]').forEach((button) => {
        button.addEventListener('click', () => {
          const enquiry = button.closest('[data-enquiry]');
          if (!enquiry) return;

          const nameInput = enquiry.querySelector('[data-enquiry-name]');
          const phoneInput = enquiry.querySelector('[data-enquiry-phone]');
          const result = enquiry.querySelector('[data-enquiry-result]');
          const name = nameInput?.value.trim() || '';
          const phone = phoneInput?.value.trim() || '';

          if (!name || !phone) {
            if (result) {
              result.textContent = 'Please enter your name and phone number.';
              result.style.color = '#b42318';
            }
            if (!name) nameInput?.focus(); else phoneInput?.focus();
            return;
          }

          const originalLabel = button.textContent.trim();
          button.disabled = true;
          button.textContent = 'Sending...';

          const payload = {
            request_type: 'out_of_stock_request',
            submitted_at: new Date().toISOString(),
            name: name,
            phone: phone,
            product: {{ product.title | json }},
            variant_id: {{ variant.id | json }},
            product_url: window.location.href,
            product_handle: {{ product.handle | json }},
            product_vendor: {{ product.vendor | json }},
            product_price: {{ product.price | money_without_currency | strip_html | json }},
            device: window.matchMedia('(max-width: 749px)').matches ? 'mobile' : 'desktop'
          };

          fetch(STOCK_REQUEST_URL, {
            method: 'POST',
            mode: 'no-cors',
            headers: { 'Content-Type': 'text/plain;charset=utf-8' },
            body: JSON.stringify(payload)
          }).then(() => {
            if (result) {
              result.textContent = 'Thank you. Our team will contact you regarding availability.';
              result.style.color = '#16803c';
            }
            if (nameInput) nameInput.value = '';
            if (phoneInput) phoneInput.value = '';
            button.textContent = 'Request submitted';
          }).catch((error) => {
            console.error('Availability enquiry error:', error);
            if (result) {
              result.textContent = 'Something went wrong. Please try again.';
              result.style.color = '#b42318';
            }
            button.disabled = false;
            button.textContent = originalLabel;
          });
        });
      });

      const stickyBar = root.querySelector('[data-sticky-bar]');
      const primaryAtc = root.querySelector('[data-atc]');
      const purchaseAvailable = root.querySelector('[data-purchase-available]');

      const updateStickyBar = () => {
        if (!stickyBar || !primaryAtc || window.innerWidth >= 990) {
          stickyBar?.classList.remove('is-visible');
          return;
        }

        const primaryButtonPassed = primaryAtc.getBoundingClientRect().bottom < 0;
        const productAvailable = purchaseAvailable && !purchaseAvailable.hidden && !primaryAtc.disabled;
        stickyBar.classList.toggle('is-visible', Boolean(primaryButtonPassed && productAvailable));
      };

      let scrollFrame;
      const requestStickyUpdate = () => {
        window.cancelAnimationFrame(scrollFrame);
        scrollFrame = window.requestAnimationFrame(updateStickyBar);
      };

      window.addEventListener('scroll', requestStickyUpdate, { passive: true });
      window.addEventListener('resize', requestStickyUpdate);
      new MutationObserver(requestStickyUpdate).observe(root, {
        subtree: true,
        attributes: true,
        attributeFilter: ['hidden', 'disabled', 'value']
      });
      updateStickyBar();

      const dateInput = root.querySelector('[data-visit-date]');
      if (dateInput && !dateInput.min) {
        const today = new Date();
        const year = today.getFullYear();
        const month = String(today.getMonth() + 1).padStart(2, '0');
        const day = String(today.getDate()).padStart(2, '0');
        dateInput.min = `${year}-${month}-${day}`;
      }

      const videoCallButtons = root.querySelectorAll('[data-video-call]');
      const updateVideoCallAvailability = () => {
        const now = new Date();
        const hour = now.getHours();
        const isOpen = hour >= 12 && hour < 20;
        videoCallButtons.forEach((button) => {
          const status = button.querySelector('[data-video-call-status]');
          button.disabled = !isOpen;
          button.setAttribute('aria-disabled', String(!isOpen));
          if (status) status.textContent = isOpen ? button.dataset.openLabel : button.dataset.closedLabel;
        });
      };
      updateVideoCallAvailability();
      window.setInterval(updateVideoCallAvailability, 60000);

      const getWhatsAppUrl = (message) => {
        const number = root.dataset.whatsapp || '';
        return `https://wa.me/${number}?text=${encodeURIComponent(message)}`;
      };

      videoCallButtons.forEach((button) => {
        button.addEventListener('click', () => {
          if (button.disabled) return;
          const productTitle = {{ product.title | json }};
          const productUrl = {{ product.url | prepend: shop.url | json }};
          const message = `Hi, I want to shop this watch on video call between 12 PM - 8 PM.\n\nWatch: ${productTitle}\nLink: ${productUrl}`;
          window.open(getWhatsAppUrl(message), '_blank', 'noopener');
        });
      });

      root.querySelectorAll('[data-delivery]').forEach((deliveryBox) => {
        const input = deliveryBox.querySelector('[data-pincode]');
        const button = deliveryBox.querySelector('[data-check-pincode]');
        const result = deliveryBox.querySelector('[data-pincode-result]');
        if (!input || !button || !result) return;

        button.addEventListener('click', () => {
          const pincode = input.value.trim();
          window.setTimeout(() => {
            if (!/^\d{6}$/.test(pincode) || !result.hidden) return;
            result.hidden = false;
            result.textContent = 'Bluedart ETA: usually 2-5 working days after dispatch. Final delivery time depends on Bluedart serviceability for this pincode.';
          }, 250);
        });
      });

      const similarSection = root.querySelector('[data-similar-watches]');
      const similarGrid = similarSection?.querySelector('[data-similar-grid]');
      if (similarSection && similarGrid?.querySelector('.sv3-product-skeleton')) {
        fetch(similarSection.dataset.url)
          .then((response) => {
            if (!response.ok) throw new Error('Recommendations unavailable');
            return response.text();
          })
          .then((html) => {
            const parsed = new DOMParser().parseFromString(html, 'text/html');
            const incomingGrid = parsed.querySelector('[data-similar-grid]');
            if (!incomingGrid || !incomingGrid.querySelector('.sv3-product-card')) {
              similarSection.hidden = true;
              return;
            }
            similarGrid.replaceChildren(...incomingGrid.children);
          })
          .catch(() => {
            similarSection.hidden = true;
          });
      }

      root.addEventListener('click', (event) => {
        if (event.target.closest('[data-scroll-reviews]')) {
          root.querySelector('#SethiReviews-{{ section.id }}')?.scrollIntoView({
            behavior: reducedMotion ? 'auto' : 'smooth',
            block: 'start'
          });
        }

        if (event.target.closest('[data-scroll-authenticity]')) {
          root.querySelector('[data-authenticity-section]')?.scrollIntoView({
            behavior: reducedMotion ? 'auto' : 'smooth',
            block: 'start'
          });
        }
      });
    })();
  </script>

  <script type="application/json" data-product-json>{{ product.variants | json }}</script>
  <script type="application/json" data-spin-json>[{% if spin_images != blank %}{% for spin_image in spin_images %}"{{ spin_image | image_url: width: 1400 }}"{% unless forloop.last %},{% endunless %}{% endfor %}{% endif %}]</script>
</section>

