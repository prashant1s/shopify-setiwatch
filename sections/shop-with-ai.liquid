{% comment %}
  SETHI AI – SMART WATCH FINDER
  Standalone Custom Liquid Code
{% endcomment %}

<div id="sethi-ai-concierge">

  <!-- FLOATING BUTTON -->
  <button class="sethi-ai-floating-btn" type="button">
    <span class="sethi-ai-floating-icon">✦</span>
    <span>Shop with AI</span>
  </button>

  <!-- OVERLAY -->
  <div class="sethi-ai-overlay"></div>

  <!-- AI DRAWER -->
  <div class="sethi-ai-drawer">

    <!-- HEADER -->
    <div class="sethi-ai-header">

      <div class="sethi-ai-brand">
        <div class="sethi-ai-logo">✦</div>

        <div>
          <span class="sethi-ai-eyebrow">SETHI WATCH COMPANY</span>
          <h2>SETHI AI</h2>
        </div>
      </div>

      <button class="sethi-ai-close" type="button">×</button>

    </div>

    <!-- CHAT AREA -->
    <div class="sethi-ai-chat-area">

      <div class="sethi-ai-messages">

        <!-- WELCOME -->
        <div class="sethi-ai-welcome">

          <div class="sethi-ai-welcome-icon">✦</div>

          <span class="sethi-ai-small-label">
            YOUR PERSONAL WATCH CONCIERGE
          </span>

          <h3>Find a watch you'll love.</h3>

          <p>
            Tell me what you're looking for in your own words.
            Budget, occasion, style or brand — I'll help you find the right watch.
          </p>

        </div>

        <!-- SUGGESTIONS -->
        <div class="sethi-ai-suggestions">

          <button type="button"
            class="sethi-ai-suggestion"
            data-prompt="Suggest an elegant women's watch under ₹30,000">
            <span>✦</span>
            <div>
              <strong>Elegant for Her</strong>
              <small>Find a beautiful women's watch</small>
            </div>
          </button>

          <button type="button"
            class="sethi-ai-suggestion"
            data-prompt="Suggest a premium men's watch under ₹50,000">
            <span>◈</span>
            <div>
              <strong>Premium for Him</strong>
              <small>Explore refined men's watches</small>
            </div>
          </button>

          <button type="button"
            class="sethi-ai-suggestion"
            data-prompt="I need a watch for office and daily wear">
            <span>◌</span>
            <div>
              <strong>Everyday Essential</strong>
              <small>Versatile watches for daily wear</small>
            </div>
          </button>

        </div>

      </div>


      <!-- TYPING -->
      <div class="sethi-ai-typing">

        <div class="sethi-ai-message-avatar">✦</div>

        <div class="sethi-ai-typing-bubble">
          <span></span>
          <span></span>
          <span></span>
        </div>

      </div>

    </div>


    <!-- INPUT -->
    <div class="sethi-ai-input-area">

      <div class="sethi-ai-input-wrap">

        <textarea
          class="sethi-ai-input"
          placeholder="Ask me anything about watches..."
          rows="1"
        ></textarea>

        <button class="sethi-ai-send" type="button">
          ↑
        </button>

      </div>

      <p>
        SETHI AI recommends products from our available collection.
      </p>

    </div>

  </div>

</div>


<style>

#sethi-ai-concierge {
  --ai-dark: #1e1e1d;
  --ai-bg: #f6f4f0;
  --ai-border: #ddd8cf;
  --ai-text: #282827;
  --ai-muted: #747474;
  --ai-gold: #a67d43;
  font-family: Arial, Helvetica, sans-serif;
}


/* FLOAT BUTTON */

.sethi-ai-floating-btn {
  position: fixed;
  right: 28px;
  bottom: 28px;
  z-index: 999999;

  border: 1px solid rgba(255,255,255,.3);
  background: #050505;
  color: #fff;

  height: 70px;
  padding: 0 28px 0 10px;

  border-radius: 100px;

  display: flex;
  align-items: center;
  gap: 15px;

  font-size: 17px;
  letter-spacing: .3px;

  cursor: pointer;

  box-shadow: 0 15px 40px rgba(0,0,0,.2);

  transition: .3s ease;
}

.sethi-ai-floating-btn:hover {
  transform: translateY(-3px);
}

.sethi-ai-floating-icon {
  width: 50px;
  height: 50px;

  background: #f2f2f0;
  color: #111;

  border-radius: 50%;

  display: flex;
  align-items: center;
  justify-content: center;

  font-size: 23px;
}


/* OVERLAY */

.sethi-ai-overlay {
  position: fixed;
  inset: 0;

  background: rgba(0,0,0,.35);

  opacity: 0;
  visibility: hidden;

  z-index: 999997;

  transition: .3s ease;
}

.sethi-ai-overlay.active {
  opacity: 1;
  visibility: visible;
}


/* DRAWER */

.sethi-ai-drawer {
  position: fixed;

  right: 0;
  top: 0;

  width: min(620px, 100%);
  height: 100vh;

  background: var(--ai-bg);

  z-index: 999998;

  display: flex;
  flex-direction: column;

  transform: translateX(105%);

  transition: transform .45s cubic-bezier(.22,.61,.36,1);

  box-shadow: -20px 0 60px rgba(0,0,0,.12);
}

.sethi-ai-drawer.active {
  transform: translateX(0);
}


/* HEADER */

.sethi-ai-header {
  padding: 22px 24px;

  border-bottom: 1px solid var(--ai-border);

  display: flex;
  justify-content: space-between;
  align-items: center;

  flex-shrink: 0;
}

.sethi-ai-brand {
  display: flex;
  align-items: center;
  gap: 13px;
}

.sethi-ai-logo {
  width: 56px;
  height: 56px;

  border-radius: 50%;

  background: var(--ai-dark);
  color: white;

  display: flex;
  align-items: center;
  justify-content: center;

  font-size: 25px;
}

.sethi-ai-eyebrow {
  display: block;

  font-size: 10px;
  letter-spacing: 3px;

  color: var(--ai-gold);

  font-weight: 700;

  margin-bottom: 3px;
}

.sethi-ai-brand h2 {
  margin: 0;

  font-family: Georgia, serif;

  font-size: 28px;
  font-weight: 500;

  letter-spacing: 1px;
}

.sethi-ai-close {
  background: transparent;
  border: 0;

  font-size: 42px;
  line-height: 1;

  cursor: pointer;

  color: #333;
}


/* CHAT */

.sethi-ai-chat-area {
  flex: 1;

  overflow-y: auto;

  padding: 28px 24px 20px;
}

.sethi-ai-messages {
  max-width: 100%;
}


/* WELCOME */

.sethi-ai-welcome {
  text-align: center;

  padding: 30px 20px 22px;
}

.sethi-ai-welcome-icon {
  width: 60px;
  height: 60px;

  border-radius: 50%;

  margin: 0 auto 24px;

  background: var(--ai-dark);
  color: white;

  display: flex;
  align-items: center;
  justify-content: center;

  font-size: 25px;
}

.sethi-ai-small-label {
  font-size: 10px;
  font-weight: 700;

  letter-spacing: 3px;

  color: var(--ai-gold);
}

.sethi-ai-welcome h3 {
  font-family: Georgia, serif;

  font-size: 42px;
  font-weight: 400;

  margin: 13px 0;
}

.sethi-ai-welcome p {
  max-width: 450px;

  margin: auto;

  color: var(--ai-muted);

  line-height: 1.7;

  font-size: 16px;
}


/* SUGGESTIONS */

.sethi-ai-suggestions {
  display: grid;
  gap: 10px;

  margin-top: 15px;
}

.sethi-ai-suggestion {
  width: 100%;

  padding: 18px;

  border: 1px solid var(--ai-border);

  background: transparent;

  text-align: left;

  display: flex;
  align-items: center;
  gap: 16px;

  cursor: pointer;

  transition: .25s ease;
}

.sethi-ai-suggestion:hover {
  background: white;
  border-color: #aaa;
}

.sethi-ai-suggestion > span {
  width: 35px;

  font-size: 20px;

  text-align: center;
}

.sethi-ai-suggestion strong,
.sethi-ai-suggestion small {
  display: block;
}

.sethi-ai-suggestion strong {
  font-size: 15px;

  margin-bottom: 4px;
}

.sethi-ai-suggestion small {
  color: var(--ai-muted);
}


/* MESSAGE */

.sethi-ai-message {
  display: flex;

  gap: 12px;

  margin-bottom: 24px;

  width: 100%;
}

.sethi-ai-message.ai {
  justify-content: flex-start;
}

.sethi-ai-message.user {
  justify-content: flex-end;
}


.sethi-ai-message-avatar {
  flex: 0 0 42px;

  width: 42px;
  height: 42px;

  border-radius: 50%;

  background: var(--ai-dark);
  color: white;

  display: flex;
  align-items: center;
  justify-content: center;

  font-size: 17px;
}

.sethi-ai-message-content {
  max-width: calc(100% - 55px);
}

.sethi-ai-message-bubble {
  padding: 17px 19px;

  line-height: 1.65;

  font-size: 16px;

  letter-spacing: .3px;

  word-break: break-word;
  overflow-wrap: anywhere;
}

.sethi-ai-message.ai .sethi-ai-message-bubble {
  background: #fff;

  border: 1px solid var(--ai-border);

  color: #4d4d4d;
}

.sethi-ai-message.user .sethi-ai-message-bubble {
  background: var(--ai-dark);

  color: white;

  max-width: 82%;

  display: inline-block;

  margin-left: auto;
}


/* PRODUCT CARDS */

.sethi-ai-products {
  display: grid;

  gap: 12px;

  margin-top: 14px;
}

.sethi-ai-product-card {
  display: flex;

  gap: 14px;

  background: #fff;

  border: 1px solid var(--ai-border);

  padding: 12px;

  text-decoration: none;

  color: inherit;

  transition: .25s ease;
}

.sethi-ai-product-card:hover {
  transform: translateY(-2px);

  box-shadow: 0 10px 25px rgba(0,0,0,.06);
}

.sethi-ai-product-image {
  width: 105px;
  height: 105px;

  flex: 0 0 105px;

  background: #f5f5f5;

  display: flex;
  align-items: center;
  justify-content: center;

  overflow: hidden;
}

.sethi-ai-product-image img {
  width: 100%;
  height: 100%;

  object-fit: contain;
}

.sethi-ai-product-info {
  padding: 4px 0;

  flex: 1;
}

.sethi-ai-product-match {
  display: inline-block;

  font-size: 9px;

  color: var(--ai-gold);

  letter-spacing: 1px;

  margin-bottom: 6px;
}

.sethi-ai-product-vendor {
  display: block;

  font-size: 9px;

  letter-spacing: 1.5px;

  color: #888;

  margin-bottom: 6px;
}

.sethi-ai-product-title {
  font-family: Georgia, serif;

  font-size: 16px;

  font-weight: 400;

  line-height: 1.35;

  margin: 0 0 9px;
}

.sethi-ai-product-price {
  font-size: 15px;

  font-weight: 600;
}


/* TYPING */

.sethi-ai-typing {
  display: none;

  align-items: center;

  gap: 12px;

  margin-top: 10px;
}

.sethi-ai-typing.active {
  display: flex;
}

.sethi-ai-typing-bubble {
  background: white;

  border: 1px solid var(--ai-border);

  padding: 15px 18px;
}

.sethi-ai-typing-bubble span {
  width: 6px;
  height: 6px;

  display: inline-block;

  background: #777;

  border-radius: 50%;

  margin: 0 2px;

  animation: sethiTyping 1.2s infinite;
}

.sethi-ai-typing-bubble span:nth-child(2) {
  animation-delay: .2s;
}

.sethi-ai-typing-bubble span:nth-child(3) {
  animation-delay: .4s;
}

@keyframes sethiTyping {

  0%, 60%, 100% {
    transform: translateY(0);
    opacity: .4;
  }

  30% {
    transform: translateY(-5px);
    opacity: 1;
  }

}


/* INPUT */

.sethi-ai-input-area {
  padding: 16px 24px 18px;

  background: var(--ai-bg);

  border-top: 1px solid var(--ai-border);

  flex-shrink: 0;
}

.sethi-ai-input-wrap {
  display: flex;

  align-items: flex-end;

  border: 1px solid #cfcac2;

  background: white;

  padding: 7px;
}

.sethi-ai-input {
  flex: 1;

  resize: none;

  border: 0;

  outline: none;

  background: transparent;

  padding: 11px 12px;

  min-height: 45px;
  max-height: 120px;

  font-family: inherit;

  font-size: 15px;
}

.sethi-ai-send {
  width: 45px;
  height: 45px;

  border: 0;

  background: var(--ai-dark);

  color: white;

  font-size: 23px;

  cursor: pointer;

  transition: .2s;
}

.sethi-ai-send:hover {
  background: #444;
}

.sethi-ai-input-area p {
  text-align: center;

  margin: 9px 0 0;

  font-size: 10px;

  color: #999;
}


/* MOBILE */

@media(max-width: 600px) {

  .sethi-ai-floating-btn {
    right: 16px;
    bottom: 16px;

    height: 58px;

    padding-right: 20px;

    font-size: 14px;
  }

  .sethi-ai-floating-icon {
    width: 42px;
    height: 42px;
  }

  .sethi-ai-drawer {
    width: 100%;
  }

  .sethi-ai-header {
    padding: 16px;
  }

  .sethi-ai-brand h2 {
    font-size: 24px;
  }

  .sethi-ai-logo {
    width: 48px;
    height: 48px;
  }

  .sethi-ai-chat-area {
    padding: 20px 14px;
  }

  .sethi-ai-input-area {
    padding: 12px 14px;
  }

  .sethi-ai-welcome h3 {
    font-size: 32px;
  }

  .sethi-ai-product-image {
    width: 85px;
    height: 85px;

    flex-basis: 85px;
  }

}

</style>


<script>

document.addEventListener('DOMContentLoaded', function () {

  const container = document.querySelector('#sethi-ai-concierge');

  if (!container) return;


  const floatingButton = container.querySelector('.sethi-ai-floating-btn');
  const drawer = container.querySelector('.sethi-ai-drawer');
  const overlay = container.querySelector('.sethi-ai-overlay');
  const closeButton = container.querySelector('.sethi-ai-close');

  const input = container.querySelector('.sethi-ai-input');
  const sendButton = container.querySelector('.sethi-ai-send');

  const messagesContainer = container.querySelector('.sethi-ai-messages');
  const typing = container.querySelector('.sethi-ai-typing');

  const chatArea = container.querySelector('.sethi-ai-chat-area');

  const suggestions = container.querySelectorAll('.sethi-ai-suggestion');

  const welcome = container.querySelector('.sethi-ai-welcome');
  const suggestionsBox = container.querySelector('.sethi-ai-suggestions');


  let conversationHistory = [];


  /* OPEN */

  function openChat() {

    drawer.classList.add('active');
    overlay.classList.add('active');

    document.body.style.overflow = 'hidden';

    setTimeout(function () {
      input.focus();
    }, 400);

  }


  /* CLOSE */

  function closeChat() {

    drawer.classList.remove('active');
    overlay.classList.remove('active');

    document.body.style.overflow = '';

  }


  floatingButton.addEventListener('click', openChat);
  closeButton.addEventListener('click', closeChat);
  overlay.addEventListener('click', closeChat);


  /* INPUT RESIZE */

  input.addEventListener('input', function () {

    this.style.height = 'auto';

    this.style.height =
      Math.min(this.scrollHeight, 120) + 'px';

  });


  /* ENTER */

  input.addEventListener('keydown', function (event) {

    if (event.key === 'Enter' && !event.shiftKey) {

      event.preventDefault();

      sendMessage();

    }

  });


  sendButton.addEventListener('click', sendMessage);


  /* SUGGESTIONS */

  suggestions.forEach(function (button) {

    button.addEventListener('click', function () {

      input.value = this.dataset.prompt;

      sendMessage();

    });

  });


  /* SEND MESSAGE */

  async function sendMessage() {

    const message = input.value.trim();

    if (!message) return;


    welcome.style.display = 'none';
    suggestionsBox.style.display = 'none';


    addUserMessage(message);


    conversationHistory.push({
      role: 'user',
      content: message
    });


    input.value = '';
    input.style.height = '45px';


    typing.classList.add('active');

    scrollToBottom();


    /*
      ANALYSE CUSTOMER REQUIREMENT
    */

    const intent = analyseMessage(
      message,
      conversationHistory
    );


    /*
      SEARCH PRODUCTS
    */

    let products = [];

    try {

      products = await searchShopifyProducts(intent);

    } catch(error) {

      console.log('Product search error:', error);

    }


    typing.classList.remove('active');


    const reply = generateReply(intent, products);


    addAIMessage(reply, products);


    conversationHistory.push({
      role: 'assistant',
      content: reply
    });


  }


  /* ==========================================
     UNDERSTAND CUSTOMER MESSAGE
  ========================================== */

  function analyseMessage(message, history) {

    const text = message.toLowerCase();

    const allHistory = history
      .map(item => item.content || '')
      .join(' ')
      .toLowerCase();


    let intent = {

      budget: null,
      gender: null,
      brand: null,
      style: [],
      occasion: [],
      searchTerms: []

    };


    /*
      BUDGET DETECTION
    */

    const budgetPatterns = [

      /under\s*₹?\s*(\d+)\s*k/i,
      /below\s*₹?\s*(\d+)\s*k/i,
      /within\s*₹?\s*(\d+)\s*k/i,
      /₹\s*(\d+)\s*k/i,
      /(\d+)\s*k\s*(budget)?/i,

      /under\s*₹?\s*(\d{4,6})/i,
      /below\s*₹?\s*(\d{4,6})/i,
      /₹\s*(\d{4,6})/i,

      /(\d{4,6})\s*(rupees|rs)/i

    ];


    for (const pattern of budgetPatterns) {

      const match = text.match(pattern);

      if (match) {

        let value = parseInt(match[1]);

        if (
          pattern.source.includes('k')
        ) {
          value = value * 1000;
        }

        if (value > 1000) {
          intent.budget = value;
          break;
        }

      }

    }


    /*
      GENDER / RECIPIENT
    */

    if (

      /women|woman|ladies|lady|female|girl|girlfriend|wife|her|gf|sister|mother|mom|mummy/i.test(allHistory)

    ) {

      intent.gender = 'women';

    }


    if (

      /men|man|male|boy|boyfriend|husband|him|brother|father|dad|bf/i.test(allHistory)

    ) {

      intent.gender = 'men';

    }


    /*
      BRANDS
    */

    const brands = [

      'seiko',
      'tissot',
      'fossil',
      'casio',
      'guess',
      'citizen',
      'timex',
      'nebula',
      'gc',
      'g-shock',
      'diesel',
      'emporio armani',
      'michael kors',
      'tommy hilfiger'

    ];


    brands.forEach(function (brand) {

      if (allHistory.includes(brand)) {

        intent.brand = brand;

      }

    });


    /*
      STYLE
    */

    const styleKeywords = {

      elegant: ['elegant', 'classy', 'sophisticated', 'graceful'],

      luxury: ['luxury', 'luxurious', 'premium', 'high-end'],

      classic: ['classic', 'timeless', 'traditional'],

      sporty: ['sporty', 'sports', 'rugged', 'outdoor'],

      minimal: ['minimal', 'minimalist', 'simple', 'clean'],

      vintage: ['vintage', 'retro'],

      bold: ['bold', 'statement', 'fashion'],

      automatic: ['automatic', 'mechanical']

    };


    Object.keys(styleKeywords).forEach(function(style) {

      styleKeywords[style].forEach(function(keyword) {

        if (allHistory.includes(keyword)) {

          if (!intent.style.includes(style)) {

            intent.style.push(style);

          }

        }

      });

    });


    /*
      OCCASION
    */

    const occasionKeywords = {

      gift: ['gift', 'birthday', 'anniversary', 'present'],

      office: ['office', 'work', 'professional'],

      daily: ['daily', 'everyday', 'regular'],

      wedding: ['wedding', 'marriage', 'shaadi'],

      party: ['party', 'event', 'occasion'],

      travel: ['travel', 'trip']

    };


    Object.keys(occasionKeywords).forEach(function(occasion) {

      occasionKeywords[occasion].forEach(function(keyword) {

        if (allHistory.includes(keyword)) {

          if (!intent.occasion.includes(occasion)) {

            intent.occasion.push(occasion);

          }

        }

      });

    });


    /*
      BUILD SEARCH QUERY
    */

    if (intent.brand) {

      intent.searchTerms.push(intent.brand);

    }

    if (intent.gender === 'women') {

      intent.searchTerms.push('women');

    }

    if (intent.gender === 'men') {

      intent.searchTerms.push('men');

    }

    intent.style.forEach(function(style) {

      intent.searchTerms.push(style);

    });


    if (!intent.searchTerms.length) {

      /*
        Use original message keywords
      */

      intent.searchTerms = message
        .replace(/[₹0-9]/g, '')
        .split(' ')
        .filter(word => word.length > 3)
        .slice(0, 4);

    }


    return intent;

  }


  /* ==========================================
     SHOPIFY PRODUCT SEARCH
  ========================================== */

  async function searchShopifyProducts(intent) {

    let query = intent.searchTerms
      .join(' ')
      .trim();


    if (!query) {

      query = 'watch';

    }


    /*
      SHOPIFY PREDICTIVE SEARCH
    */

    const url =
      '/search/suggest.json?q=' +
      encodeURIComponent(query) +
      '&resources[type]=product' +
      '&resources[limit]=10';


    const response = await fetch(url);


    if (!response.ok) {

      throw new Error('Search failed');

    }


    const data = await response.json();


    let products =
      data.resources.results.products || [];


    /*
      FILTER AVAILABLE PRODUCTS
    */

    products = products.filter(function(product) {

      return product.available !== false;

    });


    /*
      BUDGET FILTER
    */

    if (intent.budget) {

      products = products.filter(function(product) {

        let price =
          parseFloat(product.price || 0);

        /*
          Shopify predictive search price
          usually returns paise/cents depending output.
        */

        if (price > 100000) {

          price = price / 100;

        }

        return price <= intent.budget;

      });

    }


    /*
      IF NOTHING FOUND
      SEARCH BRAND OR WATCH
    */

    if (!products.length) {

      const fallbackQuery =
        intent.brand || 'watch';


      const fallbackURL =
        '/search/suggest.json?q=' +
        encodeURIComponent(fallbackQuery) +
        '&resources[type]=product' +
        '&resources[limit]=12';


      const fallbackResponse =
        await fetch(fallbackURL);


      const fallbackData =
        await fallbackResponse.json();


      products =
        fallbackData.resources.results.products || [];


      products = products.filter(function(product) {

        return product.available !== false;

      });

    }


    /*
      LIMIT 3
    */

    return products
      .slice(0, 3)
      .map(function(product, index) {

        let price =
          parseFloat(product.price || 0);


        if (price > 100000) {

          price = price / 100;

        }


        return {

          title: product.title,

          vendor: product.vendor || 'SETHI WATCH COMPANY',

          url: product.url,

          image:
            product.image ||
            product.featured_image?.url ||
            '',

          price:
            formatMoney(price),

          match:
            96 - (index * 4)

        };

      });

  }


  /* ==========================================
     GENERATE AI RESPONSE
  ========================================== */

  function generateReply(intent, products) {

    let response = '';


    if (products.length) {

      response = 'Based on what you’re looking for';

      if (intent.budget) {

        response +=
          ' and your budget of ' +
          formatMoney(intent.budget);

      }

      response +=
        ', I found these available watches from our collection.';


      if (intent.gender === 'women') {

        response +=
          ' I’ve prioritised options suitable for her.';

      }


      if (intent.gender === 'men') {

        response +=
          ' I’ve prioritised options suitable for him.';

      }


      if (intent.brand) {

        response +=
          ' Your brand preference has also been considered.';

      }


      return response;

    }


    /*
      NO PRODUCTS
    */

    if (!intent.budget) {

      return 'I can help you find the right watch. To narrow down the best options, tell me your approximate budget — for example Under ₹10,000, ₹25,000 or ₹50,000.';

    }


    return 'I couldn’t find an exact match from the current search. Try giving me a little more detail about the style, brand or occasion, and I’ll refine the recommendations.';

  }


  /* ==========================================
     USER MESSAGE
  ========================================== */

  function addUserMessage(message) {

    const messageElement =
      document.createElement('div');


    messageElement.className =
      'sethi-ai-message user';


    const bubble =
      document.createElement('div');


    bubble.className =
      'sethi-ai-message-bubble';


    bubble.textContent = message;


    messageElement.appendChild(bubble);


    messagesContainer.appendChild(messageElement);


    scrollToBottom();

  }


  /* ==========================================
     AI MESSAGE
  ========================================== */

  function addAIMessage(message, products) {

    const messageElement =
      document.createElement('div');


    messageElement.className =
      'sethi-ai-message ai';


    const avatar =
      document.createElement('div');


    avatar.className =
      'sethi-ai-message-avatar';


    avatar.textContent = '✦';


    const content =
      document.createElement('div');


    content.className =
      'sethi-ai-message-content';


    const bubble =
      document.createElement('div');


    bubble.className =
      'sethi-ai-message-bubble';


    bubble.textContent = message;


    content.appendChild(bubble);


    /*
      PRODUCTS
    */

    if (products && products.length) {

      const wrapper =
        document.createElement('div');


      wrapper.className =
        'sethi-ai-products';


      products.forEach(function(product) {

        const card =
          document.createElement('a');


        card.className =
          'sethi-ai-product-card';


        card.href = product.url;


        card.innerHTML = `

          <div class="sethi-ai-product-image">

            ${
              product.image
                ? `<img src="${escapeHTML(product.image)}"
                    alt="${escapeHTML(product.title)}">`
                : ''
            }

          </div>


          <div class="sethi-ai-product-info">

            <span class="sethi-ai-product-match">
              ${product.match}% MATCH
            </span>


            <span class="sethi-ai-product-vendor">
              ${escapeHTML(product.vendor)}
            </span>


            <h4 class="sethi-ai-product-title">
              ${escapeHTML(product.title)}
            </h4>


            <div class="sethi-ai-product-price">
              ${escapeHTML(product.price)}
            </div>

          </div>

        `;


        wrapper.appendChild(card);

      });


      content.appendChild(wrapper);

    }


    messageElement.appendChild(avatar);
    messageElement.appendChild(content);


    messagesContainer.appendChild(messageElement);


    scrollToBottom();

  }


  /* MONEY */

  function formatMoney(value) {

    return new Intl.NumberFormat(
      'en-IN',
      {
        style: 'currency',
        currency: 'INR',
        maximumFractionDigits: 0
      }
    ).format(value);

  }


  /* SCROLL */

  function scrollToBottom() {

    setTimeout(function() {

      chatArea.scrollTo({

        top: chatArea.scrollHeight,

        behavior: 'smooth'

      });

    }, 100);

  }


  /* ESCAPE HTML */

  function escapeHTML(value) {

    if (!value) return '';

    const div =
      document.createElement('div');

    div.textContent = value;

    return div.innerHTML;

  }


});

</script>