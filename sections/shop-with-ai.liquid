<div id="sethi-ai-concierge">

  <button class="sethi-ai-floating-btn" type="button">
    <span class="sethi-ai-floating-icon">✦</span>
    <span>Shop with AI</span>
  </button>

  <div class="sethi-ai-overlay"></div>

  <div class="sethi-ai-drawer">

    <div class="sethi-ai-header">

      <div class="sethi-ai-brand">
        <div class="sethi-ai-logo">✦</div>

        <div>
          <span class="sethi-ai-eyebrow">SETHI WATCH COMPANY</span>
          <h2>SETHI AI</h2>
        </div>
      </div>

      <button class="sethi-ai-close" type="button">×</button>

    </div>


    <div class="sethi-ai-chat-area">

      <div class="sethi-ai-messages">

        <div class="sethi-ai-welcome">

          <div class="sethi-ai-welcome-icon">✦</div>

          <span class="sethi-ai-small-label">
            YOUR PERSONAL WATCH CONCIERGE
          </span>

          <h3>Find Your Perfect Watch.</h3>

          <p>
            Ask naturally. Tell me your budget, favourite brand,
            occasion, style, or even a specific model number.
          </p>

        </div>


        <div class="sethi-ai-suggestions">

          <button class="sethi-ai-suggestion" type="button"
            data-prompt="Suggest a good watch under ₹10,000">
            <span>₹</span>
            <div>
              <strong>Shop by Budget</strong>
              <small>Find watches within your price range</small>
            </div>
          </button>

          <button class="sethi-ai-suggestion" type="button"
            data-prompt="Suggest an elegant watch for gifting">
            <span>✦</span>
            <div>
              <strong>Find a Gift</strong>
              <small>Discover something special</small>
            </div>
          </button>

          <button class="sethi-ai-suggestion" type="button"
            data-prompt="Suggest watches for a couple">
            <span>♡</span>
            <div>
              <strong>Couple Watches</strong>
              <small>Find the perfect pair</small>
            </div>
          </button>

        </div>

      </div>


      <div class="sethi-ai-typing">

        <div class="sethi-ai-message-avatar">✦</div>

        <div class="sethi-ai-typing-bubble">
          <span></span>
          <span></span>
          <span></span>
        </div>

      </div>

    </div>


    <div class="sethi-ai-input-area">

      <div class="sethi-ai-input-wrap">

        <textarea
          class="sethi-ai-input"
          placeholder="Ask me anything about watches..."
          rows="1"
        ></textarea>

        <button class="sethi-ai-send" type="button">↑</button>

      </div>

      <p>
        Recommendations are based on products currently available at Sethi Watch Company.
      </p>

    </div>

  </div>

</div>


<style>

#sethi-ai-concierge{
  --ai-dark:#1d1d1c;
  --ai-bg:#f5f3ef;
  --ai-border:#d8d2c8;
  --ai-text:#292928;
  --ai-muted:#777;
  --ai-gold:#a27b45;
  font-family:Arial,Helvetica,sans-serif;
}


/* FLOATING BUTTON */

.sethi-ai-floating-btn{
  position:fixed;
  right:28px;
  bottom:28px;
  z-index:999999;
  height:68px;
  padding:0 28px 0 10px;
  border-radius:100px;
  border:1px solid rgba(255,255,255,.25);
  background:#050505;
  color:#fff;
  display:flex;
  align-items:center;
  gap:14px;
  cursor:pointer;
  font-size:17px;
  box-shadow:0 15px 40px rgba(0,0,0,.2);
  transition:.3s;
}

.sethi-ai-floating-btn:hover{
  transform:translateY(-3px);
}

.sethi-ai-floating-icon{
  width:48px;
  height:48px;
  border-radius:50%;
  background:#f3f3f1;
  color:#111;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:22px;
}


/* OVERLAY */

.sethi-ai-overlay{
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.4);
  z-index:999997;
  opacity:0;
  visibility:hidden;
  transition:.3s;
}

.sethi-ai-overlay.active{
  opacity:1;
  visibility:visible;
}


/* DRAWER */

.sethi-ai-drawer{
  position:fixed;
  top:0;
  right:0;
  width:min(620px,100%);
  height:100vh;
  background:var(--ai-bg);
  z-index:999998;
  display:flex;
  flex-direction:column;
  transform:translateX(105%);
  transition:transform .4s ease;
  box-shadow:-20px 0 60px rgba(0,0,0,.15);
}

.sethi-ai-drawer.active{
  transform:translateX(0);
}


/* HEADER */

.sethi-ai-header{
  padding:22px 24px;
  border-bottom:1px solid var(--ai-border);
  display:flex;
  align-items:center;
  justify-content:space-between;
  flex-shrink:0;
}

.sethi-ai-brand{
  display:flex;
  align-items:center;
  gap:14px;
}

.sethi-ai-logo{
  width:62px;
  height:62px;
  border-radius:50%;
  background:var(--ai-dark);
  color:#fff;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:27px;
}

.sethi-ai-eyebrow{
  display:block;
  font-size:10px;
  letter-spacing:3px;
  color:var(--ai-gold);
  font-weight:700;
  margin-bottom:4px;
}

.sethi-ai-brand h2{
  margin:0;
  font-family:Georgia,serif;
  font-size:31px;
  font-weight:400;
  letter-spacing:1px;
}

.sethi-ai-close{
  border:0;
  background:transparent;
  font-size:42px;
  cursor:pointer;
  line-height:1;
}


/* CHAT AREA */

.sethi-ai-chat-area{
  flex:1;
  overflow-y:auto;
  padding:26px 22px;
}

.sethi-ai-welcome{
  text-align:center;
  padding:28px 20px;
}

.sethi-ai-welcome-icon{
  width:58px;
  height:58px;
  margin:0 auto 20px;
  border-radius:50%;
  background:var(--ai-dark);
  color:#fff;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:24px;
}

.sethi-ai-small-label{
  font-size:10px;
  font-weight:700;
  letter-spacing:3px;
  color:var(--ai-gold);
}

.sethi-ai-welcome h3{
  margin:14px 0;
  font-family:Georgia,serif;
  font-size:40px;
  font-weight:400;
}

.sethi-ai-welcome p{
  max-width:450px;
  margin:auto;
  color:var(--ai-muted);
  line-height:1.7;
}


/* SUGGESTIONS */

.sethi-ai-suggestions{
  display:grid;
  gap:10px;
}

.sethi-ai-suggestion{
  width:100%;
  padding:18px;
  border:1px solid var(--ai-border);
  background:transparent;
  display:flex;
  gap:15px;
  align-items:center;
  text-align:left;
  cursor:pointer;
  transition:.25s;
}

.sethi-ai-suggestion:hover{
  background:#fff;
}

.sethi-ai-suggestion > span{
  width:35px;
  text-align:center;
  font-size:20px;
}

.sethi-ai-suggestion strong,
.sethi-ai-suggestion small{
  display:block;
}

.sethi-ai-suggestion strong{
  margin-bottom:4px;
}

.sethi-ai-suggestion small{
  color:var(--ai-muted);
}


/* MESSAGES */

.sethi-ai-message{
  display:flex;
  gap:12px;
  margin-bottom:22px;
  width:100%;
}

.sethi-ai-message.ai{
  justify-content:flex-start;
}

.sethi-ai-message.user{
  justify-content:flex-end;
}

.sethi-ai-message-avatar{
  width:48px;
  height:48px;
  flex:0 0 48px;
  border-radius:50%;
  background:var(--ai-dark);
  color:#fff;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:18px;
}

.sethi-ai-message-content{
  max-width:calc(100% - 60px);
  width:100%;
}

.sethi-ai-message-bubble{
  padding:17px 20px;
  font-size:16px;
  line-height:1.65;
  letter-spacing:.2px;
}

.sethi-ai-message.ai .sethi-ai-message-bubble{
  background:#fff;
  border:1px solid var(--ai-border);
  color:#555;
}

.sethi-ai-message.user .sethi-ai-message-bubble{
  background:var(--ai-dark);
  color:#fff;
  max-width:82%;
  margin-left:auto;
}


/* PRODUCTS */

.sethi-ai-products{
  display:grid;
  gap:12px;
  margin-top:14px;
}

.sethi-ai-product-card{
  display:flex;
  gap:15px;
  padding:12px;
  background:#fff;
  border:1px solid var(--ai-border);
  text-decoration:none;
  color:inherit;
  transition:.25s;
}

.sethi-ai-product-card:hover{
  transform:translateY(-2px);
  box-shadow:0 8px 25px rgba(0,0,0,.08);
}

.sethi-ai-product-image{
  width:105px;
  height:105px;
  flex:0 0 105px;
  display:flex;
  align-items:center;
  justify-content:center;
  background:#f7f7f7;
  overflow:hidden;
}

.sethi-ai-product-image img{
  width:100%;
  height:100%;
  object-fit:contain;
}

.sethi-ai-product-info{
  flex:1;
  padding:4px 0;
}

.sethi-ai-product-label{
  display:block;
  color:var(--ai-gold);
  font-size:9px;
  letter-spacing:1.5px;
  margin-bottom:7px;
  font-weight:700;
}

.sethi-ai-product-vendor{
  display:block;
  color:#888;
  font-size:10px;
  letter-spacing:1.5px;
  margin-bottom:7px;
}

.sethi-ai-product-title{
  margin:0 0 9px;
  font-family:Georgia,serif;
  font-weight:400;
  font-size:17px;
  line-height:1.4;
}

.sethi-ai-product-price{
  font-size:16px;
  font-weight:600;
}


/* TYPING */

.sethi-ai-typing{
  display:none;
  gap:12px;
  align-items:center;
  margin-top:10px;
}

.sethi-ai-typing.active{
  display:flex;
}

.sethi-ai-typing-bubble{
  background:#fff;
  border:1px solid var(--ai-border);
  padding:15px 18px;
}

.sethi-ai-typing-bubble span{
  display:inline-block;
  width:6px;
  height:6px;
  border-radius:50%;
  background:#777;
  margin:0 2px;
  animation:typing 1.2s infinite;
}

.sethi-ai-typing-bubble span:nth-child(2){
  animation-delay:.2s;
}

.sethi-ai-typing-bubble span:nth-child(3){
  animation-delay:.4s;
}

@keyframes typing{
  0%,60%,100%{transform:translateY(0);opacity:.4}
  30%{transform:translateY(-5px);opacity:1}
}


/* INPUT */

.sethi-ai-input-area{
  padding:16px 22px;
  border-top:1px solid var(--ai-border);
  flex-shrink:0;
}

.sethi-ai-input-wrap{
  display:flex;
  align-items:flex-end;
  border:1px solid #cfc8be;
  background:#fff;
  padding:7px;
}

.sethi-ai-input{
  flex:1;
  border:0;
  outline:0;
  resize:none;
  padding:10px 12px;
  min-height:45px;
  max-height:120px;
  font-family:inherit;
  font-size:16px;
  background:transparent;
}

.sethi-ai-send{
  width:46px;
  height:46px;
  border:0;
  background:var(--ai-dark);
  color:#fff;
  font-size:24px;
  cursor:pointer;
}

.sethi-ai-input-area p{
  text-align:center;
  font-size:10px;
  color:#999;
  margin:9px 0 0;
}


/* MOBILE */

@media(max-width:600px){

  .sethi-ai-floating-btn{
    right:15px;
    bottom:15px;
    height:58px;
    padding-right:20px;
  }

  .sethi-ai-floating-icon{
    width:42px;
    height:42px;
  }

  .sethi-ai-header{
    padding:16px;
  }

  .sethi-ai-chat-area{
    padding:18px 14px;
  }

  .sethi-ai-input-area{
    padding:12px 14px;
  }

  .sethi-ai-welcome h3{
    font-size:31px;
  }

  .sethi-ai-product-image{
    width:85px;
    height:85px;
    flex-basis:85px;
  }

}

</style>


<script>

document.addEventListener('DOMContentLoaded', function(){

  const container = document.querySelector('#sethi-ai-concierge');

  if(!container) return;


  const floatingButton = container.querySelector('.sethi-ai-floating-btn');
  const drawer = container.querySelector('.sethi-ai-drawer');
  const overlay = container.querySelector('.sethi-ai-overlay');
  const closeButton = container.querySelector('.sethi-ai-close');

  const input = container.querySelector('.sethi-ai-input');
  const sendButton = container.querySelector('.sethi-ai-send');

  const chatArea = container.querySelector('.sethi-ai-chat-area');
  const messagesContainer = container.querySelector('.sethi-ai-messages');
  const typing = container.querySelector('.sethi-ai-typing');

  const welcome = container.querySelector('.sethi-ai-welcome');
  const suggestionsBox = container.querySelector('.sethi-ai-suggestions');

  const suggestions = container.querySelectorAll('.sethi-ai-suggestion');


  let conversationHistory = [];


  /* ==============================
     OPEN / CLOSE
  ============================== */

  function openChat(){

    drawer.classList.add('active');
    overlay.classList.add('active');

    document.body.style.overflow = 'hidden';

    setTimeout(function(){
      input.focus();
    },300);

  }


  function closeChat(){

    drawer.classList.remove('active');
    overlay.classList.remove('active');

    document.body.style.overflow = '';

  }


  floatingButton.addEventListener('click',openChat);
  closeButton.addEventListener('click',closeChat);
  overlay.addEventListener('click',closeChat);


  /* ==============================
     INPUT
  ============================== */

  input.addEventListener('input',function(){

    this.style.height = 'auto';

    this.style.height =
      Math.min(this.scrollHeight,120) + 'px';

  });


  input.addEventListener('keydown',function(e){

    if(e.key === 'Enter' && !e.shiftKey){

      e.preventDefault();

      sendMessage();

    }

  });


  sendButton.addEventListener('click',sendMessage);


  suggestions.forEach(function(button){

    button.addEventListener('click',function(){

      input.value = this.dataset.prompt;

      sendMessage();

    });

  });


  /* ==============================
     SEND MESSAGE
  ============================== */

  async function sendMessage(){

    const message = input.value.trim();

    if(!message) return;


    welcome.style.display = 'none';
    suggestionsBox.style.display = 'none';


    addUserMessage(message);


    conversationHistory.push({
      role:'user',
      content:message
    });


    input.value = '';
    input.style.height = '45px';


    typing.classList.add('active');

    scrollToBottom();


    const intent = analyseMessage(
      message,
      conversationHistory
    );


    let result = {
      products:[],
      type:'normal'
    };


    try{

      if(intent.isCouple){

        result = await searchCoupleWatches(intent);

      }else{

        result.products = await searchProducts(intent);

      }

    }catch(error){

      console.log(error);

    }


    typing.classList.remove('active');


    const reply = generateReply(
      intent,
      result.products,
      result.type
    );


    addAIMessage(
      reply,
      result.products,
      intent
    );


    conversationHistory.push({
      role:'assistant',
      content:reply
    });


  }


  /* =====================================
     AI / INTENT ANALYSIS
  ===================================== */

  function analyseMessage(message,history){

    const text = message.toLowerCase();

    const historyText = history
      .map(function(item){
        return item.content || '';
      })
      .join(' ')
      .toLowerCase();


    let intent = {

      originalMessage:message,

      modelNumber:null,

      budget:null,

      brand:null,

      gender:null,

      recipient:null,

      occasion:null,

      styles:[],

      isGift:false,

      isCouple:false,

      searchTerms:[]

    };


    /* ---------------------------
       MODEL NUMBER DETECTION
    --------------------------- */

    const modelPatterns = [

      /\b[A-Z]{1,4}[0-9]{3,}[A-Z0-9-]*\b/i,

      /\b[0-9]{4,}[A-Z]{1,}[A-Z0-9-]*\b/i

    ];


    for(let pattern of modelPatterns){

      const match = message.match(pattern);

      if(match){

        const possibleModel = match[0];

        /*
          Avoid treating money numbers as model
        */

        if(!/^\d+$/.test(possibleModel)){

          intent.modelNumber =
            possibleModel.toUpperCase();

          break;

        }

      }

    }


    /* ---------------------------
       BUDGET DETECTION
    --------------------------- */

    const budgetPatterns = [

      {
        regex:/(?:under|below|less than|less then|within|max|maximum|upto|up to|andar|tak)\s*₹?\s*(\d+(?:\.\d+)?)\s*k\b/i,
        multiplier:1000
      },

      {
        regex:/₹\s*(\d+(?:\.\d+)?)\s*k\b/i,
        multiplier:1000
      },

      {
        regex:/(?:under|below|less than|less then|within|max|maximum|upto|up to|andar|tak)\s*₹?\s*(\d{3,6})\b/i,
        multiplier:1
      },

      {
        regex:/₹\s*(\d{3,6})\b/i,
        multiplier:1
      },

      {
        regex:/(\d+(?:\.\d+)?)\s*k\s*(?:budget)?/i,
        multiplier:1000
      }

    ];


    for(let item of budgetPatterns){

      const match = text.match(item.regex);

      if(match){

        intent.budget =
          Math.round(
            parseFloat(match[1]) *
            item.multiplier
          );

        break;

      }

    }


    /* ---------------------------
       COUPLE DETECTION
    --------------------------- */

    if(
      /couple|pair watch|matching watch|matching watches|his and her|his & her|husband wife|husband and wife/.test(historyText)
    ){

      intent.isCouple = true;

    }


    /* ---------------------------
       GIFT DETECTION
    --------------------------- */

    if(
      /gift|gifting|birthday|anniversary|present|surprise|shaadi gift|wedding gift/.test(historyText)
    ){

      intent.isGift = true;

    }


    /* ---------------------------
       RECIPIENT / GENDER
    --------------------------- */

    if(
      /girlfriend|wife|her|girl|woman|women|lady|ladies|mother|mom|mum|sister|daughter|fiancee/.test(historyText)
    ){

      intent.gender = 'women';
      intent.recipient = 'female';

    }


    if(
      /boyfriend|husband|him|man|men|male|father|dad|brother|son|fiance/.test(historyText)
    ){

      intent.gender = 'men';
      intent.recipient = 'male';

    }


    /* ---------------------------
       BRANDS
    --------------------------- */

    const brands = [

      'seiko',
      'tissot',
      'fossil',
      'casio',
      'guess',
      'guess collection',
      'gc',
      'citizen',
      'timex',
      'victorinox',
      'nebula',
      'titan',
      'g-shock',
      'g shock',
      'diesel',
      'emporio armani',
      'michael kors',
      'tommy hilfiger',
      'orient',
      'bulova',
      'rado',
      'longines',
      'movado'

    ];


    brands.forEach(function(brand){

      if(historyText.includes(brand)){

        intent.brand = brand;

      }

    });


    /* ---------------------------
       OCCASION
    --------------------------- */

    if(/office|work|professional|corporate/.test(historyText)){

      intent.occasion = 'office';

    }

    if(/daily|everyday|regular|daily use/.test(historyText)){

      intent.occasion = 'daily';

    }

    if(/party|event|night out/.test(historyText)){

      intent.occasion = 'party';

    }

    if(/wedding|marriage|shaadi/.test(historyText)){

      intent.occasion = 'wedding';

    }

    if(/sport|sports|gym|running|outdoor|adventure/.test(historyText)){

      intent.occasion = 'sport';

    }


    /* ---------------------------
       STYLE DETECTION
    --------------------------- */

    const styleMap = {

      elegant:[
        'elegant',
        'classy',
        'sophisticated',
        'graceful'
      ],

      luxury:[
        'luxury',
        'premium',
        'luxurious',
        'high end',
        'high-end'
      ],

      classic:[
        'classic',
        'timeless',
        'traditional'
      ],

      sporty:[
        'sporty',
        'sports',
        'rugged',
        'outdoor'
      ],

      minimal:[
        'minimal',
        'minimalist',
        'simple',
        'clean'
      ],

      bold:[
        'bold',
        'statement',
        'fashion'
      ],

      automatic:[
        'automatic',
        'mechanical',
        'self winding',
        'self-winding'
      ]

    };


    Object.keys(styleMap).forEach(function(style){

      styleMap[style].forEach(function(keyword){

        if(historyText.includes(keyword)){

          if(!intent.styles.includes(style)){

            intent.styles.push(style);

          }

        }

      });

    });


    /* ---------------------------
       BUILD SEARCH TERMS
    --------------------------- */

    if(intent.modelNumber){

      intent.searchTerms = [
        intent.modelNumber
      ];

      return intent;

    }


    if(intent.brand){

      intent.searchTerms.push(intent.brand);

    }


    if(intent.gender){

      intent.searchTerms.push(intent.gender);

    }


    if(intent.occasion === 'office'){

      intent.searchTerms.push('classic');

    }


    if(intent.occasion === 'sport'){

      intent.searchTerms.push('sport');

    }


    intent.styles.forEach(function(style){

      intent.searchTerms.push(style);

    });


    /*
      GIFT FALLBACK
    */

    if(
      intent.isGift &&
      !intent.searchTerms.length
    ){

      intent.searchTerms.push('watch');

    }


    /*
      GENERAL FALLBACK
    */

    if(!intent.searchTerms.length){

      intent.searchTerms =
        message
          .replace(/₹/g,'')
          .replace(/[0-9]+/g,'')
          .split(/\s+/)
          .filter(function(word){

            return word.length > 3 &&
              ![
                'watch',
                'suggest',
                'please',
                'need',
                'want',
                'show',
                'tell',
                'good'
              ].includes(word.toLowerCase());

          })
          .slice(0,4);


      if(!intent.searchTerms.length){

        intent.searchTerms = ['watch'];

      }

    }


    return intent;

  }


  /* =====================================
     PRODUCT SEARCH
  ===================================== */

  async function searchProducts(intent){

    /*
      EXACT MODEL NUMBER SEARCH
    */

    if(intent.modelNumber){

      return await exactModelSearch(
        intent.modelNumber
      );

    }


    let searchQuery =
      intent.searchTerms.join(' ');


    let products =
      await predictiveSearch(searchQuery);


    /*
      Brand search fallback
    */

    if(
      !products.length &&
      intent.brand
    ){

      products =
        await predictiveSearch(intent.brand);

    }


    /*
      Apply filters
    */

    products = applyFilters(
      products,
      intent
    );


    /*
      If filters removed everything,
      don't show random unrelated products
    */

    if(!products.length){

      return [];

    }


    return products.slice(0,4);

  }


  /* =====================================
     EXACT MODEL NUMBER SEARCH
  ===================================== */

  async function exactModelSearch(model){

    /*
      First predictive search with SKU fields
    */

    const url =
      '/search/suggest.json?q=' +
      encodeURIComponent(model) +
      '&resources[type]=product' +
      '&resources[limit]=10' +
      '&resources[options][fields]=title,product_type,vendor,variants.sku,variants.barcode';


    const response =
      await fetch(url);


    const data =
      await response.json();


    let products =
      data?.resources?.results?.products || [];


    /*
      Exact match priority
    */

    products = products.filter(function(product){

      const title =
        (product.title || '').toUpperCase();

      const vendor =
        (product.vendor || '').toUpperCase();

      const sku =
        (product.sku || '').toUpperCase();


      return (
        title.includes(model.toUpperCase()) ||
        sku.includes(model.toUpperCase()) ||
        vendor.includes(model.toUpperCase())
      );

    });


    /*
      Important:
      No generic fallback here.
    */

    return products
      .filter(function(product){

        return product.available !== false;

      })
      .slice(0,3)
      .map(normalizeProduct);

  }


  /* =====================================
     PREDICTIVE SEARCH
  ===================================== */

  async function predictiveSearch(query){

    const url =
      '/search/suggest.json?q=' +
      encodeURIComponent(query) +
      '&resources[type]=product' +
      '&resources[limit]=20' +
      '&resources[options][unavailable_products]=hide';


    const response =
      await fetch(url);


    if(!response.ok){

      return [];

    }


    const data =
      await response.json();


    const products =
      data?.resources?.results?.products || [];


    return products
      .filter(function(product){

        return product.available !== false;

      })
      .map(normalizeProduct);

  }


  /* =====================================
     NORMALIZE PRODUCT
  ===================================== */

  function normalizeProduct(product){

    let price =
      parseFloat(product.price || 0);


    /*
      Shopify sometimes returns money
      as paise/cents
    */

    if(price > 100000){

      price = price / 100;

    }


    return {

      title:product.title || '',

      vendor:product.vendor || '',

      url:product.url || '#',

      image:
        product.image ||
        product.featured_image?.url ||
        '',

      priceNumber:price,

      price:formatMoney(price),

      available:
        product.available !== false

    };

  }


  /* =====================================
     FILTER PRODUCTS
  ===================================== */

  function applyFilters(products,intent){

    let filtered = [...products];


    /*
      BUDGET FILTER
    */

    if(intent.budget){

      filtered = filtered.filter(function(product){

        return (
          product.priceNumber <= intent.budget
        );

      });

    }


    /*
      BRAND FILTER
    */

    if(intent.brand){

      filtered = filtered.filter(function(product){

        const text =
          (
            product.vendor + ' ' +
            product.title
          ).toLowerCase();


        return text.includes(
          intent.brand.toLowerCase()
        );

      });

    }


    /*
      GENDER FILTER
      Only if enough products exist
    */

    if(intent.gender){

      const genderProducts =
        filtered.filter(function(product){

          const text =
            (
              product.title + ' ' +
              product.vendor
            ).toLowerCase();


          if(intent.gender === 'women'){

            return /women|woman|ladies|lady|female/.test(text);

          }


          if(intent.gender === 'men'){

            return /men|man|male/.test(text);

          }

          return true;

        });


      if(genderProducts.length){

        filtered = genderProducts;

      }

    }


    /*
      SORT BY PRICE
    */

    filtered.sort(function(a,b){

      return a.priceNumber - b.priceNumber;

    });


    return filtered;

  }


  /* =====================================
     COUPLE WATCH SEARCH
  ===================================== */

  async function searchCoupleWatches(intent){

    let baseQuery =
      intent.brand || 'watch';


    const products =
      await predictiveSearch(baseQuery);


    const men = products.filter(function(product){

      const text =
        product.title.toLowerCase();

      return /men|man|male/.test(text);

    });


    const women = products.filter(function(product){

      const text =
        product.title.toLowerCase();

      return /women|woman|ladies|lady|female/.test(text);

    });


    let selected = [];


    if(men.length){

      selected.push({
        ...men[0],
        label:'FOR HIM'
      });

    }


    if(women.length){

      selected.push({
        ...women[0],
        label:'FOR HER'
      });

    }


    /*
      Budget filter if provided
    */

    if(intent.budget){

      selected =
        selected.filter(function(product){

          return (
            product.priceNumber <= intent.budget
          );

        });

    }


    return {

      products:selected,

      type:'couple'

    };

  }


  /* =====================================
     GENERATE RESPONSE
  ===================================== */

  function generateReply(intent,products,type){

    /*
      EXACT MODEL
    */

    if(intent.modelNumber){

      if(products.length){

        return (
          'Yes! I found the exact model ' +
          intent.modelNumber +
          ' in our currently available collection.'
        );

      }

      return (
        'I couldn’t find model ' +
        intent.modelNumber +
        ' in our currently available collection. It may currently be out of stock or unavailable.'
      );

    }


    /*
      COUPLE
    */

    if(intent.isCouple){

      if(products.length >= 2){

        return 'I found a matching option for him and her. These watches can make a great couple pairing.';

      }

      if(products.length){

        return 'I found one suitable option from our available collection.';

      }

      return 'I couldn’t find a suitable couple combination right now. Try mentioning a preferred brand or budget.';

    }


    /*
      NORMAL RESULTS
    */

    if(products.length){

      let response =
        'Based on what you’re looking for';


      if(intent.budget){

        response +=
          ' and your budget of ' +
          formatMoney(intent.budget);

      }


      if(intent.brand){

        response +=
          ', with ' +
          intent.brand.toUpperCase() +
          ' as your preferred brand';

      }


      response +=
        ', I found these available options from our collection.';


      if(intent.isGift){

        response +=
          ' These can work well as a gift.';

      }


      return response;

    }


    /*
      NO RESULT WITH BUDGET
    */

    if(intent.budget && intent.brand){

      return (
        'I couldn’t find an available ' +
        intent.brand +
        ' watch within ' +
        formatMoney(intent.budget) +
        ' at the moment.'
      );

    }


    if(intent.budget){

      return (
        'I couldn’t find a suitable available watch within ' +
        formatMoney(intent.budget) +
        '. You can try increasing the budget slightly or mention a specific brand.'
      );

    }


    if(intent.brand){

      return (
        'I couldn’t find an available result for ' +
        intent.brand +
        ' right now.'
      );

    }


    return (
      'I couldn’t find an exact match yet. Try telling me your budget, preferred brand, occasion or style.'
    );

  }


  /* =====================================
     USER MESSAGE
  ===================================== */

  function addUserMessage(message){

    const messageElement =
      document.createElement('div');


    messageElement.className =
      'sethi-ai-message user';


    const bubble =
      document.createElement('div');


    bubble.className =
      'sethi-ai-message-bubble';


    bubble.textContent = message;


    messageElement.appendChild(bubble);


    messagesContainer.appendChild(
      messageElement
    );


    scrollToBottom();

  }


  /* =====================================
     AI MESSAGE
  ===================================== */

  function addAIMessage(message,products,intent){

    const messageElement =
      document.createElement('div');


    messageElement.className =
      'sethi-ai-message ai';


    const avatar =
      document.createElement('div');


    avatar.className =
      'sethi-ai-message-avatar';


    avatar.textContent = '✦';


    const content =
      document.createElement('div');


    content.className =
      'sethi-ai-message-content';


    const bubble =
      document.createElement('div');


    bubble.className =
      'sethi-ai-message-bubble';


    bubble.textContent = message;


    content.appendChild(bubble);


    if(products && products.length){

      const wrapper =
        document.createElement('div');


      wrapper.className =
        'sethi-ai-products';


      products.forEach(function(product){

        const card =
          document.createElement('a');


        card.className =
          'sethi-ai-product-card';


        card.href = product.url;


        card.innerHTML = `

          <div class="sethi-ai-product-image">

            ${
              product.image
                ? `<img src="${escapeHTML(product.image)}" alt="${escapeHTML(product.title)}">`
                : ''
            }

          </div>


          <div class="sethi-ai-product-info">

            ${
              product.label
                ? `<span class="sethi-ai-product-label">${escapeHTML(product.label)}</span>`
                : `<span class="sethi-ai-product-label">AVAILABLE NOW</span>`
            }


            ${
              product.vendor
                ? `<span class="sethi-ai-product-vendor">${escapeHTML(product.vendor)}</span>`
                : ''
            }


            <h4 class="sethi-ai-product-title">
              ${escapeHTML(product.title)}
            </h4>


            <div class="sethi-ai-product-price">
              ${escapeHTML(product.price)}
            </div>

          </div>

        `;


        wrapper.appendChild(card);

      });


      content.appendChild(wrapper);

    }


    messageElement.appendChild(avatar);
    messageElement.appendChild(content);


    messagesContainer.appendChild(
      messageElement
    );


    scrollToBottom();

  }


  /* =====================================
     MONEY
  ===================================== */

  function formatMoney(value){

    return new Intl.NumberFormat(
      'en-IN',
      {
        style:'currency',
        currency:'INR',
        maximumFractionDigits:0
      }
    ).format(value);

  }


  /* =====================================
     ESCAPE HTML
  ===================================== */

  function escapeHTML(value){

    const div =
      document.createElement('div');

    div.textContent = value || '';

    return div.innerHTML;

  }


  /* =====================================
     SCROLL
  ===================================== */

  function scrollToBottom(){

    setTimeout(function(){

      chatArea.scrollTo({
        top:chatArea.scrollHeight,
        behavior:'smooth'
      });

    },100);

  }


});

</script>