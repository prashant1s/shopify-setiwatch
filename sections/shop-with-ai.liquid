<!-- =========================================================
     SETHI AI – SMART WATCH FINDER
     COMPLETE CATALOG SEARCH VERSION
========================================================= -->

<div id="sethi-ai-concierge">

  <!-- FLOATING BUTTON -->
  <button class="sethi-ai-trigger" id="sethiAiOpen">
    <span class="sethi-ai-trigger-icon">✦</span>
    <span>Shop with AI</span>
  </button>

  <!-- CHAT DRAWER -->
  <div class="sethi-ai-overlay" id="sethiAiOverlay"></div>

  <div class="sethi-ai-drawer" id="sethiAiDrawer">

    <!-- HEADER -->
    <div class="sethi-ai-header">
      <div class="sethi-ai-brand">
        <div class="sethi-ai-logo">✦</div>
        <div>
          <span>SETHI WATCH COMPANY</span>
          <h2>SETHI AI</h2>
        </div>
      </div>

      <button class="sethi-ai-close" id="sethiAiClose">×</button>
    </div>

    <!-- CHAT AREA -->
    <div class="sethi-ai-chat" id="sethiAiChat">

      <div class="sethi-ai-message assistant">
        <div class="sethi-ai-avatar">✦</div>

        <div class="sethi-ai-bubble">
          <p>
            Hi! I can help you find the right watch from our available collection.
          </p>

          <p>
            You can ask naturally — for example:
          </p>

          <div class="sethi-ai-examples">
            <button>Show me a watch under ₹15,000</button>
            <button>Timex watches</button>
            <button>Suggest a couple watch</button>
            <button>Elegant watch for gifting</button>
          </div>
        </div>
      </div>

    </div>

    <!-- INPUT -->
    <div class="sethi-ai-input-area">

      <div class="sethi-ai-input-wrap">
        <input
          type="text"
          id="sethiAiInput"
          placeholder="Ask me anything about watches..."
          autocomplete="off"
        >

        <button id="sethiAiSend">
          <span>✦</span>
          Shop with AI
        </button>
      </div>

    </div>

  </div>

</div>


<style>

/* =========================================================
   BASE
========================================================= */

#sethi-ai-concierge {
  --ai-black: #20201f;
  --ai-white: #f8f7f3;
  --ai-border: #d8d3ca;
  --ai-text: #3e3e3d;
  --ai-muted: #747474;
  --ai-gold: #9c7a4b;
  --ai-bg: #f5f3ef;
}

.sethi-ai-trigger {
  position: fixed;
  right: 25px;
  bottom: 25px;
  z-index: 9999;

  border: 1px solid #ffffff;
  background: #050505;
  color: white;

  height: 78px;
  min-width: 280px;

  padding: 0 28px 0 12px;

  border-radius: 100px;

  display: flex;
  align-items: center;
  gap: 18px;

  font-size: 17px;
  font-weight: 600;

  cursor: pointer;

  box-shadow: 0 10px 30px rgba(0,0,0,.18);

  transition: .3s ease;
}

.sethi-ai-trigger:hover {
  transform: translateY(-3px);
}

.sethi-ai-trigger-icon {
  width: 54px;
  height: 54px;

  border-radius: 50%;

  background: #f5f5f3;
  color: #111;

  display: flex;
  align-items: center;
  justify-content: center;

  font-size: 26px;
}


/* =========================================================
   OVERLAY
========================================================= */

.sethi-ai-overlay {
  position: fixed;
  inset: 0;

  background: rgba(0,0,0,.35);

  z-index: 99998;

  opacity: 0;
  visibility: hidden;

  transition: .3s ease;
}

.sethi-ai-overlay.active {
  opacity: 1;
  visibility: visible;
}


/* =========================================================
   DRAWER
========================================================= */

.sethi-ai-drawer {
  position: fixed;

  top: 0;
  right: 0;

  width: 620px;
  max-width: 100%;

  height: 100vh;

  background: var(--ai-bg);

  z-index: 99999;

  transform: translateX(100%);

  transition: transform .4s cubic-bezier(.22,.61,.36,1);

  display: flex;
  flex-direction: column;

  box-shadow: -20px 0 50px rgba(0,0,0,.12);
}

.sethi-ai-drawer.active {
  transform: translateX(0);
}


/* =========================================================
   HEADER
========================================================= */

.sethi-ai-header {
  background: #f8f7f3;

  padding: 22px 24px;

  border-bottom: 1px solid var(--ai-border);

  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sethi-ai-brand {
  display: flex;
  align-items: center;
  gap: 16px;
}

.sethi-ai-logo {
  width: 58px;
  height: 58px;

  background: var(--ai-black);
  color: white;

  border-radius: 50%;

  display: flex;
  align-items: center;
  justify-content: center;

  font-size: 25px;
}

.sethi-ai-brand span {
  display: block;

  font-size: 10px;
  letter-spacing: 4px;

  color: var(--ai-gold);

  font-weight: 700;

  margin-bottom: 4px;
}

.sethi-ai-brand h2 {
  margin: 0;

  font-family: Georgia, serif;

  font-size: 30px;

  font-weight: 500;

  letter-spacing: 1px;

  color: #2d2d2c;
}

.sethi-ai-close {
  border: 0;
  background: transparent;

  font-size: 40px;

  line-height: 1;

  color: #333;

  cursor: pointer;

  padding: 0;
}


/* =========================================================
   CHAT
========================================================= */

.sethi-ai-chat {
  flex: 1;

  overflow-y: auto;

  padding: 28px 22px 130px;

  scroll-behavior: smooth;
}

.sethi-ai-message {
  display: flex;

  gap: 14px;

  margin-bottom: 26px;

  align-items: flex-start;
}

.sethi-ai-message.user {
  justify-content: flex-end;
}

.sethi-ai-avatar {
  width: 48px;
  height: 48px;

  min-width: 48px;

  border-radius: 50%;

  background: var(--ai-black);
  color: white;

  display: flex;
  align-items: center;
  justify-content: center;

  font-size: 20px;
}

.sethi-ai-bubble {
  background: #fdfcf9;

  border: 1px solid var(--ai-border);

  padding: 20px;

  max-width: 470px;

  color: #565656;

  font-size: 16px;

  line-height: 1.7;

  letter-spacing: .5px;
}

.sethi-ai-bubble p {
  margin: 0 0 12px;
}

.sethi-ai-bubble p:last-child {
  margin-bottom: 0;
}


/* USER MESSAGE */

.sethi-ai-message.user .sethi-ai-bubble {
  background: var(--ai-black);

  color: white;

  border-color: var(--ai-black);

  max-width: 75%;

  padding: 18px 22px;
}


/* =========================================================
   EXAMPLES
========================================================= */

.sethi-ai-examples {
  margin-top: 15px;

  display: flex;

  flex-wrap: wrap;

  gap: 8px;
}

.sethi-ai-examples button {
  background: transparent;

  border: 1px solid #cfc9c0;

  padding: 9px 12px;

  cursor: pointer;

  font-size: 12px;

  color: #555;

  transition: .25s;
}

.sethi-ai-examples button:hover {
  background: #222;
  color: white;
}


/* =========================================================
   PRODUCT CARD
========================================================= */

.sethi-ai-product-card {
  background: #faf9f6;

  border: 1px solid var(--ai-border);

  margin: 14px 0 18px;

  padding: 20px;

  display: flex;

  gap: 20px;

  cursor: pointer;

  transition: .25s ease;

  text-decoration: none;
}

.sethi-ai-product-card:hover {
  transform: translateY(-2px);

  box-shadow: 0 10px 30px rgba(0,0,0,.06);
}

.sethi-ai-product-image {
  width: 110px;

  min-width: 110px;

  height: 130px;

  display: flex;

  align-items: center;

  justify-content: center;
}

.sethi-ai-product-image img {
  max-width: 100%;

  max-height: 125px;

  object-fit: contain;
}

.sethi-ai-product-info {
  flex: 1;
}

.sethi-ai-match-label {
  font-size: 9px;

  letter-spacing: 2px;

  color: var(--ai-gold);

  font-weight: 700;

  margin-bottom: 7px;

  text-transform: uppercase;
}

.sethi-ai-vendor {
  font-size: 11px;

  color: #888;

  letter-spacing: 2px;

  margin-bottom: 8px;
}

.sethi-ai-product-title {
  font-family: Georgia, serif;

  font-size: 19px;

  line-height: 1.4;

  color: #393939;

  margin-bottom: 12px;
}

.sethi-ai-price {
  font-size: 17px;

  font-weight: 700;

  color: #555;
}


/* =========================================================
   COUPLE SECTION
========================================================= */

.sethi-ai-couple-title {
  font-family: Georgia, serif;

  font-size: 24px;

  margin: 18px 0 5px;

  color: #333;
}

.sethi-ai-couple-subtitle {
  color: #777;

  font-size: 14px;

  margin-bottom: 15px;
}


/* =========================================================
   LOADING
========================================================= */

.sethi-ai-loading {
  display: flex;

  align-items: center;

  gap: 10px;

  color: #666;

  font-size: 14px;
}

.sethi-ai-spinner {
  width: 18px;
  height: 18px;

  border: 2px solid #ddd;
  border-top-color: #333;

  border-radius: 50%;

  animation: sethiSpin .7s linear infinite;
}

@keyframes sethiSpin {
  to {
    transform: rotate(360deg);
  }
}


/* =========================================================
   INPUT
========================================================= */

.sethi-ai-input-area {
  position: absolute;

  bottom: 0;
  left: 0;
  right: 0;

  padding: 18px;

  background: #f8f7f3;

  border-top: 1px solid var(--ai-border);
}

.sethi-ai-input-wrap {
  display: flex;

  align-items: center;

  background: white;

  border: 1px solid #cfcac1;
}

.sethi-ai-input-wrap input {
  flex: 1;

  height: 64px;

  border: 0;

  outline: none;

  padding: 0 18px;

  font-size: 16px;

  background: transparent;
}

.sethi-ai-input-wrap button {
  height: 64px;

  border: 0;

  background: #050505;

  color: white;

  padding: 0 22px;

  cursor: pointer;

  font-size: 14px;

  font-weight: 600;

  white-space: nowrap;
}


/* =========================================================
   MOBILE
========================================================= */

@media(max-width: 768px) {

  .sethi-ai-trigger {
    right: 12px;
    bottom: 15px;

    min-width: auto;

    height: 62px;

    padding: 0 18px 0 8px;

    font-size: 14px;
  }

  .sethi-ai-trigger-icon {
    width: 46px;
    height: 46px;
  }

  .sethi-ai-drawer {
    width: 100%;
  }

  .sethi-ai-header {
    padding: 16px;
  }

  .sethi-ai-logo {
    width: 50px;
    height: 50px;
  }

  .sethi-ai-brand h2 {
    font-size: 26px;
  }

  .sethi-ai-brand span {
    font-size: 8px;
    letter-spacing: 3px;
  }

  .sethi-ai-chat {
    padding: 20px 14px 120px;
  }

  .sethi-ai-bubble {
    max-width: calc(100% - 55px);
  }

  .sethi-ai-product-card {
    padding: 14px;
    gap: 12px;
  }

  .sethi-ai-product-image {
    width: 80px;
    min-width: 80px;
    height: 110px;
  }

  .sethi-ai-product-title {
    font-size: 16px;
  }

  .sethi-ai-input-wrap input {
    min-width: 0;
  }

  .sethi-ai-input-wrap button {
    padding: 0 12px;
    font-size: 12px;
  }

}

</style>


<script>

document.addEventListener('DOMContentLoaded', function() {

  const openBtn = document.getElementById('sethiAiOpen');
  const closeBtn = document.getElementById('sethiAiClose');
  const overlay = document.getElementById('sethiAiOverlay');
  const drawer = document.getElementById('sethiAiDrawer');

  const input = document.getElementById('sethiAiInput');
  const sendBtn = document.getElementById('sethiAiSend');
  const chat = document.getElementById('sethiAiChat');

  let ALL_PRODUCTS = [];
  let catalogLoaded = false;
  let catalogLoading = false;


  /* =====================================================
     BRAND DATABASE
  ===================================================== */

  const BRANDS = [
    'Emporio Armani',
    'Michael Kors',
    'Tommy Hilfiger',
    'G-Shock',
    'Victorinox',
    'Tissot',
    'Seiko',
    'Fossil',
    'Casio',
    'Guess',
    'Citizen',
    'Timex',
    'Nebula',
    'Diesel',
    'Titan',
    'Sonata',
    'GC',
    'G.C.'
  ];


  /* =====================================================
     OPEN / CLOSE
  ===================================================== */

  function openAI() {
    drawer.classList.add('active');
    overlay.classList.add('active');

    setTimeout(() => input.focus(), 300);
  }

  function closeAI() {
    drawer.classList.remove('active');
    overlay.classList.remove('active');
  }

  openBtn.addEventListener('click', openAI);
  closeBtn.addEventListener('click', closeAI);
  overlay.addEventListener('click', closeAI);


  /* =====================================================
     SCROLL CHAT
  ===================================================== */

  function scrollChat() {
    setTimeout(() => {
      chat.scrollTop = chat.scrollHeight;
    }, 100);
  }


  /* =====================================================
     ESCAPE HTML
  ===================================================== */

  function escapeHTML(str) {

    if (!str) return '';

    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');

  }


  /* =====================================================
     FORMAT MONEY
  ===================================================== */

  function formatMoney(price) {

    return new Intl.NumberFormat('en-IN', {
      style: 'currency',
      currency: 'INR',
      maximumFractionDigits: 0
    }).format(Number(price));

  }


  /* =====================================================
     LOAD FULL SHOPIFY CATALOG
  ===================================================== */

  async function loadCatalog() {

    if (catalogLoaded) return ALL_PRODUCTS;

    if (catalogLoading) {

      return new Promise(resolve => {

        const wait = setInterval(() => {

          if (catalogLoaded) {
            clearInterval(wait);
            resolve(ALL_PRODUCTS);
          }

        }, 500);

      });

    }

    catalogLoading = true;


    /* SESSION CACHE */

    try {

      const cached = sessionStorage.getItem('sethi_ai_catalog');

      if (cached) {

        const parsed = JSON.parse(cached);

        if (Array.isArray(parsed) && parsed.length) {

          ALL_PRODUCTS = parsed;
          catalogLoaded = true;
          catalogLoading = false;

          return ALL_PRODUCTS;

        }

      }

    } catch(e) {}


    let page = 1;
    let keepLoading = true;
    let products = [];


    try {

      while (keepLoading && page <= 30) {

        const response = await fetch(
          '/collections/all/products.json?limit=250&page=' + page
        );

        if (!response.ok) break;

        const data = await response.json();

        if (!data.products || !data.products.length) {
          keepLoading = false;
          break;
        }


        products = products.concat(data.products);


        if (data.products.length < 250) {
          keepLoading = false;
        }

        page++;

      }


      /* REMOVE DUPLICATES */

      const unique = {};

      products.forEach(product => {
        unique[product.id] = product;
      });

      ALL_PRODUCTS = Object.values(unique);


      /* CACHE */

      try {

        sessionStorage.setItem(
          'sethi_ai_catalog',
          JSON.stringify(ALL_PRODUCTS)
        );

      } catch(e) {}


      catalogLoaded = true;
      catalogLoading = false;

      return ALL_PRODUCTS;

    }

    catch(error) {

      console.error('SETHI AI Catalog Error:', error);

      catalogLoading = false;

      return [];

    }

  }


  /* =====================================================
     NORMALIZE TEXT
  ===================================================== */

  function normalize(text) {

    return String(text || '')
      .toLowerCase()
      .replace(/[₹,]/g, '')
      .replace(/[^a-z0-9\s]/g, ' ')
      .replace(/\s+/g, ' ')
      .trim();

  }


  /* =====================================================
     PRICE NUMBER PARSER
  ===================================================== */

  function parsePriceNumber(value) {

    if (!value) return null;

    let v = String(value)
      .toLowerCase()
      .replace(/₹|rs\.?|inr|,/g, '')
      .trim();

    let multiplier = 1;

    if (v.includes('k')) {
      multiplier = 1000;
      v = v.replace('k', '');
    }

    const number = parseFloat(v);

    if (isNaN(number)) return null;

    return number * multiplier;

  }


  /* =====================================================
     UNDERSTAND USER QUERY
  ===================================================== */

  function understandQuery(query) {

    const q = normalize(query);

    const intent = {
      original: query,
      normalized: q,

      minPrice: null,
      maxPrice: null,

      brand: null,

      gender: null,

      purpose: null,

      style: null,

      isCouple: false,

      isGift: false,

      modelNumbers: [],

      keywords: []
    };


    /* ==========================================
       COUPLE
    ========================================== */

    if (
      q.includes('couple watch') ||
      q.includes('couple watches') ||
      q.includes('pair watch') ||
      q.includes('pair watches') ||
      q.includes('matching watch') ||
      q.includes('matching watches') ||
      q.includes('his and her') ||
      q.includes('him and her') ||
      q.includes('for couple')
    ) {

      intent.isCouple = true;

    }


    /* ==========================================
       GIFT
    ========================================== */

    if (
      q.includes('gift') ||
      q.includes('gifting') ||
      q.includes('present') ||
      q.includes('birthday')
    ) {

      intent.isGift = true;

      intent.purpose = 'gift';

    }


    /* ==========================================
       GENDER / RECIPIENT
    ========================================== */

    if (
      q.includes('women') ||
      q.includes('woman') ||
      q.includes('female') ||
      q.includes('ladies') ||
      q.includes('lady') ||
      q.includes('girl') ||
      q.includes('girlfriend') ||
      q.includes('wife') ||
      q.includes('her')
    ) {

      intent.gender = 'female';

    }


    if (
      q.includes('men') ||
      q.includes('man') ||
      q.includes('male') ||
      q.includes('boy') ||
      q.includes('boyfriend') ||
      q.includes('husband') ||
      q.includes('him')
    ) {

      intent.gender = 'male';

    }


    /* ==========================================
       BRAND DETECTION
    ========================================== */

    BRANDS.forEach(brand => {

      const b = normalize(brand);

      if (
        q.includes(b) ||
        q.includes(b.replace(/\s/g, ''))
      ) {

        intent.brand = brand;

      }

    });


    /* ==========================================
       STYLE
    ========================================== */

    const styleMap = {

      luxury: [
        'luxury',
        'premium',
        'expensive',
        'high end'
      ],

      elegant: [
        'elegant',
        'classy',
        'formal',
        'sophisticated'
      ],

      sporty: [
        'sport',
        'sports',
        'sporty',
        'fitness',
        'adventure'
      ],

      casual: [
        'casual',
        'daily wear',
        'everyday',
        'regular'
      ],

      classic: [
        'classic',
        'traditional',
        'timeless',
        'vintage'
      ],

      digital: [
        'digital'
      ],

      chronograph: [
        'chronograph'
      ]

    };


    Object.keys(styleMap).forEach(style => {

      styleMap[style].forEach(word => {

        if (q.includes(word)) {

          intent.style = style;

        }

      });

    });


    /* ==========================================
       PURPOSE
    ========================================== */

    if (
      q.includes('office') ||
      q.includes('work') ||
      q.includes('professional')
    ) {

      intent.purpose = 'office';

    }


    if (
      q.includes('daily') ||
      q.includes('everyday') ||
      q.includes('daily wear')
    ) {

      intent.purpose = 'daily';

    }


    if (
      q.includes('party') ||
      q.includes('wedding') ||
      q.includes('occasion')
    ) {

      intent.purpose = 'occasion';

    }


    /* ==========================================
       MODEL NUMBER DETECTION
    ========================================== */

    const rawTokens = query
      .split(/[\s,]+/)
      .map(x => x.trim())
      .filter(Boolean);

    rawTokens.forEach(token => {

      const clean = token
        .replace(/[^a-zA-Z0-9\-]/g, '');

      if (
        clean.length >= 5 &&
        /[a-zA-Z]/.test(clean) &&
        /\d/.test(clean)
      ) {

        intent.modelNumbers.push(
          clean.toLowerCase()
        );

      }

    });


    /* ==========================================
       BUDGET RANGE
    ========================================== */

    const original = query
      .toLowerCase()
      .replace(/,/g, '');


    /* BETWEEN 15K TO 20K */

    let rangeMatch = original.match(
      /(?:between|from)?\s*(₹?\s*\d+(?:\.\d+)?\s*k?)\s*(?:to|-|and|se)\s*(₹?\s*\d+(?:\.\d+)?\s*k?)/i
    );


    if (rangeMatch) {

      const min = parsePriceNumber(rangeMatch[1]);
      const max = parsePriceNumber(rangeMatch[2]);

      if (min !== null && max !== null) {

        intent.minPrice = Math.min(min, max);
        intent.maxPrice = Math.max(min, max);

      }

    }


    /* UNDER / BELOW / LESS THAN */

    if (intent.maxPrice === null) {

      let underMatch = original.match(
        /(?:under|below|less than|upto|up to|within|maximum|max|se kam|ke andar)\s*(₹?\s*\d+(?:\.\d+)?\s*k?)/i
      );

      if (underMatch) {

        intent.maxPrice = parsePriceNumber(
          underMatch[1]
        );

      }

    }


    /* 10K BUDGET */

    if (
      intent.maxPrice === null &&
      intent.minPrice === null
    ) {

      let budgetMatch = original.match(
        /(?:budget|around|approximately|about|near|around)\s*(₹?\s*\d+(?:\.\d+)?\s*k?)/i
      );

      if (budgetMatch) {

        const price = parsePriceNumber(
          budgetMatch[1]
        );

        if (price) {

          intent.minPrice = price * 0.75;
          intent.maxPrice = price * 1.15;

        }

      }

    }


    /* "15K KI WATCH" */

    if (
      intent.maxPrice === null &&
      intent.minPrice === null
    ) {

      const simpleBudget = original.match(
        /₹?\s*(\d+(?:\.\d+)?k?)\s*(?:ki|ka|ke|budget)/i
      );

      if (simpleBudget) {

        const price = parsePriceNumber(
          simpleBudget[1]
        );

        if (price) {

          intent.maxPrice = price;

        }

      }

    }


    /* ==========================================
       KEYWORDS
    ========================================== */

    const stopWords = [
      'show','me','a','an','the','watch','watches',
      'please','mujhe','bhai','bata','bta','chahiye',
      'suggest','karo','kro','for','and','with',
      'under','below','less','than','between','to',
      'in','of','ki','ka','ke','se','andar','wala',
      'brand','give','find'
    ];


    intent.keywords = q
      .split(' ')
      .filter(word =>
        word.length > 2 &&
        !stopWords.includes(word) &&
        !/^\d+$/.test(word)
      );


    return intent;

  }


  /* =====================================================
     PRODUCT HELPERS
  ===================================================== */

  function productText(product) {

    return normalize(
      [
        product.title,
        product.vendor,
        product.product_type,
        product.tags ? product.tags.join(' ') : '',
        product.handle
      ].join(' ')
    );

  }


  function productPrice(product) {

    if (!product.variants || !product.variants.length) {
      return 0;
    }

    const prices = product.variants
      .filter(v => v.available)
      .map(v => parseFloat(v.price));

    if (!prices.length) {
      return parseFloat(product.variants[0].price);
    }

    return Math.min(...prices);

  }


  function productAvailable(product) {

    if (!product.variants) return false;

    return product.variants.some(
      variant => variant.available
    );

  }


  function getProductImage(product) {

    if (product.images && product.images.length) {
      return product.images[0].src;
    }

    if (product.image && product.image.src) {
      return product.image.src;
    }

    return '';

  }


  /* =====================================================
     MODEL NUMBER MATCH
  ===================================================== */

  function hasModelMatch(product, models) {

    if (!models.length) return false;

    const productData = normalize(
      product.title + ' ' +
      product.handle + ' ' +
      (product.vendor || '')
    ).replace(/\s/g, '');


    let variantData = '';

    if (product.variants) {

      variantData = product.variants
        .map(v => normalize(v.sku || ''))
        .join('')
        .replace(/\s/g, '');

    }


    return models.some(model => {

      const cleanModel = normalize(model)
        .replace(/\s/g, '');

      return (
        productData.includes(cleanModel) ||
        variantData.includes(cleanModel)
      );

    });

  }


  /* =====================================================
     BRAND MATCH
  ===================================================== */

  function brandMatch(product, brand) {

    if (!brand) return false;

    const productBrand = normalize(
      product.vendor || ''
    );

    const productTitle = normalize(
      product.title || ''
    );

    const searchBrand = normalize(brand);

    return (
      productBrand.includes(searchBrand) ||
      productTitle.includes(searchBrand)
    );

  }


  /* =====================================================
     GENDER MATCH
  ===================================================== */

  function genderScore(product, gender) {

    if (!gender) return 0;

    const text = productText(product);

    if (gender === 'male') {

      if (
        text.includes('men') ||
        text.includes('mens') ||
        text.includes('man')
      ) return 60;

      if (
        text.includes('women') ||
        text.includes('womens') ||
        text.includes('lady')
      ) return -40;

    }


    if (gender === 'female') {

      if (
        text.includes('women') ||
        text.includes('womens') ||
        text.includes('lady') ||
        text.includes('ladies')
      ) return 60;

      if (
        text.includes('men') ||
        text.includes('mens')
      ) return -40;

    }

    return 0;

  }


  /* =====================================================
     STYLE SCORE
  ===================================================== */

  function styleScore(product, style) {

    if (!style) return 0;

    const text = productText(product);

    const styleWords = {

      luxury: [
        'luxury','premium','gold','automatic'
      ],

      elegant: [
        'classic','elegant','formal','dress'
      ],

      sporty: [
        'sport','sporty','chronograph',
        'diver','outdoor'
      ],

      casual: [
        'casual','digital','daily'
      ],

      classic: [
        'classic','vintage','heritage'
      ],

      digital: [
        'digital'
      ],

      chronograph: [
        'chronograph'
      ]

    };


    if (!styleWords[style]) return 0;

    let score = 0;

    styleWords[style].forEach(word => {

      if (text.includes(word)) {
        score += 20;
      }

    });

    return score;

  }


  /* =====================================================
     KEYWORD SCORE
  ===================================================== */

  function keywordScore(product, keywords) {

    const text = productText(product);

    let score = 0;

    keywords.forEach(word => {

      if (
        word.length > 2 &&
        text.includes(word)
      ) {

        score += 15;

      }

    });

    return score;

  }


  /* =====================================================
     MAIN SEARCH ENGINE
  ===================================================== */

  function searchProducts(intent) {

    let products = ALL_PRODUCTS
      .filter(productAvailable);


    /* EXACT MODEL NUMBER */

    if (intent.modelNumbers.length) {

      const exactModelProducts = products.filter(product =>
        hasModelMatch(
          product,
          intent.modelNumbers
        )
      );

      if (exactModelProducts.length) {
        return exactModelProducts.slice(0, 5);
      }

    }


    /* STRICT BRAND FILTER */

    if (intent.brand) {

      const brandProducts = products.filter(product =>
        brandMatch(product, intent.brand)
      );

      if (brandProducts.length) {
        products = brandProducts;
      }

    }


    /* STRICT PRICE FILTER */

    if (
      intent.minPrice !== null ||
      intent.maxPrice !== null
    ) {

      products = products.filter(product => {

        const price = productPrice(product);

        if (
          intent.minPrice !== null &&
          price < intent.minPrice
        ) {
          return false;
        }

        if (
          intent.maxPrice !== null &&
          price > intent.maxPrice
        ) {
          return false;
        }

        return true;

      });

    }


    /* STRICT GENDER FILTER WHEN CLEAR */

    if (intent.gender) {

      const genderProducts = products.filter(product => {

        const text = productText(product);

        if (intent.gender === 'male') {

          return (
            text.includes('men') ||
            text.includes('mens') ||
            text.includes('man')
          );

        }

        if (intent.gender === 'female') {

          return (
            text.includes('women') ||
            text.includes('womens') ||
            text.includes('lady') ||
            text.includes('ladies')
          );

        }

        return true;

      });


      if (genderProducts.length) {
        products = genderProducts;
      }

    }


    /* SCORE PRODUCTS */

    const scored = products.map(product => {

      let score = 0;

      /* BRAND */

      if (
        intent.brand &&
        brandMatch(product, intent.brand)
      ) {
        score += 200;
      }


      /* MODEL */

      if (
        intent.modelNumbers.length &&
        hasModelMatch(product, intent.modelNumbers)
      ) {
        score += 10000;
      }


      /* GENDER */

      score += genderScore(
        product,
        intent.gender
      );


      /* STYLE */

      score += styleScore(
        product,
        intent.style
      );


      /* KEYWORDS */

      score += keywordScore(
        product,
        intent.keywords
      );


      /* OFFICE */

      const text = productText(product);

      if (intent.purpose === 'office') {

        if (
          text.includes('classic') ||
          text.includes('analog') ||
          text.includes('formal')
        ) {
          score += 20;
        }

      }


      /* DAILY */

      if (intent.purpose === 'daily') {

        if (
          text.includes('casual') ||
          text.includes('digital') ||
          text.includes('sport')
        ) {
          score += 20;
        }

      }


      /* GIFT */

      if (intent.isGift) {

        score += 10;

      }


      return {
        product,
        score
      };

    });


    scored.sort((a, b) =>
      b.score - a.score
    );


    return scored
      .map(item => item.product)
      .slice(0, 5);

  }


  /* =====================================================
     COUPLE WATCH SEARCH
  ===================================================== */

  function findCoupleWatches(intent) {

    let products = ALL_PRODUCTS
      .filter(productAvailable);


    /* BRAND */

    if (intent.brand) {

      const branded = products.filter(product =>
        brandMatch(product, intent.brand)
      );

      if (branded.length) {
        products = branded;
      }

    }


    /* BUDGET */

    if (
      intent.minPrice !== null ||
      intent.maxPrice !== null
    ) {

      products = products.filter(product => {

        const price = productPrice(product);

        if (
          intent.minPrice !== null &&
          price < intent.minPrice
        ) return false;

        if (
          intent.maxPrice !== null &&
          price > intent.maxPrice
        ) return false;

        return true;

      });

    }


    const male = [];
    const female = [];


    products.forEach(product => {

      const text = productText(product);

      if (
        text.includes('men') ||
        text.includes('mens')
      ) {
        male.push(product);
      }

      if (
        text.includes('women') ||
        text.includes('womens') ||
        text.includes('ladies')
      ) {
        female.push(product);
      }

    });


    /* SORT BY SAME BRAND FIRST */

    let pairs = [];

    male.slice(0, 50).forEach(man => {

      female.slice(0, 50).forEach(woman => {

        let score = 0;

        if (
          normalize(man.vendor) ===
          normalize(woman.vendor)
        ) {
          score += 100;
        }

        const priceDifference = Math.abs(
          productPrice(man) -
          productPrice(woman)
        );

        score -= priceDifference / 1000;

        pairs.push({
          man,
          woman,
          score
        });

      });

    });


    pairs.sort((a, b) =>
      b.score - a.score
    );


    return pairs.slice(0, 2);

  }


  /* =====================================================
     PRODUCT CARD HTML
  ===================================================== */

  function productCard(product, label = 'BEST MATCH') {

    const image = getProductImage(product);

    return `
      <a
        href="/products/${escapeHTML(product.handle)}"
        class="sethi-ai-product-card"
      >

        <div class="sethi-ai-product-image">

          ${
            image
              ? `<img src="${escapeHTML(image)}" alt="${escapeHTML(product.title)}">`
              : ''
          }

        </div>

        <div class="sethi-ai-product-info">

          <div class="sethi-ai-match-label">
            ${label}
          </div>

          <div class="sethi-ai-vendor">
            ${escapeHTML(product.vendor || 'SETHI WATCH COMPANY')}
          </div>

          <div class="sethi-ai-product-title">
            ${escapeHTML(product.title)}
          </div>

          <div class="sethi-ai-price">
            ${formatMoney(productPrice(product))}
          </div>

        </div>

      </a>
    `;

  }


  /* =====================================================
     ADD USER MESSAGE
  ===================================================== */

  function addUserMessage(message) {

    const html = `
      <div class="sethi-ai-message user">

        <div class="sethi-ai-bubble">
          ${escapeHTML(message)}
        </div>

      </div>
    `;

    chat.insertAdjacentHTML(
      'beforeend',
      html
    );

    scrollChat();

  }


  /* =====================================================
     ADD ASSISTANT MESSAGE
  ===================================================== */

  function addAssistantMessage(html) {

    const message = `
      <div class="sethi-ai-message assistant">

        <div class="sethi-ai-avatar">✦</div>

        <div style="flex:1;">
          ${html}
        </div>

      </div>
    `;

    chat.insertAdjacentHTML(
      'beforeend',
      message
    );

    scrollChat();

  }


  /* =====================================================
     LOADING MESSAGE
  ===================================================== */

  function addLoadingMessage() {

    const id = 'sethi-ai-loading-' + Date.now();

    addAssistantMessage(`
      <div class="sethi-ai-bubble" id="${id}">

        <div class="sethi-ai-loading">

          <span class="sethi-ai-spinner"></span>

          Searching our available watch collection...

        </div>

      </div>
    `);

    return id;

  }


  /* =====================================================
     REMOVE LOADING
  ===================================================== */

  function removeLoading(id) {

    const element = document.getElementById(id);

    if (element) {

      const parent = element.closest(
        '.sethi-ai-message'
      );

      if (parent) parent.remove();

    }

  }


  /* =====================================================
     GENERATE RESPONSE
  ===================================================== */

  async function generateResponse(query) {

    const intent = understandQuery(query);

    const loadingID = addLoadingMessage();


    /* LOAD CATALOG */

    await loadCatalog();


    removeLoading(loadingID);


    if (!ALL_PRODUCTS.length) {

      addAssistantMessage(`
        <div class="sethi-ai-bubble">
          I’m unable to access the product catalog right now. Please try again.
        </div>
      `);

      return;

    }


    /* =====================================
       COUPLE WATCH
    ===================================== */

    if (intent.isCouple) {

      const pairs = findCoupleWatches(intent);


      if (!pairs.length) {

        addAssistantMessage(`
          <div class="sethi-ai-bubble">
            I couldn't find a suitable couple watch combination in our current available collection.
          </div>
        `);

        return;

      }


      let html = `
        <div class="sethi-ai-bubble">
          I found matching options from our available collection that could work nicely as a couple watch set.
        </div>
      `;


      pairs.forEach((pair, index) => {

        html += `
          <div class="sethi-ai-couple-title">
            Couple Watch Pair ${index + 1}
          </div>

          <div class="sethi-ai-couple-subtitle">
            One for him and one for her
          </div>
        `;

        html += productCard(
          pair.man,
          'FOR HIM'
        );

        html += productCard(
          pair.woman,
          'FOR HER'
        );

      });


      addAssistantMessage(html);

      return;

    }


    /* =====================================
       NORMAL SEARCH
    ===================================== */

    const results = searchProducts(intent);


    if (!results.length) {

      let message = `
        I couldn't find an exact match in our current available collection.
      `;


      if (intent.brand) {
        message += ` I couldn't find an available ${intent.brand} watch matching your request.`;
      }


      if (
        intent.minPrice !== null ||
        intent.maxPrice !== null
      ) {
        message += ` Try changing the budget range slightly.`;
      }


      message += `
        You can also tell me your preferred brand, budget, occasion or style.
      `;


      addAssistantMessage(`
        <div class="sethi-ai-bubble">
          ${message}
        </div>
      `);

      return;

    }


    /* =====================================
       RESPONSE TEXT
    ===================================== */

    let responseText = 'Based on your request, I found these available watches from our collection.';


    /* MODEL */

    if (intent.modelNumbers.length) {

      responseText = `I found the watch matching model number <strong>${escapeHTML(intent.modelNumbers[0].toUpperCase())}</strong>.`;

    }


    /* BRAND */

    else if (intent.brand) {

      responseText = `Here are the available <strong>${escapeHTML(intent.brand)}</strong> watches matching your request.`;

    }


    /* BUDGET RANGE */

    else if (
      intent.minPrice !== null &&
      intent.maxPrice !== null
    ) {

      responseText = `I found these available watches strictly between <strong>${formatMoney(intent.minPrice)}</strong> and <strong>${formatMoney(intent.maxPrice)}</strong>.`;

    }


    /* UNDER BUDGET */

    else if (intent.maxPrice !== null) {

      responseText = `I found these available watches within your budget of <strong>${formatMoney(intent.maxPrice)}</strong>.`;

    }


    /* GIFT */

    else if (intent.isGift) {

      responseText = `These are suitable options from our available collection for gifting.`;

    }


    addAssistantMessage(`
      <div class="sethi-ai-bubble">
        ${responseText}
      </div>
    `);


    /* PRODUCTS */

    results.forEach((product, index) => {

      let label = 'RECOMMENDED';

      if (index === 0) {
        label = 'BEST MATCH';
      }


      addAssistantMessage(
        productCard(product, label)
      );

    });

  }


  /* =====================================================
     SEND MESSAGE
  ===================================================== */

  async function sendMessage() {

    const message = input.value.trim();

    if (!message) return;

    addUserMessage(message);

    input.value = '';

    sendBtn.disabled = true;

    try {

      await generateResponse(message);

    }

    catch(error) {

      console.error(error);

      addAssistantMessage(`
        <div class="sethi-ai-bubble">
          Something went wrong while searching. Please try again.
        </div>
      `);

    }

    sendBtn.disabled = false;

    input.focus();

  }


  /* =====================================================
     SEND EVENTS
  ===================================================== */

  sendBtn.addEventListener(
    'click',
    sendMessage
  );


  input.addEventListener(
    'keydown',
    function(e) {

      if (e.key === 'Enter') {
        sendMessage();
      }

    }
  );


  /* =====================================================
     EXAMPLE BUTTONS
  ===================================================== */

  document.addEventListener(
    'click',
    function(e) {

      if (
        e.target.closest('.sethi-ai-examples button')
      ) {

        const text =
          e.target.closest('button').innerText;

        input.value = text;

        sendMessage();

      }

    }
  );


});

</script>