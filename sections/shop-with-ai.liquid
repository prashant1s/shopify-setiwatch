{% comment %}
  SETHI AI – SMART WATCH FINDER
  File: sections/sethi-ai-concierge.liquid
{% endcomment %}

<div class="sethi-ai-wrapper" id="sethi-ai-wrapper">

  <!-- Floating Button -->
  <button class="sethi-ai-launcher" id="sethiAiLauncher" type="button">
    <span class="sethi-ai-launcher-icon">✦</span>
    <span>Shop with AI</span>
  </button>

  <!-- AI Drawer -->
  <div class="sethi-ai-overlay" id="sethiAiOverlay"></div>

  <aside class="sethi-ai-drawer" id="sethiAiDrawer">

    <!-- Header -->
    <div class="sethi-ai-header">
      <div class="sethi-ai-brand">
        <div class="sethi-ai-logo">✦</div>
        <div>
          <span class="sethi-ai-small-title">SETHI WATCH COMPANY</span>
          <h2>SETHI AI</h2>
        </div>
      </div>

      <button class="sethi-ai-close" id="sethiAiClose" type="button">×</button>
    </div>

    <!-- Chat Area -->
    <div class="sethi-ai-chat" id="sethiAiChat">

      <div class="sethi-ai-message ai-message">
        <div class="sethi-ai-avatar">✦</div>

        <div class="sethi-ai-bubble">
          Hi! I'm Sethi AI, your personal watch shopping assistant.

          <br><br>

          Tell me naturally what you're looking for. For example:

          <div class="sethi-ai-suggestions">
            <button type="button" class="ai-suggestion">Show me a watch under ₹15,000</button>
            <button type="button" class="ai-suggestion">Suggest a gift for my wife</button>
            <button type="button" class="ai-suggestion">I need a daily wear watch</button>
            <button type="button" class="ai-suggestion">Show me Seiko watches</button>
            <button type="button" class="ai-suggestion">Find model Z32004G1MF</button>
            <button type="button" class="ai-suggestion">Show me couple watches</button>
          </div>
        </div>
      </div>

    </div>

    <!-- Input -->
    <div class="sethi-ai-input-area">
      <input
        type="text"
        id="sethiAiInput"
        placeholder="Ask me anything about watches..."
        autocomplete="off"
      >

      <button id="sethiAiSend" type="button">
        <span>✦</span>
        Shop with AI
      </button>
    </div>

  </aside>
</div>


<style>

.sethi-ai-wrapper {
  font-family: Arial, sans-serif;
}

/* Floating Button */

.sethi-ai-launcher {
  position: fixed;
  right: 28px;
  bottom: 28px;
  z-index: 9998;
  display: flex;
  align-items: center;
  gap: 14px;
  background: #050505;
  color: #fff;
  border: 0;
  padding: 12px 24px 12px 12px;
  border-radius: 100px;
  font-size: 16px;
  font-weight: 600;
  cursor: pointer;
  box-shadow: 0 8px 30px rgba(0,0,0,.2);
  transition: .25s ease;
}

.sethi-ai-launcher:hover {
  transform: translateY(-2px);
}

.sethi-ai-launcher-icon {
  width: 48px;
  height: 48px;
  background: #fff;
  color: #111;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22px;
}


/* Overlay */

.sethi-ai-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,.35);
  opacity: 0;
  visibility: hidden;
  transition: .3s ease;
  z-index: 9998;
}

.sethi-ai-overlay.active {
  opacity: 1;
  visibility: visible;
}


/* Drawer */

.sethi-ai-drawer {
  position: fixed;
  top: 0;
  right: -680px;
  width: 100%;
  max-width: 640px;
  height: 100vh;
  background: #f7f6f3;
  z-index: 9999;
  transition: right .35s cubic-bezier(.77,0,.18,1);
  display: flex;
  flex-direction: column;
  box-shadow: -15px 0 50px rgba(0,0,0,.12);
}

.sethi-ai-drawer.active {
  right: 0;
}


/* Header */

.sethi-ai-header {
  padding: 22px 28px;
  border-bottom: 1px solid #d8d5ce;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sethi-ai-brand {
  display: flex;
  align-items: center;
  gap: 14px;
}

.sethi-ai-logo,
.sethi-ai-avatar {
  width: 54px;
  height: 54px;
  border-radius: 50%;
  background: #222;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 20px;
}

.sethi-ai-small-title {
  display: block;
  font-size: 10px;
  letter-spacing: 4px;
  color: #8c6c42;
  font-weight: 700;
  margin-bottom: 4px;
}

.sethi-ai-header h2 {
  margin: 0;
  font-family: Georgia, serif;
  font-size: 30px;
  font-weight: 500;
  letter-spacing: 1px;
}

.sethi-ai-close {
  border: 0;
  background: transparent;
  font-size: 42px;
  line-height: 1;
  cursor: pointer;
  color: #333;
}


/* Chat */

.sethi-ai-chat {
  flex: 1;
  overflow-y: auto;
  padding: 28px 22px 150px;
}

.sethi-ai-message {
  display: flex;
  gap: 14px;
  margin-bottom: 22px;
  align-items: flex-start;
}

.sethi-ai-bubble {
  background: #fff;
  border: 1px solid #d9d6cf;
  padding: 22px;
  max-width: 82%;
  font-size: 16px;
  line-height: 1.7;
  color: #555;
}

.user-message {
  justify-content: flex-end;
}

.user-message .sethi-ai-bubble {
  background: #252525;
  color: #fff;
  border: none;
  max-width: 75%;
}


/* Suggestions */

.sethi-ai-suggestions {
  margin-top: 18px;
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.ai-suggestion {
  border: 1px solid #d8d4cb;
  background: #faf9f7;
  padding: 9px 12px;
  font-size: 12px;
  cursor: pointer;
  color: #555;
}

.ai-suggestion:hover {
  background: #222;
  color: #fff;
}


/* Product Cards */

.sethi-ai-products {
  width: 100%;
  margin-top: 16px;
}

.sethi-ai-product-card {
  display: flex;
  gap: 20px;
  background: #fff;
  border: 1px solid #d8d5ce;
  padding: 18px;
  margin-bottom: 14px;
  text-decoration: none;
  color: inherit;
  transition: .2s ease;
}

.sethi-ai-product-card:hover {
  border-color: #222;
  transform: translateY(-2px);
}

.sethi-ai-product-image {
  width: 105px;
  height: 130px;
  object-fit: contain;
  flex-shrink: 0;
}

.sethi-ai-product-info {
  flex: 1;
}

.sethi-ai-match {
  display: block;
  font-size: 10px;
  letter-spacing: 2px;
  color: #8c6c42;
  margin-bottom: 10px;
  font-weight: 700;
  text-transform: uppercase;
}

.sethi-ai-vendor {
  font-size: 11px;
  color: #888;
  letter-spacing: 1.5px;
  margin-bottom: 8px;
}

.sethi-ai-product-title {
  font-family: Georgia, serif;
  font-size: 20px;
  line-height: 1.35;
  color: #333;
  margin-bottom: 12px;
}

.sethi-ai-price {
  font-size: 18px;
  font-weight: 600;
  color: #555;
}


/* Input */

.sethi-ai-input-area {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 18px 20px;
  background: #f7f6f3;
  border-top: 1px solid #d8d5ce;
  display: flex;
  gap: 10px;
}

.sethi-ai-input-area input {
  flex: 1;
  height: 58px;
  border: 1px solid #cfcac0;
  padding: 0 18px;
  background: #fff;
  font-size: 16px;
  outline: none;
}

.sethi-ai-input-area button {
  background: #080808;
  color: #fff;
  border: 0;
  padding: 0 22px;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  white-space: nowrap;
}


/* Typing */

.sethi-ai-typing {
  display: flex;
  gap: 5px;
  padding: 10px 0;
}

.sethi-ai-typing span {
  width: 7px;
  height: 7px;
  background: #888;
  border-radius: 50%;
  animation: aiTyping 1.2s infinite;
}

.sethi-ai-typing span:nth-child(2) {
  animation-delay: .2s;
}

.sethi-ai-typing span:nth-child(3) {
  animation-delay: .4s;
}

@keyframes aiTyping {
  0%,60%,100% { transform: translateY(0); opacity:.4; }
  30% { transform: translateY(-5px); opacity:1; }
}


@media(max-width: 600px) {

  .sethi-ai-drawer {
    max-width: 100%;
  }

  .sethi-ai-launcher {
    right: 15px;
    bottom: 15px;
  }

  .sethi-ai-header {
    padding: 16px 18px;
  }

  .sethi-ai-header h2 {
    font-size: 25px;
  }

  .sethi-ai-product-title {
    font-size: 16px;
  }

  .sethi-ai-product-image {
    width: 80px;
  }

  .sethi-ai-input-area button {
    padding: 0 14px;
    font-size: 12px;
  }

}

</style>


<script>

document.addEventListener('DOMContentLoaded', function() {

  const launcher = document.getElementById('sethiAiLauncher');
  const drawer = document.getElementById('sethiAiDrawer');
  const overlay = document.getElementById('sethiAiOverlay');
  const closeBtn = document.getElementById('sethiAiClose');
  const chat = document.getElementById('sethiAiChat');
  const input = document.getElementById('sethiAiInput');
  const sendBtn = document.getElementById('sethiAiSend');


  /* OPEN / CLOSE */

  function openAI() {
    drawer.classList.add('active');
    overlay.classList.add('active');

    setTimeout(() => input.focus(), 300);
  }

  function closeAI() {
    drawer.classList.remove('active');
    overlay.classList.remove('active');
  }

  launcher.addEventListener('click', openAI);
  closeBtn.addEventListener('click', closeAI);
  overlay.addEventListener('click', closeAI);


  /* SUGGESTIONS */

  document.addEventListener('click', function(e) {

    if (e.target.classList.contains('ai-suggestion')) {

      const text = e.target.textContent.trim();

      input.value = text;
      sendMessage();
    }

  });


  /* SEND */

  sendBtn.addEventListener('click', sendMessage);

  input.addEventListener('keydown', function(e) {

    if (e.key === 'Enter') {
      sendMessage();
    }

  });


  function sendMessage() {

    const query = input.value.trim();

    if (!query) return;

    addUserMessage(query);

    input.value = '';

    showTyping();

    setTimeout(async function() {

      removeTyping();

      await processQuery(query);

    }, 600);

  }


  /* USER MESSAGE */

  function addUserMessage(text) {

    const div = document.createElement('div');

    div.className = 'sethi-ai-message user-message';

    div.innerHTML = `
      <div class="sethi-ai-bubble">${escapeHtml(text)}</div>
    `;

    chat.appendChild(div);

    scrollChat();

  }


  /* AI MESSAGE */

  function addAIMessage(text) {

    const div = document.createElement('div');

    div.className = 'sethi-ai-message ai-message';

    div.innerHTML = `
      <div class="sethi-ai-avatar">✦</div>

      <div class="sethi-ai-bubble">
        ${text}
      </div>
    `;

    chat.appendChild(div);

    scrollChat();

  }


  /* TYPING */

  function showTyping() {

    const div = document.createElement('div');

    div.id = 'sethiAiTyping';

    div.className = 'sethi-ai-message ai-message';

    div.innerHTML = `
      <div class="sethi-ai-avatar">✦</div>

      <div class="sethi-ai-bubble">
        <div class="sethi-ai-typing">
          <span></span>
          <span></span>
          <span></span>
        </div>
      </div>
    `;

    chat.appendChild(div);

    scrollChat();

  }


  function removeTyping() {

    const typing = document.getElementById('sethiAiTyping');

    if (typing) typing.remove();

  }


  /* ==========================================
     MAIN SMART QUERY PROCESSOR
  ========================================== */

  async function processQuery(originalQuery) {

    const query = originalQuery.toLowerCase().trim();

    const intent = detectIntent(query);

    console.log('SETHI AI INTENT:', intent);


    /* EXACT MODEL NUMBER */

    if (intent.modelNumber) {

      const products = await searchProducts(intent.modelNumber);

      const exactMatches = products.filter(product => {

        const title = product.title.toLowerCase();
        const vendor = product.vendor.toLowerCase();

        return title.includes(intent.modelNumber.toLowerCase()) ||
               vendor.includes(intent.modelNumber.toLowerCase());

      });

      if (exactMatches.length) {

        addAIMessage(
          `Yes! I found this model in our available collection.`
        );

        renderProducts(exactMatches.slice(0, 5), 'EXACT MATCH');

        return;
      }

      if (products.length) {

        addAIMessage(
          `I couldn't find an exact match for <strong>${escapeHtml(intent.modelNumber)}</strong>, but I found these closely related available options.`
        );

        renderProducts(products.slice(0, 5), 'CLOSE MATCH');

        return;
      }

      addAIMessage(
        `I couldn't find model <strong>${escapeHtml(intent.modelNumber)}</strong> in our current available collection. Please check the model number once or try searching by brand.`
      );

      return;
    }


    /* COUPLE WATCH */

    if (intent.couple) {

      await handleCoupleWatch(intent);

      return;
    }


    /* GIFT INTENT */

    if (intent.gift) {

      const products = await smartSearch(intent);

      if (products.length) {

        let message = 'These watches could make a great gift';

        if (intent.forHer) {
          message = 'I found these elegant options that would work beautifully as a gift for her.';
        }

        if (intent.forHim) {
          message = 'I found these options that would make a great gift for him.';
        }

        addAIMessage(message);

        renderProducts(products, 'GIFT PICK');

        return;
      }

      addAIMessage(
        `I couldn't find a suitable gifting option based on that request. Try telling me your budget as well, for example: "Gift watch for wife under ₹20,000".`
      );

      return;
    }


    /* NORMAL SMART SEARCH */

    const products = await smartSearch(intent);


    if (products.length) {

      let response = buildResponse(intent, products);

      addAIMessage(response);

      renderProducts(products, 'RECOMMENDED');

    } else {

      addAIMessage(buildNoResultMessage(intent));

    }

  }


  /* ==========================================
     INTENT DETECTION
  ========================================== */

  function detectIntent(query) {

    const intent = {

      rawQuery: query,

      modelNumber: null,

      budgetMin: null,

      budgetMax: null,

      brand: null,

      gender: null,

      forHer: false,

      forHim: false,

      couple: false,

      gift: false,

      dailyWear: false,

      luxury: false,

      formal: false,

      casual: false,

      sports: false,

      keywords: []

    };


    /* MODEL NUMBER DETECTION */

    const modelPattern = /\b[a-z0-9]{5,}\b/gi;

    const possibleModels = query.match(modelPattern);

    if (possibleModels) {

      possibleModels.forEach(item => {

        const hasNumber = /\d/.test(item);
        const hasLetter = /[a-z]/i.test(item);

        if (hasNumber && hasLetter && item.length >= 5) {

          intent.modelNumber = item;

        }

      });

    }


    /* COUPLE */

    if (
      query.includes('couple watch') ||
      query.includes('couple watches') ||
      query.includes('matching watch') ||
      query.includes('matching watches') ||
      query.includes('pair watch') ||
      query.includes('his and her') ||
      query.includes('for couples')
    ) {

      intent.couple = true;

    }


    /* GIFT */

    if (
      query.includes('gift') ||
      query.includes('gifting') ||
      query.includes('present') ||
      query.includes('birthday') ||
      query.includes('anniversary')
    ) {

      intent.gift = true;

    }


    /* FOR HER */

    if (
      query.includes('wife') ||
      query.includes('girlfriend') ||
      query.includes('her') ||
      query.includes('women') ||
      query.includes('woman') ||
      query.includes('lady') ||
      query.includes('female') ||
      query.includes('girl')
    ) {

      intent.forHer = true;
      intent.gender = 'women';

    }


    /* FOR HIM */

    if (
      query.includes('husband') ||
      query.includes('boyfriend') ||
      query.includes('him') ||
      query.includes('men') ||
      query.includes('man') ||
      query.includes('male') ||
      query.includes('boy')
    ) {

      intent.forHim = true;
      intent.gender = 'men';

    }


    /* DAILY WEAR */

    if (
      query.includes('daily wear') ||
      query.includes('dailywear') ||
      query.includes('everyday') ||
      query.includes('regular use') ||
      query.includes('office use') ||
      query.includes('office wear')
    ) {

      intent.dailyWear = true;

    }


    /* LUXURY */

    if (
      query.includes('luxury') ||
      query.includes('premium') ||
      query.includes('high end') ||
      query.includes('expensive')
    ) {

      intent.luxury = true;

    }


    /* FORMAL */

    if (
      query.includes('formal') ||
      query.includes('office') ||
      query.includes('business')
    ) {

      intent.formal = true;

    }


    /* CASUAL */

    if (
      query.includes('casual') ||
      query.includes('college') ||
      query.includes('college wear')
    ) {

      intent.casual = true;

    }


    /* SPORTS */

    if (
      query.includes('sport') ||
      query.includes('sports') ||
      query.includes('gym') ||
      query.includes('running') ||
      query.includes('outdoor')
    ) {

      intent.sports = true;

    }


    /* BUDGET DETECTION */

    extractBudget(query, intent);


    /* REMOVE COMMON WORDS */

    let cleaned = query
      .replace(/under|below|less than|upto|up to|within|budget|watch|watches|show me|suggest|find|need|want|please|koi|mujhe|mujhe koi|batao|bta de|for|gift|daily wear/gi, ' ')
      .replace(/₹|rs\.?|inr/gi, ' ')
      .replace(/\d{1,3}(?:,\d{3})+|\d+k|\d+/gi, ' ')
      .replace(/\s+/g, ' ')
      .trim();


    if (cleaned.length > 2) {

      intent.keywords = cleaned.split(' ');

    }


    return intent;

  }


  /* ==========================================
     BUDGET DETECTION
  ========================================== */

  function extractBudget(query, intent) {

    let normalized = query
      .replace(/,/g, '')
      .replace(/₹/g, ' ')
      .replace(/rs\.?/g, ' ')
      .replace(/inr/g, ' ');


    /* 15K / 20K */

    const kMatch = normalized.match(/(\d+(?:\.\d+)?)\s*k\b/i);

    let kValue = null;

    if (kMatch) {

      kValue = Math.round(parseFloat(kMatch[1]) * 1000);

    }


    /* UNDER / BELOW / LESS THAN / WITHIN */

    if (
      normalized.includes('under') ||
      normalized.includes('below') ||
      normalized.includes('less than') ||
      normalized.includes('upto') ||
      normalized.includes('up to') ||
      normalized.includes('within') ||
      normalized.includes('tak') ||
      normalized.includes('tk')
    ) {

      if (kValue) {

        intent.budgetMax = kValue;

      } else {

        const number = normalized.match(/\d{3,7}/);

        if (number) intent.budgetMax = parseInt(number[0]);

      }

      return;

    }


    /* "15K KI WATCH" */

    if (kValue) {

      intent.budgetMax = kValue;

      return;

    }


    /* ₹ 10,000 */

    const amountMatch = normalized.match(/\d{4,7}/);

    if (amountMatch) {

      intent.budgetMax = parseInt(amountMatch[0]);

    }

  }


  /* ==========================================
     COUPLE WATCH SEARCH
  ========================================== */

  async function handleCoupleWatch(intent) {

    let searchTerm = 'watch';

    if (intent.budgetMax) {

      searchTerm += ' under ' + intent.budgetMax;

    }


    const menProducts = await searchProducts('men watch');

    const womenProducts = await searchProducts('women watch');


    let men = filterProducts(menProducts, {
      ...intent,
      gender: 'men'
    });

    let women = filterProducts(womenProducts, {
      ...intent,
      gender: 'women'
    });


    if (!men.length || !women.length) {

      addAIMessage(
        `I couldn't find a dedicated matching couple watch set in the current available collection. However, here are some options that can work well as a pair.`
      );

      const generalProducts = await searchProducts('watch');

      const filtered = filterProducts(generalProducts, intent);

      if (filtered.length) {

        renderProducts(filtered.slice(0, 6), 'COUPLE PICK');

      }

      return;

    }


    addAIMessage(
      `I found options for both him and her that could work nicely as a couple watch combination.`
    );


    renderProducts(
      [
        ...men.slice(0, 2),
        ...women.slice(0, 2)
      ],
      'COUPLE PICK'
    );

  }


  /* ==========================================
     SMART SEARCH
  ========================================== */

  async function smartSearch(intent) {

    let searches = [];


    /* BRAND SEARCH */

    if (intent.brand) {

      searches.push(intent.brand);

    }


    /* GENDER SEARCH */

    if (intent.gender === 'women') {

      searches.push('women watch');

    }

    else if (intent.gender === 'men') {

      searches.push('men watch');

    }


    /* DAILY WEAR */

    if (intent.dailyWear) {

      searches.push('daily watch');

    }


    /* FORMAL */

    if (intent.formal) {

      searches.push('formal watch');

    }


    /* SPORTS */

    if (intent.sports) {

      searches.push('sport watch');

    }


    /* KEYWORDS */

    if (intent.keywords.length) {

      searches.push(intent.keywords.join(' '));

    }


    /* FALLBACK SEARCH TERM */

    if (!searches.length) {

      searches.push('watch');

    }


    /* REMOVE DUPLICATES */

    searches = [...new Set(searches)];


    let allProducts = [];


    for (const term of searches.slice(0, 3)) {

      const products = await searchProducts(term);

      allProducts = [...allProducts, ...products];

    }


    /* REMOVE DUPLICATES */

    const uniqueProducts = [];

    const ids = new Set();


    allProducts.forEach(product => {

      if (!ids.has(product.id)) {

        ids.add(product.id);

        uniqueProducts.push(product);

      }

    });


    return filterProducts(uniqueProducts, intent);

  }


  /* ==========================================
     SHOPIFY PRODUCT SEARCH
  ========================================== */

  async function searchProducts(term) {

    try {

      const url =
        '/search/suggest.json?q=' +
        encodeURIComponent(term) +
        '&resources[type]=product' +
        '&resources[limit]=20' +
        '&resources[options][unavailable_products]=hide';


      const response = await fetch(url);

      const data = await response.json();


      const products =
        data.resources &&
        data.resources.results &&
        data.resources.results.products
          ? data.resources.results.products
          : [];


      return products.map(product => {

        return {

          id: product.id,

          title: product.title || '',

          vendor: product.vendor || '',

          url: product.url || '#',

          image:
            product.image ||
            product.featured_image ||
            '',

          price:
            product.price ||
            product.price_min ||
            0,

          available: true

        };

      });

    }

    catch (error) {

      console.error('SETHI AI SEARCH ERROR:', error);

      return [];

    }

  }


  /* ==========================================
     FILTER + SCORE PRODUCTS
  ========================================== */

  function filterProducts(products, intent) {

    let filtered = products.filter(product => {

      if (!product.available) return false;

      const price = parsePrice(product.price);


      /* STRICT BUDGET */

      if (
        intent.budgetMax &&
        price > intent.budgetMax
      ) {

        return false;

      }


      return true;

    });


    /* SCORE */

    filtered = filtered.map(product => {

      let score = 0;

      const text = (
        product.title +
        ' ' +
        product.vendor
      ).toLowerCase();


      /* EXACT BRAND */

      if (intent.brand && text.includes(intent.brand)) {

        score += 100;

      }


      /* KEYWORDS */

      intent.keywords.forEach(keyword => {

        if (
          keyword.length > 2 &&
          text.includes(keyword)
        ) {

          score += 20;

        }

      });


      /* GENDER */

      if (intent.gender === 'women') {

        if (
          text.includes('women') ||
          text.includes("women's") ||
          text.includes('lady') ||
          text.includes('girl')
        ) {

          score += 40;

        }

      }


      if (intent.gender === 'men') {

        if (
          text.includes('men') ||
          text.includes("men's")
        ) {

          score += 40;

        }

      }


      /* DAILY WEAR */

      if (intent.dailyWear) {

        if (
          text.includes('classic') ||
          text.includes('casual') ||
          text.includes('analog') ||
          text.includes('everyday')
        ) {

          score += 15;

        }

      }


      /* LUXURY */

      if (intent.luxury) {

        const price = parsePrice(product.price);

        if (price >= 30000) {

          score += 20;

        }

      }


      /* FORMAL */

      if (intent.formal) {

        if (
          text.includes('classic') ||
          text.includes('dress') ||
          text.includes('formal')
        ) {

          score += 20;

        }

      }


      /* SPORTS */

      if (intent.sports) {

        if (
          text.includes('sport') ||
          text.includes('chronograph') ||
          text.includes('diver')
        ) {

          score += 25;

        }

      }


      /* PRICE PREFERENCE */

      if (intent.budgetMax) {

        const price = parsePrice(product.price);

        const difference =
          intent.budgetMax - price;

        if (difference >= 0) {

          score += Math.max(
            0,
            10 - Math.floor(
              difference / intent.budgetMax * 10
            )
          );

        }

      }


      return {
        ...product,
        score
      };

    });


    /* IMPORTANT:
       NO RANDOM FALLBACK PRODUCT
    */

    filtered = filtered
      .filter(product => {

        /* If user has a strong intent,
           require some relevance */

        if (
          intent.gender ||
          intent.dailyWear ||
          intent.formal ||
          intent.sports ||
          intent.brand ||
          intent.keywords.length
        ) {

          return product.score > 0;

        }

        return true;

      })
      .sort((a, b) => b.score - a.score);


    return filtered.slice(0, 6);

  }


  /* ==========================================
     BRAND DETECTION
     ADD YOUR IMPORTANT BRANDS HERE
  ========================================== */

  const knownBrands = [

    'seiko',
    'casio',
    'citizen',
    'titan',
    'fossil',
    'guess',
    'victorinox',
    'tissot',
    'orient',
    'diesel',
    'emporio armani',
    'michael kors',
    'tommy hilfiger',
    'police',
    'nebula',
    'longines',
    'rado',
    'hamilton',
    'bulova',
    'g-shock',
    'edifice'

  ];


  const originalDetectIntent = detectIntent;


  function detectIntent(query) {

    const intent = {

      rawQuery: query,
      modelNumber: null,
      budgetMin: null,
      budgetMax: null,
      brand: null,
      gender: null,
      forHer: false,
      forHim: false,
      couple: false,
      gift: false,
      dailyWear: false,
      luxury: false,
      formal: false,
      casual: false,
      sports: false,
      keywords: []

    };


    /* MODEL NUMBER */

    const words = query.match(/\b[a-z0-9-]{5,}\b/gi);

    if (words) {

      words.forEach(word => {

        const letters = /[a-z]/i.test(word);
        const numbers = /\d/.test(word);

        if (letters && numbers) {

          intent.modelNumber = word;

        }

      });

    }


    /* BRAND */

    knownBrands.forEach(brand => {

      if (query.includes(brand)) {

        intent.brand = brand;

      }

    });


    /* COUPLE */

    intent.couple =
      /couple|matching watch|his and her|pair watch|for couples/.test(query);


    /* GIFT */

    intent.gift =
      /gift|gifting|present|birthday|anniversary/.test(query);


    /* WOMEN */

    if (
      /wife|girlfriend|for her|women|woman|lady|female|girl/.test(query)
    ) {

      intent.forHer = true;
      intent.gender = 'women';

    }


    /* MEN */

    if (
      /husband|boyfriend|for him|men|man|male|boy/.test(query)
    ) {

      intent.forHim = true;
      intent.gender = 'men';

    }


    /* DAILY */

    intent.dailyWear =
      /daily wear|dailywear|everyday|regular use|office use/.test(query);


    /* LUXURY */

    intent.luxury =
      /luxury|premium|high end|expensive/.test(query);


    /* FORMAL */

    intent.formal =
      /formal|office|business/.test(query);


    /* CASUAL */

    intent.casual =
      /casual|college/.test(query);


    /* SPORTS */

    intent.sports =
      /sport|sports|gym|running|outdoor/.test(query);


    /* BUDGET */

    extractBudget(query, intent);


    /* CLEAN KEYWORDS */

    let cleaned = query
      .replace(
        /under|below|less than|upto|up to|within|budget|watch|watches|show|me|suggest|find|need|want|please|koi|mujhe|batao|bta|de|ki|ka|ke|tak|tk|for|gift|daily|wear/gi,
        ' '
      )
      .replace(/₹|rs\.?|inr/gi, ' ')
      .replace(/\d+(?:,\d{3})*|\d+k/gi, ' ')
      .replace(/\s+/g, ' ')
      .trim();


    if (cleaned) {

      intent.keywords =
        cleaned
          .split(' ')
          .filter(word => word.length > 2);

    }


    return intent;

  }


  /* ==========================================
     PRICE CONVERSION
  ========================================== */

  function parsePrice(price) {

    if (typeof price === 'number') {

      /*
        Shopify predictive search usually
        returns money in smallest currency unit
      */

      if (price > 100000) {

        return price / 100;

      }

      return price;

    }


    if (typeof price === 'string') {

      return parseFloat(
        price.replace(/[^\d.]/g, '')
      );

    }


    return 0;

  }


  /* ==========================================
     RESPONSE TEXT
  ========================================== */

  function buildResponse(intent, products) {

    if (intent.brand) {

      return `I found these available <strong>${capitalize(intent.brand)}</strong> watches from our collection.`;

    }


    if (intent.dailyWear && intent.budgetMax) {

      return `Based on your request for a <strong>daily wear watch under ₹${formatNumber(intent.budgetMax)}</strong>, these are the most suitable available options.`;

    }


    if (intent.budgetMax) {

      return `I found these available watches within your budget of <strong>₹${formatNumber(intent.budgetMax)}</strong>.`;

    }


    if (intent.dailyWear) {

      return `For everyday use, I would recommend these versatile watches from our available collection.`;

    }


    if (intent.forHer) {

      return `Based on your request, these are suitable options for her from our available collection.`;

    }


    if (intent.forHim) {

      return `Based on your request, these are suitable options for him from our available collection.`;

    }


    if (intent.luxury) {

      return `Here are some premium watches from our available collection that match your luxury preference.`;

    }


    return `Based on what you're looking for, I found these available watches from our collection.`;

  }


  /* ==========================================
     NO RESULT
  ========================================== */

  function buildNoResultMessage(intent) {

    if (intent.budgetMax) {

      return `I couldn't find a suitable available watch matching your request within <strong>₹${formatNumber(intent.budgetMax)}</strong>. Try increasing the budget slightly or tell me a preferred brand.`;

    }


    if (intent.brand) {

      return `I couldn't find a suitable available <strong>${capitalize(intent.brand)}</strong> watch matching your request right now.`;

    }


    if (intent.couple) {

      return `I couldn't find a dedicated couple watch combination in the current available collection.`;

    }


    return `I couldn't find an exact suitable match in our current available collection. Try telling me your budget, preferred brand, occasion or style.`;

  }


  /* ==========================================
     RENDER PRODUCTS
  ========================================== */

  function renderProducts(products, label) {

    if (!products.length) return;

    const wrapper = document.createElement('div');

    wrapper.className = 'sethi-ai-products';


    products.forEach((product, index) => {

      const price = parsePrice(product.price);

      const match =
        index === 0
          ? 'BEST MATCH'
          : label;


      const card = document.createElement('a');

      card.className = 'sethi-ai-product-card';

      card.href = product.url;


      card.innerHTML = `

        ${
          product.image
            ? `<img
                class="sethi-ai-product-image"
                src="${product.image}"
                alt="${escapeHtml(product.title)}"
              >`
            : ''
        }

        <div class="sethi-ai-product-info">

          <span class="sethi-ai-match">
            ${match}
          </span>

          ${
            product.vendor
              ? `<div class="sethi-ai-vendor">
                  ${escapeHtml(product.vendor)}
                </div>`
              : ''
          }

          <div class="sethi-ai-product-title">
            ${escapeHtml(product.title)}
          </div>

          <div class="sethi-ai-price">
            ₹${formatNumber(price)}
          </div>

        </div>

      `;

      wrapper.appendChild(card);

    });


    chat.appendChild(wrapper);

    scrollChat();

  }


  /* ==========================================
     HELPERS
  ========================================== */

  function escapeHtml(text) {

    const div = document.createElement('div');

    div.textContent = text;

    return div.innerHTML;

  }


  function formatNumber(number) {

    return new Intl.NumberFormat('en-IN').format(
      Math.round(number)
    );

  }


  function capitalize(text) {

    return text.replace(
      /\b\w/g,
      char => char.toUpperCase()
    );

  }


  function scrollChat() {

    setTimeout(function() {

      chat.scrollTop = chat.scrollHeight;

    }, 100);

  }

});

</script>


