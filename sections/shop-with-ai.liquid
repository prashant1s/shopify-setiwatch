{% comment %}
  SETHI AI CONCIERGE
  ChatGPT Style AI Watch Assistant
{% endcomment %}

<section id="sethi-ai-concierge" class="sethi-ai-concierge">

  <!-- FLOATING BUTTON -->
  <button class="sethi-ai-floating-btn" type="button" aria-label="Shop with AI">
    <span class="sethi-ai-floating-icon">
      ✦
    </span>
    <span class="sethi-ai-floating-text">Shop with AI</span>
  </button>


  <!-- OVERLAY -->
  <div class="sethi-ai-overlay"></div>


  <!-- AI DRAWER -->
  <div class="sethi-ai-drawer">

    <!-- HEADER -->
    <div class="sethi-ai-header">

      <div class="sethi-ai-branding">
        <div class="sethi-ai-logo">✦</div>

        <div>
          <span class="sethi-ai-small-title">SETHI WATCH COMPANY</span>
          <h2>SETHI AI</h2>
        </div>
      </div>

      <button class="sethi-ai-close" type="button" aria-label="Close">
        ×
      </button>

    </div>


    <!-- CHAT AREA -->
    <div class="sethi-ai-chat-area">

      <div class="sethi-ai-chat-inner">

        <!-- WELCOME -->
        <div class="sethi-ai-welcome">

          <div class="sethi-ai-welcome-icon">✦</div>

          <span class="sethi-ai-eyebrow">
            YOUR PERSONAL WATCH CONCIERGE
          </span>

          <h3>How can I help you find your perfect watch?</h3>

          <p>
            Tell me what you're looking for in your own words.
            I'll help you discover the best watches from our collection.
          </p>

        </div>


        <!-- SUGGESTED PROMPTS -->
        <div class="sethi-ai-suggestions">

          <span class="sethi-ai-suggestions-title">
            TRY ASKING
          </span>

          <button class="sethi-ai-suggestion" data-prompt="Mere liye koi premium daily wear watch batao">
            <span>⌚</span>
            Mere liye koi premium daily wear watch batao
          </button>

          <button class="sethi-ai-suggestion" data-prompt="30 se 40 hazaar ke budget mein best watch batao">
            <span>₹</span>
            30–40 hazaar ke budget mein best watch batao
          </button>

          <button class="sethi-ai-suggestion" data-prompt="Gift ke liye elegant women's watch suggest karo">
            <span>✦</span>
            Gift ke liye elegant women's watch suggest karo
          </button>

          <button class="sethi-ai-suggestion" data-prompt="Mujhe automatic movement wali watch chahiye">
            <span>⚙</span>
            Mujhe automatic movement wali watch chahiye
          </button>

        </div>


        <!-- MESSAGES -->
        <div class="sethi-ai-messages"></div>


        <!-- TYPING -->
        <div class="sethi-ai-typing">

          <div class="sethi-ai-message-avatar">✦</div>

          <div class="sethi-ai-typing-bubble">
            <span></span>
            <span></span>
            <span></span>
          </div>

        </div>

      </div>

    </div>


    <!-- FOOTER INPUT -->
    <div class="sethi-ai-input-area">

      <div class="sethi-ai-input-wrapper">

        <textarea
          class="sethi-ai-input"
          placeholder="Ask me about watches..."
          rows="1"
        ></textarea>

        <button class="sethi-ai-send" type="button" aria-label="Send">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none">
            <path d="M3 11.5L21 3L13 21L10 13L3 11.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
          </svg>
        </button>

      </div>

      <div class="sethi-ai-footer-note">
        SETHI AI recommends watches from the Sethi Watch Company collection.
      </div>

    </div>

  </div>

</section>


<style>

/* =====================================================
   SETHI AI CONCIERGE
===================================================== */

#shopify-section-{{ section.id }} {
  position: relative;
}


/* RESET */

.sethi-ai-concierge *,
.sethi-ai-concierge *:before,
.sethi-ai-concierge *:after {
  box-sizing: border-box;
}


/* =====================================================
   FLOATING BUTTON
===================================================== */

.sethi-ai-floating-btn {
  position: fixed;
  right: 28px;
  bottom: 28px;

  z-index: 9997;

  display: flex;
  align-items: center;
  gap: 12px;

  background: #090909;
  color: #ffffff;

  border: 1px solid rgba(255,255,255,.35);
  border-radius: 100px;

  padding: 8px 22px 8px 9px;

  font-family: inherit;
  font-size: 14px;
  font-weight: 500;

  cursor: pointer;

  box-shadow:
    0 12px 35px rgba(0,0,0,.22);

  transition:
    transform .3s ease,
    box-shadow .3s ease;
}

.sethi-ai-floating-btn:hover {
  transform: translateY(-3px);
  box-shadow:
    0 20px 45px rgba(0,0,0,.28);
}

.sethi-ai-floating-icon {
  width: 45px;
  height: 45px;

  border-radius: 50%;

  background: #f4f3ef;
  color: #111111;

  display: flex;
  align-items: center;
  justify-content: center;

  font-size: 21px;
}

.sethi-ai-floating-text {
  white-space: nowrap;
}


/* =====================================================
   OVERLAY
===================================================== */

.sethi-ai-overlay {
  position: fixed;
  inset: 0;

  z-index: 9998;

  background: rgba(15,15,15,.42);
  backdrop-filter: blur(4px);

  opacity: 0;
  visibility: hidden;

  transition:
    opacity .35s ease,
    visibility .35s ease;
}

.sethi-ai-overlay.active {
  opacity: 1;
  visibility: visible;
}


/* =====================================================
   DRAWER
===================================================== */

.sethi-ai-drawer {
  position: fixed;

  top: 0;
  right: 0;

  width: 100%;
  max-width: 540px;
  height: 100vh;

  z-index: 9999;

  background: #f6f5f2;

  display: flex;
  flex-direction: column;

  transform: translateX(100%);

  transition:
    transform .45s cubic-bezier(.22,.61,.36,1);

  box-shadow:
    -20px 0 60px rgba(0,0,0,.12);
}

.sethi-ai-drawer.active {
  transform: translateX(0);
}


/* =====================================================
   HEADER
===================================================== */

.sethi-ai-header {
  padding: 23px 28px;

  border-bottom: 1px solid #ddd9d2;

  display: flex;
  align-items: center;
  justify-content: space-between;

  flex-shrink: 0;
}

.sethi-ai-branding {
  display: flex;
  align-items: center;
  gap: 12px;
}

.sethi-ai-logo {
  width: 42px;
  height: 42px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background: #1b1b1a;
  color: #fff;

  font-size: 18px;
}

.sethi-ai-small-title {
  display: block;

  font-size: 9px;
  letter-spacing: .18em;
  font-weight: 600;

  color: #9a713e;

  margin-bottom: 4px;
}

.sethi-ai-branding h2 {
  margin: 0;

  font-family: Georgia, "Times New Roman", serif;

  font-size: 22px;
  line-height: 1;

  font-weight: 400;

  letter-spacing: .04em;
}

.sethi-ai-close {
  width: 42px;
  height: 42px;

  border: 0;
  background: transparent;

  color: #333;

  font-size: 34px;
  line-height: 1;

  cursor: pointer;

  transition: opacity .2s ease;
}

.sethi-ai-close:hover {
  opacity: .55;
}


/* =====================================================
   CHAT AREA
===================================================== */

.sethi-ai-chat-area {
  flex: 1;

  overflow-y: auto;

  scroll-behavior: smooth;
}

.sethi-ai-chat-inner {
  padding: 34px 28px 30px;
}


/* =====================================================
   WELCOME
===================================================== */

.sethi-ai-welcome {
  text-align: center;

  max-width: 410px;

  margin: 18px auto 32px;
}

.sethi-ai-welcome-icon {
  width: 60px;
  height: 60px;

  margin: 0 auto 20px;

  border-radius: 50%;

  display: flex;
  align-items: center;
  justify-content: center;

  background: #1c1c1b;
  color: #fff;

  font-size: 25px;

  box-shadow:
    0 10px 25px rgba(0,0,0,.12);
}

.sethi-ai-eyebrow {
  display: block;

  font-size: 9px;
  letter-spacing: .18em;
  font-weight: 600;

  color: #a27439;

  margin-bottom: 13px;
}

.sethi-ai-welcome h3 {
  margin: 0 0 12px;

  color: #262626;

  font-family: Georgia, "Times New Roman", serif;

  font-size: 30px;
  line-height: 1.22;

  font-weight: 400;
}

.sethi-ai-welcome p {
  margin: 0;

  color: #737373;

  font-size: 14px;
  line-height: 1.65;
}


/* =====================================================
   SUGGESTIONS
===================================================== */

.sethi-ai-suggestions {
  max-width: 460px;
  margin: 0 auto;
}

.sethi-ai-suggestions-title {
  display: block;

  font-size: 9px;
  letter-spacing: .16em;
  font-weight: 600;

  color: #9b9b9b;

  margin-bottom: 10px;
}

.sethi-ai-suggestion {
  width: 100%;

  display: flex;
  align-items: center;
  gap: 12px;

  padding: 14px 15px;

  margin-bottom: 8px;

  background: #fff;

  border: 1px solid #dedad3;

  color: #383838;

  text-align: left;

  font-family: inherit;
  font-size: 13px;

  cursor: pointer;

  transition:
    border-color .25s ease,
    transform .25s ease;
}

.sethi-ai-suggestion:hover {
  border-color: #333;
  transform: translateX(3px);
}

.sethi-ai-suggestion span {
  width: 25px;

  color: #a27439;

  font-size: 16px;

  text-align: center;
}


/* =====================================================
   MESSAGES
===================================================== */

.sethi-ai-messages {
  width: 100%;
}

.sethi-ai-message {
  display: flex;
  gap: 10px;

  margin: 22px 0;

  animation: sethiMessageIn .35s ease;
}

@keyframes sethiMessageIn {
  from {
    opacity: 0;
    transform: translateY(8px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}


/* AI MESSAGE */

.sethi-ai-message.ai {
  align-items: flex-start;
}

.sethi-ai-message-avatar {
  width: 32px;
  height: 32px;

  min-width: 32px;

  border-radius: 50%;

  display: flex;
  align-items: center;
  justify-content: center;

  background: #1c1c1b;
  color: #fff;

  font-size: 13px;
}

.sethi-ai-message-content {
  max-width: 78%;

  padding-top: 4px;
}

.sethi-ai-message-bubble {
  background: #ffffff;

  border: 1px solid #e2ded7;

  padding: 14px 16px;

  color: #353535;

  font-size: 14px;
  line-height: 1.65;
}


/* USER MESSAGE */

.sethi-ai-message.user {
  justify-content: flex-end;
}

.sethi-ai-message.user .sethi-ai-message-bubble {
  max-width: 78%;

  background: #1d1d1c;
  color: #fff;

  border: 0;

  padding: 13px 16px;
}


/* =====================================================
   PRODUCT CARDS
===================================================== */

.sethi-ai-products {
  display: grid;
  grid-template-columns: 1fr;

  gap: 10px;

  margin-top: 14px;
}

.sethi-ai-product-card {
  display: grid;

  grid-template-columns: 92px 1fr;

  gap: 13px;

  padding: 10px;

  background: #fff;

  border: 1px solid #ddd8d0;

  text-decoration: none;

  color: inherit;

  transition:
    border-color .25s ease,
    transform .25s ease;
}

.sethi-ai-product-card:hover {
  border-color: #1c1c1b;
  transform: translateY(-2px);
}

.sethi-ai-product-image {
  width: 92px;
  height: 105px;

  background: #f4f3f0;

  display: flex;
  align-items: center;
  justify-content: center;

  overflow: hidden;
}

.sethi-ai-product-image img {
  width: 100%;
  height: 100%;

  object-fit: contain;
}

.sethi-ai-product-info {
  min-width: 0;

  padding: 3px 3px 3px 0;
}

.sethi-ai-product-match {
  display: inline-block;

  padding: 4px 7px;

  margin-bottom: 7px;

  background: #e9f0ea;
  color: #487154;

  font-size: 9px;
  font-weight: 600;

  letter-spacing: .08em;
}

.sethi-ai-product-vendor {
  display: block;

  font-size: 9px;
  letter-spacing: .1em;
  text-transform: uppercase;

  color: #a27439;

  margin-bottom: 4px;
}

.sethi-ai-product-title {
  margin: 0 0 6px;

  font-family: Georgia, "Times New Roman", serif;

  font-size: 15px;
  line-height: 1.3;
  font-weight: 400;

  color: #252525;
}

.sethi-ai-product-price {
  font-size: 14px;
  font-weight: 600;

  color: #202020;
}


/* =====================================================
   TYPING
===================================================== */

.sethi-ai-typing {
  display: none;
  align-items: center;
  gap: 10px;

  margin-top: 20px;
}

.sethi-ai-typing.active {
  display: flex;
}

.sethi-ai-typing-bubble {
  padding: 14px 16px;

  background: #fff;

  border: 1px solid #e2ded7;

  display: flex;
  align-items: center;
  gap: 4px;
}

.sethi-ai-typing-bubble span {
  width: 5px;
  height: 5px;

  border-radius: 50%;

  background: #777;

  animation: sethiTyping 1.2s infinite;
}

.sethi-ai-typing-bubble span:nth-child(2) {
  animation-delay: .15s;
}

.sethi-ai-typing-bubble span:nth-child(3) {
  animation-delay: .3s;
}

@keyframes sethiTyping {
  0%, 60%, 100% {
    transform: translateY(0);
    opacity: .4;
  }

  30% {
    transform: translateY(-4px);
    opacity: 1;
  }
}


/* =====================================================
   INPUT AREA
===================================================== */

.sethi-ai-input-area {
  padding: 18px 28px 15px;

  background: #f6f5f2;

  border-top: 1px solid #ddd9d2;

  flex-shrink: 0;
}

.sethi-ai-input-wrapper {
  position: relative;

  display: flex;
  align-items: flex-end;

  background: #fff;

  border: 1px solid #cec9c0;

  transition:
    border-color .2s ease,
    box-shadow .2s ease;
}

.sethi-ai-input-wrapper:focus-within {
  border-color: #333;

  box-shadow:
    0 0 0 3px rgba(0,0,0,.04);
}

.sethi-ai-input {
  width: 100%;

  min-height: 54px;
  max-height: 130px;

  padding: 16px 55px 15px 16px;

  resize: none;

  border: 0;
  outline: none;

  background: transparent;

  font-family: inherit;
  font-size: 14px;

  color: #222;
}

.sethi-ai-send {
  position: absolute;

  right: 8px;
  bottom: 8px;

  width: 38px;
  height: 38px;

  display: flex;
  align-items: center;
  justify-content: center;

  border: 0;

  background: #1c1c1b;
  color: #fff;

  cursor: pointer;

  transition:
    background .2s ease,
    transform .2s ease;
}

.sethi-ai-send:hover {
  background: #9c713d;
  transform: scale(1.03);
}

.sethi-ai-footer-note {
  text-align: center;

  margin-top: 9px;

  font-size: 9px;
  line-height: 1.4;

  color: #999;
}


/* =====================================================
   MOBILE
===================================================== */

@media screen and (max-width: 749px) {

  .sethi-ai-floating-btn {
    right: 15px;
    bottom: 78px;

    padding: 7px 17px 7px 8px;

    font-size: 13px;
  }

  .sethi-ai-floating-icon {
    width: 40px;
    height: 40px;
  }

  .sethi-ai-drawer {
    max-width: 100%;
  }

  .sethi-ai-header {
    padding: 18px 18px;
  }

  .sethi-ai-chat-inner {
    padding: 24px 18px;
  }

  .sethi-ai-input-area {
    padding: 14px 18px 12px;
  }

  .sethi-ai-welcome h3 {
    font-size: 27px;
  }

}

</style>


<script>

document.addEventListener('DOMContentLoaded', function() {

  const container = document.querySelector('#sethi-ai-concierge');

  if (!container) return;


  /* ELEMENTS */

  const floatingButton = container.querySelector('.sethi-ai-floating-btn');
  const drawer = container.querySelector('.sethi-ai-drawer');
  const overlay = container.querySelector('.sethi-ai-overlay');
  const closeButton = container.querySelector('.sethi-ai-close');

  const input = container.querySelector('.sethi-ai-input');
  const sendButton = container.querySelector('.sethi-ai-send');

  const messagesContainer = container.querySelector('.sethi-ai-messages');
  const typing = container.querySelector('.sethi-ai-typing');

  const chatArea = container.querySelector('.sethi-ai-chat-area');
  const suggestions = container.querySelectorAll('.sethi-ai-suggestion');

  const welcome = container.querySelector('.sethi-ai-welcome');
  const suggestionsBox = container.querySelector('.sethi-ai-suggestions');


  /* CHAT HISTORY */

  let conversationHistory = [];


  /* OPEN CHAT */

  function openChat() {

    drawer.classList.add('active');
    overlay.classList.add('active');

    document.body.style.overflow = 'hidden';

    setTimeout(function() {
      input.focus();
    }, 400);

  }


  /* CLOSE CHAT */

  function closeChat() {

    drawer.classList.remove('active');
    overlay.classList.remove('active');

    document.body.style.overflow = '';

  }


  floatingButton.addEventListener('click', openChat);

  closeButton.addEventListener('click', closeChat);

  overlay.addEventListener('click', closeChat);


  /* AUTO RESIZE TEXTAREA */

  input.addEventListener('input', function() {

    this.style.height = 'auto';

    this.style.height = Math.min(this.scrollHeight, 130) + 'px';

  });


  /* ENTER TO SEND */

  input.addEventListener('keydown', function(event) {

    if (event.key === 'Enter' && !event.shiftKey) {

      event.preventDefault();

      sendMessage();

    }

  });


  sendButton.addEventListener('click', sendMessage);


  /* SUGGESTIONS */

  suggestions.forEach(function(button) {

    button.addEventListener('click', function() {

      input.value = this.dataset.prompt;

      sendMessage();

    });

  });


  /* SEND MESSAGE */

  async function sendMessage() {

    const message = input.value.trim();

    if (!message) return;


    /* Hide welcome after first message */

    welcome.style.display = 'none';
    suggestionsBox.style.display = 'none';


    /* Add User Message */

    addUserMessage(message);


    /* Save history */

    conversationHistory.push({
      role: 'user',
      content: message
    });


    /* Reset input */

    input.value = '';
    input.style.height = '54px';


    /* Show typing */

    typing.classList.add('active');

    scrollToBottom();


    try {

      /*
        ====================================================

        BACKEND API WILL CONNECT HERE

        Expected endpoint:

        /apps/sethi-ai/chat

        Expected request:

        {
          message: "user message",
          history: [...]
        }

        Expected response:

        {
          reply: "AI response",
          products: [
            {
              title,
              vendor,
              price,
              url,
              image,
              match
            }
          ]
        }

        ====================================================
      */


      const response = await fetch('/apps/sethi-ai/chat', {

        method: 'POST',

        headers: {
          'Content-Type': 'application/json'
        },

        body: JSON.stringify({
          message: message,
          history: conversationHistory
        })

      });


      if (!response.ok) {
        throw new Error('AI service unavailable');
      }


      const data = await response.json();


      typing.classList.remove('active');


      const aiReply = data.reply || 'I found a few watches that may suit what you are looking for.';


      addAIMessage(aiReply, data.products || []);


      conversationHistory.push({
        role: 'assistant',
        content: aiReply
      });


    } catch (error) {

      console.log('AI Backend not connected yet:', error);


      /*
        TEMPORARY DEMO RESPONSE

        Remove automatically once backend is connected.
      */


      setTimeout(function() {

        typing.classList.remove('active');


        const demoReply = getDemoResponse(message);


        addAIMessage(demoReply);


        conversationHistory.push({
          role: 'assistant',
          content: demoReply
        });

      }, 1200);

    }

  }


  /* ADD USER MESSAGE */

  function addUserMessage(message) {

    const messageElement = document.createElement('div');

    messageElement.className = 'sethi-ai-message user';

    messageElement.innerHTML = `
      <div class="sethi-ai-message-bubble"></div>
    `;

    messageElement
      .querySelector('.sethi-ai-message-bubble')
      .textContent = message;


    messagesContainer.appendChild(messageElement);

    scrollToBottom();

  }


  /* ADD AI MESSAGE */

  function addAIMessage(message, products = []) {

    const messageElement = document.createElement('div');

    messageElement.className = 'sethi-ai-message ai';


    const avatar = document.createElement('div');

    avatar.className = 'sethi-ai-message-avatar';

    avatar.textContent = '✦';


    const content = document.createElement('div');

    content.className = 'sethi-ai-message-content';


    const bubble = document.createElement('div');

    bubble.className = 'sethi-ai-message-bubble';

    bubble.textContent = message;


    content.appendChild(bubble);


    /*
      PRODUCT CARDS
    */

    if (products && products.length) {

      const productsWrapper = document.createElement('div');

      productsWrapper.className = 'sethi-ai-products';


      products.forEach(function(product) {

        const card = document.createElement('a');

        card.className = 'sethi-ai-product-card';

        card.href = product.url || '#';


        const imageHTML = product.image
          ? `<img src="${escapeHTML(product.image)}" alt="${escapeHTML(product.title)}">`
          : '';


        card.innerHTML = `

          <div class="sethi-ai-product-image">
            ${imageHTML}
          </div>

          <div class="sethi-ai-product-info">

            ${product.match ? `
              <span class="sethi-ai-product-match">
                ${escapeHTML(String(product.match))}% MATCH
              </span>
            ` : ''}

            <span class="sethi-ai-product-vendor">
              ${escapeHTML(product.vendor || 'SETHI WATCH COMPANY')}
            </span>

            <h4 class="sethi-ai-product-title">
              ${escapeHTML(product.title || '')}
            </h4>

            <div class="sethi-ai-product-price">
              ${escapeHTML(product.price || '')}
            </div>

          </div>

        `;

        productsWrapper.appendChild(card);

      });


      content.appendChild(productsWrapper);

    }


    messageElement.appendChild(avatar);

    messageElement.appendChild(content);


    messagesContainer.appendChild(messageElement);

    scrollToBottom();

  }


  /* DEMO AI RESPONSE */

  function getDemoResponse(message) {

    const text = message.toLowerCase();


    if (
      text.includes('budget') ||
      text.includes('₹') ||
      text.includes('30') ||
      text.includes('40') ||
      text.includes('50')
    ) {

      return "Absolutely! I can help with that. I’ve noted your budget preference. Is this watch for daily wear, office use, a special occasion, or as a gift?";

    }


    if (
      text.includes('gift') ||
      text.includes('birthday') ||
      text.includes('girlfriend') ||
      text.includes('wife') ||
      text.includes('brother')
    ) {

      return "That sounds like a great gift! Tell me a little about the person — their approximate age, style preference, and your budget. I’ll narrow down the best options from our collection.";

    }


    if (
      text.includes('automatic') ||
      text.includes('movement')
    ) {

      return "Excellent choice. Automatic watches offer incredible craftsmanship and mechanical character. Do you have a preferred budget range or brand in mind?";

    }


    return "Bilkul! Main aapki help karunga. Aap bas mujhe apni requirement normal language mein bataiye — budget, occasion, style ya brand preference — aur main Sethi Watch Company ke available collection mein se best options suggest karunga.";

  }


  /* SCROLL */

  function scrollToBottom() {

    setTimeout(function() {

      chatArea.scrollTop = chatArea.scrollHeight;

    }, 100);

  }


  /* ESCAPE HTML */

  function escapeHTML(value) {

    if (!value) return '';

    const div = document.createElement('div');

    div.textContent = value;

    return div.innerHTML;

  }


});

</script>


