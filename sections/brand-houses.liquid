<section
  id="BrandHouses-{{ section.id }}"
  class="brand-houses brand-houses--{{ section.id }}"
>
  <div class="brand-houses__inner">

    <div class="brand-houses__header">
      {% if section.settings.eyebrow != blank %}
        <p class="brand-houses__eyebrow">
          {{ section.settings.eyebrow }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="brand-houses__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <p class="brand-houses__subheading">
          {{ section.settings.subheading }}
        </p>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <div class="brand-houses__grid">
        {% for block in section.blocks %}
          <a
            href="{{ block.settings.link | default: '#' }}"
            class="brand-house"
            {{ block.shopify_attributes }}
          >
            <div class="brand-house__main">
              {% if block.settings.logo != blank %}
                {{
                  block.settings.logo
                  | image_url: width: 500
                  | image_tag:
                    loading: 'lazy',
                    widths: '180, 260, 360, 500',
                    sizes: '(min-width: 990px) 24vw, (min-width: 750px) 48vw, 50vw',
                    class: 'brand-house__logo',
                    alt: block.settings.brand_name
                }}
              {% elsif block.settings.brand_name != blank %}
                <span class="brand-house__name">
                  {{ block.settings.brand_name }}
                </span>
              {% endif %}
            </div>

            <div class="brand-house__hover">
              {% if block.settings.tagline != blank %}
                <span class="brand-house__tagline">
                  {{ block.settings.tagline }}
                </span>
              {% endif %}

              <span class="brand-house__explore">
                {{ section.settings.card_link_label }}
                <span aria-hidden="true">→</span>
              </span>
            </div>
          </a>
        {% endfor %}
      </div>
    {% endif %}

    <div class="brand-houses__footer">
      {% if section.settings.more_text != blank %}
        <p class="brand-houses__more">
          {{ section.settings.more_text }}
        </p>
      {% endif %}

      {% if section.settings.button_label != blank and section.settings.button_link != blank %}
        <a href="{{ section.settings.button_link }}" class="brand-houses__button">
          {{ section.settings.button_label }}
          <span aria-hidden="true">→</span>
        </a>
      {% endif %}
    </div>

  </div>
</section>

<style>
  .brand-houses--{{ section.id }} {
    --section-background: rgb(var(--color-canvas-deep));
    --text-color: rgb(var(--color-ink));
    --muted-color: rgb(var(--color-ink-muted));
    --accent-color: rgb(var(--color-gold));
    --divider-color: {{ section.settings.divider_color }};
    --columns: 6;
    width: 100%;
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    overflow: hidden;
    background: var(--section-background);
    color: var(--text-color);
  }

  .brand-houses--{{ section.id }} * {
    box-sizing: border-box;
  }

  .brand-houses--{{ section.id }} .brand-houses__inner {
    width: min(100% - 48px, {{ section.settings.container_width }}px);
    margin: 0 auto;
  }

  .brand-houses--{{ section.id }} .brand-houses__header {
    max-width: 760px;
    margin: 0 auto {{ section.settings.header_gap }}px;
    text-align: center;
  }

  .brand-houses--{{ section.id }} .brand-houses__eyebrow {
    margin: 0 0 10px;
    color: var(--accent-color);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 2.6px;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .brand-houses--{{ section.id }} .brand-houses__heading {
    margin: 0;
    color: var(--text-color);
    font-family: var(--font-display-family);
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 400;
    line-height: 1.04;
    letter-spacing: -0.6px;
  }

  .brand-houses--{{ section.id }} .brand-houses__subheading {
    max-width: 610px;
    margin: 15px auto 0;
    color: var(--muted-color);
    font-size: 13px;
    line-height: 1.7;
  }

  .brand-houses--{{ section.id }} .brand-houses__grid {
    display: grid;
    grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
    border-top: 1px solid var(--divider-color);
  }

  .brand-houses--{{ section.id }} .brand-house {
    position: relative;
    display: flex;
    min-height: {{ section.settings.card_height }}px;
    padding: 26px 18px;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    color: var(--text-color);
    border-bottom: 1px solid var(--divider-color);
    text-decoration: none;
    transition:
      background 0.35s ease,
      transform 0.35s ease;
  }


  .brand-houses--{{ section.id }} .brand-house__main {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: center;
    transition:
      transform 0.4s ease,
      opacity 0.3s ease;
  }

  .brand-houses--{{ section.id }} .brand-house__logo {
    display: block;
    width: auto;
    max-width: 82%;
    height: auto;
    max-height: {{ section.settings.logo_height }}px;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.82;
    transition:
      filter 0.35s ease,
      opacity 0.35s ease,
      transform 0.35s ease;
  }

  .brand-houses--{{ section.id }} .brand-house__name {
    font-size: 21px;
    font-weight: 600;
    letter-spacing: 2.2px;
    line-height: 1.1;
    text-align: center;
    text-transform: uppercase;
  }

  .brand-houses--{{ section.id }} .brand-house__hover {
    position: absolute;
    inset: auto 22px 18px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 14px;
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.35s ease,
      transform 0.35s ease;
  }

  .brand-houses--{{ section.id }} .brand-house__tagline {
    color: var(--muted-color);
    font-size: 10px;
    line-height: 1.35;
    letter-spacing: 0.9px;
    text-transform: uppercase;
  }

  .brand-houses--{{ section.id }} .brand-house__explore {
    flex-shrink: 0;
    color: var(--text-color);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 1.3px;
    text-transform: uppercase;
  }

  .brand-houses--{{ section.id }} .brand-house::after {
    content: "";
    position: absolute;
    right: 20%;
    bottom: 0;
    left: 20%;
    height: 1px;
    background: var(--accent-color);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.4s ease;
  }

  .brand-houses--{{ section.id }} .brand-house:hover {
    background: rgba(255, 255, 255, 0.65);
  }

  .brand-houses--{{ section.id }} .brand-house:hover .brand-house__main {
    transform: translateY(-12px);
  }

  .brand-houses--{{ section.id }} .brand-house:hover .brand-house__logo {
    filter: grayscale(0);
    opacity: 1;
    transform: scale(1.025);
  }

  .brand-houses--{{ section.id }} .brand-house:hover .brand-house__hover {
    opacity: 1;
    transform: translateY(0);
  }

  .brand-houses--{{ section.id }} .brand-house:hover::after {
    transform: scaleX(1);
  }

  .brand-houses--{{ section.id }} .brand-houses__footer {
    display: flex;
    margin-top: 34px;
    align-items: center;
    justify-content: center;
    gap: 22px;
    text-align: center;
  }

  .brand-houses--{{ section.id }} .brand-houses__more {
    margin: 0;
    color: var(--muted-color);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  .brand-houses--{{ section.id }} .brand-houses__button {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--text-color);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-decoration: none;
    text-transform: uppercase;
  }

  .brand-houses--{{ section.id }} .brand-houses__button::after {
    content: "";
    position: absolute;
  }

  @media screen and (max-width: 989px) {
    .brand-houses--{{ section.id }} {
      --columns: 3;
    }
  }

  @media screen and (max-width: 749px) {
    .brand-houses--{{ section.id }} {
      --columns: 2;
      padding-top: calc({{ section.settings.padding_top }}px * 0.72);
      padding-bottom: calc({{ section.settings.padding_bottom }}px * 0.72);
    }

    .brand-houses--{{ section.id }} .brand-houses__inner {
      width: min(100% - 28px, {{ section.settings.container_width }}px);
    }

    .brand-houses--{{ section.id }} .brand-houses__header {
      margin-bottom: 30px;
    }

    .brand-houses--{{ section.id }} .brand-houses__heading {
      font-size: calc({{ section.settings.heading_size }}px * 0.72);
    }

    .brand-houses--{{ section.id }} .brand-houses__subheading {
      font-size: 12px;
    }

    .brand-houses--{{ section.id }} .brand-house {
      min-height: {{ section.settings.mobile_card_height }}px;
      padding: 20px 14px;
    }

    .brand-houses--{{ section.id }} .brand-house__logo {
      max-width: 82%;
      max-height: {{ section.settings.mobile_logo_height }}px;
    }

    .brand-houses--{{ section.id }} .brand-house__name {
      font-size: 15px;
      letter-spacing: 1.3px;
    }

    .brand-houses--{{ section.id }} .brand-house__hover {
      display: none;
    }

    .brand-houses--{{ section.id }} .brand-house:hover .brand-house__main {
      transform: none;
    }

    .brand-houses--{{ section.id }} .brand-houses__footer {
      flex-direction: column;
      gap: 12px;
    }
  }
</style>

