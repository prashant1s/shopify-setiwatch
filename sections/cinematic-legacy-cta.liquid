<section
  id="SignatureClosing-{{ section.id }}"
  class="signature-closing signature-closing--{{ section.id }}"
  data-signature-closing
>
  <div class="signature-closing__inner">
    <div class="signature-closing__media">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 1800
          | image_tag:
            loading: 'lazy',
            widths: '700, 1000, 1400, 1800',
            sizes: '(min-width: 990px) 50vw, 100vw',
            class: 'signature-closing__image',
            alt: section.settings.heading
        }}
      {% else %}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'signature-closing__placeholder' }}
      {% endif %}

      {% if section.settings.image_badge != blank %}
        <span class="signature-closing__badge">
          {{ section.settings.image_badge }}
        </span>
      {% endif %}
    </div>

    <div class="signature-closing__content">
      <div class="signature-closing__copy">
        {% if section.settings.eyebrow != blank %}
          <p class="signature-closing__eyebrow signature-closing__reveal">
            {{ section.settings.eyebrow }}
          </p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="signature-closing__heading signature-closing__reveal">
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <p class="signature-closing__description signature-closing__reveal">
            {{ section.settings.description }}
          </p>
        {% endif %}

        {% if section.settings.primary_label != blank and section.settings.primary_link != blank %}
          <a
            href="{{ section.settings.primary_link }}"
            class="signature-closing__button signature-closing__reveal"
          >
            <span>{{ section.settings.primary_label }}</span>
            <span aria-hidden="true">→</span>
          </a>
        {% endif %}

        {% if section.settings.show_stats %}
          <div class="signature-closing__stats signature-closing__reveal">
            <div>
              <strong>{{ section.settings.stat_1_number }}</strong>
              <span>{{ section.settings.stat_1_label }}</span>
            </div>

            <div>
              <strong>{{ section.settings.stat_2_number }}</strong>
              <span>{{ section.settings.stat_2_label }}</span>
            </div>

            <div>
              <strong>{{ section.settings.stat_3_number }}</strong>
              <span>{{ section.settings.stat_3_label }}</span>
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<style>
  .signature-closing--{{ section.id }} {
    --background: {{ section.settings.background_color }};
    --text: {{ section.settings.text_color }};
    --muted: {{ section.settings.muted_color }};
    --accent: {{ section.settings.accent_color }};
    width: 100%;
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.outer_background }};
  }

  .signature-closing--{{ section.id }} * {
    box-sizing: border-box;
  }

  .signature-closing--{{ section.id }} .signature-closing__inner {
    display: grid;
    grid-template-columns: {{ section.settings.image_width }}% 1fr;
    width: min(100% - 48px, {{ section.settings.container_width }}px);
    min-height: {{ section.settings.desktop_height }}px;
    margin: 0 auto;
    overflow: hidden;
    background: var(--background);
    border: 1px solid rgba(23, 21, 19, .06);
    border-radius: {{ section.settings.corner_radius }}px;
    box-shadow: 0 24px 70px rgba(48, 37, 23, .08);
  }

  .signature-closing--{{ section.id }} .signature-closing__media {
    position: relative;
    min-width: 0;
    overflow: hidden;
    background: #e9e2da;
  }

  .signature-closing--{{ section.id }} .signature-closing__image,
  .signature-closing--{{ section.id }} .signature-closing__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    min-height: {{ section.settings.desktop_height }}px;
    object-fit: cover;
    object-position: {{ section.settings.image_position }};
    transition: transform 1.2s cubic-bezier(.22,1,.36,1);
  }

  .signature-closing--{{ section.id }}:hover .signature-closing__image {
    transform: scale(1.025);
  }

  .signature-closing--{{ section.id }} .signature-closing__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        rgba(88, 53, 31, .12),
        transparent 35%,
        transparent 75%,
        rgba(255, 255, 255, .06)
      );
    pointer-events: none;
  }

  .signature-closing--{{ section.id }} .signature-closing__badge {
    position: absolute;
    z-index: 2;
    top: 24px;
    left: 24px;
    padding: 9px 12px;
    color: #fff;
    background: rgba(18, 17, 15, .64);
    border: 1px solid rgba(255, 255, 255, .3);
    backdrop-filter: blur(14px);
    font-size: 8px;
    font-weight: 600;
    letter-spacing: 1.7px;
    text-transform: uppercase;
  }

  .signature-closing--{{ section.id }} .signature-closing__content {
    display: flex;
    min-width: 0;
    padding: {{ section.settings.content_padding }}px;
    align-items: center;
    justify-content: center;
    background:
      radial-gradient(circle at 85% 15%, rgba(255,255,255,.9), transparent 30%),
      var(--background);
  }

  .signature-closing--{{ section.id }} .signature-closing__copy {
    width: min(100%, {{ section.settings.content_width }}px);
    text-align: {{ section.settings.text_alignment }};
  }

  .signature-closing--{{ section.id }} .signature-closing__eyebrow {
    margin: 0 0 14px;
    color: var(--accent);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 2.6px;
    text-transform: uppercase;
  }

  .signature-closing--{{ section.id }} .signature-closing__heading {
    margin: 0;
    color: var(--text);
    font-family: Georgia, "Times New Roman", serif;
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 400;
    line-height: 1.04;
    letter-spacing: -.8px;
  }

  .signature-closing--{{ section.id }} .signature-closing__description {
    max-width: 560px;
    margin:
      20px
      {% if section.settings.text_alignment == 'center' %}auto{% elsif section.settings.text_alignment == 'right' %}0 0 auto{% else %}0{% endif %}
      0;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.75;
  }

  .signature-closing--{{ section.id }} .signature-closing__button {
    display: inline-flex;
    min-height: 52px;
    margin-top: 28px;
    padding: 0 22px;
    align-items: center;
    justify-content: center;
    gap: 12px;
    color: #fff;
    background: var(--text);
    border: 1px solid var(--text);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 1.4px;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      transform .3s ease,
      color .3s ease,
      background .3s ease,
      border-color .3s ease;
  }

  .signature-closing--{{ section.id }} .signature-closing__button:hover {
    color: var(--text);
    background: transparent;
    border-color: var(--accent);
    transform: translateY(-3px);
  }

  .signature-closing--{{ section.id }} .signature-closing__button span:last-child {
    transition: transform .3s ease;
  }

  .signature-closing--{{ section.id }} .signature-closing__button:hover span:last-child {
    transform: translateX(4px);
  }

  .signature-closing--{{ section.id }} .signature-closing__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: 42px;
    padding-top: 24px;
    border-top: 1px solid rgba(23, 21, 19, .1);
  }

  .signature-closing--{{ section.id }} .signature-closing__stats > div {
    padding: 0 18px;
    text-align: center;
    border-right: 1px solid rgba(23, 21, 19, .08);
  }

  .signature-closing--{{ section.id }} .signature-closing__stats > div:first-child {
    padding-left: 0;
  }

  .signature-closing--{{ section.id }} .signature-closing__stats > div:last-child {
    padding-right: 0;
    border-right: 0;
  }

  .signature-closing--{{ section.id }} .signature-closing__stats strong {
    display: block;
    color: var(--text);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 24px;
    font-weight: 400;
  }

  .signature-closing--{{ section.id }} .signature-closing__stats span {
    display: block;
    margin-top: 6px;
    color: var(--muted);
    font-size: 8px;
    font-weight: 600;
    letter-spacing: 1.2px;
    text-transform: uppercase;
  }

  .signature-closing--{{ section.id }} .signature-closing__reveal {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity .7s ease,
      transform .7s cubic-bezier(.22,1,.36,1);
  }

  .signature-closing--{{ section.id }}.is-visible .signature-closing__reveal {
    opacity: 1;
    transform: none;
  }

  .signature-closing--{{ section.id }}.is-visible .signature-closing__heading {
    transition-delay: .08s;
  }

  .signature-closing--{{ section.id }}.is-visible .signature-closing__description {
    transition-delay: .16s;
  }

  .signature-closing--{{ section.id }}.is-visible .signature-closing__button {
    transition-delay: .24s;
  }

  .signature-closing--{{ section.id }}.is-visible .signature-closing__stats {
    transition-delay: .32s;
  }

  @media screen and (max-width: 989px) {
    .signature-closing--{{ section.id }} .signature-closing__inner {
      grid-template-columns: 1fr;
    }

    .signature-closing--{{ section.id }} .signature-closing__image,
    .signature-closing--{{ section.id }} .signature-closing__placeholder {
      min-height: 440px;
    }

    .signature-closing--{{ section.id }} .signature-closing__content {
      padding: 64px 44px;
    }
  }

  @media screen and (max-width: 749px) {
    .signature-closing--{{ section.id }} {
      padding-top: calc({{ section.settings.padding_top }}px * .72);
      padding-bottom: calc({{ section.settings.padding_bottom }}px * .72);
    }

    .signature-closing--{{ section.id }} .signature-closing__inner {
      width: min(100% - 28px, {{ section.settings.container_width }}px);
      border-radius: calc({{ section.settings.corner_radius }}px * .7);
    }

    .signature-closing--{{ section.id }} .signature-closing__image,
    .signature-closing--{{ section.id }} .signature-closing__placeholder {
      min-height: {{ section.settings.mobile_image_height }}px;
    }

    .signature-closing--{{ section.id }} .signature-closing__content {
      padding: 48px 24px;
    }

    .signature-closing--{{ section.id }} .signature-closing__copy {
      text-align: left;
    }

    .signature-closing--{{ section.id }} .signature-closing__heading {
      font-size: calc({{ section.settings.heading_size }}px * .67);
    }

    .signature-closing--{{ section.id }} .signature-closing__description {
      margin-right: 0;
      margin-left: 0;
    }

    .signature-closing--{{ section.id }} .signature-closing__button {
      width: 100%;
    }

    .signature-closing--{{ section.id }} .signature-closing__stats {
      gap: 0;
    }

    .signature-closing--{{ section.id }} .signature-closing__stats > div {
      padding: 0 10px;
    }

    .signature-closing--{{ section.id }} .signature-closing__stats strong {
      font-size: 20px;
    }
  }
</style>

<script>
  (() => {
    const initSignatureClosing = (section) => {
      if (!section || section.dataset.signatureClosingReady === 'true') return;
      section.dataset.signatureClosingReady = 'true';

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              section.classList.add('is-visible');
              observer.disconnect();
            }
          });
        },
        { threshold: 0.2 }
      );

      observer.observe(section);
    };

    const initAll = (root = document) => {
      root.querySelectorAll('[data-signature-closing]').forEach(initSignatureClosing);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => initAll());
    } else {
      initAll();
    }

    document.addEventListener('shopify:section:load', (event) => {
      initAll(event.target);
    });
  })();
</script>

