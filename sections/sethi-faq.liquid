<section class="sethi-section sethi-faq" data-faq>
  <div class="sethi-container">
    <div class="sethi-section-header">
      {% if section.settings.eyebrow != blank %}
        <span class="sethi-eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}
      <div class="sethi-minute-track" role="presentation"></div>
      {% if section.settings.heading != blank %}
        <h2 class="sethi-heading sethi-heading--h2">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p class="sethi-subheading">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>

    <div class="sethi-faq__list">
      {% for block in section.blocks %}
        <details class="sethi-faq__item" {{ block.shopify_attributes }} {% if forloop.first %}open{% endif %}>
          <summary class="sethi-faq__question">
            <span>{{ block.settings.question }}</span>
            <span class="sethi-faq__toggle" aria-hidden="true"></span>
          </summary>
          <div class="sethi-faq__answer">{{ block.settings.answer }}</div>
        </details>
      {% endfor %}
    </div>

    {% if section.settings.help_text != blank or section.settings.phone != blank or section.settings.whatsapp_link != blank %}
      <div class="sethi-faq__help">
        {% if section.settings.help_text != blank %}<span>{{ section.settings.help_text }}</span>{% endif %}
        {% if section.settings.phone != blank %}
          <a href="tel:{{ section.settings.phone | remove: ' ' }}">{{ section.settings.phone }}</a>
        {% endif %}
        {% if section.settings.whatsapp_link != blank %}
          <a href="{{ section.settings.whatsapp_link }}" target="_blank" rel="noopener">WhatsApp us</a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

<style>
  .sethi-faq__list {
    max-width: 76rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .sethi-faq__item {
    border: 1px solid var(--color-border);
    border-radius: var(--sethi-radius-md);
    background: rgb(var(--color-surface));
    overflow: hidden;
  }
  .sethi-faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    font-family: var(--font-display-family);
    font-size: var(--text-h5);
    color: rgb(var(--color-ink));
    cursor: pointer;
    list-style: none;
    -webkit-tap-highlight-color: transparent;
  }
  .sethi-faq__question::-webkit-details-marker { display: none; }
  .sethi-faq__question:focus-visible {
    outline: 2px solid rgb(var(--color-gold));
    outline-offset: -2px;
  }
  .sethi-faq__toggle {
    flex: none;
    position: relative;
    width: 1.6rem;
    height: 1.6rem;
  }
  .sethi-faq__toggle::before,
  .sethi-faq__toggle::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    background: rgb(var(--color-gold));
    transform: translate(-50%, -50%);
    transition: transform 0.2s ease;
  }
  .sethi-faq__toggle::before { width: 1.6rem; height: 0.15rem; }
  .sethi-faq__toggle::after { width: 0.15rem; height: 1.6rem; }
  .sethi-faq__item[open] .sethi-faq__toggle::after { transform: translate(-50%, -50%) rotate(90deg); opacity: 0; }
  .sethi-faq__answer {
    padding: 0 var(--space-5) var(--space-4);
    font-family: var(--font-body-family);
    font-size: var(--text-body);
    color: rgb(var(--color-ink-muted));
    max-width: 66ch;
  }
  .sethi-faq__answer a { color: rgb(var(--color-gold-deep)); }
  .sethi-faq__help {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
    font-size: 1.3rem;
    color: rgb(var(--color-ink-muted));
  }
  .sethi-faq__help a {
    color: rgb(var(--color-gold-deep));
    text-decoration: underline;
  }
  @media (prefers-reduced-motion: reduce) {
    .sethi-faq__toggle::before,
    .sethi-faq__toggle::after { transition: none; }
  }
  @media screen and (max-width: 749px) {
    .sethi-faq__question { padding: var(--space-3) var(--space-4); font-size: var(--text-body-lg); }
    .sethi-faq__answer { padding: 0 var(--space-4) var(--space-3); }
  }
</style>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Good to know" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently Asked Questions" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "help_text", "label": "Help prompt text", "default": "Still have a question?" },
    { "type": "text", "id": "phone", "label": "Support phone number" },
    { "type": "url", "id": "whatsapp_link", "label": "WhatsApp link" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "question", "settings": { "question": "Is Sethi Watch an authorised dealer?", "answer": "<p>Yes. We have traded since 1950 and are an authorised multi-brand retailer for every brand we carry, including an authorised Casio Service Centre. Every watch we sell is genuine and backed by the manufacturer's own warranty.</p>" } },
        { "type": "question", "settings": { "question": "What warranty do I get?", "answer": "<p>Every watch carries the full manufacturer's brand warranty, honoured directly by the brand's own service network — not a seller's warranty that ends if we ever close.</p>" } },
        { "type": "question", "settings": { "question": "Can I pay by EMI?", "answer": "<p>Yes, EMI is available at checkout on eligible cards and orders. The option appears automatically during payment.</p>" } },
        { "type": "question", "settings": { "question": "What's your return and cancellation policy?", "answer": "<p>See our Shipping and Refund/Cancellation policies for full details, or contact us directly and we'll walk you through it.</p>" } },
        { "type": "question", "settings": { "question": "Do you service watches I didn't buy from you?", "answer": "<p>Yes. As a Casio Authorised Service Centre and general watch-service workshop, we service watches regardless of where they were purchased. Book a service or track an existing repair from the Services menu.</p>" } },
        { "type": "question", "settings": { "question": "What does \"Pre-Booking\" mean?", "answer": "<p>Pre-booking lets you reserve an upcoming or hard-to-find watch ahead of stock arriving. It works in three steps: (1) place a small deposit to reserve your watch, (2) we confirm sourcing and an expected timeline, (3) we contact you to collect or arrange delivery the moment it arrives. No obligation to complete the purchase if the timeline no longer works for you — full terms are confirmed with our team before any deposit is taken.</p>" } },
        { "type": "question", "settings": { "question": "How do I track my order or repair?", "answer": "<p>Use Track Order for a purchase, or the repair tracker page with your Repair ID for a watch currently being serviced.</p>" } }
      ]
    }
  ]
}
{% endschema %}
