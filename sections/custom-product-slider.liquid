{% liquid
  assign selected_collection = section.settings.collection
  assign products_limit = section.settings.products_limit
%}

<section
  class="custom-product-slider section-{{ section.id }}"
  id="ProductSlider-{{ section.id }}"
  data-product-slider
>
  <div class="custom-product-slider__container">

    <div class="custom-product-slider__header">
      <div class="custom-product-slider__heading-group">
        {% if section.settings.eyebrow != blank %}
          <p class="custom-product-slider__eyebrow">
            {{ section.settings.eyebrow }}
          </p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="custom-product-slider__heading">
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        {% if section.settings.subheading != blank %}
          <p class="custom-product-slider__subheading">
            {{ section.settings.subheading }}
          </p>
        {% endif %}
      </div>

      {% if section.settings.show_view_all and selected_collection != blank %}
        <a
          href="{{ selected_collection.url }}"
          class="custom-product-slider__view-all"
        >
          {{ section.settings.view_all_label | default: 'View all' }}
        </a>
      {% endif %}
    </div>

    {% if selected_collection != blank and selected_collection.products_count > 0 %}

      <div class="custom-product-slider__wrapper">

        <button
          type="button"
          class="custom-product-slider__arrow custom-product-slider__arrow--left"
          aria-label="Previous products"
          data-slider-previous
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M15 18L9 12L15 6"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>

        <div
          class="custom-product-slider__track"
          data-slider-track
          tabindex="0"
        >
          {% for product in selected_collection.products limit: products_limit %}
            <article class="custom-product-card sethi-product-card">

              <div class="custom-product-card__image-wrapper sethi-product-card__media">

                <a
                  href="{{ product.url }}"
                  class="custom-product-card__image-link"
                  aria-label="{{ product.title | escape }}"
                >
                  {% if product.featured_image != blank %}
                    {{
                      product.featured_image
                      | image_url: width: 700
                      | image_tag:
                        loading: 'lazy',
                        widths: '240, 360, 480, 600, 700',
                        sizes: '(min-width: 1200px) 17vw, (min-width: 750px) 24vw, 46vw',
                        class: 'custom-product-card__image',
                        alt: product.featured_image.alt
                    }}
                  {% else %}
                    {{ 'product-1' | placeholder_svg_tag: 'custom-product-card__placeholder' }}
                  {% endif %}
                </a>

                {% if product.compare_at_price > product.price %}
                  {% assign discount_amount = product.compare_at_price
                    | minus: product.price
                  %}
                  {% assign discount_percentage = discount_amount
                    | times: 100.0
                    | divided_by: product.compare_at_price
                    | round
                  %}

                  {% if section.settings.show_discount_badge %}
                    <span class="custom-product-card__badge">
                      {{ discount_percentage }}% off
                    </span>
                  {% endif %}
                {% endif %}

                {% if section.settings.show_wishlist_icon %}
                  <button
                    type="button"
                    class="custom-product-card__wishlist sethi-product-card__wishlist"
                    aria-label="Add {{ product.title | escape }} to wishlist"
                    data-wishlist-button
                    data-product-handle="{{ product.handle }}"
                  >
                    <svg
                      width="21"
                      height="21"
                      viewBox="0 0 24 24"
                      fill="none"
                      aria-hidden="true"
                    >
                      <path
                        d="M20.84 4.61A5.5 5.5 0 0 0 13.06 4.61L12 5.67L10.94 4.61A5.5 5.5 0 0 0 3.16 12.39L4.22 13.45L12 21.23L19.78 13.45L20.84 12.39A5.5 5.5 0 0 0 20.84 4.61Z"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </button>
                {% endif %}
              </div>

              <div class="custom-product-card__information sethi-product-card__body">

                {% if section.settings.show_vendor and product.vendor != blank %}
                  <div class="custom-product-card__vendor sethi-product-card__vendor">
                    {{ product.vendor }}
                  </div>
                {% endif %}

                <h3 class="custom-product-card__title sethi-product-card__title">
                  <a href="{{ product.url }}">
                    {{ product.title }}
                  </a>
                </h3>

                {% if product.metafields.reviews.rating.value != blank %}
                  <div class="custom-product-card__rating sethi-product-card__rating">
                    <span>
                      {{ product.metafields.reviews.rating.value.rating }}
                    </span>

                    <svg
                      width="13"
                      height="13"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
                    </svg>

                    {% if product.metafields.reviews.rating_count != blank %}
                      <span class="custom-product-card__rating-count sethi-product-card__rating-count">
                        | {{ product.metafields.reviews.rating_count }}
                      </span>
                    {% endif %}
                  </div>
                {% endif %}

                <div class="custom-product-card__price sethi-product-card__price">
                  <span class="custom-product-card__current-price">
                    {{ product.price | money }}
                  </span>

                  {% if product.compare_at_price > product.price %}
                    <s class="custom-product-card__compare-price">
                      {{ product.compare_at_price | money }}
                    </s>

                    {% unless section.settings.show_discount_badge %}
                      <span class="custom-product-card__discount">
                        {{ discount_percentage }}% off
                      </span>
                    {% endunless %}
                  {% endif %}
                </div>

              </div>
            </article>
          {% endfor %}
        </div>

        <button
          type="button"
          class="custom-product-slider__arrow custom-product-slider__arrow--right"
          aria-label="Next products"
          data-slider-next
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M9 18L15 12L9 6"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>

      </div>

    {% else %}

      <div class="custom-product-slider__empty">
        Please select a collection from the Theme Editor.
      </div>

    {% endif %}

  </div>
</section>

<style>
  .section-{{ section.id }} {
    --desktop-products: {{ section.settings.desktop_products }};
    --tablet-products: {{ section.settings.tablet_products }};
    --mobile-products: {{ section.settings.mobile_products }};
    --product-gap: {{ section.settings.product_gap }}px;
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .section-{{ section.id }}.custom-product-slider {
    display: block;
    width: 100%;
    padding-top: var(--section-padding-top);
    padding-bottom: var(--section-padding-bottom);
    overflow: hidden;
    background: {{ section.settings.background_color }};
  }

  .section-{{ section.id }} .custom-product-slider__container {
    width: 100%;
    max-width: {{ section.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .section-{{ section.id }} {
    --accent-color: {{ section.settings.accent_color }};
    --text-color: {{ section.settings.text_color }};
  }

  .section-{{ section.id }} .custom-product-slider__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 32px;
  }

  .section-{{ section.id }} .custom-product-slider__eyebrow {
    margin: 0 0 9px;
    color: var(--accent-color);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 2.5px;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .section-{{ section.id }} .custom-product-slider__heading {
    margin: 0;
    color: {{ section.settings.text_color }};
    font-family: var(--font-display-family);
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 400;
    line-height: 1.04;
    letter-spacing: -0.6px;
  }

  .section-{{ section.id }} .custom-product-slider__subheading {
    max-width: 560px;
    margin: 12px 0 0;
    color: {{ section.settings.secondary_text_color }};
    font-size: 13px;
    line-height: 1.7;
  }

  .section-{{ section.id }} .custom-product-slider__view-all {
    display: inline-flex;
    flex-shrink: 0;
    min-height: 40px;
    padding: 0 18px;
    align-items: center;
    justify-content: center;
    color: {{ section.settings.text_color }};
    border: 1px solid rgba(23, 21, 19, 0.2);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 1.3px;
    text-decoration: none;
    text-transform: uppercase;
    transition: background 0.3s ease, color 0.3s ease, border-color 0.3s ease;
  }

  .section-{{ section.id }} .custom-product-slider__view-all:hover {
    color: {{ section.settings.background_color }};
    background: {{ section.settings.text_color }};
    border-color: {{ section.settings.text_color }};
  }

  .section-{{ section.id }} .custom-product-slider__wrapper {
    position: relative;
    width: 100%;
  }

  .section-{{ section.id }} .custom-product-slider__track {
    display: flex;
    flex-wrap: nowrap;
    gap: var(--product-gap);
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-inline: contain;
    -webkit-overflow-scrolling: touch;
  }

  .section-{{ section.id }} .custom-product-slider__track::-webkit-scrollbar {
    display: none;
  }

  .section-{{ section.id }} .custom-product-card {
    flex: 0 0 calc(
      (100% - ((var(--desktop-products) - 1) * var(--product-gap)))
      / var(--desktop-products)
    );
    min-width: 0;
    scroll-snap-align: start;
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .section-{{ section.id }} .custom-product-card:hover {
    transform: translateY(-6px);
  }

  .section-{{ section.id }} .custom-product-card__image-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: {{ section.settings.image_radius }}px;
    background: rgb(var(--color-canvas-deep));
    box-shadow: 0 8px 24px rgba(var(--color-ink), 0.05);
    transition: box-shadow 0.4s ease;
  }

  .section-{{ section.id }} .custom-product-card:hover .custom-product-card__image-wrapper {
    box-shadow: 0 22px 46px rgba(var(--color-ink), 0.13);
  }

  .section-{{ section.id }} .custom-product-card__image-link {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: {{ section.settings.image_ratio }};
  }

  .section-{{ section.id }} .custom-product-card__image,
  .section-{{ section.id }} .custom-product-card__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_fit }};
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .section-{{ section.id }} .custom-product-card:hover .custom-product-card__image {
    transform: scale(1.045);
  }

  @media (prefers-reduced-motion: reduce) {
    .section-{{ section.id }} .custom-product-card,
    .section-{{ section.id }} .custom-product-card__image,
    .section-{{ section.id }} .custom-product-card__image-wrapper {
      transition: none;
    }

    .section-{{ section.id }} .custom-product-card:hover {
      transform: none;
    }
  }

  .section-{{ section.id }} .custom-product-card__wishlist {
    position: absolute;
    top: 11px;
    right: 11px;
    z-index: 2;
    display: flex;
    width: 41px;
    height: 41px;
    padding: 0;
    align-items: center;
    justify-content: center;
    color: var(--text-color);
    background: rgba(var(--color-surface), 0.92);
    border: 0;
    border-radius: 50%;
    box-shadow: 0 2px 10px rgba(var(--color-ink), 0.06);
    cursor: pointer;
    transition:
      background 0.2s ease,
      transform 0.2s ease;
  }

  .section-{{ section.id }} .custom-product-card__wishlist:hover {
    background: rgb(var(--color-surface));
    transform: scale(1.05);
  }

  .section-{{ section.id }} .custom-product-card__wishlist.is-active svg {
    fill: var(--text-color);
  }

  .section-{{ section.id }} .custom-product-card__badge {
    position: absolute;
    bottom: 10px;
    left: 10px;
    z-index: 2;
    padding: 6px 9px;
    color: rgb(var(--color-surface));
    background: rgba(23, 21, 19, 0.86);
    backdrop-filter: blur(8px);
    border-radius: var(--sethi-radius-sm);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.6px;
    line-height: 1;
    text-transform: uppercase;
  }

  .section-{{ section.id }} .custom-product-card__information {
    padding-top: 14px;
  }

  .section-{{ section.id }} .custom-product-card__vendor {
    margin: 0 0 5px;
    color: var(--accent-color);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 1.4px;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .section-{{ section.id }} .custom-product-card__title {
    display: -webkit-box;
    min-height: 40px;
    margin: 0 0 8px;
    overflow: hidden;
    color: {{ section.settings.text_color }};
    font-family: var(--font-display-family);
    font-size: 15px;
    font-weight: 400;
    line-height: 1.35;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .section-{{ section.id }} .custom-product-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .section-{{ section.id }} .custom-product-card__rating {
    display: flex;
    width: max-content;
    margin-bottom: 8px;
    padding: 3px 8px;
    align-items: center;
    gap: 4px;
    color: {{ section.settings.text_color }};
    background: rgba(23, 21, 19, 0.05);
    border-radius: var(--sethi-radius-md);
    font-size: 11px;
    line-height: 1;
  }

  .section-{{ section.id }} .custom-product-card__rating svg {
    fill: var(--accent-color);
  }

  .section-{{ section.id }} .custom-product-card__rating-count {
    color: {{ section.settings.secondary_text_color }};
  }

  .section-{{ section.id }} .custom-product-card__price {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }

  .section-{{ section.id }} .custom-product-card__current-price {
    color: {{ section.settings.text_color }};
    font-size: 15px;
    font-weight: 700;
  }

  .section-{{ section.id }} .custom-product-card__compare-price {
    color: {{ section.settings.secondary_text_color }};
    font-size: 12px;
  }

  .section-{{ section.id }} .custom-product-card__discount {
    color: var(--accent-color);
    font-size: 12px;
    font-weight: 600;
  }

  .section-{{ section.id }} .custom-product-slider__arrow {
    position: absolute;
    top: 42%;
    z-index: 5;
    display: flex;
    width: 44px;
    height: 44px;
    padding: 0;
    align-items: center;
    justify-content: center;
    color: var(--text-color);
    background: rgb(var(--color-surface));
    border: 1px solid var(--color-border);
    border-radius: 50%;
    box-shadow: 0 5px 18px rgba(var(--color-ink), 0.12);
    cursor: pointer;
    transform: translateY(-50%);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      background 0.2s ease;
  }

  .section-{{ section.id }} .custom-product-slider__arrow:hover {
    background: rgb(var(--color-canvas-deep));
    transform: translateY(-50%) scale(1.05);
  }

  .section-{{ section.id }} .custom-product-slider__arrow--left {
    left: -20px;
  }

  .section-{{ section.id }} .custom-product-slider__arrow--right {
    right: -20px;
  }

  .section-{{ section.id }} .custom-product-slider__arrow:disabled {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .section-{{ section.id }} .custom-product-slider__empty {
    padding: 40px 20px;
    text-align: center;
    background: rgb(var(--color-canvas-deep));
    border-radius: var(--sethi-radius-md);
  }

  @media screen and (max-width: 989px) {
    .section-{{ section.id }} .custom-product-card {
      flex-basis: calc(
        (100% - ((var(--tablet-products) - 1) * var(--product-gap)))
        / var(--tablet-products)
      );
    }

    .section-{{ section.id }} .custom-product-slider__arrow--left {
      left: 6px;
    }

    .section-{{ section.id }} .custom-product-slider__arrow--right {
      right: 6px;
    }
  }

  @media screen and (max-width: 749px) {
    .section-{{ section.id }} .custom-product-slider__container {
      padding: 0 16px;
    }

    .section-{{ section.id }} .custom-product-slider__header {
      margin-bottom: 18px;
    }

    .section-{{ section.id }} .custom-product-slider__heading {
      font-size: calc({{ section.settings.heading_size }}px * 0.78);
    }

    .section-{{ section.id }} .custom-product-card {
      flex-basis: calc(
        (100% - ((var(--mobile-products) - 1) * var(--product-gap)))
        / var(--mobile-products)
      );
    }

    .section-{{ section.id }} .custom-product-slider__arrow {
      display: none;
    }

    .section-{{ section.id }} .custom-product-card__wishlist {
      width: 36px;
      height: 36px;
      top: 8px;
      right: 8px;
    }

    .section-{{ section.id }} .custom-product-card__title {
      font-size: 12px;
    }

    .section-{{ section.id }} .custom-product-card__current-price {
      font-size: 14px;
    }
  }
</style>

<script>
  (() => {
    const initialiseProductSlider = (section) => {
      if (!section || section.dataset.sliderInitialised === 'true') return;

      const track = section.querySelector('[data-slider-track]');
      const previousButton = section.querySelector('[data-slider-previous]');
      const nextButton = section.querySelector('[data-slider-next]');

      if (!track || !previousButton || !nextButton) return;

      section.dataset.sliderInitialised = 'true';

      const getScrollAmount = () => {
        const firstCard = track.querySelector('.custom-product-card');

        if (!firstCard) {
          return track.clientWidth;
        }

        const trackStyle = window.getComputedStyle(track);
        const gap = parseFloat(trackStyle.columnGap || trackStyle.gap) || 0;

        return firstCard.getBoundingClientRect().width + gap;
      };

      const updateButtons = () => {
        const maximumScroll = track.scrollWidth - track.clientWidth;
        const currentScroll = track.scrollLeft;

        previousButton.disabled = currentScroll <= 5;
        nextButton.disabled = currentScroll >= maximumScroll - 5;
      };

      previousButton.addEventListener('click', () => {
        track.scrollBy({
          left: -getScrollAmount(),
          behavior: 'smooth'
        });
      });

      nextButton.addEventListener('click', () => {
        track.scrollBy({
          left: getScrollAmount(),
          behavior: 'smooth'
        });
      });

      track.addEventListener('scroll', updateButtons, { passive: true });
      window.addEventListener('resize', updateButtons);

      updateButtons();
    };

    const initialiseAllProductSliders = (container = document) => {
      container.querySelectorAll('[data-product-slider]').forEach((slider) => {
        initialiseProductSlider(slider);
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        initialiseAllProductSliders();
      });
    } else {
      initialiseAllProductSliders();
    }

    document.addEventListener('shopify:section:load', (event) => {
      initialiseAllProductSliders(event.target);
    });
  })();
</script>

{% schema %}
{
  "name": "Custom product slider",
  "tag": "section",
  "class": "custom-product-slider-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Bestsellers"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Description"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select collection"
    },
    {
      "type": "range",
      "id": "products_limit",
      "min": 4,
      "max": 24,
      "step": 1,
      "label": "Maximum products",
      "default": 12
    },
    {
      "type": "range",
      "id": "desktop_products",
      "min": 3,
      "max": 7,
      "step": 1,
      "label": "Products visible on desktop",
      "default": 6
    },
    {
      "type": "range",
      "id": "tablet_products",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Products visible on tablet",
      "default": 3
    },
    {
      "type": "select",
      "id": "mobile_products",
      "label": "Products visible on mobile",
      "default": "1.5",
      "options": [
        {
          "value": "1.2",
          "label": "1.2 products"
        },
        {
          "value": "1.5",
          "label": "1.5 products"
        },
        {
          "value": "2",
          "label": "2 products"
        }
      ]
    },
    {
      "type": "range",
      "id": "product_gap",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Space between products",
      "default": 20
    },
    {
      "type": "range",
      "id": "container_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Maximum section width",
      "default": 1700
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 64,
      "step": 1,
      "unit": "px",
      "label": "Heading size",
      "default": 40
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Product image ratio",
      "default": "1 / 1",
      "options": [
        {
          "value": "1 / 1",
          "label": "Square"
        },
        {
          "value": "4 / 5",
          "label": "Portrait"
        },
        {
          "value": "3 / 4",
          "label": "Tall portrait"
        }
      ]
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Product image fitting",
      "default": "cover",
      "options": [
        {
          "value": "cover",
          "label": "Cover"
        },
        {
          "value": "contain",
          "label": "Contain"
        }
      ]
    },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
