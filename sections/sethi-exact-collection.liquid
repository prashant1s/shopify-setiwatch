{{ 'component-facets.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'sethi-exact-collection.css' | asset_url | stylesheet_tag }}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">

<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'sethi-exact-collection.js' | asset_url }}" defer="defer"></script>

{% style %}
  .sethi-exact-collection {
    --sethi-body-font: "Manrope", sans-serif;
    --sethi-heading-font: "Cormorant Garamond", serif;
    font-family: var(--sethi-body-font);
    font-size: 15px;
    line-height: 1.55;
    color: #181818;
  }

  .sethi-exact-collection button,
  .sethi-exact-collection select,
  .sethi-exact-collection input,
  .sethi-exact-collection label,
  .sethi-exact-collection a,
  .sethi-exact-collection p,
  .sethi-exact-collection span,
  .sethi-exact-collection small,
  .sethi-exact-collection em {
    font-family: var(--sethi-body-font);
  }

  .sethi-exact-collection h1,
  .sethi-exact-collection h2,
  .sethi-exact-collection h3,
  .sethi-exact-collection .card__heading,
  .sethi-exact-collection .card__heading a {
    font-family: var(--sethi-heading-font) !important;
  }

  .sethi-exact-grid .card__heading,
  .sethi-exact-grid .card__heading a {
    font-size: 19px !important;
    line-height: 1.25 !important;
    font-weight: 600 !important;
    letter-spacing: 0.01em;
    color: #171717;
  }

  .sethi-exact-grid {
    align-items: stretch;
  }

  .sethi-exact-grid__item {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .sethi-exact-grid__item > .card-wrapper {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    width: 100%;
    height: 100%;
  }

  .sethi-exact-grid__item .card {
    flex: 1 1 auto;
    width: 100%;
    height: 100%;
  }

  .sethi-exact-grid__item .card__inner {
    width: 100%;
  }

  .sethi-exact-grid__item .card__media,
  .sethi-exact-grid__item .card__media .media {
    width: 100%;
    height: 100%;
  }

  .sethi-exact-grid__item .card__media .media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .sethi-exact-grid__item .card__heading {
    display: -webkit-box;
    height: 3.75em;
    min-height: 3.75em;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
  }

  .sethi-exact-grid__item .caption-with-letter-spacing {
    display: block;
    min-height: 16px;
    max-height: 16px;
    overflow: hidden;
  }

  .sethi-exact-grid__item .price {
    display: flex;
    align-items: center;
    min-height: 24px;
  }

  .sethi-exact-grid .caption-with-letter-spacing {
    font-family: var(--sethi-body-font) !important;
    font-size: 11px !important;
    line-height: 1.4;
    font-weight: 600;
    letter-spacing: 0.12em;
  }

  .sethi-exact-grid .price {
    font-family: var(--sethi-body-font) !important;
    font-size: 15px !important;
    font-weight: 600;
  }

  .sethi-exact-count {
    font-size: 14px !important;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  /* The custom filter trigger is a MOBILE control only.
     On desktop the vertical facets already provide the FILTER heading. */
  .sethi-exact-mobile-filter {
    display: none !important;
  }

  @media screen and (max-width: 749px) {
    .sethi-exact-mobile-filter {
      display: inline-flex !important;
    }
  }

  .sethi-exact-sidebar,
  .facets__heading,
  .facets__summary,
  .facets__label,
  .facets__label-text,
  .facets__selected,
  .active-facets__button,
  .active-facets__button-inner {
    font-family: var(--sethi-body-font) !important;
  }

  .facets__heading {
    font-size: 15px !important;
    font-weight: 700 !important;
  }

  .facets__summary,
  .facets__label,
  .facets__label-text {
    font-size: 14px !important;
    line-height: 1.5 !important;
  }

  .facets__summary {
    font-weight: 600 !important;
    padding-top: 17px !important;
    padding-bottom: 17px !important;
  }

  /* On mobile Shopify's facets already provide the Filters control.
     Hide the duplicate vertical "FILTER:" heading. */
  @media screen and (max-width: 749px) {
    /* Keep our mobile Filters control. Hide only the duplicate vertical
       FILTER: title rendered by the facets markup. */
    .sethi-exact-sidebar .facets__heading {
      display: none !important;
    }
  }

  .sethi-exact-sort label,
  .facet-filters__label {
    font-size: 14px !important;
    font-weight: 600 !important;
  }

  .sethi-exact-sort select,
  .facet-filters__sort {
    min-height: 44px;
    padding: 0 38px 0 14px !important;
    border: 1px solid #d8d8d8;
    border-radius: 2px;
    background-color: #fff;
    font-size: 14px !important;
    font-weight: 500;
    color: #171717;
  }

  .sethi-exact-chips a {
    font-size: 13px !important;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .sethi-exact-grid__item {
    position: relative;
  }

  .sethi-product-badges {
    position: absolute;
    z-index: 5;
    top: 13px;
    left: 13px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    pointer-events: none;
  }

  .sethi-product-badge {
    display: inline-flex;
    align-items: center;
    min-height: 27px;
    padding: 5px 10px;
    font-family: var(--sethi-body-font) !important;
    font-size: 10px;
    line-height: 1;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.1);
  }

  .sethi-product-badge--best {
    color: #fff;
    background: #9a7426;
  }

  .sethi-product-badge--new {
    color: #fff;
    background: #161616;
  }

  price-range.facets__price,
  .sethi-price-slider-host {
    flex-wrap: wrap;
  }

  .sethi-price-slider-host > .field,
  .sethi-price-slider-host > .field-currency {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }

  .sethi-price-filter-enhanced > .facets__header,
  .sethi-price-filter-enhanced .facets__header,
  .sethi-price-filter-enhanced > .mobile-facets__info {
    display: none !important;
  }

  .sethi-original-price-control {
    display: none !important;
  }

  .sethi-price-slider {
    flex: 0 0 100%;
    width: 100%;
    margin: 8px 0 4px;
    order: -1;
  }

  .sethi-price-slider__rail {
    --sethi-price-low: 0%;
    --sethi-price-high: 100%;
    position: relative;
    width: 100%;
    height: 28px;
  }

  .sethi-price-slider__rail::before,
  .sethi-price-slider__rail::after {
    content: "";
    position: absolute;
    top: 50%;
    height: 7px;
    transform: translateY(-50%);
  }

  .sethi-price-slider__rail::before {
    left: 0;
    right: 0;
    background: #dedede;
  }

  .sethi-price-slider__rail::after {
    left: var(--sethi-price-low);
    right: calc(100% - var(--sethi-price-high));
    background: #9a7426;
  }

  .sethi-price-slider__input {
    position: absolute;
    z-index: 2;
    top: 0;
    left: 0;
    width: 100%;
    height: 28px;
    margin: 0;
    padding: 0;
    border: 0;
    outline: 0;
    appearance: none;
    -webkit-appearance: none;
    background: transparent;
    pointer-events: none;
  }

  .sethi-price-slider__input--max {
    z-index: 3;
  }

  .sethi-price-slider__input::-webkit-slider-runnable-track {
    height: 7px;
    background: transparent;
  }

  .sethi-price-slider__input::-webkit-slider-thumb {
    width: 18px;
    height: 18px;
    margin-top: -5.5px;
    border: 1px solid #bdbdbd;
    border-radius: 50%;
    appearance: none;
    -webkit-appearance: none;
    background: #fff;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.14);
    cursor: grab;
    pointer-events: auto;
  }

  .sethi-price-slider__input::-webkit-slider-thumb:active {
    cursor: grabbing;
    transform: scale(1.08);
  }

  .sethi-price-slider__input::-moz-range-track {
    height: 7px;
    border: 0;
    background: transparent;
  }

  .sethi-price-slider__input::-moz-range-thumb {
    width: 16px;
    height: 16px;
    border: 1px solid #bdbdbd;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.14);
    cursor: grab;
    pointer-events: auto;
  }

  .sethi-price-slider__input:focus-visible::-webkit-slider-thumb {
    outline: 2px solid #171717;
    outline-offset: 3px;
  }

  .sethi-price-slider__ticks {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 2px;
    margin: 0 0 14px;
  }

  .sethi-price-slider__ticks span {
    display: block;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: #c8c8c8;
  }

  .sethi-price-slider__controls {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 11px;
  }

  .sethi-price-slider__select {
    width: 100%;
    min-width: 0;
    height: 42px;
    padding: 0 32px 0 11px;
    border: 1px solid #d8d8d8;
    border-radius: 0;
    background-color: #fff;
    color: #171717;
    font-family: var(--sethi-body-font) !important;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
  }

  .sethi-price-slider__to {
    color: #777;
    font-size: 14px;
    font-weight: 500;
  }

  .sethi-card-compare {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    min-height: 40px;
    margin-top: 12px;
    padding: 9px 12px;
    border: 1px solid #d7d2c8;
    background: #fff;
    color: #242424;
    font-family: var(--sethi-body-font) !important;
    font-size: 11px;
    line-height: 1;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color 180ms ease, background 180ms ease, border-color 180ms ease;
  }

  .sethi-card-compare:hover,
  .sethi-card-compare[aria-pressed="true"] {
    border-color: #171717;
    background: #171717;
    color: #fff;
  }

  .sethi-card-compare__box {
    position: relative;
    display: block;
    width: 14px;
    height: 14px;
    flex: 0 0 14px;
    border: 1px solid currentColor;
  }

  .sethi-card-compare[aria-pressed="true"] .sethi-card-compare__box::after {
    content: "";
    position: absolute;
    left: 3px;
    top: 0;
    width: 5px;
    height: 9px;
    border: solid currentColor;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  .sethi-compare-mini {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .sethi-compare-mini img {
    display: block;
    width: 46px;
    height: 46px;
    object-fit: contain;
    background: #f6f6f4;
  }

  .sethi-compare-mini span {
    max-width: 120px;
    overflow: hidden;
    color: #fff;
    font-size: 11px;
    line-height: 1.3;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sethi-compare-mini button {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    padding: 0;
    border: 0;
    background: transparent;
    color: #fff;
    font-size: 18px;
    cursor: pointer;
  }

  .sethi-exact-compare-tray__button[aria-disabled="true"] {
    opacity: 0.45;
    pointer-events: none;
  }

  .sethi-product-badge--stock { color:#fff; background:#7b2d2d; }
  .sethi-exact-hero__content { position:absolute; z-index:3; inset:0; display:flex; flex-direction:column; justify-content:flex-end; align-items:flex-start; padding-top:40px; padding-bottom:clamp(42px,7vw,88px); color:#fff; }
  .sethi-exact-hero__crumbs { display:flex; align-items:center; gap:9px; margin-bottom:18px; font-size:11px; letter-spacing:.12em; text-transform:uppercase; opacity:.9; }
  .sethi-exact-hero__crumbs a { color:inherit; text-decoration:none; }
  .sethi-exact-hero__eyebrow { margin:0 0 10px; font-size:12px; font-weight:700; letter-spacing:.18em; text-transform:uppercase; }
  .sethi-exact-hero__content h1 { max-width:760px; margin:0; color:#fff; font-size:clamp(44px,6vw,82px); line-height:.96; }
  .sethi-exact-hero__description { max-width:650px; margin-top:18px; color:rgba(255,255,255,.9); font-size:15px; }
  .sethi-exact-hero__description p { margin:0; }
  .sethi-exact-text-link { display:inline-flex; align-items:center; gap:10px; margin-top:22px; padding-bottom:7px; border-bottom:1px solid rgba(255,255,255,.8); color:#fff; font-size:12px; font-weight:700; letter-spacing:.12em; text-decoration:none; text-transform:uppercase; }
  .sethi-exact-mini-trust { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); margin:0 auto 22px; border-top:1px solid #e7e2d9; border-bottom:1px solid #e7e2d9; }
  .sethi-exact-mini-trust__item { padding:16px 20px; text-align:center; border-right:1px solid #e7e2d9; }
  .sethi-exact-mini-trust__item:last-child { border-right:0; }
  .sethi-exact-mini-trust__item strong { display:block; font-size:11px; letter-spacing:.08em; text-transform:uppercase; }
  .sethi-exact-mini-trust__item span { display:block; margin-top:3px; font-size:12px; color:#666; }

  @media screen and (max-width: 749px) {
    .sethi-exact-hero__content { padding-bottom:34px; }
    .sethi-exact-hero__crumbs { margin-bottom:12px; font-size:9px; }
    .sethi-exact-hero__eyebrow { font-size:9px; }
    .sethi-exact-hero__content h1 { font-size:clamp(36px,12vw,52px); }
    .sethi-exact-hero__description { margin-top:12px; font-size:13px; max-width:90%; }
    .sethi-exact-mini-trust { grid-template-columns:repeat(2,minmax(0,1fr)); }
    .sethi-exact-mini-trust__item { padding:12px 9px; border-bottom:1px solid #e7e2d9; }
    .sethi-exact-mini-trust__item:nth-child(2), .sethi-exact-mini-trust__item:nth-child(4) { border-right:0; }
    .sethi-exact-mini-trust__item:nth-child(3), .sethi-exact-mini-trust__item:nth-child(4) { border-bottom:0; }

    .sethi-exact-collection {
      font-size: 14px;
    }

    .sethi-exact-grid .card__heading,
    .sethi-exact-grid .card__heading a {
      font-size: 17px !important;
    }

    .sethi-product-badges {
      top: 9px;
      left: 9px;
      gap: 4px;
    }

    .sethi-product-badge {
      min-height: 23px;
      padding: 4px 7px;
      font-size: 8px;
    }

    .sethi-price-slider__controls {
      gap: 8px;
    }

    .sethi-price-slider__select {
      height: 40px;
      padding-right: 26px;
      font-size: 13px;
    }

    .sethi-card-compare {
      min-height: 37px;
      margin-top: 9px;
      padding: 8px 7px;
      font-size: 9px;
    }
  }

  /* =========================================================
     FINAL COLLECTION LAYOUT OVERRIDES
  ========================================================= */

  /* Desktop structure */
  .sethi-exact-main {
    display: grid;
    grid-template-columns: minmax(220px, 250px) minmax(0, 1fr);
    align-items: start;
    gap: 34px;
    width: 100%;
    margin-top: 30px;
  }

  .sethi-exact-sidebar,
  .sethi-exact-content {
    min-width: 0;
  }

  .sethi-exact-sidebar {
    width: 100%;
  }

  .sethi-exact-content {
    width: 100%;
  }

  /* Keep all Shopify facet groups available in the left sidebar */
  .sethi-exact-sidebar .facets-container,
  .sethi-exact-sidebar .facets-vertical {
    width: 100%;
  }

  /* Toolbar */
  .sethi-exact-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding-top: 18px;
    padding-bottom: 18px;
  }

  .sethi-exact-toolbar__left,
  .sethi-exact-toolbar__right {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  /* Top compare button */
  .sethi-exact-compare-top {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 0 18px;
    border: 1px solid #1a1a1a;
    background: #1a1a1a;
    color: #fff;
    font-family: var(--sethi-body-font) !important;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background .2s ease, color .2s ease, border-color .2s ease;
  }

  .sethi-exact-compare-top:hover {
    background: #fff;
    color: #1a1a1a;
  }

  .sethi-exact-compare-top [data-compare-count] {
    display: inline-grid;
    place-items: center;
    min-width: 18px;
    height: 18px;
    margin-left: 5px;
    padding: 0 4px;
    border-radius: 999px;
    background: #9a7426;
    color: #fff;
    font-size: 9px;
  }

  /* Bottom compare tray */
  .sethi-exact-compare-tray {
    position: fixed;
    z-index: 50;
    left: 50%;
    bottom: 24px;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 18px;
    width: min(1120px, calc(100vw - 32px));
    padding: 14px 18px;
    background: #171717;
    color: #fff;
    box-shadow: 0 16px 40px rgba(0,0,0,.22);
  }

  .sethi-exact-compare-tray[hidden] {
    display: none !important;
  }

  .sethi-exact-compare-tray__copy {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 150px;
  }

  .sethi-exact-compare-tray__copy strong {
    font-size: 13px;
  }

  .sethi-exact-compare-tray__copy > span {
    color: rgba(255,255,255,.68);
    font-size: 11px;
  }

  .sethi-exact-compare-tray__items {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 1 1 auto;
    min-width: 0;
    overflow-x: auto;
  }

  .sethi-exact-compare-tray__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 0 16px;
    background: #fff;
    color: #171717;
    text-decoration: none;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .06em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .sethi-exact-compare-tray > button[data-compare-close] {
    width: 32px;
    height: 32px;
    padding: 0;
    border: 0;
    background: transparent;
    color: #fff;
    font-size: 24px;
    cursor: pointer;
  }

  /* Service banners: give the next section breathing room */
  .sethi-exact-services {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    margin-top: 54px !important;
    margin-bottom: 72px !important;
  }

  .sethi-exact-service-card {
    min-height: 285px;
  }

  .sethi-exact-trust {
    margin-top: 56px !important;
    margin-bottom: 0 !important;
  }

  /* Mobile */
  @media screen and (max-width: 989px) {
    .sethi-exact-main {
      grid-template-columns: 1fr;
      gap: 22px;
    }

    .sethi-exact-sidebar {
      width: 100%;
    }

    .sethi-exact-services {
      margin-top: 42px !important;
      margin-bottom: 56px !important;
    }
  }

  @media screen and (max-width: 749px) {
    .sethi-exact-toolbar {
      padding-top: 12px;
      padding-bottom: 12px;
    }

    .sethi-exact-toolbar__right {
      gap: 8px;
    }

    .sethi-exact-compare-top {
      min-height: 38px;
      padding: 0 11px;
      font-size: 9px;
    }

    .sethi-exact-sort label {
      display: none;
    }

    .sethi-exact-sort select {
      min-height: 38px;
      max-width: 132px;
      padding-left: 10px !important;
      padding-right: 28px !important;
      font-size: 12px !important;
    }

    .sethi-exact-compare-tray {
      bottom: 12px;
      width: calc(100vw - 20px);
      gap: 10px;
      padding: 10px 12px;
    }

    .sethi-exact-compare-tray__copy > span,
    .sethi-exact-compare-tray__items {
      display: none;
    }

    .sethi-exact-compare-tray__copy {
      flex: 1 1 auto;
      min-width: 0;
    }

