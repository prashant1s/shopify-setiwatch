<script>
  (() => {
    /* Some Prestige/Shopify facet versions render an extra literal
       "FILTER:" heading that does not use the standard facets__heading class. */
    const removeDuplicateMobileFilterHeading = () => {
      if (window.innerWidth > 749) return;
      document.querySelectorAll('.sethi-exact-sidebar').forEach((sidebar) => {
        sidebar.querySelectorAll('*').forEach((element) => {
          if (element.children.length === 0 && /^(filter|filters):?$/i.test(element.textContent.trim())) {
            element.style.display = 'none';
          }
        });
      });
    };

    const sectionSelector = '.sethi-exact-collection';

    // Our toolbar button should open Dawn's existing mobile facets drawer.
    const bindMobileFilterButton = () => {
      document.querySelectorAll('.sethi-exact-mobile-filter').forEach((button) => {
        if (button.dataset.sethiFilterBound === 'true') return;
        button.dataset.sethiFilterBound = 'true';
        button.addEventListener('click', () => {
          const nativeButton = document.querySelector(
            '.mobile-facets__open, [data-drawer-trigger="mobile-facets"], button[name="filter"]'
          );
          if (nativeButton && nativeButton !== button) nativeButton.click();
        });
      });
    };

    const numberValue = (value) => {
      const matches = String(value || '').match(/-?\d[\d,]*(?:\.\d+)?/g);
      if (!matches || !matches.length) return 0;

      const cleaned = matches[matches.length - 1].replace(/,/g, '');
      const parsed = Number.parseFloat(cleaned);
      return Number.isFinite(parsed) ? parsed : 0;
    };

    const highestNumberValue = (value) => {
      const matches = String(value || '').match(/\d[\d,]*(?:\.\d+)?/g) || [];
      return matches.reduce((highest, match) => {
        const parsed = Number.parseFloat(match.replace(/,/g, ''));
        return Number.isFinite(parsed) ? Math.max(highest, parsed) : highest;
      }, 0);
    };

    const clamp = (value, minimum, maximum) => {
      return Math.min(Math.max(value, minimum), maximum);
    };

    const niceIncrement = (rawStep) => {
      if (rawStep <= 0) return 1;

      const power = Math.pow(10, Math.floor(Math.log10(rawStep)));
      const fraction = rawStep / power;
      let niceFraction = 1;

      if (fraction > 5) niceFraction = 10;
      else if (fraction > 2) niceFraction = 5;
      else if (fraction > 1) niceFraction = 2;

      return Math.max(1, niceFraction * power);
    };

    const formatPrice = (value, currencySymbol) => {
      return `${currencySymbol}${Math.round(value).toLocaleString('en-IN')}`;
    };

    const initialisePriceRange = (priceRange) => {
      if (priceRange.dataset.sethiSliderReady === 'true') return;

      const allInputs = Array.from(priceRange.querySelectorAll('input'));
      let numberInputs = allInputs.filter((input) => {
        const identity = `${input.name || ''} ${input.id || ''}`;
        return /filter\.v\.price|price.*(?:gte|lte)|(?:gte|lte).*price/i.test(identity);
      });

      if (numberInputs.length < 2) {
        numberInputs = allInputs.filter((input) => {
          const identity = `${input.name || ''} ${input.id || ''} ${input.placeholder || ''}`;
          return /price|from|to|gte|lte|minimum|maximum/i.test(identity) && input.type !== 'range';
        });
      }

      if (numberInputs.length < 2) return;

      const minimumInput =
        numberInputs.find((input) => /gte|minimum|min/i.test(`${input.id} ${input.name}`)) ||
        numberInputs[0];

      const maximumInput =
        numberInputs.find((input) => /lte|maximum|max/i.test(`${input.id} ${input.name}`)) ||
        numberInputs[1];

      const minimumLimit = Math.min(
        numberValue(minimumInput.min),
        numberValue(maximumInput.min)
      );

      const priceFilterScope =
        priceRange.closest('details') ||
        priceRange.closest('.facets__disclosure') ||
        priceRange.parentElement;

      const maximumFromFilterText = highestNumberValue(
        priceFilterScope ? priceFilterScope.textContent : ''
      );

      const maximumLimit = Math.max(
        numberValue(minimumInput.max),
        numberValue(maximumInput.max),
        numberValue(maximumInput.placeholder),
        numberValue(maximumInput.value),
        numberValue(priceRange.dataset.rangeMax),
        maximumFromFilterText
      );

      if (!Number.isFinite(maximumLimit) || maximumLimit <= minimumLimit) return;

      priceRange.classList.add('sethi-price-slider-host');
      if (priceFilterScope) priceFilterScope.classList.add('sethi-price-filter-enhanced');

      [minimumInput, maximumInput].forEach((input) => {
        const field = input.closest('.field') || input.parentElement;
        if (field) field.classList.add('sethi-original-price-control');
      });

      priceRange.querySelectorAll('.field-currency').forEach((currency) => {
        currency.classList.add('sethi-original-price-control');
      });

      const priceSpan = maximumLimit - minimumLimit;
      const step = niceIncrement(priceSpan / 15);
      const currencySymbol =
        Array.from(priceRange.querySelectorAll('.field-currency'))
          .map((element) => element.textContent.trim())
          .find(Boolean) || '₹';

      const currentMinimum = clamp(
        minimumInput.value === '' ? minimumLimit : numberValue(minimumInput.value),
        minimumLimit,
        maximumLimit
      );
      const currentMaximum = clamp(
        maximumInput.value === '' ? maximumLimit : numberValue(maximumInput.value),
        minimumLimit,
        maximumLimit
      );

      const minimumOptions = ['<option value="">Min</option>'];
      const maximumOptions = [];

      for (let price = minimumLimit + step; price < maximumLimit; price += step) {
        const cleanPrice = Math.min(price, maximumLimit);
        const label = formatPrice(cleanPrice, currencySymbol);
        minimumOptions.push(`<option value="${cleanPrice}">${label}</option>`);
        maximumOptions.push(`<option value="${cleanPrice}">${label}</option>`);
      }

      maximumOptions.push(
        `<option value="">${formatPrice(maximumLimit, currencySymbol)}+</option>`
      );

      const slider = document.createElement('div');
      slider.className = 'sethi-price-slider';
      slider.innerHTML = `
        <div class="sethi-price-slider__rail">
          <input
            class="sethi-price-slider__input sethi-price-slider__input--min"
            type="range"
            min="${minimumLimit}"
            max="${maximumLimit}"
            step="${step}"
            value="${Math.min(currentMinimum, currentMaximum)}"
            aria-label="Minimum price"
          >
          <input
            class="sethi-price-slider__input sethi-price-slider__input--max"
            type="range"
            min="${minimumLimit}"
            max="${maximumLimit}"
            step="${step}"
            value="${Math.max(currentMinimum, currentMaximum)}"
            aria-label="Maximum price"
          >
        </div>
        <div class="sethi-price-slider__ticks" aria-hidden="true">
          <span></span><span></span><span></span><span></span>
          <span></span><span></span><span></span>
        </div>
        <div class="sethi-price-slider__controls">
          <select
            class="sethi-price-slider__select sethi-price-slider__select--min"
            aria-label="Choose minimum price"
          >
            ${minimumOptions.join('')}
          </select>
          <span class="sethi-price-slider__to">to</span>
          <select
            class="sethi-price-slider__select sethi-price-slider__select--max"
            aria-label="Choose maximum price"
          >
            ${maximumOptions.join('')}
          </select>
        </div>
      `;

      priceRange.prepend(slider);
      priceRange.dataset.sethiSliderReady = 'true';

      const rail = slider.querySelector('.sethi-price-slider__rail');
      const minimumSlider = slider.querySelector('.sethi-price-slider__input--min');
      const maximumSlider = slider.querySelector('.sethi-price-slider__input--max');
      const minimumSelect = slider.querySelector('.sethi-price-slider__select--min');
      const maximumSelect = slider.querySelector('.sethi-price-slider__select--max');

      const ensureSelectOption = (select, value) => {
        if (value === '' || Array.from(select.options).some((option) => option.value === String(value))) {
          return;
        }

        const option = document.createElement('option');
        option.value = value;
        option.textContent = formatPrice(value, currencySymbol);
        select.append(option);
      };

      ensureSelectOption(minimumSelect, minimumInput.value);
      ensureSelectOption(maximumSelect, maximumInput.value);
      minimumSelect.value = minimumInput.value === '' ? '' : String(currentMinimum);
      maximumSelect.value = maximumInput.value === '' ? '' : String(currentMaximum);

      const paintRail = () => {
        const span = maximumLimit - minimumLimit;
        const low = ((numberValue(minimumSlider.value) - minimumLimit) / span) * 100;
        const high = ((numberValue(maximumSlider.value) - minimumLimit) / span) * 100;

        rail.style.setProperty('--sethi-price-low', `${low}%`);
        rail.style.setProperty('--sethi-price-high', `${high}%`);
      };

      const syncMinimum = () => {
        const nextValue = Math.min(
          numberValue(minimumSlider.value),
          numberValue(maximumSlider.value)
        );

        minimumSlider.value = nextValue;
        minimumInput.value = nextValue <= minimumLimit ? '' : nextValue;
        ensureSelectOption(minimumSelect, minimumInput.value);
        minimumSelect.value = minimumInput.value;
        paintRail();
      };

      const syncMaximum = () => {
        const nextValue = Math.max(
          numberValue(maximumSlider.value),
          numberValue(minimumSlider.value)
        );

        maximumSlider.value = nextValue;
        maximumInput.value = nextValue >= maximumLimit ? '' : nextValue;
        ensureSelectOption(maximumSelect, maximumInput.value);
        maximumSelect.value = maximumInput.value;
        paintRail();
      };

      let priceFilterFallbackTimer;

      const applyPriceFilter = () => {
        [minimumInput, maximumInput].forEach((input) => {
          input.dispatchEvent(new Event('input', { bubbles: true, composed: true }));
          input.dispatchEvent(new Event('change', { bubbles: true, composed: true }));
        });

        const targetUrl = new URL(window.location.href);
        const minimumName = minimumInput.name || 'filter.v.price.gte';
        const maximumName = maximumInput.name || 'filter.v.price.lte';
        const minimumValue = minimumInput.value.trim();
        const maximumValue = maximumInput.value.trim();

        if (minimumValue === '') targetUrl.searchParams.delete(minimumName);
        else targetUrl.searchParams.set(minimumName, minimumValue);

        if (maximumValue === '') targetUrl.searchParams.delete(maximumName);
        else targetUrl.searchParams.set(maximumName, maximumValue);

        targetUrl.searchParams.delete('page');
        window.clearTimeout(priceFilterFallbackTimer);

        priceFilterFallbackTimer = window.setTimeout(() => {
          const currentUrl = new URL(window.location.href);
          const currentMinimum = currentUrl.searchParams.get(minimumName) || '';
          const currentMaximum = currentUrl.searchParams.get(maximumName) || '';

          const minimumMatches = minimumValue === ''
            ? currentMinimum === ''
            : numberValue(currentMinimum) === numberValue(minimumValue);

          const maximumMatches = maximumValue === ''
            ? currentMaximum === ''
            : numberValue(currentMaximum) === numberValue(maximumValue);

          if (!minimumMatches || !maximumMatches) {
            window.location.assign(targetUrl.toString());
          }
        }, 1200);
      };

      minimumSlider.addEventListener('input', syncMinimum);
      maximumSlider.addEventListener('input', syncMaximum);

      minimumSlider.addEventListener('change', () => {
        syncMinimum();
        applyPriceFilter();
      });

      maximumSlider.addEventListener('change', () => {
        syncMaximum();
        applyPriceFilter();
      });

      minimumSelect.addEventListener('change', () => {
        minimumSlider.value = minimumSelect.value === ''
          ? minimumLimit
          : clamp(numberValue(minimumSelect.value), minimumLimit, numberValue(maximumSlider.value));
        syncMinimum();
        applyPriceFilter();
      });

      maximumSelect.addEventListener('change', () => {
        maximumSlider.value = maximumSelect.value === ''
          ? maximumLimit
          : clamp(numberValue(maximumSelect.value), numberValue(minimumSlider.value), maximumLimit);
        syncMaximum();
        applyPriceFilter();
      });

      minimumInput.addEventListener('input', () => {
        minimumSlider.value = minimumInput.value === ''
          ? minimumLimit
          : clamp(numberValue(minimumInput.value), minimumLimit, numberValue(maximumSlider.value));
        ensureSelectOption(minimumSelect, minimumInput.value);
        minimumSelect.value = minimumInput.value;
        paintRail();
      });

      maximumInput.addEventListener('input', () => {
        maximumSlider.value = maximumInput.value === ''
          ? maximumLimit
          : clamp(numberValue(maximumInput.value), numberValue(minimumSlider.value), maximumLimit);
        ensureSelectOption(maximumSelect, maximumInput.value);
        maximumSelect.value = maximumInput.value;
        paintRail();
      });

      paintRail();
    };

    const initialiseAllSliders = () => {
      document.querySelectorAll(sectionSelector).forEach((section) => {
        const nativePriceRanges = section.querySelectorAll('price-range');

        if (nativePriceRanges.length) {
          nativePriceRanges.forEach((priceRange) => initialisePriceRange(priceRange));
          return;
        }

        section
          .querySelectorAll('.facets__price')
          .forEach((priceRange) => initialisePriceRange(priceRange));
      });
    };

    const compareStorageKey = 'sethi_compare_products';
    const compareLimit = 4;
    let compareTrayDismissed = false;
    let savedCompareProducts = [];

    try {
      const storedProducts = JSON.parse(window.localStorage.getItem(compareStorageKey) || '[]');
      if (Array.isArray(storedProducts)) savedCompareProducts = storedProducts;
    } catch (error) {
      savedCompareProducts = [];
    }

    const selectedCompareProducts = new Map(
      savedCompareProducts
        .filter((product) => product && product.id)
        .slice(0, compareLimit)
        .map((product) => [String(product.id), product])
    );

    const saveCompareProducts = () => {
      try {
        window.localStorage.setItem(
          compareStorageKey,
          JSON.stringify(Array.from(selectedCompareProducts.values()))
        );
      } catch (error) {
        /* Browsers with blocked storage can still compare during this page visit. */
      }
    };

    const productFromCompareButton = (button) => ({
  id: String(button.dataset.productId || ''),
  handle: button.dataset.productHandle || '',
  title: button.dataset.productTitle || '',
  url: button.dataset.productUrl || '',
  image: button.dataset.productImage || '',

  vendor: button.dataset.productVendor || '',
  price: button.dataset.productPrice || '',
  available: button.dataset.productAvailable === 'true',

  caseShape: button.dataset.caseShape || '',
  watchCollection: button.dataset.watchCollection || '',
  watchColor: button.dataset.watchColor || '',
  strapMaterial: button.dataset.strapMaterial || '',
  movement: button.dataset.movement || '',
  caseSize: button.dataset.caseSize || '',
  productDetails: button.dataset.productDetails || '',
  warranty: button.dataset.warranty || '',

  bandColor: button.dataset.bandColor || '',
  ageGroup: button.dataset.ageGroup || '',
  material: button.dataset.material || '',
  colorPattern: button.dataset.colorPattern || '',
  targetGender: button.dataset.targetGender || '',
  dialColor: button.dataset.dialColor || '',
  watchFeatures: button.dataset.watchFeatures || '',
  watchDisplay: button.dataset.watchDisplay || '',
  caseColor: button.dataset.caseColor || '',
  watchMaterial: button.dataset.watchMaterial || ''
});

    const updateCompareButtons = () => {
      document.querySelectorAll('[data-sethi-compare]').forEach((button) => {
        const selected = selectedCompareProducts.has(String(button.dataset.productId));
        const label = button.querySelector('[data-compare-label]');
        const nextLabel = selected ? 'Selected' : 'Add to Compare';

        button.setAttribute('aria-pressed', selected ? 'true' : 'false');
        if (label && label.textContent !== nextLabel) label.textContent = nextLabel;
      });
    };

    const renderCompareTray = () => {
      const products = Array.from(selectedCompareProducts.values());
      const count = products.length;

      document.querySelectorAll('[data-compare-count]').forEach((counter) => {
        counter.textContent = count;
      });

      document.querySelectorAll('[data-compare-tray]').forEach((tray) => {
        const items = tray.querySelector('[data-compare-items]');
        const compareLink = tray.querySelector('.sethi-exact-compare-tray__button');

        tray.hidden = count === 0 || compareTrayDismissed;

        if (items) {
          items.innerHTML = '';

          products.forEach((product) => {
            const item = document.createElement('div');
            item.className = 'sethi-compare-mini';

            if (product.image) {
              const image = document.createElement('img');
              image.src = product.image;
              image.alt = product.title;
              image.loading = 'lazy';
              item.append(image);
            }

            const title = document.createElement('span');
            title.textContent = product.title;
            item.append(title);

            const removeButton = document.createElement('button');
            removeButton.type = 'button';
            removeButton.dataset.removeCompare = product.id;
            removeButton.setAttribute('aria-label', `Remove ${product.title} from compare`);
            removeButton.textContent = '×';
            item.append(removeButton);

            items.append(item);
          });
        }

        if (compareLink) {
          const handles = products.map((product) => product.handle).filter(Boolean);
          const canCompare = handles.length >= 2;
          compareLink.href = canCompare
            ? `/pages/compare?products=${encodeURIComponent(handles.join(','))}`
            : '#';
          compareLink.setAttribute('aria-disabled', canCompare ? 'false' : 'true');
        }
      });

      updateCompareButtons();
      saveCompareProducts();
    };

    document.addEventListener('click', (event) => {
      const compareButton = event.target.closest('[data-sethi-compare]');

      if (compareButton) {
        event.preventDefault();
        const product = productFromCompareButton(compareButton);

        if (!product.id) return;

        if (selectedCompareProducts.has(product.id)) {
          selectedCompareProducts.delete(product.id);
        } else {
          if (selectedCompareProducts.size >= compareLimit) {
            window.alert(`You can compare up to ${compareLimit} watches at a time.`);
            return;
          }

          selectedCompareProducts.set(product.id, product);
          compareTrayDismissed = false;
        }

        renderCompareTray();
        return;
      }

      const removeButton = event.target.closest('[data-remove-compare]');

      if (removeButton) {
        event.preventDefault();
        selectedCompareProducts.delete(String(removeButton.dataset.removeCompare));
        compareTrayDismissed = false;
        renderCompareTray();
        return;
      }

      const trayCloseButton = event.target.closest('[data-compare-close]');

      if (trayCloseButton) {
        event.preventDefault();
        compareTrayDismissed = true;
        renderCompareTray();
        return;
      }

      const topCompareButton = event.target.closest('.sethi-exact-compare-top');

      if (topCompareButton && selectedCompareProducts.size > 0) {
        event.preventDefault();
        compareTrayDismissed = false;
        renderCompareTray();
      }
    });

    let animationFrame;
    const observer = new MutationObserver(() => {
      window.cancelAnimationFrame(animationFrame);
      animationFrame = window.requestAnimationFrame(() => {
        initialiseAllSliders();
        updateCompareButtons();
      });
    });

    const start = () => {
      removeDuplicateMobileFilterHeading();
      initialiseAllSliders();
      renderCompareTray();
      observer.observe(document.body, { childList: true, subtree: true });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', start, { once: true });
    } else {
      start();
    }

    document.addEventListener('shopify:section:load', () => {
      removeDuplicateMobileFilterHeading();
      initialiseAllSliders();
      renderCompareTray();
    });
  })();

  // Custom collection sort: keep all active filters/search parameters and
  // reload the collection with Shopify's native sort_by parameter.
  const sethiSortBy = document.getElementById('SethiSortBy');
  if (sethiSortBy && !sethiSortBy.dataset.bound) {
    sethiSortBy.dataset.bound = 'true';

    sethiSortBy.addEventListener('change', function () {
      const url = new URL(window.location.href);

      if (this.value) {
        url.searchParams.set('sort_by', this.value);
      } else {
        url.searchParams.delete('sort_by');
      }

      url.searchParams.delete('page');
      window.location.assign(url.toString());
    });
  }

