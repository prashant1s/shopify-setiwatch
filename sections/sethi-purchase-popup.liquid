{{ 'sethi-purchase-popup.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sethi-purchase-popup.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign popup_collection = section.settings.product_collection
  assign popup_limit = section.settings.product_limit
-%}

{%- if section.settings.enable_popup
  and popup_collection != blank
  and popup_collection.products_count > 0
-%}
  <recent-purchase-popup
    id="SethiPurchasePopup-{{ section.id }}"
    class="sethi-purchase-popup"
    data-section-id="{{ section.id }}"
    data-initial-delay="{{ section.settings.initial_delay | times: 1000 }}"
    data-display-duration="{{ section.settings.display_duration | times: 1000 }}"
    data-interval-min="{{ section.settings.interval_min | times: 1000 }}"
    data-interval-max="{{ section.settings.interval_max | times: 1000 }}"
    data-max-impressions="{{ section.settings.max_impressions }}"
    data-mobile-enabled="{{ section.settings.show_on_mobile }}"
    data-page-restriction="{{ section.settings.page_restriction }}"
    hidden
  >
    <div
      class="sethi-purchase-popup__card"
      role="status"
      aria-live="polite"
      aria-atomic="true"
    >
      <button
        type="button"
        class="sethi-purchase-popup__close"
        aria-label="Close recent purchase notification"
      >
        <svg
          width="14"
          height="14"
          viewBox="0 0 14 14"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M1 1L13 13M13 1L1 13"
            stroke="currentColor"
            stroke-width="1.4"
          />
        </svg>
      </button>

      <a
        href="#"
        class="sethi-purchase-popup__link"
        aria-label="View recently purchased watch"
      >
        <div class="sethi-purchase-popup__media">
          <img
            class="sethi-purchase-popup__image"
            src=""
            alt=""
            width="110"
            height="130"
            loading="lazy"
          >
        </div>

        <div class="sethi-purchase-popup__content">
          {%- if section.settings.eyebrow_text != blank -%}
            <p class="sethi-purchase-popup__eyebrow">
              {{ section.settings.eyebrow_text | escape }}
            </p>
          {%- endif -%}

          <p class="sethi-purchase-popup__message">
            <span>
              {{ section.settings.customer_text | escape }}
            </span>

            <span class="sethi-purchase-popup__city"></span>

            <span>
              {{ section.settings.purchase_text | escape }}
            </span>
          </p>

          <p class="sethi-purchase-popup__product-title"></p>

          <div class="sethi-purchase-popup__meta">
            <span class="sethi-purchase-popup__time"></span>

            {%- if section.settings.show_activity_label -%}
              <span class="sethi-purchase-popup__verified">
                <svg
                  width="13"
                  height="13"
                  viewBox="0 0 16 16"
                  fill="none"
                  aria-hidden="true"
                >
                  <circle
                    cx="8"
                    cy="8"
                    r="7.25"
                    stroke="currentColor"
                    stroke-width="1.5"
                  />

                  <path
                    d="M4.75 8.1L6.85 10.1L11.35 5.65"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>

                {{ section.settings.activity_label | escape }}
              </span>
            {%- endif -%}
          </div>
        </div>
      </a>

      <span
        class="sethi-purchase-popup__progress"
        aria-hidden="true"
      ></span>
    </div>

    <script
      type="application/json"
      class="sethi-purchase-popup__data"
    >
      {
        "products": [
          {%- for popup_product in popup_collection.products limit: popup_limit -%}
            {
              "title": {{ popup_product.title | json }},
              "url": {{ popup_product.url | json }},
              "image": {
                {%- if popup_product.featured_image != blank -%}
                  "src": {{ popup_product.featured_image | image_url: width: 360 | json }},
                  "alt": {{ popup_product.featured_image.alt | default: popup_product.title | json }}
                {%- else -%}
                  "src": "",
                  "alt": {{ popup_product.title | json }}
                {%- endif -%}
              },
              "city": "",
              "time": "",
              "customLabel": ""
            }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ],

        "fallbackCities": [
          {%- assign popup_cities = section.settings.fallback_cities | split: ',' -%}

          {%- for city in popup_cities -%}
            {{ city | strip | json }}
            {%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ],

        "fallbackTimes": [
          {%- assign popup_times = section.settings.fallback_times | split: ',' -%}

          {%- for time in popup_times -%}
            {{ time | strip | json }}
            {%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ]
      }
    </script>
  </recent-purchase-popup>
{%- endif -%}

{% schema %}
{
  "name": "Recent purchase popup",
  "tag": "section",
  "class": "sethi-global-purchase-popup",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_popup",
      "label": "Enable popup",
      "default": true
    },
    {
      "type": "collection",
      "id": "product_collection",
      "label": "Products collection",
      "info": "Products will be picked automatically from this collection."
    },
    {
      "type": "range",
      "id": "product_limit",
      "min": 4,
      "max": 30,
      "step": 1,
      "label": "Products available to popup",
      "default": 15
    },
    {
      "type": "select",
      "id": "page_restriction",
      "label": "Show popup on",
      "options": [
        {
          "value": "all",
          "label": "All pages"
        },
        {
          "value": "home",
          "label": "Homepage only"
        },
        {
          "value": "shopping",
          "label": "Homepage, collections and products"
        }
      ],
      "default": "shopping"
    },
    {
      "type": "checkbox",
      "id": "show_on_mobile",
      "label": "Show on mobile",
      "default": true
    },
    {
      "type": "header",
      "content": "Popup content"
    },
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Top label",
      "default": "Recently purchased"
    },
    {
      "type": "text",
      "id": "customer_text",
      "label": "Customer text",
      "default": "Someone in"
    },
    {
      "type": "text",
      "id": "purchase_text",
      "label": "Purchase text",
      "default": "recently purchased"
    },
    {
      "type": "checkbox",
      "id": "show_activity_label",
      "label": "Show activity label",
      "default": true
    },
    {
      "type": "text",
      "id": "activity_label",
      "label": "Activity label",
      "default": "Recent activity"
    },
    {
      "type": "textarea",
      "id": "fallback_cities",
      "label": "Cities",
      "info": "Separate cities with commas.",
      "default": "Delhi, Noida, Gurugram, Ghaziabad, Faridabad, Jaipur, Chandigarh"
    },
    {
      "type": "textarea",
      "id": "fallback_times",
      "label": "Time options",
      "info": "Separate values with commas.",
      "default": "2 minutes ago, 5 minutes ago, 8 minutes ago, 12 minutes ago, 18 minutes ago"
    },
    {
      "type": "header",
      "content": "Timing"
    },
    {
      "type": "range",
      "id": "initial_delay",
      "min": 2,
      "max": 30,
      "step": 1,
      "unit": "s",
      "label": "First popup delay",
      "default": 6
    },
    {
      "type": "range",
      "id": "display_duration",
      "min": 4,
      "max": 15,
      "step": 1,
      "unit": "s",
      "label": "Display duration",
      "default": 7
    },
    {
      "type": "range",
      "id": "interval_min",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "s",
      "label": "Minimum interval",
      "default": 20
    },
    {
      "type": "range",
      "id": "interval_max",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "s",
      "label": "Maximum interval",
      "default": 40
    },
    {
      "type": "range",
      "id": "max_impressions",
      "min": 1,
      "max": 12,
      "step": 1,
      "label": "Maximum popups per session",
      "default": 6
    }
  ],
  "presets": [
    {
      "name": "Recent purchase popup"
    }
  ]
}
{% endschema %}