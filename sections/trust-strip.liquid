<section class="trust-strip" data-trust-strip>
  <div class="sethi-container sethi-container--wide">
    <ul class="trust-strip__list" role="list">
      {% for block in section.blocks %}
        <li class="trust-strip__item" {{ block.shopify_attributes }}>
          <span class="trust-strip__icon" aria-hidden="true">
            {% case block.settings.icon %}
              {% when 'shield' %}
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M12 3L4 6v6c0 5 3.4 8.7 8 9 4.6-.3 8-4 8-9V6l-8-3Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {% when 'wrench' %}
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M14.7 6.3a4 4 0 0 0-5.4 4.6L4 16.2V20h3.8l5.3-5.3a4 4 0 0 0 4.6-5.4l-2.6 2.6-2-2 2.6-2.6Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
              {% when 'badge' %}
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="9" r="5" stroke="currentColor" stroke-width="1.4"/><path d="M9 13.5 7.5 21l4.5-2.5L16.5 21 15 13.5" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
              {% when 'return' %}
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M4 12a8 8 0 1 1 2.6 5.9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><path d="M4 17v-5h5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {% when 'card' %}
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><rect x="3" y="6" width="18" height="13" rx="2" stroke="currentColor" stroke-width="1.4"/><path d="M3 10.5h18" stroke="currentColor" stroke-width="1.4"/></svg>
              {% else %}
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.4"/></svg>
            {% endcase %}
          </span>
          <span class="trust-strip__text">
            <strong>{{ block.settings.heading }}</strong>
            {% if block.settings.subtext != blank %}<span>{{ block.settings.subtext }}</span>{% endif %}
          </span>
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

<style>
  .trust-strip {
    background: rgb(var(--color-canvas-deep));
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-4) 0;
  }
  .trust-strip__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--space-4);
  }
  .trust-strip__item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .trust-strip__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 3.6rem;
    height: 3.6rem;
    border-radius: 50%;
    background: rgb(var(--color-surface));
    color: rgb(var(--color-gold));
  }
  .trust-strip__text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }
  .trust-strip__text strong {
    font-family: var(--font-body-family);
    font-size: 1.3rem;
    font-weight: 600;
    color: rgb(var(--color-ink));
    line-height: 1.25;
  }
  .trust-strip__text span {
    font-size: 1.1rem;
    color: rgb(var(--color-ink-muted));
    line-height: 1.3;
  }

  @media screen and (max-width: 989px) {
    .trust-strip__list { grid-template-columns: repeat(3, 1fr); row-gap: var(--space-4); }
  }

  @media screen and (max-width: 749px) {
    .trust-strip {
      padding: var(--space-3) 0;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .trust-strip::-webkit-scrollbar { display: none; }
    .trust-strip__list {
      display: flex;
      grid-template-columns: unset;
      gap: var(--space-5);
      padding: 0 var(--space-4);
    }
    .trust-strip__item { flex: 0 0 auto; }
    .trust-strip__text span { display: none; }
    .trust-strip__text strong { font-size: 1.2rem; white-space: nowrap; }
    .trust-strip__icon { width: 3.2rem; height: 3.2rem; }
  }
</style>

{% schema %}
{
  "name": "Trust strip",
  "settings": [],
  "blocks": [
    {
      "type": "item",
      "name": "Trust item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shield", "label": "Shield (authorised)" },
            { "value": "wrench", "label": "Wrench (service)" },
            { "value": "badge", "label": "Badge (warranty)" },
            { "value": "return", "label": "Return arrow" },
            { "value": "card", "label": "Card (EMI/payment)" }
          ],
          "default": "shield"
        },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Authorised dealer" },
        { "type": "text", "id": "subtext", "label": "Subtext (optional, hidden on mobile)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust strip",
      "blocks": [
        { "type": "item", "settings": { "icon": "shield", "heading": "Authorised dealer", "subtext": "Since 1950" } },
        { "type": "item", "settings": { "icon": "wrench", "heading": "Casio service centre", "subtext": "In-house repairs" } },
        { "type": "item", "settings": { "icon": "badge", "heading": "Brand warranty", "subtext": "On every watch" } },
        { "type": "item", "settings": { "icon": "return", "heading": "Easy returns", "subtext": "Hassle-free process" } },
        { "type": "item", "settings": { "icon": "card", "heading": "EMI available", "subtext": "At checkout" } }
      ]
    }
  ]
}
{% endschema %}
